          <div class="cat-toolbar reveal delay-1" id="cat-toolbar">
            <div class="cat-toolbar-shell">
              <div class="ct-search">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                  ><circle cx="11" cy="11" r="7"></circle><path
                    d="m21 21-4.3-4.3"></path></svg
                >
                <input
                  type="search"
                  class="ct-input"
                  id="ct-search"
                  placeholder="Filtrer ces formations…"
                  autocomplete="off"
                  spellcheck="false"
                  aria-label="Filtrer les formations de la catégorie"
                />
                <kbd class="ct-kbd" aria-hidden="true">/</kbd>
              </div>
              <div
                class="ct-levels"
                role="group"
                aria-label="Filtrer par niveau"
                id="ct-levels"
              >
                <button
                  type="button"
                  class="ct-level"
                  data-level="all"
                  aria-pressed="true">Tous</button
                >
                <button
                  type="button"
                  class="ct-level"
                  data-level="initiation"
                  aria-pressed="false"
                  >Initiation <span class="ct-level-n"></span></button
                >
                <button
                  type="button"
                  class="ct-level"
                  data-level="intermediaire"
                  aria-pressed="false"
                  >Intermédiaire <span class="ct-level-n"></span></button
                >
                <button
                  type="button"
                  class="ct-level"
                  data-level="perfectionnement"
                  aria-pressed="false"
                  >Perfectionnement <span class="ct-level-n"></span></button
                >
                <button
                  type="button"
                  class="ct-level"
                  data-level="expert"
                  aria-pressed="false"
                  >Expert <span class="ct-level-n"></span></button
                >
              </div>
              <span class="ct-count"
                ><strong id="ct-n">8</strong> / 8 affichées</span
              >
            </div>
          </div>

          <ol class="fcat-grid" id="fcat-grid">
            <li
