    <!-- Script de soumission vers l'API Python Docker -->
    <script>
      const form = document.getElementById("contact-form") as HTMLFormElement;
      const errorEl = document.getElementById("q-error") as HTMLElement;
      const successEl = document.getElementById("q-success") as HTMLElement;
      const submitBtn = document.getElementById(
        "q-submit",
      ) as HTMLButtonElement;

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (errorEl) {
          errorEl.hidden = true;
          errorEl.textContent = "";
        }

        const formData = new FormData(form);
        const name = formData.get("name")?.toString() || "";
        const company = formData.get("company")?.toString() || "";
        const email = formData.get("email")?.toString() || "";
        const phone = formData.get("phone")?.toString() || "";
        const messageContent = formData.get("message")?.toString() || "";

        const fullMessage = `
Entreprise: ${company || "Non renseignée"}
Téléphone: ${phone || "Non renseigné"}

Message:
${messageContent}
        `.trim();

        const payload = {
          name,
          email,
          message: fullMessage,
        };

        try {
          if (submitBtn) submitBtn.disabled = true;

          // Appel au conteneur Docker "jcd-groupe-contact" sur le port 5000
          const response = await fetch("http://127.0.0.1:5000/api/contact", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          if (response.ok) {
            form.hidden = true;
            if (successEl) successEl.hidden = false;
          } else {
            const result = await response.json();
            if (errorEl) {
              errorEl.textContent =
                result.error || "Une erreur s'est produite lors de l'envoi.";
              errorEl.hidden = false;
            }
          }
        } catch (err) {
          if (errorEl) {
            errorEl.textContent =
              "Impossible de contacter le serveur d'envoi. Veuillez réessayer.";
            errorEl.hidden = false;
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    </script>

    <!-- jcd-a11y (Lot 5) -->
    <div class="jcd-fab-wrap" id="jcd-fab">
      <button
        class="jcd-fab jcd-fab--top"
        id="jcdToTop"
        type="button"
        aria-label="Remonter en haut"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M10 16V5M5 10l5-5 5 5"></path></svg
        >
      </button>
      <a
        class="jcd-fab jcd-fab--contact"
        id="jcdFabContact"
        href="/contact"
        aria-label="Nous contacter"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2.5" y="4.5" width="15" height="11" rx="2.3"></rect><path
            d="M3 6.7 L10 10.7 L17 6.7"></path></svg
        >
      </a>
    </div>
    <script is:inline src="/js/shared/a11y.js" id="jcd-a11y-js"></script>
    <script is:inline src="/js/shared/mrefonte.js" id="jcd-mrefonte-js"
    ></script>
