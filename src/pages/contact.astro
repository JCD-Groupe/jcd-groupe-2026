---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import { fetchSvgContent } from "../utils/formatters";

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let contact = await directus.request(
  readSingleton("contact", {
    fields: ["*"],
  }),
);

contact.icone_general_content = await fetchSvgContent(contact.icone_general);

let informatique = await directus.request(
  readSingleton("JCD_Informatique", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
informatique.icone_pole_content = await fetchSvgContent(
  informatique.icone_pole,
);

let developpement = await directus.request(
  readSingleton("JCD_Developpement", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
developpement.icone_pole_content = await fetchSvgContent(
  developpement.icone_pole,
);

let print = await directus.request(
  readSingleton("JCD_Print", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
print.icone_pole_content = await fetchSvgContent(print.icone_pole);

let service = await directus.request(
  readSingleton("JCD_Service", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
service.icone_pole_content = await fetchSvgContent(service.icone_pole);

let telecom = await directus.request(
  readSingleton("JCD_Telecom", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
telecom.icone_pole_content = await fetchSvgContent(telecom.icone_pole);

let formation = await directus.request(
  readSingleton("JCD_Formation", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
formation.icone_pole_content = await fetchSvgContent(formation.icone_pole);

let agencement = await directus.request(
  readSingleton("JCD_Agencement", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
agencement.icone_pole_content = await fetchSvgContent(agencement.icone_pole);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon}`}
      type="image/svg+xml"
    />
    <meta name="description" content={contact.meta_description} />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/contact`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={`Contact · ${global.nom_societe}`} />
    <meta property="og:description" content={contact.meta_description} />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/contact`}
    />
    <meta name="twitter:card" content="summary" />
    <title>Contact · {global.nom_societe}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/contact.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/contact-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/mpolish.js" id="jcd-mpolish-js"></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <Header current="contact" />

    <main id="contenu">
      <h1 class="visually-hidden">Contact — {global.nom_societe}</h1>

      <section class="q-section" aria-label="Formulaire de contact">
        <div class="container">
          <form id="contact-form" class="q-shell reveal" novalidate>
            <div class="q-shell-inner">
              <!-- Barre de progression (2 étapes) -->
              <div class="q-progress" aria-hidden="true">
                <div class="q-progress-track">
                  <div class="q-progress-fill" id="q-progress-fill"></div>
                </div>
                <ol class="q-progress-steps">
                  <li class="q-progress-step is-active" data-pstep="1">
                    <span class="q-progress-num">1</span><span
                      class="q-progress-label">Vos besoins</span
                    >
                  </li>
                  <li class="q-progress-step" data-pstep="2">
                    <span class="q-progress-num">2</span><span
                      class="q-progress-label">Coordonnées</span
                    >
                  </li>
                </ol>
              </div>

              <!-- ÉTAPE 1 — Sélection des pôles -->
              <section
                class="q-step"
                id="q-step-1"
                aria-labelledby="q-step1-title"
              >
                <!-- <div
                  class="q-intent"
                  role="radiogroup"
                  aria-label="Type de demande"
                >
                  <button
                    type="button"
                    class="q-intent-opt is-selected"
                    data-intent="projet"
                    role="radio"
                    aria-checked="true">Nouveau projet</button
                  >
                  <button
                    type="button"
                    class="q-intent-opt"
                    data-intent="assistance"
                    role="radio"
                    aria-checked="false">Assistance client</button
                  >
                  <span class="q-intent-glider" aria-hidden="true"></span>
                </div> -->

                <h2 id="q-step1-title" class="q-step-title" tabindex="-1">
                  Quels pôles souhaitez-vous solliciter&nbsp;?
                </h2>
                <p class="q-step-hint">
                  Sélectionnez les pôles concernés, ou passez directement à vos
                  coordonnées. <span class="q-count" id="q-pole-count"
                    >Aucun pôle sélectionné</span
                  >
                </p>

                <fieldset class="pole-fieldset">
                  <legend class="visually-hidden">Pôles d'expertise JCD</legend>
                  <div class="pole-grid" id="pole-grid">
                    <label class="pole-card" style="--pc: var(--c-informatique)"
                      ><input
                        type="checkbox"
                        name="pole"
                        value="informatique"
                        aria-label={`${informatique.nom_pole} — ${informatique.description_navigation}`}
                      /><span class="pole-ico" aria-hidden="true">
                        <Fragment set:html={informatique.icone_pole_content} />
                      </span><span class="pole-tx"
                        ><span class="pole-name">{informatique.nom_pole}</span
                        ><span class="pole-sub"
                          >{informatique.description_navigation}</span
                        ></span
                      ><span class="pole-check" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M20 6 9 17l-5-5"></path></svg
                        ></span
                      ></label
                    ><label class="pole-card" style="--pc: var(--c-service)"
                      ><input
                        type="checkbox"
                        name="pole"
                        value="service"
                        aria-label={`${service.nom_pole} — ${service.description_navigation}`}
                      /><span class="pole-ico" aria-hidden="true">
                        <Fragment set:html={service.icone_pole_content} />
                      </span><span class="pole-tx"
                        ><span class="pole-name">{service.nom_pole}</span><span
                          class="pole-sub"
                          >{service.description_navigation}</span
                        ></span
                      ><span class="pole-check" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M20 6 9 17l-5-5"></path></svg
                        ></span
                      ></label
                    ><label
                      class="pole-card"
                      style="--pc: var(--c-developpement)"
                      ><input
                        type="checkbox"
                        name="pole"
                        value="developpement"
                        aria-label={`${developpement.nom_pole} — ${developpement.description_navigation}`}
                      /><span class="pole-ico" aria-hidden="true">
                        <Fragment set:html={developpement.icone_pole_content} />
                      </span><span class="pole-tx"
                        ><span class="pole-name">{developpement.nom_pole}</span
                        ><span class="pole-sub"
                          >{developpement.description_navigation}</span
                        ></span
                      ><span class="pole-check" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M20 6 9 17l-5-5"></path></svg
                        ></span
                      ></label
                    ><label class="pole-card" style="--pc: var(--c-print)"
                      ><input
                        type="checkbox"
                        name="pole"
                        value="print"
                        aria-label={`${print.nom_pole} — ${print.description_navigation}`}
                      /><span class="pole-ico" aria-hidden="true">
                        <Fragment set:html={print.icone_pole_content} />
                      </span><span class="pole-tx"
                        ><span class="pole-name">{print.nom_pole}</span><span
                          class="pole-sub">{print.description_navigation}</span
                        ></span
                      ><span class="pole-check" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M20 6 9 17l-5-5"></path></svg
                        ></span
                      ></label
                    ><label class="pole-card" style="--pc: var(--c-telecom)"
                      ><input
                        type="checkbox"
                        name="pole"
                        value="telecom"
                        aria-label={`${telecom.nom_pole} — ${telecom.description_navigation}`}
                      /><span class="pole-ico" aria-hidden="true">
                        <Fragment set:html={telecom.icone_pole_content} />
                      </span><span class="pole-tx"
                        ><span class="pole-name">{telecom.nom_pole}</span><span
                          class="pole-sub"
                          >{telecom.description_navigation}</span
                        ></span
                      ><span class="pole-check" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M20 6 9 17l-5-5"></path></svg
                        ></span
                      ></label
                    ><label class="pole-card" style="--pc: var(--c-formation)"
                      ><input
                        type="checkbox"
                        name="pole"
                        value="formation"
                        aria-label={`${formation.nom_pole} — ${formation.description_navigation}`}
                      /><span class="pole-ico" aria-hidden="true">
                        <Fragment set:html={formation.icone_pole_content} />
                      </span><span class="pole-tx"
                        ><span class="pole-name">{formation.nom_pole}</span
                        ><span class="pole-sub"
                          >{formation.description_navigation}</span
                        ></span
                      ><span class="pole-check" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M20 6 9 17l-5-5"></path></svg
                        ></span
                      ></label
                    ><label class="pole-card" style="--pc: var(--c-agencement)"
                      ><input
                        type="checkbox"
                        name="pole"
                        value="agencement"
                        aria-label={`${agencement.nom_pole} — ${agencement.description_navigation}`}
                      /><span class="pole-ico" aria-hidden="true">
                        <Fragment set:html={agencement.icone_pole_content} />
                      </span><span class="pole-tx"
                        ><span class="pole-name">{agencement.nom_pole}</span
                        ><span class="pole-sub"
                          >{agencement.description_navigation}</span
                        ></span
                      ><span class="pole-check" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M20 6 9 17l-5-5"></path></svg
                        ></span
                      ></label
                    ><label
                      class="pole-card pole-card--light"
                      style="--pc: var(--c-servicesgeneraux)"
                      ><input
                        type="checkbox"
                        name="pole"
                        value="servicesgeneraux"
                        aria-label={`${contact.titre_general} — ${contact.sous_titre_general}`}
                      /><span class="pole-ico" aria-hidden="true">
                        <Fragment set:html={contact.icone_general_content} />
                      </span><span class="pole-tx"
                        ><span class="pole-name">{contact.titre_general}</span
                        ><span class="pole-sub"
                          >{contact.sous_titre_general}</span
                        ></span
                      ><span class="pole-check" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M20 6 9 17l-5-5"></path></svg
                        ></span
                      ></label
                    >
                  </div>
                </fieldset>

                <div class="q-actions">
                  <span aria-hidden="true"></span>
                  <button
                    type="button"
                    class="q-btn q-btn--primary"
                    id="to-step-2"
                  >
                    Continuer
                    <span class="q-btn-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </button>
                </div>
              </section>

              <!-- ÉTAPE 2 — Coordonnées + envoi -->
              <section
                class="q-step"
                id="q-step-2"
                aria-labelledby="q-step2-title"
                hidden
              >
                <h2 id="q-step2-title" class="q-step-title" tabindex="-1">
                  Vos coordonnées
                </h2>
                <p class="q-step-hint">Vous contactez&nbsp;:</p>
                <div class="q-recap" id="q-recap" aria-live="polite"></div>

                <div class="q-fields">
                  <div class="q-row">
                    <div class="q-field">
                      <label for="f-name"
                        >Nom et prénom <span aria-hidden="true">*</span></label
                      >
                      <input
                        id="f-name"
                        name="name"
                        type="text"
                        autocomplete="name"
                        required
                        placeholder="Jean Dupont"
                      />
                    </div>
                    <div class="q-field">
                      <label for="f-company">Société</label>
                      <input
                        id="f-company"
                        name="company"
                        type="text"
                        autocomplete="organization"
                        placeholder="Nom de votre entreprise"
                      />
                    </div>
                  </div>
                  <div class="q-row">
                    <div class="q-field">
                      <label for="f-email"
                        >Email <span aria-hidden="true">*</span></label
                      >
                      <input
                        id="f-email"
                        name="email"
                        type="email"
                        autocomplete="email"
                        required
                        placeholder="jean.dupont@societe.fr"
                      />
                    </div>
                    <div class="q-field">
                      <label for="f-phone">Téléphone</label>
                      <input
                        id="f-phone"
                        name="phone"
                        type="tel"
                        autocomplete="tel"
                        placeholder="06 12 34 56 78"
                      />
                    </div>
                  </div>
                  <div class="q-field">
                    <label for="f-message"
                      >Votre message <span aria-hidden="true">*</span></label
                    >
                    <textarea
                      id="f-message"
                      name="message"
                      rows="3"
                      required
                      placeholder="Décrivez votre contexte, vos objectifs, vos contraintes…"
                    ></textarea>
                  </div>
                </div>

                <label class="q-rgpd">
                  <input type="checkbox" id="f-consent" required />
                  <span
                    >J'accepte que les informations transmises soient utilisées
                    par JCD Groupe pour traiter ma demande, conformément à la <a
                      href="/politique-de-confidentialite"
                      target="_blank"
                      rel="noopener">politique de confidentialité</a
                    >. <span aria-hidden="true">*</span></span
                  >
                </label>

                <p class="q-error" id="q-error" role="alert" hidden></p>

                <div class="q-actions">
                  <button type="button" class="q-btn q-btn--ghost" data-back="1"
                    >Retour</button
                  >
                  <button
                    type="submit"
                    class="q-btn q-btn--primary q-btn--send"
                    id="q-submit"
                  >
                    Recevoir une réponse de nos experts
                    <span class="q-btn-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </button>
                </div>
              </section>
            </div>
          </form>

          <!-- Écran de confirmation -->
          <div
            class="q-success"
            id="q-success"
            hidden
            role="status"
            aria-live="polite"
          >
            <span class="q-success-mark" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg
              >
            </span>
            <h2>Votre demande est partie.</h2>
            <p>
              Merci&nbsp;! Nos équipes <strong id="q-success-poles"
                >concernées</strong
              > reviennent vers vous sous 24&nbsp;h ouvrées. Pour une urgence, appelez
              le <a href="tel:+33387184920">03 87 18 49 20</a>.
            </p>
            <div class="q-recap" id="q-success-recap" aria-hidden="true"></div>
            <div class="q-actions" style="justify-content: center;">
              <a href="/" class="q-btn q-btn--ghost">Retour à l'accueil</a>
            </div>
          </div>

          <noscript>
            <p
              style="max-width: 820px; margin: 24px auto; color: var(--text-2); text-align: center; line-height: 1.6;"
            >
              Le formulaire interactif nécessite JavaScript. Vous pouvez nous
              joindre directement au
              <a href="tel:+33387184920" style="color: var(--text-1);"
                >03 87 18 49 20</a
              > ou par email à
              <a
                href="mailto:contact@jcd-groupe.fr"
                style="color: var(--text-1);">contact@jcd-groupe.fr</a
              >.
            </p>
          </noscript>
        </div>
      </section>
    </main>

    <Footer />

    <!-- ================================
     DONNÉES PÔLES — source unique des cartes à cocher de l'étape 1
     (rendu : renderPoleCards dans /js/pages/contact-2.js).
     À câbler sur Directus : remplir ce bloc JSON depuis la collection
     des pôles. Champs : id, name, sub, icon (SVG inline, quotes
     simples), light (optionnel, carte claire). NB : chaque id doit
     avoir sa couleur --c-<id> définie dans le CSS de la page.
     ================================ -->
    <script is:inline id="jcd-poles-data" type="application/json">
      [
        {
          "id": "informatique",
          "name": "Informatique",
          "sub": "Parc, cloud & collaboration",
          "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='12' rx='2'/><path d='M8 20h8M12 16v4'/></svg>"
        },
        {
          "id": "service",
          "name": "Service",
          "sub": "Support & proximité",
          "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M3 14v-2a9 9 0 0 1 18 0v2'/><path d='M21 14v3a2 2 0 0 1-2 2h-1v-7h1a2 2 0 0 1 2 2zM3 14v3a2 2 0 0 0 2 2h1v-7H5a2 2 0 0 0-2 2z'/></svg>"
