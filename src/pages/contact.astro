---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="Contactez JCD Groupe en une seule demande. Sélectionnez un ou plusieurs pôles — Informatique, Service, Développement, Print, Télécom, Formation, Agencement — votre besoin est transmis directement aux bonnes équipes à Metz et Nancy."
    />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/contact`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content="Contact · JCD Groupe — Parlons de votre projet"
    />
    <meta
      property="og:description"
      content="Contactez JCD Groupe en une seule demande. Sélectionnez un ou plusieurs pôles — Informatique, Service, Développement, Print, Télécom, Formation, Agencement — votre besoin est transmis directement aux bonnes équipes à Metz et Nancy."
    />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/contact`}
    />
    <meta name="twitter:card" content="summary" />
    <title>Contact · JCD Groupe — Parlons de votre projet</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/contact.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/contact-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/mpolish.js" id="jcd-mpolish-js"></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header current="contact" />

    <main id="contenu">
      <h1 class="visually-hidden">Contact — JCD Groupe</h1>

      <section class="q-section" aria-label="Formulaire de contact">
        <div class="container">
          <form id="contact-form" class="q-shell reveal" novalidate>
            <div class="q-shell-inner">
              <!-- Barre de progression (3 étapes) -->
              <div class="q-progress" aria-hidden="true">
                <div class="q-progress-track">
                  <div class="q-progress-fill" id="q-progress-fill"></div>
                </div>
                <ol class="q-progress-steps">
                  <li class="q-progress-step is-active" data-pstep="1">
                    <span class="q-progress-num">1</span><span
                      class="q-progress-label">Vos besoins</span
                    >
                  </li>
                  <li class="q-progress-step" data-pstep="2">
                    <span class="q-progress-num">2</span><span
                      class="q-progress-label">Coordonnées</span
                    >
                  </li>
                </ol>
              </div>

              <!-- ÉTAPE 1 — Sélection des pôles -->
              <section
                class="q-step"
                id="q-step-1"
                aria-labelledby="q-step1-title"
              >
                <div
                  class="q-intent"
                  role="radiogroup"
                  aria-label="Type de demande"
                >
                  <button
                    type="button"
                    class="q-intent-opt is-selected"
                    data-intent="projet"
                    role="radio"
                    aria-checked="true">Nouveau projet</button
                  >
                  <button
                    type="button"
                    class="q-intent-opt"
                    data-intent="assistance"
                    role="radio"
                    aria-checked="false">Assistance client</button
                  >
                  <span class="q-intent-glider" aria-hidden="true"></span>
                </div>

                <h2 id="q-step1-title" class="q-step-title" tabindex="-1">
                  Quels pôles souhaitez-vous solliciter&nbsp;?
                </h2>
                <p class="q-step-hint">
                  Sélectionnez les pôles concernés, ou passez directement à vos
                  coordonnées. <span class="q-count" id="q-pole-count"
                    >Aucun pôle sélectionné</span
                  >
                </p>

                <fieldset class="pole-fieldset">
                  <legend class="visually-hidden">Pôles d'expertise JCD</legend>
                  <div class="pole-grid" id="pole-grid"></div>
                </fieldset>

                <div class="q-actions">
                  <span aria-hidden="true"></span>
                  <button
                    type="button"
                    class="q-btn q-btn--primary"
                    id="to-step-2"
                  >
                    Continuer
                    <span class="q-btn-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </button>
                </div>
              </section>

              <!-- ÉTAPE 2 — Coordonnées + envoi -->
              <section
                class="q-step"
                id="q-step-2"
                aria-labelledby="q-step2-title"
                hidden
              >
                <h2 id="q-step2-title" class="q-step-title" tabindex="-1">
                  Vos coordonnées
                </h2>
                <p class="q-step-hint">Vous contactez&nbsp;:</p>
                <div class="q-recap" id="q-recap" aria-live="polite"></div>

                <div class="q-fields">
                  <div class="q-row">
                    <div class="q-field">
                      <label for="f-name"
                        >Nom et prénom <span aria-hidden="true">*</span></label
                      >
                      <input
                        id="f-name"
                        name="name"
                        type="text"
                        autocomplete="name"
                        required
                        placeholder="Jean Dupont"
                      />
                    </div>
                    <div class="q-field">
                      <label for="f-company">Société</label>
                      <input
                        id="f-company"
                        name="company"
                        type="text"
                        autocomplete="organization"
                        placeholder="Nom de votre entreprise"
                      />
                    </div>
                  </div>
                  <div class="q-row">
                    <div class="q-field">
                      <label for="f-email"
                        >Email <span aria-hidden="true">*</span></label
                      >
                      <input
                        id="f-email"
                        name="email"
                        type="email"
                        autocomplete="email"
                        required
                        placeholder="jean.dupont@societe.fr"
                      />
                    </div>
                    <div class="q-field">
                      <label for="f-phone">Téléphone</label>
                      <input
                        id="f-phone"
                        name="phone"
                        type="tel"
                        autocomplete="tel"
                        placeholder="06 12 34 56 78"
                      />
                    </div>
                  </div>
                  <div class="q-field">
                    <label for="f-message"
                      >Votre message <span aria-hidden="true">*</span></label
                    >
                    <textarea
                      id="f-message"
                      name="message"
                      rows="3"
                      required
                      placeholder="Décrivez votre contexte, vos objectifs, vos contraintes…"
                    ></textarea>
                  </div>
                </div>

                <label class="q-rgpd">
                  <input type="checkbox" id="f-consent" required />
                  <span
                    >J'accepte que les informations transmises soient utilisées
                    par JCD Groupe pour traiter ma demande, conformément à la <a
                      href="/politique-de-confidentialite"
                      target="_blank"
                      rel="noopener">politique de confidentialité</a
                    >. <span aria-hidden="true">*</span></span
                  >
                </label>

                <p class="q-error" id="q-error" role="alert" hidden></p>

                <div class="q-actions">
                  <button type="button" class="q-btn q-btn--ghost" data-back="1"
                    >Retour</button
                  >
                  <button
                    type="submit"
                    class="q-btn q-btn--primary q-btn--send"
                    id="q-submit"
                  >
                    Recevoir une réponse de nos experts
                    <span class="q-btn-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </button>
                </div>
              </section>

              <!-- Champs cachés Web3Forms — REMPLACER la clé ci-dessous par votre
             clé d'accès gratuite (https://web3forms.com → email destinataire
             = contact@jcd-groupe.fr). Tant que la clé n'est pas renseignée,
             l'envoi échoue volontairement (message d'erreur affiché). -->
              <input
                type="hidden"
                name="access_key"
                id="f-access-key"
                value="VOTRE_CLE_WEB3FORMS_ICI"
              />
              <input
                type="hidden"
                name="subject"
                id="f-subject"
                value="Nouvelle demande de contact — JCD Groupe"
              />
              <input type="hidden" name="from_name" value="Site JCD Groupe" />
              <input
                type="checkbox"
                name="botcheck"
                id="f-botcheck"
                class="visually-hidden"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
              />
            </div>
          </form>

          <!-- Écran de confirmation (affiché après envoi réussi) -->
          <div
            class="q-success"
            id="q-success"
            hidden
            role="status"
            aria-live="polite"
          >
            <span class="q-success-mark" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg
              >
            </span>
            <h2>Votre demande est partie.</h2>
            <p>
              Merci&nbsp;! Nos équipes <strong id="q-success-poles"
                >concernées</strong
              > reviennent vers vous sous 24&nbsp;h ouvrées. Pour une urgence, appelez
              le <a href="tel:+33387184920">03 87 18 49 20</a>.
            </p>
            <div class="q-recap" id="q-success-recap" aria-hidden="true"></div>
            <div class="q-actions" style="justify-content: center;">
              <a href="/" class="q-btn q-btn--ghost">Retour à l'accueil</a>
            </div>
          </div>

          <noscript>
            <p
              style="max-width: 820px; margin: 24px auto; color: var(--text-2); text-align: center; line-height: 1.6;"
            >
              Le formulaire interactif nécessite JavaScript. Vous pouvez nous
              joindre directement au
              <a href="tel:+33387184920" style="color: var(--text-1);"
                >03 87 18 49 20</a
              > ou par email à
              <a
                href="mailto:contact@jcd-groupe.fr"
                style="color: var(--text-1);">contact@jcd-groupe.fr</a
              >.
            </p>
          </noscript>
        </div>
      </section>
    </main>

    <Footer />

    <!-- ================================
     DONNÉES PÔLES — source unique des cartes à cocher de l'étape 1
     (rendu : renderPoleCards dans /js/pages/contact-2.js).
     À câbler sur Directus : remplir ce bloc JSON depuis la collection
     des pôles. Champs : id, name, sub, icon (SVG inline, quotes
     simples), light (optionnel, carte claire). NB : chaque id doit
     avoir sa couleur --c-<id> définie dans le CSS de la page.
     ================================ -->
    <script is:inline id="jcd-poles-data" type="application/json">
      [
        {
          "id": "informatique",
          "name": "Informatique",
          "sub": "Parc, cloud & collaboration",
          "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='12' rx='2'/><path d='M8 20h8M12 16v4'/></svg>"
        },
        {
          "id": "service",
          "name": "Service",
          "sub": "Support & proximité",
          "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M3 14v-2a9 9 0 0 1 18 0v2'/><path d='M21 14v3a2 2 0 0 1-2 2h-1v-7h1a2 2 0 0 1 2 2zM3 14v3a2 2 0 0 0 2 2h1v-7H5a2 2 0 0 0-2 2z'/></svg>"
        },
        {
          "id": "developpement",
          "name": "Développement",
          "sub": "Logiciels sur mesure",
          "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='m8 6-6 6 6 6M16 6l6 6-6 6M14 4l-4 16'/></svg>"
        },
        {
          "id": "print",
          "name": "Print",
          "sub": "Impression & reprographie",
          "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9V3h12v6'/><rect x='3' y='9' width='18' height='8' rx='2'/><path d='M7 17h10v4H7z'/><circle cx='17' cy='13' r='0.8' fill='currentColor'/></svg>"
        },
        {
          "id": "telecom",
          "name": "Télécom",
          "sub": "Téléphonie d’entreprise",
          "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.29a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z'/></svg>"
        },
        {
          "id": "formation",
          "name": "Formation",
          "sub": "Monter en compétences",
          "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M22 10 12 5 2 10l10 5 10-5z'/><path d='M6 12v5c2 2 4 3 6 3s4-1 6-3v-5'/></svg>"
        },
        {
          "id": "agencement",
          "name": "Agencement",
          "sub": "Espaces de travail",
          "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M4 18v3M20 18v3M3 8h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM6 8V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3'/></svg>"
        },
        {
          "id": "servicesgeneraux",
          "name": "Services généraux",
          "sub": "Communication, direction, RH…",
          "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M3 21h18'/><path d='M5 21V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v16'/><path d='M16 21V9h3a2 2 0 0 1 2 2v10'/><path d='M9 7h2M9 11h2M9 15h2'/></svg>",
          "light": true
        }
      ]
    </script>

    <script is:inline src="/js/pages/contact-1.js"></script>

    <script is:inline src="/js/pages/contact-2.js"></script>
    <script is:inline src="/js/shared/menu-frost.js"></script>
    <!-- jcd-a11y (Lot 5) -->
    <div class="jcd-fab-wrap" id="jcd-fab">
      <button
        class="jcd-fab jcd-fab--top"
        id="jcdToTop"
        type="button"
        aria-label="Remonter en haut"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M10 16V5M5 10l5-5 5 5"></path></svg
        >
      </button>
      <a
        class="jcd-fab jcd-fab--contact"
        id="jcdFabContact"
        href="/contact"
        aria-label="Nous contacter"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2.5" y="4.5" width="15" height="11" rx="2.3"></rect><path
            d="M3 6.7 L10 10.7 L17 6.7"></path></svg
        >
      </a>
    </div>
    <script is:inline src="/js/shared/a11y.js" id="jcd-a11y-js"></script>
    <script is:inline src="/js/shared/micons.js" id="jcd-micons-js"></script>
    <script is:inline src="/js/shared/mrefonte.js" id="jcd-mrefonte-js"
    ></script>
  </body>
</html>
