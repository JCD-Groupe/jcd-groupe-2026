    <main id="contenu">
      <h1 class="visually-hidden">Contact — JCD Groupe</h1>

      <section class="q-section" aria-label="Formulaire de contact">
        <div class="container">
          <form id="contact-form" class="q-shell reveal" novalidate>
            <div class="q-shell-inner">
              <!-- Barre de progression (3 étapes) -->
              <div class="q-progress" aria-hidden="true">
                <div class="q-progress-track">
                  <div class="q-progress-fill" id="q-progress-fill"></div>
                </div>
                <ol class="q-progress-steps">
                  <li class="q-progress-step is-active" data-pstep="1">
                    <span class="q-progress-num">1</span><span
                      class="q-progress-label">Vos besoins</span
                    >
                  </li>
                  <li class="q-progress-step" data-pstep="2">
                    <span class="q-progress-num">2</span><span
                      class="q-progress-label">Coordonnées</span
                    >
                  </li>
                </ol>
              </div>

              <!-- ÉTAPE 1 — Sélection des pôles -->
              <section
                class="q-step"
                id="q-step-1"
                aria-labelledby="q-step1-title"
              >
                <div
                  class="q-intent"
                  role="radiogroup"
                  aria-label="Type de demande"
                >
                  <button
                    type="button"
                    class="q-intent-opt is-selected"
                    data-intent="projet"
                    role="radio"
                    aria-checked="true"
                  >
                    Nouveau projet
                  </button>
                  <button
                    type="button"
                    class="q-intent-opt"
                    data-intent="assistance"
                    role="radio"
                    aria-checked="false"
                  >
                    Assistance client
                  </button>
                  <span class="q-intent-glider" aria-hidden="true"></span>
                </div>

                <h2 id="q-step1-title" class="q-step-title" tabindex="-1">
                  Quels pôles souhaitez-vous solliciter&nbsp;?
                </h2>
                <p class="q-step-hint">
                  Sélectionnez les pôles concernés, ou passez directement à vos
                  coordonnées.
                  <span class="q-count" id="q-pole-count"
                    >Aucun pôle sélectionné</span
                  >
                </p>

                <fieldset class="pole-fieldset">
                  <legend class="visually-hidden">Pôles d'expertise JCD</legend>
                  <div class="pole-grid" id="pole-grid"></div>
                </fieldset>

                <div class="q-actions">
                  <span aria-hidden="true"></span>
                  <button
                    type="button"
                    class="q-btn q-btn--primary"
                    id="to-step-2"
                  >
                    Continuer
                    <span class="q-btn-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </button>
                </div>
              </section>

              <!-- ÉTAPE 2 — Coordonnées + envoi -->
              <section
                class="q-step"
                id="q-step-2"
                aria-labelledby="q-step2-title"
                hidden
              >
                <h2 id="q-step2-title" class="q-step-title" tabindex="-1">
                  Vos coordonnées
                </h2>
                <p class="q-step-hint">Vous contactez&nbsp;:</p>
                <div class="q-recap" id="q-recap" aria-live="polite"></div>

                <div class="q-fields">
                  <div class="q-row">
                    <div class="q-field">
                      <label for="f-name"
                        >Nom et prénom <span aria-hidden="true">*</span></label
                      >
                      <input
                        id="f-name"
                        name="name"
                        type="text"
                        autocomplete="name"
                        required
                        placeholder="Jean Dupont"
                      />
                    </div>
                    <div class="q-field">
                      <label for="f-company">Société</label>
                      <input
                        id="f-company"
                        name="company"
                        type="text"
                        autocomplete="organization"
                        placeholder="Nom de votre entreprise"
                      />
                    </div>
                  </div>
                  <div class="q-row">
                    <div class="q-field">
                      <label for="f-email"
                        >Email <span aria-hidden="true">*</span></label
                      >
                      <input
                        id="f-email"
                        name="email"
                        type="email"
                        autocomplete="email"
                        required
                        placeholder="jean.dupont@societe.fr"
                      />
                    </div>
                    <div class="q-field">
                      <label for="f-phone">Téléphone</label>
                      <input
                        id="f-phone"
                        name="phone"
                        type="tel"
                        autocomplete="tel"
                        placeholder="06 12 34 56 78"
                      />
                    </div>
                  </div>
                  <div class="q-field">
                    <label for="f-message"
                      >Votre message <span aria-hidden="true">*</span></label
