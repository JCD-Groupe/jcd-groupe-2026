---
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { fetchSvgContent } from "../utils/formatters";

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let service = await directus.request(
  readSingleton("JCD_Service", {
    fields: [
      "*",
      { prestations: ["*"] },
      { processus: ["*"] },
      { logos_confiance: ["*", { directus_files_id: ["*"] }] },
    ],
  }),
);

service.icone_cta_content = await fetchSvgContent(service.icone_cta);

service.prestations = await Promise.all(
  service.prestations.map(async (prestation: any) => ({
    ...prestation,
    icone_content: await fetchSvgContent(prestation.icone),
  })),
);

service.processus = await Promise.all(
  service.processus.map(async (processus: any) => ({
    ...processus,
    icone_content: await fetchSvgContent(processus.icone),
  })),
);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon}`}
      type="image/svg+xml"
    />
    <meta name="description" content={service.meta_description} />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/service`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content={`${service.nom_pole} • ${global.nom_societe}`}
    />
    <meta property="og:description" content={service.meta_description} />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/service`}
    />
    <meta name="twitter:card" content="summary" />
    <title>{service.nom_pole} • {global.nom_societe}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/service.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/service-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ================================
     HERO — Mesh WebGL fluide + texture pôle (pattern universel)
     ================================ -->
        <section class="print-hero" aria-labelledby="service-hero-title">
          <!-- Couche 0 : fallback CSS si WebGL indisponible / fade-in -->
          <div class="hero-mesh-fallback" aria-hidden="true"></div>

          <!-- Couche 1 : canvas WebGL — fond animé "Flux convergent" (filaments + bloom focal) -->
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>

          <!-- Couche 2 : texture pôle — Service = grille supervision / console -->
          <div class="hero-texture hero-texture--signal" aria-hidden="true">
          </div>

          <!-- Couche 3 : grain léger -->
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1
              id="service-hero-title"
              class="hero-title reveal delay-1"
              set:html={service.titre_hero}
            />

            <p
              class="hero-sub reveal delay-2"
              set:html={service.sous_titre_hero}
            />

            <div class="hero-actions reveal delay-3">
              <a
                href="/contact?pole=service&step=2"
                class="btn-cta btn-cta--ghost"
              >
                {service.bouton_hero}
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ================================
     MANIFESTO — Paper sheet inversion
     ================================ -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="signal-sheet">
            <!-- Constellation réseau discrète (statique) — derrière le contenu, masquée -->
            <svg
              class="sheet-net"
              viewBox="0 0 1440 560"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              preserveAspectRatio="xMidYMid slice"
            >
              <!-- Zone sure x 360-1060 / y 90-470 : aucun noeud n'est rogne, quel que soit
           le ratio du panneau. Les fils .net-out debordent tres au-dela du viewBox
           et rejoignent donc physiquement les bords a toutes les largeurs. -->
              <g class="net-lines">
                <line x1="360" y1="128" x2="540" y2="96"></line>
                <line x1="540" y1="96" x2="700" y2="124"></line>
                <line x1="700" y1="124" x2="880" y2="92"></line>
                <line x1="880" y1="92" x2="1060" y2="130"></line>
                <line x1="400" y1="452" x2="600" y2="436"></line>
                <line x1="600" y1="436" x2="780" y2="464"></line>
                <line x1="780" y1="464" x2="980" y2="440"></line>
                <line x1="540" y1="96" x2="480" y2="206"></line>
                <line x1="480" y1="206" x2="400" y2="452"></line>
                <line x1="880" y1="92" x2="940" y2="388"></line>
                <line x1="940" y1="388" x2="980" y2="440"></line>
                <line x1="700" y1="124" x2="780" y2="464"></line>
              </g>
              <g class="net-lines net-out">
                <line x1="360" y1="128" x2="-320" y2="96"></line>
                <line x1="400" y1="452" x2="-320" y2="486"></line>
                <line x1="1060" y1="130" x2="1760" y2="100"></line>
                <line x1="980" y1="440" x2="1760" y2="472"></line>
                <line x1="540" y1="96" x2="500" y2="-140"></line>
                <line x1="880" y1="92" x2="912" y2="-140"></line>
                <line x1="780" y1="464" x2="760" y2="700"></line>
              </g>
              <g class="net-dots">
                <circle cx="360" cy="128" r="2.6"></circle>
                <circle cx="700" cy="124" r="2.6"></circle>
                <circle cx="880" cy="92" r="2.6"></circle>
                <circle cx="600" cy="436" r="2.6"></circle>
                <circle cx="980" cy="440" r="2.6"></circle>
                <circle cx="480" cy="206" r="2.3"></circle>
                <circle cx="940" cy="388" r="2.3"></circle>
              </g>
              <g class="net-halo">
                <circle cx="540" cy="96" r="7"></circle>
                <circle cx="1060" cy="130" r="7"></circle>
                <circle cx="400" cy="452" r="7"></circle>
                <circle cx="780" cy="464" r="7"></circle>
              </g>
              <g class="net-hot">
                <circle cx="540" cy="96" r="3.2"></circle>
                <circle cx="1060" cy="130" r="3.2"></circle>
                <circle cx="400" cy="452" r="3.2"></circle>
                <circle cx="780" cy="464" r="3.2"></circle>
              </g>
            </svg>

            <div class="container">
              <header class="tx-header reveal">
                <span class="tx-header-side">
                  <span class="tx-live" aria-hidden="true"></span>
                  <span class="tx-id">SUPERVISION</span>
                  <span>&middot; Active</span>
                  <span>24/7</span>
                </span>
                <span class="tx-header-side">
                  <span class="tx-bars" aria-hidden="true">
                    <i class="tx-bar tx-bar--on"></i>
                    <i class="tx-bar"></i>
                    <i class="tx-bar tx-bar--on"></i>
                    <i class="tx-bar tx-bar--on"></i>
                    <i class="tx-bar"></i>
                  </span>
                  <span>Pôle Service</span>
                </span>
              </header>

              <div class="mf-cols">
                <blockquote
                  class="manifesto-quote manifesto-rich reveal"
                  id="manifesto-title"
                >
                  <Fragment set:html={service.manifeste} />
                </blockquote>
                <aside class="mf-brand reveal delay-2">
                  <img
                    src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${service.logo_easy_support}`}
                    alt={service.logo_marque_alt}
                    width="1100"
                    height="484"
                    decoding="async"
                  />
                </aside>
              </div>
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone : hero sticky + manifesto scrolling-over -->

      <!-- ================================
     PRESTATIONS — Catalog avec monogram glyphs
     ================================ -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prestations-title"
      >
        <div class="container">
          <div class="prest-layout">
            <aside class="prest-aside reveal">
              <h2
                class="prest-aside-title"
                id="prestations-title"
                set:html={service.titre_prestations}
              />
              <p
                class="prest-aside-sub"
                set:html={service.sous_titre_prestations}
              />

              <div class="prest-aside-partners">
                <div class="prest-aside-partners-head">
                  <span class="prest-aside-partners-label"
                    >{service.titre_confiance}</span
                  >
                  <span class="prest-aside-partners-rule" aria-hidden="true"
                  ></span>
                  <span class="prest-aside-partners-count"
                    >{service.nombre_confiance}</span
                  >
                </div>
                <div class="prest-aside-partners-grid">
                  {
                    service.logos_confiance.map((logo: any) => (
                      <div
                        class="logo-tile logo-tile--mini"
                        data-brand={logo.directus_files_id.title || ""}
                      >
                        <img
                          class="logo-tile-img"
                          loading="lazy"
                          decoding="async"
                          src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id.id}`}
                          alt={logo.directus_files_id.title || ""}
                        />
                        <span class="logo-tile-name">
                          {logo.directus_files_id.title}
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>
            </aside>

            <div class="prest-menu reveal delay-1">
              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <Fragment set:html={service.prestations[0].icone_content} />
                  </span>
                </div>
                <h3 class="prest-item-title">{service.prestations[0].titre}</h3>
                <p class="prest-item-desc">
                  {service.prestations[0].description}
                </p>
              </article>

              {
                service.prestations.slice(1).map((prestation: any) => (
                  <article class="prest-item">
                    <div class="prest-item-head">
                      <span
                        class="prest-item-glyph"
                        aria-hidden="true"
                        set:html={prestation.icone_content}
                      />
                    </div>
                    <h3 class="prest-item-title">{prestation.titre}</h3>
                    <p class="prest-item-desc">{prestation.description}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     SECTION DIVIDER — Compétences → Méthode (hairline monochrome)
     ================================ -->
      <div class="section-divider" aria-hidden="true">
        <div class="container">
          <span class="section-divider-line"></span>
        </div>
      </div>

      <!-- ================================
     PROCESS — Étapes (épuré, sans détails techniques)
     ================================ -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="section-head reveal">
            <h2 class="section-title" id="process-title">
              <span set:html={service.titre_processus} />
              <span
                class="text-muted"
                set:html={service.sous_titre_processus}
              />
            </h2>
          </div>

          <div class="pf-vflow reveal">
            <!-- ====== Schéma radial : connecteurs courbes (tracés en JS) + hub central ======
           Calque plein (pas de viewBox → 1 unité = 1px). setupProcessFlow() calcule
           le `d` de chaque connecteur depuis le bord de la carte vers le hub, et le
           recalcule au reveal, au resize et au survol (le connecteur suit la carte). -->
            <svg
              class="pf-vsvg"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <defs>
                <filter
                  id="pf-glow"
                  x="-60%"
                  y="-60%"
                  width="220%"
                  height="220%"
                >
                  <feGaussianBlur
                    in="SourceGraphic"
                    stdDeviation="3"
                    result="blur"></feGaussianBlur>
                  <feMerge>
                    <feMergeNode in="blur"></feMergeNode>
                    <feMergeNode in="SourceGraphic"></feMergeNode>
                  </feMerge>
                </filter>
                <filter
                  id="pf-hubglow"
                  x="-150%"
                  y="-150%"
                  width="400%"
                  height="400%"
                >
                  <feGaussianBlur in="SourceGraphic" stdDeviation="7"
                  ></feGaussianBlur>
                </filter>
                <!-- Disque du hub : léger sheen haut → profondeur, plus de flat #0a0a0a -->
                <radialGradient id="pf-hubfill" cx="50%" cy="36%" r="78%">
                  <stop offset="0%" stop-color="#1c1415"></stop>
                  <stop offset="52%" stop-color="#121011"></stop>
                  <stop offset="100%" stop-color="#0b0b0b"></stop>
                </radialGradient>
                <!-- Cœur du hub : point chaud dégradé, remplace l'aplat rouge -->
                <radialGradient id="pf-hubcore">
                  <stop offset="0%" stop-color="#ff6a5e"></stop>
                  <stop offset="55%" stop-color="#E51D29"></stop>
                  <stop offset="100%" stop-color="#a8121c"></stop>
                </radialGradient>
              </defs>

              <!-- 4 connecteurs courbes : du hub vers le bord de chaque carte (d calculé en JS) -->
              <path
                class="pf-draw pf-conn"
                data-i="0"
                style="--d: 0.4s"
                pathLength="100"
                fill="none"
                stroke="#F2B4AF"
                stroke-width="1.7"
                stroke-linecap="round"></path>
              <path
                class="pf-draw pf-conn"
                data-i="1"
                style="--d: 0.55s"
                pathLength="100"
                fill="none"
                stroke="#EC8C84"
                stroke-width="1.7"
                stroke-linecap="round"></path>
              <path
                class="pf-draw pf-conn"
                data-i="2"
                style="--d: 0.7s"
                pathLength="100"
                fill="none"
                stroke="#E85A50"
                stroke-width="1.7"
                stroke-linecap="round"></path>
              <path
                class="pf-draw pf-conn"
                data-i="3"
                style="--d: 0.85s"
                pathLength="100"
                fill="none"
                stroke="#E51D29"
                stroke-width="1.7"
                stroke-linecap="round"></path>

              <!-- Particules animées des branches retirées — connecteurs statiques uniquement. -->

              <!-- Pastilles d'accroche au bord de chaque carte (cx/cy calculés en JS) -->
              <g class="pf-anim-node pf-jnode" data-i="0" style="--d: 1.3s">
                <circle class="pf-jhalo" r="6.5" fill="#F2B4AF" opacity="0.16"
                ></circle>
                <circle class="pf-jdot" r="2.7" fill="#F2B4AF"></circle>
              </g>
              <g class="pf-anim-node pf-jnode" data-i="1" style="--d: 1.45s">
                <circle class="pf-jhalo" r="6.5" fill="#EC8C84" opacity="0.16"
                ></circle>
                <circle class="pf-jdot" r="2.7" fill="#EC8C84"></circle>
              </g>
              <g class="pf-anim-node pf-jnode" data-i="2" style="--d: 1.6s">
                <circle class="pf-jhalo" r="6.5" fill="#E85A50" opacity="0.16"
                ></circle>
                <circle class="pf-jdot" r="2.7" fill="#E85A50"></circle>
              </g>
              <g class="pf-anim-node pf-jnode" data-i="3" style="--d: 1.75s">
                <circle class="pf-jhalo" r="6.5" fill="#E51D29" opacity="0.16"
                ></circle>
                <circle class="pf-jdot" r="2.7" fill="#E51D29"></circle>
              </g>

              <!-- Halo central + hub double anneau (cx/cy calculés en JS) -->
              <circle
                class="pf-fiber-glow pf-hubc"
                r="30"
                fill="#E51D29"
                filter="url(#pf-hubglow)"></circle>
              <g class="pf-anim-node pf-hub-core" style="--d: 0.25s">
                <circle
                  class="pf-hubc"
                  r="27"
                  fill="url(#pf-hubfill)"
                  stroke="rgba(229,29,41,0.42)"
                  stroke-width="1"></circle>
                <circle
                  class="pf-hubc"
                  r="23.5"
                  fill="none"
                  stroke="rgba(255,255,255,0.05)"
                  stroke-width="1"></circle>
                <circle
                  class="pf-hub-bezel pf-hubc"
                  r="20.5"
                  fill="none"
                  stroke="rgba(229,29,41,0.5)"
                  stroke-width="1.1"
                  pathLength="96"
                  stroke-dasharray="1.2 2.8"
                  stroke-linecap="round"></circle>
                <circle
                  class="pf-hub-heart pf-hubc"
                  r="4.2"
                  fill="url(#pf-hubcore)"></circle>
                <circle
                  class="pf-hub-ring pf-hubc"
                  r="27"
                  fill="none"
                  stroke="#E51D29"
                  stroke-width="1.2"></circle>
              </g>

              <!-- Label du hub : le SI du client au centre du dispositif (x/y calculés en JS) -->
              <text
                class="pf-anim-node pf-hubl"
                style="--d: 1.05s"
                text-anchor="middle"
                ><tspan class="pf-hubl-dot">&#9679;</tspan><tspan dx="7"
                  >{service.label_central_processus}</tspan
                ></text
              >

              <!-- Comète de boucle : un flux parcourt hub→01, 01→hub, hub→02, … (piloté en JS) -->
              <g class="pf-comet" opacity="0">
                <circle
                  class="pf-comet-halo"
                  r="6.5"
                  fill="#EC8C84"
                  opacity="0.3"
                  filter="url(#pf-glow)"></circle>
                <circle class="pf-comet-core" r="2.6"></circle>
              </g>
            </svg>

            <!-- ====== 4 CARDS alignées avec les endpoints des branches ====== -->
            <div class="pf-vcards">
              <article
                class="pf-vcard"
                style="--c: #F2B4AF; --c-rgb: 242,180,175;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="20" cy="20" r="13.5" opacity="0.3"></circle>
                      <circle cx="20" cy="20" r="8" opacity="0.55"></circle>
                      <path d="M20 20 V6.5"></path>
                      <path
                        d="M20 6.5 A13.5 13.5 0 0 1 31.7 13.25"
                        opacity="0.5"></path>
                      <circle
                        cx="20"
                        cy="20"
                        r="2.3"
                        fill="currentColor"
                        stroke="none"></circle>
                    </svg>
                  </span>
                </div>
                <h3 class="pf-vcard-title">{service.processus[0].titre}</h3>
                <p class="pf-vcard-desc">{service.processus[0].description}</p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>

              <article
                class="pf-vcard"
                style="--c: #EC8C84; --c-rgb: 236,140,132;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M9 22v-3a11 11 0 0 1 22 0v3"></path>
                      <rect x="6.5" y="21.5" width="5.5" height="9" rx="2"
                      ></rect>
                      <rect x="28" y="21.5" width="5.5" height="9" rx="2"
                      ></rect>
                      <path d="M30.7 30.5v1a4 4 0 0 1-4 4h-4" opacity="0.55"
                      ></path>
                    </svg>
                  </span>
                </div>
                <h3 class="pf-vcard-title">{service.processus[1].titre}</h3>
                <p class="pf-vcard-desc">{service.processus[1].description}</p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>

              <article
                class="pf-vcard"
                style="--c: #E85A50; --c-rgb: 232,90,80;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="7" y="9" width="26" height="17" rx="2"></rect>
                      <path d="M11 18h3l2-4 3 8 2.5-5 1.7 3H29" opacity="0.7"
                      ></path>
                      <line x1="16" y1="31" x2="24" y2="31"></line>
                      <line x1="20" y1="26" x2="20" y2="31" opacity="0.5"
                      ></line>
                    </svg>
                  </span>
                </div>
                <h3 class="pf-vcard-title">{service.processus[2].titre}</h3>
                <p class="pf-vcard-desc">{service.processus[2].description}</p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>

              <article
                class="pf-vcard"
                style="--c: #E51D29; --c-rgb: 229,29,41;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="6.5" y="8" width="27" height="19" rx="2.8"
                      ></rect>
                      <path d="M20 27 V32" opacity="0.55"></path>
                      <path d="M15.5 32.5 H24.5" opacity="0.55"></path>
                      <path
                        d="M11 18 H15.4 L17.7 11.8 L21.3 23.2 L23.8 16.4 L25.6 18 H29"
                        opacity="0.9"></path>
                    </svg>
                  </span>
                </div>
                <h3 class="pf-vcard-title">{service.processus[3].titre}</h3>
                <p class="pf-vcard-desc">{service.processus[3].description}</p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     CTA — Bandeau compact centré, logo-icône Télécom comme accent
     ================================ -->
      <section class="cta-section" id="contact" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-frame">
            <div class="cta-inner">
              <span
                class="cta-icon"
                aria-hidden="true"
                set:html={service.icone_cta_content}
              />

              <div class="cta-body">
                <h2
                  class="cta-title reveal delay-1"
                  id="cta-title"
                  set:html={service.titre_cta}
                />

                <p class="cta-sub reveal delay-2">{service.sous_titre_cta}</p>

                <div class="cta-actions reveal delay-3">
                  <a
                    href="/contact?pole=service&step=2"
                    class="btn-cta btn-cta--primary"
                  >
                    {service.bouton_cta}
                    <span class="btn-cta-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </a>
                  <span class="cta-actions-divider" aria-hidden="true"></span>
                  <span class="cta-phone">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      width="14"
                      height="14"
                      ><path
                        d="M2 3a1 1 0 011-1h3.28a1 1 0 01.95.68l1.07 3.21a1 1 0 01-.25 1L6.54 8.4a12.06 12.06 0 005.06 5.06l1.51-1.51a1 1 0 011-.25l3.21 1.07a1 1 0 01.68.95V17a1 1 0 01-1 1A15 15 0 012 3z"
                      ></path></svg
                    >
                    <a href="tel:+33387184922" class="cta-phone-num"
                      >03 87 18 49 22</a
                    >
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     FOOTER
     ================================ -->
      <Footer />

      <!-- ================================
     SCRIPTS
     ================================ -->
      <script is:inline src="/js/shared/reveal-animations.js"></script>
      <script is:inline src="/js/shared/menu-frost.js"></script>
      <!-- jcd-a11y (Lot 5) -->
      <div class="jcd-fab-wrap" id="jcd-fab">
        <button
          class="jcd-fab jcd-fab--top"
          id="jcdToTop"
          type="button"
          aria-label="Remonter en haut"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M10 16V5M5 10l5-5 5 5"></path></svg
          >
        </button>
        <a
          class="jcd-fab jcd-fab--contact"
          id="jcdFabContact"
          href="/contact"
          aria-label="Nous contacter"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><rect x="2.5" y="4.5" width="15" height="11" rx="2.3"></rect><path
              d="M3 6.7 L10 10.7 L17 6.7"></path></svg
          >
        </a>
      </div>
      <script is:inline src="/js/shared/a11y.js" id="jcd-a11y-js"></script>
      <script is:inline src="/js/shared/mrefonte.js" id="jcd-mrefonte-js"
      ></script>
    </main>
  </body>
</html>
