---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="JCD Groupe · Pôle Service. Services informatiques managés : support helpdesk, infogérance et supervision du SI, sauvegarde, audit et gouvernance. Un interlocuteur unique de confiance en Grand Est."
    />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/service`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content="Service · Infogérance & support managé du SI · JCD Groupe"
    />
    <meta
      property="og:description"
      content="JCD Groupe · Pôle Service. Services informatiques managés : support helpdesk, infogérance et supervision du SI, sauvegarde, audit et gouvernance. Un interlocuteur unique de confiance en Grand Est."
    />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/service`}
    />
    <meta name="twitter:card" content="summary" />
    <title>Service · Infogérance &amp; support managé du SI · JCD Groupe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/service.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/service-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header labels={{ service: "Support et Infogérance" }} />

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ================================
     HERO — Mesh WebGL fluide + texture pôle (pattern universel)
     ================================ -->
        <section class="print-hero" aria-labelledby="service-hero-title">
          <!-- Couche 0 : fallback CSS si WebGL indisponible / fade-in -->
          <div class="hero-mesh-fallback" aria-hidden="true"></div>

          <!-- Couche 1 : canvas WebGL — fond animé "Flux convergent" (filaments + bloom focal) -->
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>

          <!-- Couche 2 : texture pôle — Service = grille supervision / console -->
          <div class="hero-texture hero-texture--signal" aria-hidden="true">
          </div>

          <!-- Couche 3 : grain léger -->
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1 id="service-hero-title" class="hero-title reveal delay-1">
              Un <em>guichet unique</em> pour vous accompagner au quotidien.
            </h1>

            <p class="hero-sub reveal delay-2">
              Services informatiques managés : support utilisateurs,
              exploitation, supervision et pilotage du SI, assurés au quotidien
              par une équipe dédiée.
            </p>

            <div class="hero-actions reveal delay-3">
              <a
                href="/contact?pole=service&step=2"
                class="btn-cta btn-cta--ghost"
              >
                Faire le point sur mon SI
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ================================
     MANIFESTO — Paper sheet inversion
     ================================ -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="signal-sheet">
            <!-- Constellation réseau discrète (statique) — derrière le contenu, masquée -->
            <svg
              class="sheet-net"
              viewBox="0 0 1440 560"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              preserveAspectRatio="xMidYMid slice"
            >
              <!-- Zone sure x 360-1060 / y 90-470 : aucun noeud n'est rogne, quel que soit
           le ratio du panneau. Les fils .net-out debordent tres au-dela du viewBox
           et rejoignent donc physiquement les bords a toutes les largeurs. -->
              <g class="net-lines">
                <line x1="360" y1="128" x2="540" y2="96"></line>
                <line x1="540" y1="96" x2="700" y2="124"></line>
                <line x1="700" y1="124" x2="880" y2="92"></line>
                <line x1="880" y1="92" x2="1060" y2="130"></line>
                <line x1="400" y1="452" x2="600" y2="436"></line>
                <line x1="600" y1="436" x2="780" y2="464"></line>
                <line x1="780" y1="464" x2="980" y2="440"></line>
                <line x1="540" y1="96" x2="480" y2="206"></line>
                <line x1="480" y1="206" x2="400" y2="452"></line>
                <line x1="880" y1="92" x2="940" y2="388"></line>
                <line x1="940" y1="388" x2="980" y2="440"></line>
                <line x1="700" y1="124" x2="780" y2="464"></line>
              </g>
              <g class="net-lines net-out">
                <line x1="360" y1="128" x2="-320" y2="96"></line>
                <line x1="400" y1="452" x2="-320" y2="486"></line>
                <line x1="1060" y1="130" x2="1760" y2="100"></line>
                <line x1="980" y1="440" x2="1760" y2="472"></line>
                <line x1="540" y1="96" x2="500" y2="-140"></line>
                <line x1="880" y1="92" x2="912" y2="-140"></line>
                <line x1="780" y1="464" x2="760" y2="700"></line>
              </g>
              <g class="net-dots">
                <circle cx="360" cy="128" r="2.6"></circle>
                <circle cx="700" cy="124" r="2.6"></circle>
                <circle cx="880" cy="92" r="2.6"></circle>
                <circle cx="600" cy="436" r="2.6"></circle>
                <circle cx="980" cy="440" r="2.6"></circle>
                <circle cx="480" cy="206" r="2.3"></circle>
                <circle cx="940" cy="388" r="2.3"></circle>
              </g>
              <g class="net-halo">
                <circle cx="540" cy="96" r="7"></circle>
                <circle cx="1060" cy="130" r="7"></circle>
                <circle cx="400" cy="452" r="7"></circle>
                <circle cx="780" cy="464" r="7"></circle>
              </g>
              <g class="net-hot">
                <circle cx="540" cy="96" r="3.2"></circle>
                <circle cx="1060" cy="130" r="3.2"></circle>
                <circle cx="400" cy="452" r="3.2"></circle>
                <circle cx="780" cy="464" r="3.2"></circle>
              </g>
            </svg>

            <div class="container">
              <header class="tx-header reveal">
                <span class="tx-header-side">
                  <span class="tx-live" aria-hidden="true"></span>
                  <span class="tx-id">SUPERVISION</span>
                  <span>&middot; Active</span>
                  <span>24/7</span>
                </span>
                <span class="tx-header-side">
                  <span class="tx-bars" aria-hidden="true">
                    <i class="tx-bar tx-bar--on"></i>
                    <i class="tx-bar"></i>
                    <i class="tx-bar tx-bar--on"></i>
                    <i class="tx-bar tx-bar--on"></i>
                    <i class="tx-bar"></i>
                  </span>
                  <span>Pôle Service</span>
                </span>
              </header>

              <div class="mf-cols">
                <blockquote
                  class="manifesto-quote manifesto-rich reveal"
                  id="manifesto-title"
                >
                  <em>Nous assurons</em> le support, l'exploitation, la sécurisation
                  et la gouvernance, jour après jour. <span class="q-soft"
                    >De l'audit à la supervision, votre informatique reste en
                    conditions opérationnelles.</span
                  >
                </blockquote>
                <aside class="mf-brand reveal delay-2">
                  <img
                    src="/logo%20service/easi-support-white.png"
                    alt="EASI Support - la marque support de JCD Groupe"
                    width="1100"
                    height="484"
                    decoding="async"
                  />
                </aside>
              </div>
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone : hero sticky + manifesto scrolling-over -->

      <!-- ================================
     PRESTATIONS — Catalog avec monogram glyphs
     ================================ -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prestations-title"
      >
        <div class="container">
          <div class="prest-layout">
            <aside class="prest-aside reveal">
              <h2 class="prest-aside-title" id="prestations-title">
                <em>Six savoir-faire</em>, un SI piloté de bout en bout.
              </h2>
              <p class="prest-aside-sub">
                De l'audit à la gouvernance, la gestion opérationnelle de votre
                SI au quotidien.
              </p>

              <div class="prest-aside-partners">
                <div class="prest-aside-partners-head">
                  <span class="prest-aside-partners-label">Certifications</span>
                  <span class="prest-aside-partners-rule" aria-hidden="true"
                  ></span>
                  <span class="prest-aside-partners-count">06</span>
                </div>
                <div class="prest-aside-partners-grid">
                  <div class="logo-tile logo-tile--mini" data-brand="itil">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logo service/itil.png"
                      alt="ITIL V4"
                      decoding="async"
                    />
                    <span class="logo-tile-name">ITIL&nbsp;V4</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="microsoft">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logo service/microsoft.png"
                      alt="Microsoft"
                      decoding="async"
                    />
                    <span class="logo-tile-name">Microsoft</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="veeam">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logo service/veeam.png"
                      alt="Veeam"
                      decoding="async"
                    />
                    <span class="logo-tile-name">Veeam</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="vmware">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logo service/vmware.png"
                      alt="VMware"
                      decoding="async"
                    />
                    <span class="logo-tile-name">VMware</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="eset">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logo service/eset.png"
                      alt="ESET"
                      decoding="async"
                    />
                    <span class="logo-tile-name">ESET</span>
                  </div>
                  <div
                    class="logo-tile logo-tile--mini"
                    data-brand="microsoft365"
                  >
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logo service/microsoft365.webp"
                      alt="Microsoft 365"
                      decoding="async"
                    />
                    <span class="logo-tile-name">Microsoft&nbsp;365</span>
                  </div>
                </div>
              </div>
            </aside>

            <div class="prest-menu reveal delay-1">
              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <rect
                        x="8"
                        y="9"
                        width="18"
                        height="13"
                        rx="2"
                        opacity="0.5"></rect>
                      <circle cx="21.5" cy="22.5" r="6.3"></circle>
                      <line x1="26.2" y1="27.2" x2="31.5" y2="32.5"></line>
                      <line
                        x1="18.6"
                        y1="22.5"
                        x2="24.4"
                        y2="22.5"
                        opacity="0.55"></line>
                      <line
                        x1="21.5"
                        y1="19.6"
                        x2="21.5"
                        y2="25.4"
                        opacity="0.55"></line>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Audit informatique</h3>
                <p class="prest-item-desc">
                  La 1re étape : comprendre vos enjeux et cartographier votre SI
                  afin d'être pleinement opérationnel pour vous apporter le
                  niveau de services attendu.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <rect x="7" y="9" width="26" height="17" rx="2"></rect>
                      <path d="M11 18h3l2-4 3 8 2.5-5 1.7 3H29" opacity="0.65"
                      ></path>
                      <line x1="16" y1="31" x2="24" y2="31"></line>
                      <line x1="20" y1="26" x2="20" y2="31" opacity="0.5"
                      ></line>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Infogérance du SI</h3>
                <p class="prest-item-desc">
                  Maintien en conditions opérationnelles de votre SI :
                  supervision, exploitation et amélioration continue de votre
                  informatique.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <path d="M9 22v-3a11 11 0 0 1 22 0v3"></path>
                      <rect x="6.5" y="21.5" width="5.5" height="9" rx="2"
                      ></rect>
                      <rect x="28" y="21.5" width="5.5" height="9" rx="2"
                      ></rect>
                      <path d="M30.7 30.5v1a4 4 0 0 1-4 4h-4" opacity="0.55"
                      ></path>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Support Helpdesk</h3>
                <p class="prest-item-desc">
                  Assistance utilisateur et administrateur via notre centre de
                  services, pour la résolution de vos incidents et demandes sur
                  un périmètre défini.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <rect x="11" y="8.5" width="18" height="25" rx="2.5"
                      ></rect>
                      <rect
                        x="15.5"
                        y="6"
                        width="9"
                        height="5"
                        rx="1.6"
                        opacity="0.55"></rect>
                      <path d="M15.5 21l3 3 6-6.5" opacity="0.7"></path>
                      <line
                        x1="15.5"
                        y1="28.5"
                        x2="24.5"
                        y2="28.5"
                        opacity="0.4"></line>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  Gestion de projets &amp; conformité
                </h3>
                <p class="prest-item-desc">
                  Pilotage de vos projets IT et accompagnement au respect des
                  exigences réglementaires, de sécurité et des standards en
                  vigueur.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <ellipse cx="18" cy="11" rx="9" ry="3.4"></ellipse>
                      <path
                        d="M9 11v6c0 1.9 4 3.4 9 3.4s9-1.5 9-3.4v-6"
                        opacity="0.6"></path>
                      <path
                        d="M9 17v6c0 1.9 4 3.4 9 3.4 .95 0 1.85-.05 2.7-.16"
                        opacity="0.45"></path>
                      <path d="M25.2 26.6a5 5 0 1 1-1.6-3.5" opacity="0.85"
                      ></path>
                      <path d="M25.6 22v3.2h-3.2" opacity="0.85"></path>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Infogérance de la sauvegarde</h3>
                <p class="prest-item-desc">
                  Contrôle quotidien et tests de restauration réguliers, avec un
                  plan de reprise d'activité éprouvé pour assurer la protection
                  de vos données.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <path d="M20 6l12 5.5H8z"></path>
                      <line x1="12.5" y1="12" x2="12.5" y2="27"></line>
                      <line x1="20" y1="12" x2="20" y2="27"></line>
                      <line x1="27.5" y1="12" x2="27.5" y2="27"></line>
                      <line x1="8.5" y1="27" x2="31.5" y2="27"></line>
                      <line x1="7" y1="31" x2="33" y2="31" opacity="0.6"></line>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Gouvernance du SI</h3>
                <p class="prest-item-desc">
                  Pilotage de votre SI et de vos prestataires pour l'aligner
                  avec votre stratégie et vos enjeux métiers.
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     SECTION DIVIDER — Compétences → Méthode (hairline monochrome)
     ================================ -->
      <div class="section-divider" aria-hidden="true">
        <div class="container">
          <span class="section-divider-line"></span>
        </div>
      </div>

      <!-- ================================
     PROCESS — Étapes (épuré, sans détails techniques)
     ================================ -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="section-head reveal">
            <h2 class="section-title" id="process-title">
              Quatre expertises, <em>un seul interlocuteur</em>.
              <span class="text-muted"
                >Un point de contact unique d'où découlent l'audit, la
                supervision, le support et la gouvernance de votre SI.</span
              >
            </h2>
          </div>

          <div class="pf-vflow reveal">
            <!-- ====== Schéma radial : connecteurs courbes (tracés en JS) + hub central ======
           Calque plein (pas de viewBox → 1 unité = 1px). setupProcessFlow() calcule
           le `d` de chaque connecteur depuis le bord de la carte vers le hub, et le
           recalcule au reveal, au resize et au survol (le connecteur suit la carte). -->
            <svg
              class="pf-vsvg"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <defs>
                <filter
                  id="pf-glow"
                  x="-60%"
                  y="-60%"
                  width="220%"
                  height="220%"
                >
                  <feGaussianBlur
                    in="SourceGraphic"
                    stdDeviation="3"
                    result="blur"></feGaussianBlur>
                  <feMerge>
                    <feMergeNode in="blur"></feMergeNode>
                    <feMergeNode in="SourceGraphic"></feMergeNode>
                  </feMerge>
                </filter>
                <filter
                  id="pf-hubglow"
                  x="-150%"
                  y="-150%"
                  width="400%"
                  height="400%"
                >
                  <feGaussianBlur in="SourceGraphic" stdDeviation="7"
                  ></feGaussianBlur>
                </filter>
                <!-- Disque du hub : léger sheen haut → profondeur, plus de flat #0a0a0a -->
                <radialGradient id="pf-hubfill" cx="50%" cy="36%" r="78%">
                  <stop offset="0%" stop-color="#1c1415"></stop>
                  <stop offset="52%" stop-color="#121011"></stop>
                  <stop offset="100%" stop-color="#0b0b0b"></stop>
                </radialGradient>
                <!-- Cœur du hub : point chaud dégradé, remplace l'aplat rouge -->
                <radialGradient id="pf-hubcore">
                  <stop offset="0%" stop-color="#ff6a5e"></stop>
                  <stop offset="55%" stop-color="#E51D29"></stop>
                  <stop offset="100%" stop-color="#a8121c"></stop>
                </radialGradient>
              </defs>

              <!-- 4 connecteurs courbes : du hub vers le bord de chaque carte (d calculé en JS) -->
              <path
                class="pf-draw pf-conn"
                data-i="0"
                style="--d: 0.4s"
                pathLength="100"
                fill="none"
                stroke="#F2B4AF"
                stroke-width="1.7"
                stroke-linecap="round"></path>
              <path
                class="pf-draw pf-conn"
                data-i="1"
                style="--d: 0.55s"
                pathLength="100"
                fill="none"
                stroke="#EC8C84"
                stroke-width="1.7"
                stroke-linecap="round"></path>
              <path
                class="pf-draw pf-conn"
                data-i="2"
                style="--d: 0.7s"
                pathLength="100"
                fill="none"
                stroke="#E85A50"
                stroke-width="1.7"
                stroke-linecap="round"></path>
              <path
                class="pf-draw pf-conn"
                data-i="3"
                style="--d: 0.85s"
                pathLength="100"
                fill="none"
                stroke="#E51D29"
                stroke-width="1.7"
                stroke-linecap="round"></path>

              <!-- Particules animées des branches retirées — connecteurs statiques uniquement. -->

              <!-- Pastilles d'accroche au bord de chaque carte (cx/cy calculés en JS) -->
              <g class="pf-anim-node pf-jnode" data-i="0" style="--d: 1.3s">
                <circle class="pf-jhalo" r="6.5" fill="#F2B4AF" opacity="0.16"
