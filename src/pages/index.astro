      <!-- ================================
     CTA FINAL
     ================================ -->
      <section class="cta-final" id="contact" aria-labelledby="cta-title">
        <!-- SPINE-PULSE : prolongement coloré de la fresque vertical, du top
       du CTA jusqu'au sommet du globe. Comble le tracé blanc statique
       (.cta-final::after) avec un dégradé 7 couleurs qui se révèle
       progressivement au scroll (mask vertical piloté par JS).
       L'orbital ne décolle qu'une fois cette trace pleinement illuminée. -->
        <div class="cta-spine-pulse" aria-hidden="true"></div>

        <!-- GLOBE-FILL : couverture radiale 7 couleurs JCD à l'intérieur du
       globe, opacité scroll-driven (--globe-fill-opacity de 0 à 1).
       Rendu SOUS le wireframe : à la fin du scroll, l'intégralité du
       globe visible est habillée des couleurs de la fresque histoire. -->
        <div class="cta-globe-fill" aria-hidden="true">
          <svg
            class="cta-globe-fill-svg"
            viewBox="0 0 800 800"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            preserveAspectRatio="xMidYMid meet"
          >
            <defs>
              <radialGradient id="ctaGF-fill" cx="50%" cy="38%" r="62%">
                <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.12"
                ></stop>
                <stop offset="16%" stop-color="#2E72BA" stop-opacity="0.18"
                ></stop>
                <stop offset="32%" stop-color="#F9D605" stop-opacity="0.15"
                ></stop>
                <stop offset="48%" stop-color="#F3941D" stop-opacity="0.14"
                ></stop>
                <stop offset="64%" stop-color="#E51D29" stop-opacity="0.12"
                ></stop>
                <stop offset="78%" stop-color="#8D2C87" stop-opacity="0.10"
                ></stop>
                <stop offset="92%" stop-color="#8EC041" stop-opacity="0.06"
                ></stop>
                <stop offset="100%" stop-color="#A78D75" stop-opacity="0"
                ></stop>
              </radialGradient>
            </defs>
            <circle cx="400" cy="400" r="290" fill="url(#ctaGF-fill)"></circle>
          </svg>
        </div>

        <!-- Globe wireframe atmosphérique : illustration arrière-plan style
       Supabase. Demi-globe ancré en bas de la section (effet horizon).
       Vue 3D légèrement basculée (β≈15°), 6 méridiens + 7 parallèles,
       accent JCD multicolore animé sur 3 latitudes. Purement décoratif. -->
        <div class="cta-globe" aria-hidden="true">
          <svg
            class="cta-globe-svg"
            viewBox="0 0 800 800"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            preserveAspectRatio="xMidYMid meet"
          >
            <defs>
              <!-- Stroke principale : fade vertical doux (plus clair en haut,
             s'évanouit vers le sud — suggère une source de lumière). -->
              <linearGradient id="ctaG-wire" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.26"
                ></stop>
                <stop offset="34%" stop-color="#FFFFFF" stop-opacity="0.18"
                ></stop>
                <stop offset="64%" stop-color="#FFFFFF" stop-opacity="0.11"
                ></stop>
                <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.045"
                ></stop>
              </linearGradient>

              <!-- Stroke des parallèles : légère remontée d'opacité aux
             extrémités (effet "sphère" — les lignes sont plus denses
             là où elles sont vues de biais). -->
              <linearGradient id="ctaG-lat" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.22"
                ></stop>
                <stop offset="22%" stop-color="#FFFFFF" stop-opacity="0.17"
                ></stop>
                <stop offset="48%" stop-color="#FFFFFF" stop-opacity="0.12"
                ></stop>
                <stop offset="52%" stop-color="#FFFFFF" stop-opacity="0.12"
                ></stop>
                <stop offset="78%" stop-color="#FFFFFF" stop-opacity="0.17"
                ></stop>
                <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.22"
                ></stop>
              </linearGradient>

              <!-- Halo atmosphérique : très subtil voile bleuté au cœur. -->
              <radialGradient id="ctaG-fill" cx="50%" cy="42%" r="62%">
                <stop offset="0%" stop-color="#2E72BA" stop-opacity="0.07"
                ></stop>
                <stop offset="42%" stop-color="#2E72BA" stop-opacity="0.025"
                ></stop>
                <stop offset="80%" stop-color="#FFFFFF" stop-opacity="0.005"
                ></stop>
                <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"
                ></stop>
              </radialGradient>

              <!-- Accent JCD : balayage 7 couleurs sur l'équateur, donne
             vie au globe et signe la marque sans bruit chromatique. -->
              <linearGradient id="ctaG-jcd" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#2E72BA" stop-opacity="0"></stop>
                <stop offset="6%" stop-color="#2E72BA" stop-opacity="0.10"
                ></stop>
                <stop offset="13%" stop-color="#2E72BA" stop-opacity="0.55"
                ></stop>
                <stop offset="24%" stop-color="#F9D605" stop-opacity="0.50"
                ></stop>
                <stop offset="38%" stop-color="#F3941D" stop-opacity="0.52"
                ></stop>
                <stop offset="52%" stop-color="#E51D29" stop-opacity="0.50"
                ></stop>
                <stop offset="65%" stop-color="#8D2C87" stop-opacity="0.50"
                ></stop>
                <stop offset="78%" stop-color="#8EC041" stop-opacity="0.45"
                ></stop>
                <stop offset="88%" stop-color="#A78D75" stop-opacity="0.35"
                ></stop>
                <stop offset="95%" stop-color="#A78D75" stop-opacity="0.10"
                ></stop>
                <stop offset="100%" stop-color="#A78D75" stop-opacity="0"
                ></stop>
              </linearGradient>

              <!-- Filtre de glow doux appliqué au wireframe global. -->
              <filter
                id="ctaG-glow"
                x="-20%"
                y="-20%"
                width="140%"
                height="140%"
              >
                <feGaussianBlur stdDeviation="0.55" result="b1"
                ></feGaussianBlur>
                <feMerge>
                  <feMergeNode in="b1"></feMergeNode>
                  <feMergeNode in="SourceGraphic"></feMergeNode>
                </feMerge>
              </filter>
            </defs>

            <!-- Voile atmosphérique central. -->
            <circle cx="400" cy="400" r="290" fill="url(#ctaG-fill)"></circle>

            <!-- ===== WIREFRAME (méridiens + parallèles) ===== -->
            <g class="ctaG-wire" filter="url(#ctaG-glow)">
              <!-- Silhouette extérieure. -->
              <circle
                cx="400"
                cy="400"
                r="290"
                stroke="url(#ctaG-wire)"
                stroke-width="0.85"></circle>

              <!-- Méridiens (vue tiltée β≈15° → ry = R·cos(β) ≈ 280).
             Chaque ellipse représente une paire φ / φ+180°. -->
              <ellipse
                cx="400"
                cy="400"
                rx="75"
                ry="280"
                stroke="url(#ctaG-wire)"
                stroke-width="0.55"></ellipse>
              <ellipse
                cx="400"
                cy="400"
                rx="145"
                ry="280"
                stroke="url(#ctaG-wire)"
                stroke-width="0.55"></ellipse>
              <ellipse
                cx="400"
                cy="400"
                rx="205"
                ry="280"
                stroke="url(#ctaG-wire)"
                stroke-width="0.55"></ellipse>
              <ellipse
                cx="400"
                cy="400"
                rx="251"
                ry="280"
                stroke="url(#ctaG-wire)"
                stroke-width="0.5"></ellipse>

              <!-- Méridien premier (axe vertical, lat ±90° pôles visibles). -->
              <line
                x1="400"
                y1="120"
                x2="400"
                y2="680"
                stroke="url(#ctaG-wire)"
                stroke-width="0.55"></line>

              <!-- Parallèles tiltées (β=15°). Formule : cy = 400 ∓ R·sin(θ)·cos(β),
             rx = R·cos(θ), ry = rx·sin(β). R=290. -->
              <ellipse
                cx="400"
                cy="400"
                rx="290"
                ry="75.1"
                stroke="url(#ctaG-lat)"
                stroke-width="0.65"></ellipse>
              <ellipse
                cx="400"
                cy="304.2"
                rx="272.5"
                ry="70.6"
                stroke="url(#ctaG-lat)"
                stroke-width="0.55"></ellipse>
              <ellipse
                cx="400"
                cy="495.8"
                rx="272.5"
                ry="70.6"
                stroke="url(#ctaG-lat)"
                stroke-width="0.55"></ellipse>
              <ellipse
                cx="400"
                cy="201.9"
                rx="205.0"
                ry="53.1"
                stroke="url(#ctaG-lat)"
                stroke-width="0.5"></ellipse>
              <ellipse
                cx="400"
                cy="598.1"
                rx="205.0"
                ry="53.1"
                stroke="url(#ctaG-lat)"
                stroke-width="0.5"></ellipse>
              <ellipse
                cx="400"
                cy="146.2"
                rx="122.6"
                ry="31.7"
                stroke="url(#ctaG-lat)"
                stroke-width="0.45"></ellipse>
              <ellipse
                cx="400"
                cy="653.8"
                rx="122.6"
                ry="31.7"
                stroke="url(#ctaG-lat)"
                stroke-width="0.45"></ellipse>
            </g>

            <!-- ===== ACCENT JCD : balayage couleur animé sur 3 parallèles =====
           Le pathLength=100 + dasharray "26 74" trace ~26% de l'ellipse
           qui parcourt l'orbite en boucle, comme un flux de données. -->
            <ellipse
              class="ctaG-acc ctaG-acc--eq"
              cx="400"
              cy="400"
              rx="290"
              ry="75.1"
              stroke="url(#ctaG-jcd)"
              stroke-width="0.95"
              stroke-linecap="round"
              pathLength="100"
              stroke-dasharray="26 74"></ellipse>
            <ellipse
              class="ctaG-acc ctaG-acc--n20"
              cx="400"
              cy="304.2"
              rx="272.5"
              ry="70.6"
              stroke="url(#ctaG-jcd)"
              stroke-width="0.75"
              stroke-linecap="round"
              pathLength="100"
              stroke-dasharray="22 78"></ellipse>
            <ellipse
              class="ctaG-acc ctaG-acc--s20"
              cx="400"
              cy="495.8"
              rx="272.5"
              ry="70.6"
              stroke="url(#ctaG-jcd)"
              stroke-width="0.75"
              stroke-linecap="round"
              pathLength="100"
              stroke-dasharray="22 78"></ellipse>
          </svg>
        </div>

        <!-- Couronne de diffusion : reprend la géométrie du contour exterieur
       du globe mais hors-mask. La trace verticale arrive par le sommet
       et se diffuse le long du contour entier (gradient vertical sur le
       stroke + halo gaussien). Purement décoratif. -->
        <div class="cta-spine-ring" aria-hidden="true">
          <svg
            class="cta-spine-ring-svg"
            viewBox="0 0 800 800"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            preserveAspectRatio="xMidYMid meet"
          >
            <defs>
              <!-- Filament net : pic du gradient déplacé du sommet (0%) au
             milieu (~50%) pour éliminer le bloom blanc au point de
             jonction avec la trace verticale. Le mask CSS sur
             .cta-spine-ring fade ensuite le sommet à transparent. -->
              <linearGradient id="ctaSpine-ring" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.10"
                ></stop>
                <stop offset="15%" stop-color="#FFFFFF" stop-opacity="0.14"
                ></stop>
                <stop offset="35%" stop-color="#FFFFFF" stop-opacity="0.16"
                ></stop>
                <stop offset="55%" stop-color="#FFFFFF" stop-opacity="0.135"
                ></stop>
                <stop offset="78%" stop-color="#FFFFFF" stop-opacity="0.075"
                ></stop>
                <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.025"
                ></stop>
              </linearGradient>
              <!-- Halo atmosphérique : opacités fortement réduites au sommet
             pour ne plus créer de bloom blurré à la jonction. -->
              <linearGradient id="ctaSpine-halo" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.06"
                ></stop>
                <stop offset="20%" stop-color="#FFFFFF" stop-opacity="0.080"
                ></stop>
                <stop offset="50%" stop-color="#FFFFFF" stop-opacity="0.045"
                ></stop>
                <stop offset="80%" stop-color="#FFFFFF" stop-opacity="0.020"
                ></stop>
                <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.008"
                ></stop>
              </linearGradient>
              <filter
                id="ctaSpine-bloom"
                x="-25%"
                y="-25%"
                width="150%"
                height="150%"
              >
                <feGaussianBlur stdDeviation="5.2"></feGaussianBlur>
              </filter>
              <filter
                id="ctaSpine-soft"
                x="-15%"
                y="-15%"
                width="130%"
                height="130%"
              >
                <feGaussianBlur stdDeviation="0.7"></feGaussianBlur>
              </filter>
            </defs>
            <!-- Halo (large, flou) -->
            <circle
              cx="400"
              cy="400"
              r="290"
              stroke="url(#ctaSpine-halo)"
              stroke-width="4"
              filter="url(#ctaSpine-bloom)"></circle>
            <!-- Filament (net) -->
            <circle
              cx="400"
              cy="400"
              r="290"
              stroke="url(#ctaSpine-ring)"
              stroke-width="1.15"
              filter="url(#ctaSpine-soft)"></circle>
          </svg>
        </div>

        <!-- ORBITAL PULSE — Diffusion 7-couleurs sur le contour du globe.
       Architecture à 2 couches concentriques (halo flou + arc net),
       toutes deux pilotées par les mêmes vars CSS (--orbit-dash &
       --orbit-offset). L'animation grandit symétriquement depuis 12h
       vers les deux horizons (9h et 3h), épousant exactement la
       moitié visible du globe. -->
        <div class="cta-orbit-pulse" aria-hidden="true">
          <svg
            class="cta-orbit-pulse-svg"
            viewBox="0 0 800 800"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            preserveAspectRatio="xMidYMid meet"
          >
            <defs>
              <!-- Sweep 7 couleurs JCD — CONTINU (pas de stop transparent
             aux extrêmes). Le gradient boucle proprement (0% bleu →
             100% bleu) pour que le dash montre toujours des couleurs
             pleines quelle que soit sa position le long du contour. -->
              <linearGradient id="ctaO-rainbow" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#2E72BA" stop-opacity="0.70"
                ></stop>
                <stop offset="14%" stop-color="#F9D605" stop-opacity="0.70"
                ></stop>
                <stop offset="28%" stop-color="#F3941D" stop-opacity="0.70"
                ></stop>
                <stop offset="42%" stop-color="#E51D29" stop-opacity="0.70"
                ></stop>
                <stop offset="57%" stop-color="#8D2C87" stop-opacity="0.70"
                ></stop>
                <stop offset="71%" stop-color="#8EC041" stop-opacity="0.70"
                ></stop>
                <stop offset="85%" stop-color="#A78D75" stop-opacity="0.70"
                ></stop>
                <stop offset="100%" stop-color="#2E72BA" stop-opacity="0.70"
                ></stop>
              </linearGradient>
            </defs>
            <!-- Couche HALO : stroke épais (5px) flouté en CSS → diffusion
           atmosphérique discrète. Rendu sous l'arc net. -->
            <circle
              class="cta-orbit-halo"
              cx="400"
              cy="400"
              r="290"
              stroke="url(#ctaO-rainbow)"
              stroke-width="5"
              pathLength="100"
              stroke-linecap="round"
              transform="rotate(-90 400 400)"></circle>
            <!-- Couche ARC : filament fin (1.8px) pour un rendu plus subtil.
           rotate(-90) place position 0 au sommet (12h). Le JS pilote
           stroke-dasharray + stroke-dashoffset (centré sur 12h).
           Le dash grandit de 0 à 50 unités (demi-cercle visible). -->
            <circle
              class="cta-orbit-arc"
              cx="400"
              cy="400"
              r="290"
              stroke="url(#ctaO-rainbow)"
              stroke-width="1.8"
              pathLength="100"
              stroke-linecap="round"
              transform="rotate(-90 400 400)"></circle>
          </svg>
        </div>

        <div class="container">
          <h2 id="cta-title" class="reveal delay-1">
            {accueil.titre_cta}
          </h2>
          <p class="reveal delay-2">{accueil.sous_titre_cta}</p>
