                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M22 10 12 5 2 10l10 5 10-5z"></path><path
                      d="M6 12v5c2 2 4 3 6 3s4-1 6-3v-5"></path></svg
                  >
                </div>
                <span class="pole-card-num">06 / 07</span>
              </div>
              <h3>{accueil.titre_carte_06}</h3>
