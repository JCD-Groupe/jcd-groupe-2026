              <p>{accueil.sous_titre_carte_07}</p>
            </a>
          </div>
        </div>
      </section>

      <!-- ================================
     CHIFFRES CLÉS
     ================================ -->
      <section class="chiffres" id="chiffres" aria-labelledby="chiffres-title">
        <div class="container">
          <div class="section-head reveal">
            <h2 id="chiffres-title">{accueil.titre_chiffres}</h2>
            <p>{accueil.sous_titre_chiffres}</p>
          </div>

          <!-- Chiffres clés sourcés du PPTX officiel JCD 2026 (slide 8 : "Quelques chiffres") -->
          <div class="chiffres-grid">
            <div class="chiffre reveal delay-1">
              <div
                class="chiffre-value"
                data-target={accueil.chiffre_01_nombre}
                data-suffix={accueil.chiffre_01_suffixe}
              >
                <span
                  >{accueil.chiffre_01_nombre}{accueil.chiffre_01_suffixe}</span
                >
              </div>
              <div class="chiffre-label">{accueil.chiffre_01_label}</div>
            </div>
            <div class="chiffre reveal delay-2">
              <div
                class="chiffre-value"
                data-target={accueil.chiffre_02_nombre}
                data-suffix={accueil.chiffre_02_suffixe}
              >
                <span
                  >{accueil.chiffre_02_nombre}{accueil.chiffre_02_suffixe}</span
                >
              </div>
              <div class="chiffre-label">{accueil.chiffre_02_label}</div>
            </div>
            <div class="chiffre reveal delay-3">
              <div
                class="chiffre-value"
                data-target={accueil.chiffre_03_nombre}
                data-suffix={accueil.chiffre_03_suffixe}
              >
                <span
                  >{accueil.chiffre_03_nombre}{accueil.chiffre_03_suffixe}</span
                >
              </div>
              <div class="chiffre-label">{accueil.chiffre_03_label}</div>
            </div>
            <div class="chiffre reveal delay-4">
              <div
                class="chiffre-value"
                data-target={accueil.chiffre_04_nombre}
                data-suffix={accueil.chiffre_04_suffixe}
              >
                <span
                  >{accueil.chiffre_04_nombre}{accueil.chiffre_04_suffixe}</span
                >
              </div>
              <div class="chiffre-label">{accueil.chiffre_04_label}</div>
            </div>
          </div>

          <!-- Logos clients & partenaires : marquee 3 rangees, monochrome -->
          <div
            class="clients-trust reveal"
            aria-labelledby="clients-trust-title"
          >
            <div class="clients-eyebrow" id="clients-trust-title">
              {accueil.titre_confiance}
            </div>
            <div
              class="clients-marquee"
              role="region"
              aria-label="Logos de nos clients et partenaires"
            >
              <div class="clients-row" style="--dur: 78s">
                <ul class="clients-row__track">
                  {
                    logos1.map(
                      (logo: {
                        id: string;
                        title?: string;
                        directus_files_id: string;
                      }) => (
                        <li class="clients-row__item">
                          <img
                            src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id}`}
                            alt={logo.title || ""}
                            title={logo.title || ""}
                            loading="lazy"
                            decoding="async"
                          />
                        </li>
                      ),
                    )
                  }
                </ul>
                <ul class="clients-row__track" aria-hidden="true">
                  {
                    logos1.map(
                      (logo: {
                        id: string;
                        title?: string;
                        directus_files_id: string;
                      }) => (
                        <li class="clients-row__item">
                          <img
                            src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id}`}
                            alt={logo.title || ""}
                            title={logo.title || ""}
                            loading="lazy"
                            decoding="async"
                          />
                        </li>
                      ),
                    )
                  }
                </ul>
              </div>
              <div class="clients-row clients-row--reverse" style="--dur: 92s">
                <ul class="clients-row__track">
                  {
                    logos2.map(
                      (logo: {
                        id: string;
                        title?: string;
                        directus_files_id: string;
                      }) => (
                        <li class="clients-row__item">
                          <img
                            src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id}`}
                            alt={logo.title || ""}
                            title={logo.title || ""}
                            loading="lazy"
                            decoding="async"
                          />
                        </li>
                      ),
                    )
                  }
                </ul>
                <ul class="clients-row__track" aria-hidden="true">
                  {
                    logos2.map(
                      (logo: {
                        id: string;
                        title?: string;
                        directus_files_id: string;
                      }) => (
                        <li class="clients-row__item">
                          <img
                            src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id}`}
                            alt={logo.title || ""}
                            title={logo.title || ""}
                            loading="lazy"
                            decoding="async"
                          />
                        </li>
                      ),
                    )
                  }
                </ul>
              </div>
              <div class="clients-row" style="--dur: 68s">
                <ul class="clients-row__track">
                  {
                    logos3.map(
                      (logo: {
                        id: string;
                        title?: string;
                        directus_files_id: string;
                      }) => (
                        <li class="clients-row__item">
                          <img
                            src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id}`}
                            alt={logo.title || ""}
                            title={logo.title || ""}
                            loading="lazy"
                            decoding="async"
                          />
                        </li>
                      ),
                    )
                  }
                </ul>
                <ul class="clients-row__track" aria-hidden="true">
                  {
                    logos3.map(
                      (logo: {
                        id: string;
                        title?: string;
                        directus_files_id: string;
                      }) => (
                        <li class="clients-row__item">
                          <img
                            src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id}`}
                            alt={logo.title || ""}
                            title={logo.title || ""}
                            loading="lazy"
                            decoding="async"
                          />
                        </li>
                      ),
                    )
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     VALEURS — 3 piliers
     ================================ -->
      <section class="valeurs" id="valeurs" aria-labelledby="valeurs-title">
        <div class="container">
          <div class="section-head reveal">
            <h2 id="valeurs-title">{accueil.titre_methode_valeurs}</h2>
            <p>{accueil.sous_titre_methode_valeurs}<br /></p>
          </div>

          <!-- ============================================================
         VERCEL-LIKE FLOW DIAGRAM
         Parcours client : besoin > hub JCD > 3 branches valeurs.
         SVG lignes animees + legende HTML. Mobile : version verticale.
         ============================================================ -->
          <div class="vd-flow reveal">
            <!-- === DESKTOP: SVG Diagram === -->
            <svg
              class="vd-svg"
              viewBox="0 0 900 280"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <defs>
                <linearGradient id="vd-fade-1" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#6BB5E8"></stop>
                  <stop offset="100%" stop-color="#6BB5E8" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <linearGradient id="vd-fade-2" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#2E72BA"></stop>
                  <stop offset="100%" stop-color="#2E72BA" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <linearGradient id="vd-fade-3" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#1E5A94"></stop>
                  <stop offset="100%" stop-color="#1E5A94" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <filter
                  id="vd-glow"
                  x="-20%"
                  y="-20%"
                  width="140%"
                  height="140%"
                >
                  <feGaussianBlur
                    in="SourceGraphic"
                    stdDeviation="4"
                    result="blur"></feGaussianBlur>
                  <feMerge
                    ><feMergeNode in="blur"></feMergeNode><feMergeNode
                      in="SourceGraphic"></feMergeNode></feMerge
                  >
                </filter>
                <radialGradient id="vd-hub-aura" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#2E72BA" stop-opacity="0.20"
                  ></stop>
                  <stop offset="60%" stop-color="#2E72BA" stop-opacity="0.05"
                  ></stop>
                  <stop offset="100%" stop-color="#2E72BA" stop-opacity="0"
                  ></stop>
                </radialGradient>
                <!-- Impulsions : matérialisation en sortie de hub, dissolution
               exactement au bord des cercles environnements (x=650) -->
                <linearGradient
                  id="vd-pulse-fade-1"
                  gradientUnits="userSpaceOnUse"
                  x1="309"
                  y1="0"
                  x2="650"
                  y2="0"
                >
                  <stop offset="0%" stop-color="#6BB5E8" stop-opacity="0"
                  ></stop>
                  <stop offset="6%" stop-color="#6BB5E8" stop-opacity="1"
                  ></stop>
                  <stop offset="82%" stop-color="#6BB5E8" stop-opacity="1"
                  ></stop>
                  <stop offset="100%" stop-color="#6BB5E8" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <linearGradient
                  id="vd-pulse-fade-2"
                  gradientUnits="userSpaceOnUse"
                  x1="309"
                  y1="0"
                  x2="650"
                  y2="0"
                >
                  <stop offset="0%" stop-color="#2E72BA" stop-opacity="0"
                  ></stop>
                  <stop offset="6%" stop-color="#2E72BA" stop-opacity="1"
                  ></stop>
                  <stop offset="82%" stop-color="#2E72BA" stop-opacity="1"
                  ></stop>
                  <stop offset="100%" stop-color="#2E72BA" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <linearGradient
                  id="vd-pulse-fade-3"
                  gradientUnits="userSpaceOnUse"
                  x1="309"
                  y1="0"
                  x2="650"
                  y2="0"
                >
                  <stop offset="0%" stop-color="#1E5A94" stop-opacity="0"
                  ></stop>
                  <stop offset="6%" stop-color="#1E5A94" stop-opacity="1"
                  ></stop>
                  <stop offset="82%" stop-color="#1E5A94" stop-opacity="1"
                  ></stop>
                  <stop offset="100%" stop-color="#1E5A94" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <!-- Traînée de comète du satellite orbital : fondu tête → queue -->
                <linearGradient
                  id="vd-orbit-trail"
                  gradientUnits="userSpaceOnUse"
                  x1="317"
                  y1="140"
                  x2="293"
                  y2="111.4"
                >
                  <stop offset="0%" stop-color="#6BB5E8" stop-opacity="0.45"
                  ></stop>
                  <stop offset="100%" stop-color="#6BB5E8" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <!-- Globe JCD (repris du favicon) : rect teinté révélé par le masque du logotype -->
