                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <!-- Outer entry : pliure du Z à 76% (proche du dot), dernier
               segment court → halo du dot englobe la jonction comme
               sur les middle entries. d= et x= directement en HTML
               pour compatibilité Firefox (CSS d:/x: non supportés). -->
                <path
                  class="hist-branch-path"
                  pathLength="100"
                  d="M 0 50 H 76 V 100 H 100"></path>
                <rect
                  class="hist-branch-mark"
                  x="73"
                  y="47"
                  width="6"
                  height="6"></rect>
              </svg>
              <span class="hist-node-dot" aria-hidden="true"></span>
