              <p>{accueil.sous_titre_carte_03}</p>
            </a>

            <a
              class="pole-card c-red"
              href="service.html"
              aria-label="Pôle Service"
            >
              <div class="pole-card-top">
                <div class="pole-card-icon">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 14v-2a9 9 0 0 1 18 0v2"></path><path
                      d="M21 14v3a2 2 0 0 1-2 2h-1v-7h1a2 2 0 0 1 2 2zM3 14v3a2 2 0 0 0 2 2h1v-7H5a2 2 0 0 0-2 2z"
                    ></path></svg
