          <!-- ============================================================
         RÉSEAU — Tronc vertical central + 6 branches en courbes S
         (Synapse hybride). Typographie éditoriale flottante à côté
         de chaque nœud, hairline 1px en accent couleur JCD du jalon.
         Pulse 7-couleurs scroll-driven sur le tronc (data flow).
         ============================================================ -->
          <ol class="hist-network" id="hist-network" role="list">
            <!-- Pulse vertical animé par le scroll (translate3d Y via --pulse-y).
           Continuité logique : trunk + branches + 6 dots — pas de
           décoration mid-network détachée. -->
            <span class="hist-pulse" aria-hidden="true"></span>

            <li
              class="hist-entry hist-entry--left"
              data-i="0"
              style="--node-color:#2E72BA"
