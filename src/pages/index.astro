---
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

let accueil;

accueil = await directus.request(
  readSingleton("accueil", {
    fields: ["*", { logos_clients: ["*"] }],
  }),
);

const logos = accueil.logos_clients || [];
const totalLogos = logos.length;
const third = Math.ceil(totalLogos / 3);

const logos1 = logos.slice(0, third);
const logos2 = logos.slice(third, third * 2);
const logos3 = logos.slice(third * 2);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="JCD Groupe · Votre expert informatique de proximité depuis 1996. Sept pôles métiers complémentaires : informatique, cybersécurité, développement, impression, télécom, formation, agencement. Metz · Nancy."
    />
    <link rel="canonical" href="https://www.jcd-groupe.fr/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content="JCD Groupe · Votre expert informatique de proximité"
    />
    <meta
      property="og:description"
      content="JCD Groupe · Votre expert informatique de proximité depuis 1996. Sept pôles métiers complémentaires : informatique, cybersécurité, développement, impression, télécom, formation, agencement. Metz · Nancy."
    />
    <meta property="og:url" content="https://www.jcd-groupe.fr/" />
    <meta name="twitter:card" content="summary" />
    <title>JCD Groupe · Votre expert informatique de proximité</title>

    <!--
  ====================================================================
  JCD GROUPE — LANDING PAGE
  Inspiration visuelle : Linear (sombre, minimaliste, B2B premium)
  ====================================================================

  TYPOGRAPHIE
    Inter — chargée via Google Fonts (poids 400 / 500 / 600 / 700 / 800)
    Note : la charte JCD prévoit Impact + Century Gothic. La présente
    page utilise Inter sur demande explicite, pour aligner le rendu
    avec l'esthétique Linear (B2B premium minimaliste).

  COULEURS RETENUES (sous-ensemble volontaire de la charte JCD)
    Anthracite (base) ........ #3D3B3B
    Blanc .................... #FFFFFF
    Bleu (accent unique) ..... #2E72BA  <- seul accent coloré utilisé
    Les autres couleurs de la palette JCD (jaune/orange/rouge/violet/
    vert/beige) sont présentes en variables CSS mais NON utilisées,
    pour préserver une lecture sobre et monochromatique.

  CHIFFRES CLÉS
    1996  : année de création
    30+   : années d'expertise
    7     : pôles métiers complémentaires
    2     : sites en Lorraine (Metz + Nancy)

  POSITIONNEMENT
    JCD Groupe est l'expert informatique de proximité de la Lorraine,
    actif depuis 1996. Sept pôles complémentaires accompagnent les
    projets « Métiers & Business » des entreprises clientes.

  RESSOURCES
    - Site officiel ....... https://www.jcd-groupe.fr/
    - Charte .............. ./charte graphique/Charte graphique_avril_2026.pdf
    - Logo blanc .......... ./charte graphique/logo_blanc.png
    - Présentation ........ ./charte graphique/presentation_jcd.pptx (170 Mo, non lu)

  TODO — informations non disponibles dans les sources
    - Nombre exact de collaborateurs
    - Nombre de clients accompagnés
    - Chiffre d'affaires
    - Dates précises de la timeline (entre 1996 et 2026)
  ====================================================================
-->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@1,400;1,500;1,600&display=swap"
      rel="stylesheet"
