              <h3>{accueil.titre_carte_04}</h3>
              <p>{accueil.sous_titre_carte_04}</p>
            </a>

            <a
              class="pole-card c-purple"
              href="telecom.html"
              aria-label="Pôle Télécom"
            >
              <div class="pole-card-top">
