                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M6 9V3h12v6"></path><rect
                      x="3"
                      y="9"
                      width="18"
                      height="8"
                      rx="2"></rect><path d="M7 17h10v4H7z"></path><circle
                      cx="17"
                      cy="13"
                      r="0.8"
                      fill="currentColor"></circle></svg
                  >
