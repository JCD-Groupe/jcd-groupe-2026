                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><rect x="3" y="4" width="18" height="12" rx="2"
                    ></rect><path d="M8 20h8M12 16v4"></path></svg
                  >
                </div>
                <span class="pole-card-num">01 / 07</span>
              </div>
              <h3>{accueil.titre_carte_01}</h3>
              <p>{accueil.sous_titre_carte_01}</p>
            </a>

            <a
              class="pole-card c-yellow"
              href="developpement.html"
              aria-label="Pôle Développement"
            >
              <div class="pole-card-top">
                <div class="pole-card-icon">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m8 6-6 6 6 6M16 6l6 6-6 6M14 4l-4 16"></path></svg
