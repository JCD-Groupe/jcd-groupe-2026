                aria-hidden="true"
              >
                <!-- Outer entry : pliure du Z à 76% (proche du dot). -->
                <path
                  class="hist-branch-path"
                  pathLength="100"
                  d="M 0 50 H 76 V 100 H 100"></path>
                <rect
                  class="hist-branch-mark"
