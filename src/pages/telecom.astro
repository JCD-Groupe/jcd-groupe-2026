---
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { fetchSvgContent } from "../utils/formatters";

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let telecom = await directus.request(
  readSingleton("JCD_Telecom", {
    fields: [
      "*",
      { prestations: ["*"] },
      { processus: ["*"] },
      { logos_confiance: ["*", { directus_files_id: ["*"] }] },
    ],
  }),
);

telecom.icone_cta_content = await fetchSvgContent(telecom.icone_cta);

telecom.prestations = await Promise.all(
  telecom.prestations.map(async (prestation: any) => ({
    ...prestation,
    icone_content: await fetchSvgContent(prestation.icone),
  })),
);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon_claire}`}
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon_sombre}`}
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <meta name="description" content={telecom.meta_description} />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/telecom`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content={`${telecom.nom_pole} · ${global.nom_societe}`}
    />
    <meta property="og:description" content={telecom.meta_description} />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/telecom`}
    />
    <meta name="twitter:card" content="summary" />
    <title>{telecom.nom_pole} · {global.nom_societe}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/telecom.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/telecom-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ================================
     HERO — Mesh WebGL fluide + texture pôle (pattern universel)
     ================================ -->
        <section class="print-hero" aria-labelledby="telecom-hero-title">
          <!-- Couche 0 : fallback CSS si WebGL indisponible / fade-in -->
          <div class="hero-mesh-fallback" aria-hidden="true"></div>

          <!-- Couche 1 : canvas WebGL — fond animé "Propagation" (ondes concentriques) -->
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>

          <!-- Couche 2 : texture pôle — Télécom = grille signal -->
          <div class="hero-texture hero-texture--signal" aria-hidden="true">
          </div>

          <!-- Couche 3 : grain léger -->
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1
              id="telecom-hero-title"
              class="hero-title reveal delay-1"
              set:html={telecom.titre_hero}
            />

            <p
              class="hero-sub reveal delay-2"
              set:html={telecom.sous_titre_hero}
            />

            <div class="hero-actions reveal delay-3">
              <a
                href="/contact?pole=telecom&step=2"
                class="btn-cta btn-cta--ghost"
              >
                {telecom.bouton_hero}
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ================================
     MANIFESTO — Paper sheet inversion
     ================================ -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="signal-sheet">
            <div class="container">
              <header class="tx-header reveal">
                <span class="tx-header-side">
                  <span class="tx-caret" aria-hidden="true">&#9656;</span>
                  <span class="tx-id">TX&middot;01</span>
                  <span class="tx-header-rule" aria-hidden="true"></span>
                  <span>Manifeste</span>
                </span>
                <span class="tx-header-side">
                  <span class="tx-bars" aria-hidden="true">
                    <i class="tx-bar"></i>
                    <i class="tx-bar"></i>
                    <i class="tx-bar tx-bar--on"></i>
                    <i class="tx-bar tx-bar--on"></i>
                  </span>
                  <span>Pôle Télécom</span>
                </span>
              </header>

              <blockquote
                class="manifesto-quote manifesto-rich"
                id="manifesto-title"
                data-tx-decode
                set:html={telecom.manifeste}
              >
                <span class="tx-cursor" aria-hidden="true"></span>
              </blockquote>
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone : hero sticky + manifesto scrolling-over -->

      <!-- ================================
     PRESTATIONS — Catalog avec monogram glyphs
     ================================ -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prestations-title"
      >
        <div class="container">
          <div class="prest-layout">
            <aside class="prest-aside reveal">
              <h2
                class="prest-aside-title"
                id="prestations-title"
                set:html={telecom.titre_prestations}
              />
              <p
                class="prest-aside-sub"
                set:html={telecom.sous_titre_prestations}
              />

              <div class="prest-aside-partners">
                <div class="prest-aside-partners-head">
                  <span class="prest-aside-partners-label"
                    >{telecom.titre_confiance}</span
                  >
                  <span class="prest-aside-partners-rule" aria-hidden="true"
                  ></span>
                  <span class="prest-aside-partners-count"
                    >{telecom.nombre_confiance}</span
                  >
                </div>
                <div class="prest-aside-partners-grid">
                  {
                    telecom.logos_confiance.map((logo: any) => (
                      <div
                        class="logo-tile logo-tile--mini"
                        data-brand={logo.directus_files_id.title || ""}
                      >
                        <img
                          class="logo-tile-img"
                          loading="lazy"
                          decoding="async"
                          src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id.id}`}
                          alt={logo.directus_files_id.title || ""}
                          aria-hidden="true"
                        />
                        <span class="logo-tile-name">
                          {logo.directus_files_id.title}
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>
            </aside>

            <div class="prest-menu reveal delay-1">
              {
                telecom.prestations.map((prestation: any) => (
                  <article class="prest-item">
                    <div class="prest-item-head">
                      <span
                        class="prest-item-glyph"
                        aria-hidden="true"
                        set:html={prestation.icone_content}
                      />
                    </div>
                    <h3 class="prest-item-title" set:html={prestation.titre} />
                    <p
                      class="prest-item-desc"
                      set:html={prestation.description}
                    />
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     SECTION DIVIDER — Compétences → Méthode (hairline monochrome)
     ================================ -->
      <div class="section-divider" aria-hidden="true">
        <div class="container">
          <span class="section-divider-line"></span>
        </div>
      </div>

      <!-- ================================
     PROCESS — Étapes (épuré, sans détails techniques)
     ================================ -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="section-head reveal">
            <h2
              class="section-title"
              id="process-title"
              set:html={telecom.titre_processus}
            >
              <span
                class="text-muted"
                set:html={telecom.sous_titre_processus}
              />
            </h2>
          </div>

          <div class="pf-vflow reveal">
            <!-- ====== SVG Ligne de transmission : fibre horizontale + 4 nœuds-relais ====== -->
            <svg
              class="pf-vsvg"
              viewBox="0 0 900 240"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              preserveAspectRatio="xMidYMid meet"
            >
              <defs>
                <filter
                  id="pf-glow"
                  x="-50%"
                  y="-50%"
                  width="200%"
                  height="200%"
                >
                  <feGaussianBlur
                    in="SourceGraphic"
                    stdDeviation="3.5"
                    result="blur"></feGaussianBlur>
                  <feMerge>
                    <feMergeNode in="blur"></feMergeNode>
                    <feMergeNode in="SourceGraphic"></feMergeNode>
                  </feMerge>
                </filter>
                <radialGradient id="pf-hub-aura" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#8D2C87" stop-opacity="0.20"
                  ></stop>
                  <stop offset="60%" stop-color="#8D2C87" stop-opacity="0.05"
                  ></stop>
                  <stop offset="100%" stop-color="#8D2C87" stop-opacity="0"
                  ></stop>
                </radialGradient>
                <linearGradient
                  id="pf-fiber-grad"
                  x1="46"
                  y1="0"
                  x2="854"
                  y2="0"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop offset="0" stop-color="#D2A8CE"></stop>
                  <stop offset="0.36" stop-color="#BB80B6"></stop>
                  <stop offset="0.66" stop-color="#A1539B"></stop>
                  <stop offset="1" stop-color="#8D2C87"></stop>
                </linearGradient>
              </defs>

              <!-- Aura origine (statique, subtile) — centrée sur le nœud émetteur de l'étape 01 -->
              <circle cx="106" cy="78" r="50" fill="url(#pf-hub-aura)"></circle>

              <!-- Labels extrémités : émetteur → récepteur -->
              <g class="pf-anim-node" style="--d: 0.15s">
                <text
                  x="20"
                  y="32"
                  font-family="JetBrains Mono, ui-monospace, monospace"
                  font-size="9.5"
                  fill="rgba(255,255,255,0.42)"
                  letter-spacing="3.5">{telecom.processus_label_debut}</text
                >
              </g>
              <g class="pf-anim-node" style="--d: 1.1s">
                <text
                  x="880"
                  y="32"
                  text-anchor="end"
                  font-family="JetBrains Mono, ui-monospace, monospace"
                  font-size="9.5"
                  fill="rgba(255,255,255,0.42)"
                  letter-spacing="3.5">{telecom.processus_label_fin}</text
                >
              </g>

              <!-- Halo flou sous la fibre -->
              <path
                class="pf-fiber-glow"
                d="M 106,78 L 838,78"
                stroke="url(#pf-fiber-grad)"
                stroke-width="6"
                stroke-linecap="round"
                filter="url(#pf-glow)"></path>

              <!-- Tracé fibre : dessin progressif gauche → droite -->
              <path
                class="pf-draw"
                style="--d: 0s"
                d="M 106,78 L 838,78"
                pathLength="100"
                stroke="url(#pf-fiber-grad)"
                stroke-width="1.6"
                stroke-linecap="round"></path>

              <!-- Connecteurs verticaux : nœud-relais → carte.
             Longueurs croissantes (étape 01 la plus longue) : chaque
             connecteur descend jusqu'au sommet réel de sa carte décalée
             en marches — disposition « barres de signal réseau ». -->
              <path
                class="pf-draw"
                style="--d: 0.45s"
                d="M 106,102 L 106,312"
                pathLength="100"
                stroke="#D2A8CE"
                stroke-width="1.4"
                stroke-linecap="round"></path>
              <path
                class="pf-draw"
                style="--d: 0.6s"
                d="M 335,95 L 335,288"
                pathLength="100"
                stroke="#BB80B6"
                stroke-width="1.4"
                stroke-linecap="round"></path>
              <path
                class="pf-draw"
                style="--d: 0.75s"
                d="M 564,95 L 564,264"
                pathLength="100"
                stroke="#A1539B"
                stroke-width="1.4"
                stroke-linecap="round"></path>
              <path
                class="pf-draw"
                style="--d: 0.9s"
                d="M 794,95 L 794,240"
                pathLength="100"
                stroke="#8D2C87"
                stroke-width="1.4"
                stroke-linecap="round"></path>

              <!-- Nœud 01 — émetteur : vos sites interconnectés, origine du flux -->
              <g class="pf-anim-node" style="--d: 0.4s">
                <circle
                  cx="106"
                  cy="78"
                  r="24"
                  fill="#0a0a0a"
                  stroke="rgba(210,168,206,0.42)"
                  stroke-width="1"></circle>
                <circle
                  cx="106"
                  cy="78"
                  r="13"
                  fill="none"
                  stroke="#D2A8CE"
                  stroke-width="1"
                  opacity="0.32"></circle>
                <circle
                  cx="106"
                  cy="78"
                  r="7.5"
                  fill="none"
                  stroke="#D2A8CE"
                  stroke-width="1.3"
                  opacity="0.62"></circle>
                <circle cx="106" cy="78" r="3.2" fill="#D2A8CE"></circle>
              </g>

              <!-- 3 nœuds-relais : cellules hexagonales (réseau cellulaire) avec glyphe télécom -->
              <!-- Nœud 02 — niveaux de signal / étude opérateurs -->
              <g class="pf-anim-node" style="--d: 0.55s">
                <circle cx="335" cy="78" r="27" fill="rgba(187,128,182,0.055)"
                ></circle>
                <path
                  d="M359.5,78 L347.25,99.22 L322.75,99.22 L310.5,78 L322.75,56.78 L347.25,56.78 Z"
                  fill="none"
                  stroke="#BB80B6"
                  stroke-width="1"
                  opacity="0.2"
                  stroke-linejoin="round"></path>
                <path
                  d="M355,78 L345,95.32 L325,95.32 L315,78 L325,60.68 L345,60.68 Z"
                  fill="#0a0a0a"
                  stroke="#BB80B6"
                  stroke-width="1.4"
                  stroke-linejoin="round"></path>
                <rect
                  x="328.8"
                  y="80"
                  width="2.6"
                  height="4.4"
                  rx="0.9"
                  fill="#BB80B6"
                  opacity="0.5"></rect>
                <rect
                  x="333.7"
                  y="77.4"
                  width="2.6"
                  height="7"
                  rx="0.9"
                  fill="#BB80B6"
                  opacity="0.74"></rect>
                <rect
                  x="338.6"
                  y="74.6"
                  width="2.6"
                  height="9.8"
                  rx="0.9"
                  fill="#BB80B6"></rect>
              </g>
              <!-- Nœud 03 — antenne / déploiement -->
              <g class="pf-anim-node" style="--d: 0.7s">
                <circle cx="564" cy="78" r="27" fill="rgba(161,83,155,0.06)"
                ></circle>
                <path
                  d="M588.5,78 L576.25,99.22 L551.75,99.22 L539.5,78 L551.75,56.78 L576.25,56.78 Z"
                  fill="none"
                  stroke="#A1539B"
                  stroke-width="1"
                  opacity="0.22"
                  stroke-linejoin="round"></path>
                <path
                  d="M584,78 L574,95.32 L554,95.32 L544,78 L554,60.68 L574,60.68 Z"
                  fill="#0a0a0a"
                  stroke="#A1539B"
                  stroke-width="1.4"
                  stroke-linejoin="round"></path>
                <path
                  d="M564,84.6 V75.4"
                  fill="none"
                  stroke="#A1539B"
                  stroke-width="1.15"
                  stroke-linecap="round"></path>
                <path
                  d="M560.8,84.6 H567.2"
                  fill="none"
                  stroke="#A1539B"
                  stroke-width="1.15"
                  stroke-linecap="round"></path>
                <circle cx="564" cy="73.1" r="1.7" fill="#A1539B"></circle>
                <path
                  d="M559.4,70.7 a4.6 4.6 0 0 0 0 6.4"
                  fill="none"
                  stroke="#A1539B"
                  stroke-width="1.05"
                  opacity="0.62"
                  stroke-linecap="round"></path>
                <path
                  d="M568.6,70.7 a4.6 4.6 0 0 1 0 6.4"
                  fill="none"
                  stroke="#A1539B"
                  stroke-width="1.05"
                  opacity="0.62"
                  stroke-linecap="round"></path>
              </g>
              <!-- Nœud 04 — supervision / monitoring -->
              <g class="pf-anim-node" style="--d: 0.85s">
                <circle cx="794" cy="78" r="27" fill="rgba(141,44,135,0.07)"
                ></circle>
                <path
                  d="M818.5,78 L806.25,99.22 L781.75,99.22 L769.5,78 L781.75,56.78 L806.25,56.78 Z"
                  fill="none"
                  stroke="#8D2C87"
                  stroke-width="1"
                  opacity="0.28"
                  stroke-linejoin="round"></path>
                <path
                  d="M814,78 L804,95.32 L784,95.32 L774,78 L784,60.68 L804,60.68 Z"
                  fill="#0a0a0a"
                  stroke="#8D2C87"
                  stroke-width="1.4"
                  stroke-linejoin="round"></path>
                <path
                  d="M787,78 h3.6 l2,-4.8 l2.9,8.8 l2,-4.8 h3.5"
                  fill="none"
                  stroke="#8D2C87"
                  stroke-width="1.35"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </g>

              <!-- Récepteur : terminal supervisé (endpoint monitoré) -->
              <g class="pf-anim-node" style="--d: 1.0s">
                <circle cx="844" cy="78" r="14" fill="rgba(141,44,135,0.06)"
                ></circle>
                <circle
                  cx="844"
                  cy="78"
                  r="9"
                  fill="#0a0a0a"
                  stroke="#8D2C87"
                  stroke-width="1.35"></circle>
                <circle
                  cx="844"
                  cy="78"
                  r="4.7"
                  fill="none"
                  stroke="#8D2C87"
                  stroke-width="1.1"
                  opacity="0.62"></circle>
                <circle cx="844" cy="78" r="1.8" fill="#8D2C87"></circle>
              </g>

              <!-- Jonctions : raccord connecteur ↔ carte -->
              <g class="pf-anim-node" style="--d: 1.0s">
                <circle cx="106" cy="312" r="7" fill="#D2A8CE" opacity="0.20"
                ></circle>
                <circle cx="106" cy="312" r="3.4" fill="#D2A8CE"></circle>
              </g>
              <g class="pf-anim-node" style="--d: 1.15s">
                <circle cx="335" cy="288" r="7" fill="#BB80B6" opacity="0.20"
                ></circle>
                <circle cx="335" cy="288" r="3.4" fill="#BB80B6"></circle>
              </g>
              <g class="pf-anim-node" style="--d: 1.3s">
                <circle cx="564" cy="264" r="7" fill="#A1539B" opacity="0.20"
                ></circle>
                <circle cx="564" cy="264" r="3.4" fill="#A1539B"></circle>
              </g>
              <g class="pf-anim-node" style="--d: 1.45s">
                <circle cx="794" cy="240" r="7" fill="#8D2C87" opacity="0.20"
                ></circle>
                <circle cx="794" cy="240" r="3.4" fill="#8D2C87"></circle>
              </g>

              <!-- Impulsion lumineuse : capsule brillante qui parcourt la fibre en boucle -->
              <path
                class="pf-fiber-pulse"
                d="M 106,78 L 838,78"
                pathLength="100"
                stroke="#F2E2EF"
                stroke-width="2.4"
                stroke-linecap="round"
                filter="url(#pf-glow)"></path>
            </svg>

            <!-- ====== 4 CARDS alignées avec les endpoints des branches ====== -->
            <div class="pf-vcards">
              <article
                class="pf-vcard"
                style="--c: #D2A8CE; --c-rgb: 210,168,206;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="20" cy="20" r="13.5" opacity="0.3"></circle>
                      <circle cx="20" cy="20" r="8" opacity="0.55"></circle>
                      <path d="M20 20 V6.5"></path>
                      <path
                        d="M20 6.5 A13.5 13.5 0 0 1 31.7 13.25"
                        opacity="0.5"></path>
                      <circle
                        cx="20"
                        cy="20"
                        r="2.3"
                        fill="currentColor"
                        stroke="none"></circle>
                    </svg>
                  </span>
                </div><h3 class="pf-vcard-title">
                  {telecom.processus[0]?.titre}
                </h3><p class="pf-vcard-desc">
                  {telecom.processus[0]?.description}
                </p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>

              <article
                class="pf-vcard"
                style="--c: #BB80B6; --c-rgb: 187,128,182;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line
                        x1="7.5"
                        y1="31.5"
                        x2="32.5"
                        y2="31.5"
                        opacity="0.32"></line>
                      <rect
                        x="8.5"
                        y="25"
                        width="4.6"
                        height="6.5"
                        rx="1.4"
                        opacity="0.45"></rect>
                      <rect
                        x="14.9"
                        y="21"
                        width="4.6"
                        height="10.5"
                        rx="1.4"
                        opacity="0.62"></rect>
                      <rect
                        x="21.3"
                        y="16.5"
                        width="4.6"
                        height="15"
                        rx="1.4"
                        opacity="0.8"></rect>
                      <rect x="27.7" y="11.5" width="4.6" height="20" rx="1.4"
                      ></rect>
                    </svg>
                  </span>
                </div><h3 class="pf-vcard-title">
                  {telecom.processus[1]?.titre}
                </h3><p class="pf-vcard-desc">
                  {telecom.processus[1]?.description}
                </p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>

              <article
                class="pf-vcard"
                style="--c: #A1539B; --c-rgb: 161,83,155;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 32.5 V14.5"></path>
                      <path d="M15 32.5 L20 27 L25 32.5"></path>
                      <circle
                        cx="20"
                        cy="12"
                        r="2.5"
                        fill="currentColor"
                        stroke="none"></circle>
                      <path d="M13.6 6.8 a9 9 0 0 0 0 10.4" opacity="0.4"
                      ></path>
                      <path d="M16.2 9.4 a4.8 4.8 0 0 0 0 5.2" opacity="0.66"
                      ></path>
                      <path d="M26.4 6.8 a9 9 0 0 1 0 10.4" opacity="0.4"
                      ></path>
                      <path d="M23.8 9.4 a4.8 4.8 0 0 1 0 5.2" opacity="0.66"
                      ></path>
                    </svg>
                  </span>
                </div><h3 class="pf-vcard-title">
                  {telecom.processus[2]?.titre}
                </h3><p class="pf-vcard-desc">
                  {telecom.processus[2]?.description}
                </p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>

              <article
                class="pf-vcard"
                style="--c: #8D2C87; --c-rgb: 141,44,135;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="6.5" y="8" width="27" height="19" rx="2.8"
                      ></rect>
                      <path d="M20 27 V32" opacity="0.55"></path>
                      <path d="M15.5 32.5 H24.5" opacity="0.55"></path>
                      <path
                        d="M11 18 H15.4 L17.7 11.8 L21.3 23.2 L23.8 16.4 L25.6 18 H29"
                        opacity="0.9"></path>
                    </svg>
                  </span>
                </div><h3 class="pf-vcard-title">
                  {telecom.processus[3]?.titre}
                </h3><p class="pf-vcard-desc">
                  {telecom.processus[3]?.description}
                </p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     CTA — Bandeau compact centré, logo-icône Télécom comme accent
     ================================ -->
      <section class="cta-section" id="contact" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-frame">
            <div class="cta-inner">
              <span
                class="cta-icon"
                aria-hidden="true"
                set:html={telecom.icone_cta_content}
              />

              <div class="cta-body">
                <h2
                  class="cta-title reveal delay-1"
                  id="cta-title"
                  set:html={telecom.titre_cta}
                />

                <p
                  class="cta-sub reveal delay-2"
                  set:html={telecom.sous_titre_cta}
                />

                <div class="cta-actions reveal delay-3">
                  <a
                    href="/contact?pole=telecom&step=2"
                    class="btn-cta btn-cta--primary"
                  >
                    {telecom.bouton_cta}
                    <span class="btn-cta-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </a>
                  <span class="cta-actions-divider" aria-hidden="true"></span>
                  <span class="cta-phone">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      width="14"
                      height="14"
                      ><path
                        d="M2 3a1 1 0 011-1h3.28a1 1 0 01.95.68l1.07 3.21a1 1 0 01-.25 1L6.54 8.4a12.06 12.06 0 005.06 5.06l1.51-1.51a1 1 0 011-.25l3.21 1.07a1 1 0 01.68.95V17a1 1 0 01-1 1A15 15 0 012 3z"
                      ></path></svg
                    >
                    <a href="tel:+33387184920" class="cta-phone-num"
                      >03 87 18 49 20</a
                    >
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ================================
