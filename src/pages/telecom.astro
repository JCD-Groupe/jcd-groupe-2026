---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="JCD Groupe · Pôle Télécom. Téléphonie d'entreprise fixe et mobile, liens opérateurs fibre / 5G / satellite, UCaaS. Approche multi-opérateurs en Grand Est."
    />
    <link rel="canonical" href="https://www.jcd-groupe.fr/telecom" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content="Télécom · Téléphonie d'entreprise & connectivité · JCD Groupe"
    />
    <meta
      property="og:description"
      content="JCD Groupe · Pôle Télécom. Téléphonie d'entreprise fixe et mobile, liens opérateurs fibre / 5G / satellite, UCaaS. Approche multi-opérateurs en Grand Est."
    />
    <meta property="og:url" content="https://www.jcd-groupe.fr/telecom" />
    <meta name="twitter:card" content="summary" />
    <title>
      Télécom · Téléphonie d'entreprise &amp; connectivité · JCD Groupe
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="css/telecom.css" />
    <link rel="stylesheet" href="css/global.css" />
    <link rel="stylesheet" href="css/telecom-overrides.css" />
    <link rel="stylesheet" href="css/transition.css" />
    <script is:inline src="js/shared/js/shared/transition.js"></script>
    <script is:inline src="js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ================================
     HERO — Mesh WebGL fluide + texture pôle (pattern universel)
     ================================ -->
        <section class="print-hero" aria-labelledby="telecom-hero-title">
          <!-- Couche 0 : fallback CSS si WebGL indisponible / fade-in -->
          <div class="hero-mesh-fallback" aria-hidden="true"></div>

          <!-- Couche 1 : canvas WebGL — fond animé "Propagation" (ondes concentriques) -->
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>

          <!-- Couche 2 : texture pôle — Télécom = grille signal -->
          <div class="hero-texture hero-texture--signal" aria-hidden="true">
          </div>

          <!-- Couche 3 : grain léger -->
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1 id="telecom-hero-title" class="hero-title reveal delay-1">
              La <span class="accent-grad">connexion</span> qui relie tous vos sites.
            </h1>

            <p class="hero-sub reveal delay-2">
              Tous vos services télécom, multi-opérateurs et sans intermédiaire
              : liens fibre/5G/satellite, téléphonie fixe et mobile, UCaaS.
            </p>

            <div class="hero-actions reveal delay-3">
              <a href="contact?pole=telecom" class="btn-cta btn-cta--ghost">
                Faire le point sur mon réseau
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ================================
     MANIFESTO — Paper sheet inversion
     ================================ -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="signal-sheet">
            <div class="container">
              <header class="tx-header reveal">
                <span class="tx-header-side">
                  <span class="tx-caret" aria-hidden="true">&#9656;</span>
                  <span class="tx-id">TX&middot;01</span>
                  <span class="tx-header-rule" aria-hidden="true"></span>
                  <span>Manifeste</span>
                </span>
                <span class="tx-header-side">
                  <span class="tx-bars" aria-hidden="true">
                    <i class="tx-bar"></i>
                    <i class="tx-bar"></i>
                    <i class="tx-bar tx-bar--on"></i>
                    <i class="tx-bar tx-bar--on"></i>
                  </span>
                  <span>Pôle Télécom</span>
                </span>
              </header>

              <blockquote
                class="manifesto-quote"
                id="manifesto-title"
                data-tx-decode
              >
                <em>Connecter une entreprise,</em> ce n'est pas <em
                  >tirer une ligne</em
                >. C'est trouver <span class="accent"
                  >le bon lien chez le bon opérateur</span
                >, entre fibre, 5G et satellite, et le tenir dans le temps. <span
                  class="q-soft"
                  >Aucun opérateur imposé, seulement celui qui vous convient le
                  mieux.</span
                ><span class="tx-cursor" aria-hidden="true"></span>
              </blockquote>
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone : hero sticky + manifesto scrolling-over -->

      <!-- ================================
     PRESTATIONS — Catalog avec monogram glyphs
     ================================ -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prestations-title"
      >
        <div class="container">
          <div class="prest-layout">
            <aside class="prest-aside reveal">
              <h2 class="prest-aside-title" id="prestations-title">
                <span class="accent">Six savoir-faire</span>, un réseau sur
                mesure.
              </h2>
              <p class="prest-aside-sub">
                Du lien opérateur à la téléphonie hébergée : des solutions
                étudiées site par site.
              </p>

              <div class="prest-aside-partners">
                <div class="prest-aside-partners-head">
                  <span class="prest-aside-partners-label">Partenaires</span>
                  <span class="prest-aside-partners-rule" aria-hidden="true"
                  ></span>
                  <span class="prest-aside-partners-count">12</span>
                </div>
                <div class="prest-aside-partners-grid">
                  <div class="logo-tile logo-tile--mini" data-brand="mitel">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/mitel.webp"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Mitel</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="orange">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/orange.png"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Orange</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="sfr">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/sfr.webp"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">SFR</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="bouygues">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/bouygues.png"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Bouygues</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="eurofiber">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/eurofiber.webp"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Eurofiber</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="covage">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/covage.png"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Covage</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="altitude">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/altitude.png"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Altitude</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="axione">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/axione.png"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Axione</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="celeste">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/celeste.png"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Celeste</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="fortinet">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/fortinet.svg"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Fortinet</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="kosc">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/kosc.webp"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Kosc</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="ielo">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="logos%20TELECOM/ielo.png"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Ielo</span>
                  </div>
                </div>
              </div>
            </aside>

            <div class="prest-menu reveal delay-1">
              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <circle cx="9" cy="11" r="3.1"></circle>
                      <circle cx="31" cy="11" r="3.1"></circle>
                      <circle cx="20" cy="30" r="3.1"></circle>
                      <line x1="12.1" y1="11" x2="27.9" y2="11" opacity="0.45"
                      ></line>
                      <line
                        x1="10.6"
                        y1="13.7"
                        x2="18.4"
                        y2="27.3"
                        opacity="0.45"></line>
                      <line
                        x1="29.4"
                        y1="13.7"
                        x2="21.6"
                        y2="27.3"
                        opacity="0.45"></line>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  Liens &amp; interconnexion de sites
                </h3>
                <p class="prest-item-desc">
                  L'accès internet et l'interconnexion de vos sites, en fibre,
                  5G ou satellite.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <path
                        d="M20 5 L32 9.5 V19 C32 27 26.8 32.5 20 35 C13.2 32.5 8 27 8 19 V9.5 Z"
                      ></path>
                      <path d="M15.4 19.8 l3.5 3.5 l6.7 -7.7" opacity="0.6"
                      ></path>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Sécurité</h3>
                <p class="prest-item-desc">
                  Sur site ou hébergées, des solutions pour sécuriser l'accès
                  internet de l'entreprise.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <rect x="9" y="16" width="22" height="18" rx="2"></rect>
                      <rect
                        x="13.5"
                        y="8.5"
                        width="13"
                        height="7.5"
                        rx="2"
                        opacity="0.5"></rect>
                      <line x1="14" y1="22" x2="26" y2="22" opacity="0.4"
                      ></line>
                      <line x1="14" y1="26" x2="22" y2="26" opacity="0.4"
                      ></line>
                      <circle
                        cx="26"
                        cy="29"
                        r="1.5"
                        fill="currentColor"
                        stroke="none"></circle>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Téléphonie d'entreprise</h3>
                <p class="prest-item-desc">
                  Standard IPBX, portabilité des numéros, gestion des factures :
                  solutions certifiées Mitel.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <rect x="9" y="9" width="22" height="9" rx="1.6"></rect>
                      <rect x="9" y="22" width="22" height="9" rx="1.6"></rect>
                      <circle
                        cx="14"
                        cy="13.5"
                        r="1.3"
                        fill="currentColor"
                        stroke="none"
                        opacity="0.7"></circle>
                      <circle
                        cx="14"
                        cy="26.5"
                        r="1.3"
                        fill="currentColor"
                        stroke="none"
                        opacity="0.7"></circle>
                      <line x1="18.5" y1="13.5" x2="26" y2="13.5" opacity="0.4"
                      ></line>
                      <line x1="18.5" y1="26.5" x2="26" y2="26.5" opacity="0.4"
                      ></line>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  UCaaS&nbsp;: téléphonie hébergée
                </h3>
                <p class="prest-item-desc">
                  La téléphonie hébergée dans le cloud : aucun matériel à gérer.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <rect x="11" y="9" width="13" height="23" rx="2.6"></rect>
                      <line
                        x1="15.5"
                        y1="28.3"
                        x2="19.5"
                        y2="28.3"
                        opacity="0.55"></line>
                      <path d="M27.5 13.5 a7.5 7.5 0 0 1 0 13" opacity="0.5"
                      ></path>
                      <path d="M27 17.6 a3.6 3.6 0 0 1 0 4.8" opacity="0.7"
                      ></path>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Téléphonie mobile</h3>
                <p class="prest-item-desc">
                  Forfaits mobiles multi-opérateurs et convergence fixe-mobile
                  pour toutes vos équipes.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <circle cx="20" cy="20" r="6.4"></circle>
                      <circle
                        cx="20"
                        cy="20"
                        r="2.3"
                        fill="currentColor"
                        stroke="none"
                        opacity="0.55"></circle>
                      <g opacity="0.7">
                        <line x1="20" y1="6.2" x2="20" y2="10.4"></line>
                        <line x1="20" y1="29.6" x2="20" y2="33.8"></line>
                        <line x1="6.2" y1="20" x2="10.4" y2="20"></line>
                        <line x1="29.6" y1="20" x2="33.8" y2="20"></line>
                        <line x1="10.3" y1="10.3" x2="13.3" y2="13.3"></line>
                        <line x1="26.7" y1="26.7" x2="29.7" y2="29.7"></line>
                        <line x1="29.7" y1="10.3" x2="26.7" y2="13.3"></line>
                        <line x1="13.3" y1="26.7" x2="10.3" y2="29.7"></line>
                      </g>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Maintenance</h3>
                <p class="prest-item-desc">
                  Maintenance préventive et dépannage de toutes vos solutions
                  télécom.
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     SECTION DIVIDER — Compétences → Méthode (hairline monochrome)
     ================================ -->
      <div class="section-divider" aria-hidden="true">
        <div class="container">
          <span class="section-divider-line"></span>
        </div>
      </div>

      <!-- ================================
     PROCESS — Étapes (épuré, sans détails techniques)
     ================================ -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="section-head reveal">
            <h2 class="section-title" id="process-title">
              Quatre étapes, <span class="accent">un seul interlocuteur</span>.
              <span class="text-muted"
                >De la première visite à la supervision de votre réseau au
                quotidien.</span
              >
            </h2>
          </div>

          <div class="pf-vflow reveal">
            <!-- ====== SVG Ligne de transmission : fibre horizontale + 4 nœuds-relais ====== -->
            <svg
              class="pf-vsvg"
              viewBox="0 0 900 240"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              preserveAspectRatio="xMidYMid meet"
            >
              <defs>
                <filter
                  id="pf-glow"
                  x="-50%"
                  y="-50%"
                  width="200%"
                  height="200%"
                >
                  <feGaussianBlur
                    in="SourceGraphic"
                    stdDeviation="3.5"
                    result="blur"></feGaussianBlur>
                  <feMerge>
                    <feMergeNode in="blur"></feMergeNode>
                    <feMergeNode in="SourceGraphic"></feMergeNode>
                  </feMerge>
                </filter>
                <radialGradient id="pf-hub-aura" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#8D2C87" stop-opacity="0.20"
                  ></stop>
                  <stop offset="60%" stop-color="#8D2C87" stop-opacity="0.05"
                  ></stop>
                  <stop offset="100%" stop-color="#8D2C87" stop-opacity="0"
                  ></stop>
                </radialGradient>
                <linearGradient
                  id="pf-fiber-grad"
                  x1="46"
                  y1="0"
                  x2="854"
                  y2="0"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop offset="0" stop-color="#D2A8CE"></stop>
                  <stop offset="0.36" stop-color="#BB80B6"></stop>
                  <stop offset="0.66" stop-color="#A1539B"></stop>
                  <stop offset="1" stop-color="#8D2C87"></stop>
                </linearGradient>
              </defs>

              <!-- Aura origine (statique, subtile) — centrée sur le nœud émetteur de l'étape 01 -->
              <circle cx="106" cy="78" r="50" fill="url(#pf-hub-aura)"></circle>

              <!-- Labels extrémités : émetteur → récepteur -->
              <g class="pf-anim-node" style="--d: 0.15s">
                <text
                  x="20"
                  y="32"
                  font-family="JetBrains Mono, ui-monospace, monospace"
                  font-size="9.5"
                  fill="rgba(255,255,255,0.42)"
                  letter-spacing="3.5">VOS SITES</text
                >
              </g>
              <g class="pf-anim-node" style="--d: 1.1s">
                <text
                  x="880"
                  y="32"
                  text-anchor="end"
                  font-family="JetBrains Mono, ui-monospace, monospace"
                  font-size="9.5"
                  fill="rgba(255,255,255,0.42)"
                  letter-spacing="3.5">RÉSEAU SUPERVISÉ</text
                >
              </g>

              <!-- Halo flou sous la fibre -->
              <path
                class="pf-fiber-glow"
                d="M 106,78 L 838,78"
                stroke="url(#pf-fiber-grad)"
                stroke-width="6"
                stroke-linecap="round"
                filter="url(#pf-glow)"></path>

              <!-- Tracé fibre : dessin progressif gauche → droite -->
              <path
                class="pf-draw"
                style="--d: 0s"
                d="M 106,78 L 838,78"
                pathLength="100"
                stroke="url(#pf-fiber-grad)"
                stroke-width="1.6"
                stroke-linecap="round"></path>

              <!-- Connecteurs verticaux : nœud-relais → carte.
             Longueurs croissantes (étape 01 la plus longue) : chaque
             connecteur descend jusqu'au sommet réel de sa carte décalée
             en marches — disposition « barres de signal réseau ». -->
              <path
                class="pf-draw"
                style="--d: 0.45s"
                d="M 106,102 L 106,312"
                pathLength="100"
                stroke="#D2A8CE"
                stroke-width="1.4"
                stroke-linecap="round"></path>
              <path
                class="pf-draw"
                style="--d: 0.6s"
                d="M 335,95 L 335,288"
                pathLength="100"
                stroke="#BB80B6"
                stroke-width="1.4"
                stroke-linecap="round"></path>
              <path
                class="pf-draw"
                style="--d: 0.75s"
                d="M 564,95 L 564,264"
                pathLength="100"
                stroke="#A1539B"
                stroke-width="1.4"
