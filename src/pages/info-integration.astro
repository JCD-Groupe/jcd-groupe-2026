                        stroke="rgba(79,201,226,0.55)"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        transform="translate(271.7 48.3) rotate(45)"></path>
                      <path
                        class="lc-chev"
                        d="M-5 -3.5 L2 0 L-5 3.5"
                        stroke="rgba(79,201,226,0.55)"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        transform="translate(271.7 271.7) rotate(135)"></path>
                      <path
                        class="lc-chev"
                        d="M-5 -3.5 L2 0 L-5 3.5"
                        stroke="rgba(79,201,226,0.55)"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        transform="translate(48.3 271.7) rotate(225)"></path>
                      <path
                        class="lc-chev"
                        d="M-5 -3.5 L2 0 L-5 3.5"
                        stroke="rgba(79,201,226,0.40)"
                        stroke-width="1.4"
