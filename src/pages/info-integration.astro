                  </svg>
                </div>
                <div class="station-tag">
                  <h3>{info_integration.processus[0]?.titre}</h3>
                  <p>{info_integration.processus[0]?.description}</p>
                </div>
              </div>

              <div class="station">
                <div class="station-art" aria-hidden="true">
                  <svg viewBox="0 0 132 142" fill="none">
                    <ellipse
