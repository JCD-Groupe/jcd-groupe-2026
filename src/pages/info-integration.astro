                    <path
                      class="st-build"
                      d="M32 106 L100 106 L106.5 114.6 Q107.5 117 104.5 117 L27.5 117 Q24.5 117 25.5 114.6 Z"
                      stroke="currentColor"
                      stroke-width="1.4"
                      pathLength="120"
                      stroke-dasharray="3 3"
