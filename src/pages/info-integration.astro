                      stroke-width="1.4"></rect>
                    <path
                      d="M50 78 H82 M50 86 H71"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linecap="round"
                      opacity="0.45"></path>
                    <path
                      d="M32 106 L100 106 L106.5 114.6 Q107.5 117 104.5 117 L27.5 117 Q24.5 117 25.5 114.6 Z"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linejoin="round"></path>
                    <path
                      d="M58 112.5 H74"
                      stroke="currentColor"
                      stroke-width="1"
                      stroke-linecap="round"
                      opacity="0.30"></path>
                  </svg>
                </div>
                <div class="station-tag">
                  <h3>{info_integration.processus[1]?.titre}</h3>
                  <p>{info_integration.processus[1]?.description}</p>
                </div>
              </div>

              <div class="station">
                <div class="station-art" aria-hidden="true">
                  <svg viewBox="0 0 132 142" fill="none">
                    <ellipse
                      cx="66"
                      cy="123"
                      rx="36"
                      ry="3"
                      fill="rgba(0,0,0,0.42)"></ellipse>
                    <path
                      d="M24 120 H108"
                      stroke="rgba(255,255,255,0.15)"
                      stroke-width="1.5"
                      stroke-linecap="round"></path>
                    <rect
                      x="40"
                      y="63"
                      width="52"
                      height="43"
                      rx="4.5"
                      stroke="currentColor"
                      stroke-width="1.4"></rect>
                    <path
                      class="st-trace"
