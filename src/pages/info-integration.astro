                      cy="160"
                      r="158"
                      stroke="url(#lcArc)"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-dasharray="740 253"
                      transform="rotate(-90 160 160)"></circle>
                    <g class="lc-chevrons">
                      <path
                        class="lc-chev"
