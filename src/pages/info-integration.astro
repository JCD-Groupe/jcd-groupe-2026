                        stroke-linejoin="round"
                        transform="translate(48.3 48.3) rotate(315)"></path>
                    </g>
                  </svg>
                </div>
                <div class="cycle-core">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                      d="M12 3 L19 5.8 V11 c0 4.6-3.1 7.8-7 9-3.9-1.2-7-4.4-7-9 V5.8 Z"
                    ></path><path d="M8.8 11.4 l2.3 2.3 4.1-4.5"></path></svg
                  >
                </div>
                <span class="cycle-dot cycle-dot--1"></span>
                <span class="cycle-dot cycle-dot--2"></span>
                <span class="cycle-dot cycle-dot--3"></span>
                <span class="cycle-dot cycle-dot--4"></span>
                <span class="cycle-lab cycle-lab--1"
                  ><span class="cycle-num">01</span><b
                    >{
                      info_integration.processus_cybersecurite
                        .processus_cybersecurite_label_01
                    }</b
                  ></span
                >
                <span class="cycle-lab cycle-lab--2"
                  ><span class="cycle-num">02</span><b
                    >{
                      info_integration.processus_cybersecurite
                        .processus_cybersecurite_label_02
                    }</b
                  ></span
                >
                <span class="cycle-lab cycle-lab--3"
                  ><span class="cycle-num">03</span><b
                    >{
                      info_integration.processus_cybersecurite
                        .processus_cybersecurite_label_03
                    }</b
                  ></span
                >
                <span class="cycle-lab cycle-lab--4"
                  ><span class="cycle-num">04</span><b
                    >{
                      info_integration.processus_cybersecurite
                        .processus_cybersecurite_label_04
                    }</b
                  ></span
                >
              </div>
            </div>

            <div class="seclife-copy">
              <div class="secblock-head reveal">
                <h2
                  id="sec-title"
                  set:html={info_integration.titre_processus_cybersecurite}
                />
                <p
                  set:html={info_integration.sous_titre_processus_cybersecurite}
                />
                <a href="/informatique#cybersecurite" class="secblock-link">
                  {info_integration.bouton_processus_cybersecurite}
                  <svg
                    viewBox="0 0 16 16"
                    width="15"
                    height="15"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  >
                </a>
              </div>

              <div class="seclife-points reveal delay-1">
                {
                  info_integration.processus_cybersecurite.map((point: any) => (
                    <div class="lifepoint">
                      <div>
                        <h4>{point.titre}</h4>
                        <p>{point.description}</p>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     PROCESS
     ==================================================================== -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="sec-head reveal">
            <h2
              id="process-title"
              set:html={info_integration.titre_processus}
            />
            <p set:html={info_integration.sous_titre_processus} />
          </div>

          <div class="atelier reveal delay-1">
            <div class="atelier-belt" aria-hidden="true"></div>

            <div class="atelier-steps">
              <div class="station">
                <div class="station-art" aria-hidden="true">
                  <svg viewBox="0 0 132 142" fill="none">
                    <ellipse
                      cx="66"
