---
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let agencement = await directus.request(
  readSingleton("JCD_Agencement", {
    fields: [
      "*",
      { prestations: ["*"] },
      { processus: ["*"] },
      { definitions: ["*"] },
      { logos_confiance: ["*", { directus_files_id: ["*"] }] },
    ],
  }),
);

const fetchSvgContent = async (id: string) => {
  if (!id) return null;
  const response = await fetch(
    `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${id}`,
  );
  return response.text();
};

agencement.icone_cta_content = await fetchSvgContent(agencement.icone_cta);

agencement.prestations = await Promise.all(
  agencement.prestations.map(async (prestation: any) => ({
    ...prestation,
    icone_content: await fetchSvgContent(prestation.icone),
  })),
);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon}`}
      type="image/svg+xml"
    />
    <meta
      property="og:title"
      content={`${agencement.nom_pole} • ${global.nom_societe}`}
    />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/agencement`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={agencement.meta_title} />
    <meta property="og:description" content={agencement.meta_description} />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/agencement`}
    />
    <meta name="twitter:card" content="summary" />
    <title>{agencement.nom_pole} • {global.nom_societe}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/agencement.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/agencement-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     ==================================================================== -->
    <Header />

    <main id="contenu">
      <!-- ====================================================================
     HERO + MANIFESTO — zone épinglée : le hero reste sticky, le manifeste
     glisse par-dessus.
     ==================================================================== -->
      <div class="hero-pin-zone">
        <section class="print-hero" aria-labelledby="agc-hero-title">
          <!-- Couche 0 : fallback CSS -->
          <div class="hero-mesh-fallback" aria-hidden="true"></div>

          <!-- Couche 1 : canvas WebGL — nappe de lumière taupe -->
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>

          <!-- Couche 2 : trame plan d'architecte — discrète (papier) -->
          <div class="hero-texture hero-texture--plan" aria-hidden="true"></div>

          <!-- Couche 3 : grain -->
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1
              id="agc-hero-title"
              class="hero-title reveal delay-1"
              set:html={agencement.titre_hero}
            />

            <p class="hero-sub reveal delay-2">
              {agencement.sous_titre_hero}
            </p>

            <div class="hero-actions reveal delay-3">
              <a href="#process" class="btn-cta btn-cta--ghost">
                {agencement.bouton_hero}
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ================================
       MANIFESTO — Lignes de cote
       ================================ -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="coupe-sheet">
            <div class="coupe-light" aria-hidden="true"></div>
            <div class="container">
              <header class="mf-header">
                <span class="mf-header-side">
                  <span class="mf-caret" aria-hidden="true">&#9656;</span>
                  <span class="mf-id">PL&middot;01</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Manifeste</span>
                </span>
                <span class="mf-header-side">
                  <span>Coupe</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span class="mf-scale">Éch. 1:1</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Pôle Agencement</span>
                </span>
              </header>

              <blockquote
                class="mf-quote manifesto-rich reveal delay-1"
                id="manifesto-title"
              >
                <Fragment set:html={agencement.manifeste} />
              </blockquote>

              <div class="mf-ruler reveal delay-2">
                <span class="mf-ruler-line" aria-hidden="true"></span>
                <div class="mf-ruler-stations">
                  {
                    agencement.definitions.map(
                      (definition: any, index: number) => (
                        <div
                          class="mf-station"
                          style={`--sd:${1.35 + index * 0.15}s`}
                        >
                          <span class="mf-station-tick" aria-hidden="true" />
                          <span class="mf-station-num">0{index + 1}</span>
                          <span class="mf-station-term">{definition.nom}</span>
                          <span class="mf-station-gloss">
                            {definition.definition}
                          </span>
                        </div>
                      ),
                    )
                  }
                </div>
              </div>
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone -->

      <!-- ================================
     PRESTATIONS — Nos compétences
     ================================ -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prestations-title"
      >
        <div class="container">
          <div class="prest-layout">
            <aside class="prest-aside reveal">
              <h2
                class="prest-aside-title"
                id="prestations-title"
                set:html={agencement.titre_prestations}
              />
              <p
                class="prest-aside-sub"
                set:html={agencement.sous_titre_prestations}
              />

              <div class="prest-aside-partners">
                <div class="prest-aside-partners-head">
                  <span class="prest-aside-partners-label"
                    >{agencement.titre_confiance}</span
                  >
                  <span class="prest-aside-partners-rule" aria-hidden="true"
                  ></span>
                  <span class="prest-aside-partners-count"
                    >{agencement.nombre_confiance}</span
                  >
                </div>
                <div class="prest-aside-partners-grid">
                  {
                    agencement.logos_confiance.map((logo: any) => (
                      <div
                        class="logo-tile"
                        data-brand={logo.directus_files_id.title || ""}
                      >
                        <img
                          class="logo-tile-img"
                          loading="lazy"
                          decoding="async"
                          src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id.id}`}
                          alt={logo.directus_files_id.title || ""}
                          aria-hidden="true"
                        />
                        <span class="logo-tile-name">
                          {logo.directus_files_id.title}
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>
            </aside>

            <div class="prest-menu reveal delay-1">
              {
                agencement.prestations.map((prestation: any) => (
                  <article class="prest-item">
                    <div class="prest-item-head">
                      <span
                        class="prest-item-glyph"
                        aria-hidden="true"
                        set:html={prestation.icone_content}
                      />
                    </div>
                    <h3 class="prest-item-title">{prestation.titre}</h3>
                    <p class="prest-item-desc">{prestation.description}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     SECTION DIVIDER
     ================================ -->
      <div class="section-divider" aria-hidden="true">
        <div class="container">
          <span class="section-divider-line"></span>
        </div>
      </div>

      <!-- ================================
     PROCESS — Ligne de cote : 3 temps
     ================================ -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="section-head reveal">
            <h2 class="section-title" id="process-title">
              <span set:html={agencement.titre_processus} />
              <span class="text-muted">
                {agencement.sous_titre_processus}
              </span>
            </h2>
          </div>

          <div class="pf-vflow reveal">
            <!-- ====== SVG Ligne de cote : axe coté + 3 stations-repères ====== -->
            <svg
              class="pf-vsvg"
              viewBox="0 0 900 210"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              preserveAspectRatio="xMidYMid meet"
            >
              <defs>
                <linearGradient
                  id="pf-axis-grad"
                  x1="96"
                  y1="0"
                  x2="804"
                  y2="0"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop offset="0" stop-color="#A78D75" stop-opacity="0"></stop>
                  <stop offset="0.08" stop-color="#A78D75" stop-opacity="0.5"
                  ></stop>
                  <stop offset="0.92" stop-color="#A78D75" stop-opacity="0.5"
                  ></stop>
                  <stop offset="1" stop-color="#A78D75" stop-opacity="0"></stop>
                </linearGradient>
              </defs>

              <!-- Labels extrémités : état initial → état livré -->
              <g class="pf-anim-node" style="--d: 0.2s">
                <text
                  x="22"
                  y="36"
                  font-family="JetBrains Mono, ui-monospace, monospace"
                  font-size="9.5"
                  fill="rgba(255,255,255,0.34)"
                  letter-spacing="3.2">{agencement.processus_label_debut}</text
                >
              </g>
              <g class="pf-anim-node" style="--d: 1s">
                <text
                  x="878"
                  y="36"
                  text-anchor="end"
                  font-family="JetBrains Mono, ui-monospace, monospace"
                  font-size="9.5"
                  fill="rgba(255,255,255,0.34)"
                  letter-spacing="3.2">{agencement.processus_label_fin}</text
                >
              </g>

              <!-- Axe principal : hairline fondu aux deux extrémités, dessin progressif unique -->
              <path
                class="pf-draw"
                style="--d: 0s"
                d="M 96,86 L 804,86"
                pathLength="100"
                stroke="url(#pf-axis-grad)"
                stroke-width="1"></path>

              <!-- Connecteurs verticaux : hairlines pleines, tracé progressif station -> carte -->
              <path
                class="pf-draw"
                style="--d: 0.6s"
                d="M 150,99 L 150,203"
                pathLength="100"
                stroke="#c6ad95"
                stroke-width="1"
                stroke-opacity="0.55"
                stroke-linecap="round"></path>
              <path
                class="pf-draw"
                style="--d: 0.78s"
                d="M 450,99 L 450,203"
                pathLength="100"
                stroke="#A78D75"
                stroke-width="1"
                stroke-opacity="0.55"
                stroke-linecap="round"></path>
              <path
                class="pf-draw"
                style="--d: 0.96s"
                d="M 750,99 L 750,203"
                pathLength="100"
                stroke="#8a6e54"
                stroke-width="1"
                stroke-opacity="0.6"
                stroke-linecap="round"></path>

              <!-- Stations : anneau hairline + point, respiration autour de l'axe -->
              <g class="pf-anim-node" style="--d: 0.5s">
                <circle
                  cx="150"
                  cy="86"
                  r="7"
                  fill="#0a0a0a"
                  stroke="#c6ad95"
                  stroke-width="1"
                  stroke-opacity="0.32"></circle>
                <circle cx="150" cy="86" r="2.2" fill="#c6ad95"></circle>
              </g>
              <g class="pf-anim-node" style="--d: 0.68s">
                <circle
                  cx="450"
                  cy="86"
                  r="7"
                  fill="#0a0a0a"
                  stroke="#A78D75"
                  stroke-width="1"
                  stroke-opacity="0.34"></circle>
                <circle cx="450" cy="86" r="2.2" fill="#A78D75"></circle>
              </g>
              <g class="pf-anim-node" style="--d: 0.86s">
                <circle
                  cx="750"
                  cy="86"
                  r="7"
                  fill="#0a0a0a"
                  stroke="#8a6e54"
                  stroke-width="1"
                  stroke-opacity="0.38"></circle>
                <circle cx="750" cy="86" r="2.2" fill="#8a6e54"></circle>
              </g>

              <!-- Pads de connexion au top de chaque carte : point unique, discret -->
              <g class="pf-anim-node pf-vdot pf-vdot--1" style="--d: 1.05s">
                <circle
                  cx="150"
                  cy="210"
                  r="4.5"
                  fill="#141414"
                  stroke="#c6ad95"
                  stroke-width="1"
                  stroke-opacity="0.4"></circle>
                <circle cx="150" cy="210" r="1.6" fill="#c6ad95"></circle>
              </g>
              <g class="pf-anim-node pf-vdot pf-vdot--2" style="--d: 1.2s">
                <circle
                  cx="450"
                  cy="210"
                  r="4.5"
                  fill="#141414"
                  stroke="#A78D75"
                  stroke-width="1"
                  stroke-opacity="0.4"></circle>
                <circle cx="450" cy="210" r="1.6" fill="#A78D75"></circle>
              </g>
              <g class="pf-anim-node pf-vdot pf-vdot--3" style="--d: 1.35s">
                <circle
                  cx="750"
                  cy="210"
                  r="4.5"
                  fill="#141414"
                  stroke="#8a6e54"
                  stroke-width="1"
                  stroke-opacity="0.4"></circle>
                <circle cx="750" cy="210" r="1.6" fill="#8a6e54"></circle>
              </g>
            </svg>

            <!-- ====== 3 CARDS alignées avec les stations ====== -->
            <div class="pf-vcards">
              <article
                class="pf-vcard"
                style="--c: #c6ad95; --c-rgb: 198,173,149;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="7" y="9" width="26" height="22" rx="1.6"></rect>
                      <path
                        d="M11.5 25.5 C 16 14.5, 24 14.5, 27.5 21.5"
                        opacity="0.8"></path>
                      <path
                        d="M27.5 21.5 L24.7 20.2 M27.5 21.5 L25.9 24.3"
                        opacity="0.8"></path>
                      <circle
                        cx="11.5"
                        cy="25.5"
                        r="1.7"
                        fill="currentColor"
                        stroke="none"></circle>
                    </svg>
                  </span>
                </div><h3 class="pf-vcard-title">
                  {agencement.processus[0]?.titre}
                </h3><p class="pf-vcard-desc">
                  {agencement.processus[0]?.description}
                </p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>

              <article
                class="pf-vcard"
                style="--c: #A78D75; --c-rgb: 167,141,117;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="20" cy="9" r="2.6"></circle>
                      <path d="M20 11.6 L12 31.5"></path>
                      <path d="M20 11.6 L28 31.5"></path>
                      <path d="M14.4 25.6 a 8.5 8.5 0 0 0 11.2 0" opacity="0.5"
                      ></path>
                      <path
                        d="M12 31.5 L10.3 27.6 L13.9 28 Z"
                        fill="currentColor"
                        stroke="none"></path>
                    </svg>
                  </span>
                </div><h3 class="pf-vcard-title">
                  {agencement.processus[1]?.titre}
                </h3><p class="pf-vcard-desc">
                  {agencement.processus[1]?.description}
                </p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>

              <article
                class="pf-vcard"
                style="--c: #8a6e54; --c-rgb: 138,110,84;"
              >
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="14" cy="15" r="6.2"></circle>
                      <circle
                        cx="14"
                        cy="15"
                        r="2"
                        fill="currentColor"
                        stroke="none"
                        opacity="0.7"></circle>
                      <path d="M18.4 19.4 L30.5 31.5"></path>
                      <path d="M25.5 26.5 L28.6 23.4 M28.6 31.6 L31.7 28.5"
                      ></path>
                    </svg>
                  </span>
                </div><h3 class="pf-vcard-title">
                  {agencement.processus[2]?.titre}
                </h3><p class="pf-vcard-desc">
                  {agencement.processus[2]?.description}
                </p>
                <div class="pf-vcard-fade" aria-hidden="true"></div>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     CTA — Bandeau compact, logo-icône Agencement (plan)
     ================================ -->
      <section class="cta-section" id="contact" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-frame">
            <div class="cta-inner">
              <span
                class="cta-icon"
                aria-hidden="true"
                set:html={agencement.icone_cta_content}
              />

              <div class="cta-body">
                <h2
                  class="cta-title reveal delay-1"
                  id="cta-title"
                  set:html={agencement.titre_cta}
                />

                <p
                  class="cta-sub reveal delay-2"
                  set:html={agencement.sous_titre_cta}
                />

                <div class="cta-actions reveal delay-3">
                  <a
                    href="/contact?pole=agencement&step=2"
                    class="btn-cta btn-cta--primary"
                  >
                    {agencement.bouton_cta}
                    <span class="btn-cta-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </a>
                  <span class="cta-actions-divider" aria-hidden="true"></span>
                  <span class="cta-phone">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      width="14"
                      height="14"
                      ><path
                        d="M2 3a1 1 0 011-1h3.28a1 1 0 01.95.68l1.07 3.21a1 1 0 01-.25 1L6.54 8.4a12.06 12.06 0 005.06 5.06l1.51-1.51a1 1 0 011-.25l3.21 1.07a1 1 0 01.68.95V17a1 1 0 01-1 1A15 15 0 012 3z"
                      ></path></svg
                    >
                    <a href="tel:+33387184920" class="cta-phone-num"
                      >03 87 18 49 20</a
                    >
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ================================
     FOOTER
     ================================ -->
    <Footer />

    <!-- ================================
     SCRIPTS
     ================================ -->
    <script is:inline src="/js/pages/agencement-1.js"></script>
    <script is:inline src="/js/shared/menu-frost.js"></script>
    <!-- jcd-a11y (Lot 5) -->
    <div class="jcd-fab-wrap" id="jcd-fab">
      <button
        class="jcd-fab jcd-fab--top"
        id="jcdToTop"
        type="button"
        aria-label="Remonter en haut"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M10 16V5M5 10l5-5 5 5"></path></svg
        >
      </button>
      <a
        class="jcd-fab jcd-fab--contact"
        id="jcdFabContact"
        href="/contact"
        aria-label="Nous contacter"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2.5" y="4.5" width="15" height="11" rx="2.3"></rect><path
            d="M3 6.7 L10 10.7 L17 6.7"></path></svg
        >
      </a>
    </div>
    <script is:inline src="/js/shared/a11y.js" id="jcd-a11y-js"></script>
    <script is:inline src="/js/shared/micons.js" id="jcd-micons-js"></script>
    <script is:inline src="/js/shared/mrefonte.js" id="jcd-mrefonte-js"
    ></script>
  </body>
</html>
