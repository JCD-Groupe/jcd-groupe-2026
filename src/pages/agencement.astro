      // Process flow — déclenche l'animation au scroll
      (function setupProcessFlow() {
        var flow = document.querySelector(".pf-vflow");
        if (!flow) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          flow.classList.add("visible");
