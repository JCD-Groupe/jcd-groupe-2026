---
import { readItems, readSingleton } from "@directus/sdk";
import Footer from "../../../../components/Footer.astro";
import Header from "../../../../components/Header.astro";
import { directus } from "../../../../lib/directus";
import { fetchSvgContent, hexToRgbChannels } from "../../../../utils/formatters";

export async function getStaticPaths() {
  const formations = await directus.request(
    readItems("formations", {
      limit: -1,
      fields: [
        "*",
        { thematique: ["*"] },
        { objectifs: ["*"] },
        { validation: ["*"] },
      ],
    }),
  );

  return formations.map((formation) => ({
    params: {
      thematique: formation.thematique.slug,
      formation: formation.slug,
    },
    props: { data: formation },
  }));
}

let formation = Astro.props.data;

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*", {
      adresses: ["*"]
    }],
  }),
);

let formations_commun = await directus.request(
  readSingleton("formations_commun", {
    fields: ["*"],
  }),
);

let pageFormation = await directus.request(
  readSingleton("JCD_Formation", {
    fields: ["*"],
  }),
);

pageFormation.icone_cta_content = await fetchSvgContent(
  pageFormation.icone_cta,
);

formation.thematique.couleur_rgb = hexToRgbChannels(formation.thematique.couleur);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon_claire}`}
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon_sombre}`}
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="description"
      content={`Fiche formation ${global.nom_societe} · ${formation.titre_de_la_formation} : ${formation.objectifs.map((objectif :any) => (objectif.objectif)).join(' ')}`}
    />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/formations/${formation.slug}`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content={`${formation.titre_de_la_formation} · ${global.nom_societe}`}
    />
    <meta
      property="og:description"
      content={`Fiche formation ${global.nom_societe} · ${formation.titre_de_la_formation} : ${formation.objectifs.map((objectif :any) => (objectif.objectif)).join(' ')}`}
    />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/formation-detail`}
    />
    <meta name="twitter:card" content="summary" />
    <title>{formation.titre_de_la_formation} · {global.nom_societe}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@1&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/formation-detail.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/formation-detail-overrides.css" />
    <link rel="stylesheet" href="/css/formation-detail-print.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/mpolish.js" id="jcd-mpolish-js"></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body style={`--cat: ${formation.thematique.couleur_rgb};`}>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <div class="scroll-progress" aria-hidden="true"></div>

    <Header catalogue />

    <main id="contenu">
      <!-- ================================
     HERO — fiche formation
     (zones data-field : à câbler sur Directus)
     ================================ -->
      <section class="fd-hero" aria-labelledby="fd-title">
        <div class="container">
          <nav class="crumbs reveal" aria-label="Fil d'Ariane">
            <a href="/formation">Formation</a>
            <span class="crumbs-sep" aria-hidden="true">/</span>
            <a
              href={`/formations/${formation.thematique.slug}`}
              id="fd-crumb-cat"
              data-field="categorie"
              >{formation.thematique.titre_de_la_thematique_de_formations}</a
            >
            <span class="crumbs-sep" aria-hidden="true">/</span>
            <span aria-current="page" data-field="title"
              >{formation.titre_de_la_formation}</span
            >
          </nav>

          <h1 class="fd-title reveal delay-1" id="fd-title">
            <span data-field="title">{formation.titre_de_la_formation}</span
            ><span class="cat-dot">.</span>
          </h1>

          <div class="fd-hero-meta reveal delay-2">
            <span class="chip chip--cat" data-field="categorie"
              >{formation.thematique.titre_de_la_thematique_de_formations}</span
            >
            {
              (formation.duree_en_jours || formation.duree_en_heures) && (
                <span class="chip">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 7v5l3 2" />
                  </svg>
                  <span data-field="duree">
                    {formation.duree_en_jours &&
                      `${formation.duree_en_jours} jour${formation.duree_en_jours >= 2 ? "s" : ""}`}
                    {formation.duree_en_jours &&
                      formation.duree_en_heures &&
                      " · "}
                    {formation.duree_en_heures &&
                      `${formation.duree_en_heures} heure${formation.duree_en_heures >= 2 ? "s" : ""}`}
                  </span>
                </span>
              )
            }
            {
              formation.tarif_par_participant ? (
                <span class="chip">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <>
                      <circle cx="12" cy="12" r="9" />
                      <path d="M14.8 9.2a3 3 0 0 0-5.6 1.3c0 3 5.6 2 5.6 5a3 3 0 0 1-5.6 1.3M12 6v2M12 16v2" />
                    </>
                  </svg>
                  <strong data-field="tarif">
                    {formation.tarif_par_participant}&nbsp;€&nbsp;HT
                  </strong>
                  &nbsp;/ participant
                </span>
              ) : (
                <span class="chip">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <>
                      <circle cx="12" cy="12" r="9" />
                      <path d="M14.8 9.2a3 3 0 0 0-5.6 1.3c0 3 5.6 2 5.6 5a3 3 0 0 1-5.6 1.3M12 6v2M12 16v2" />
                    </>
                  </svg>
                  Tarification sur mesure
                </span>
              )
            }
            <span class="chip" data-tosa>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                ><path d="M12 3l8 3v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3z"
                ></path><path d="M9 11.5l2 2 4-4"></path></svg
              >
              Attestation de stage{
                formation.certification_tosa ?
                  " · Certification TOSA en option" :
                  formation.certification_sur_demande && ' · Certification possible sur demande'
              }
            </span>
            { formation.pastille &&
              <span class="chip" data-tosa>
                {formation.pastille == 'les-essentiels' ? 'Les essentiels' : formation.pastille == 'innovant' ? 'Innovant' : ''}
              </span>
            }
          </div>
        </div>
      </section>

      <!-- ================================
     CORPS — contenu + récapitulatif sticky
     ================================ -->
      <section class="fd-body" aria-label="Détail de la formation">
        <div class="container">
          <div class="fd-layout">
            <div class="fd-main">
              <!-- Objectifs pédagogiques -->
              <section
                id="fd-s-objectifs"
                aria-labelledby="fd-goals-title"
                data-field="objectifs"
              >
                <div class="fd-section-head reveal">
                  <span class="fd-section-num">01</span>
                  <div>
                    <h2 class="fd-section-title" id="fd-goals-title">
                      Objectifs pédagogiques
                    </h2>
                    <p class="fd-section-sub">
                      À l'issue de la formation, vous serez capable de :
                    </p>
                  </div>
                </div>
                <ul class="fd-goals reveal delay-1">
                  {
                    formation.objectifs.map((objectif: any) => (
                      <li class="fd-goal">
                        <span class="fd-goal-ic" aria-hidden="true">
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M5 12.5l4.5 4.5L19 7.5" />
                          </svg>
                        </span>
                        {objectif.objectif}
                      </li>
                    ))
                  }
                </ul>
              </section>

              <!-- Programme -->
              <section
                id="fd-s-programme"
                aria-labelledby="fd-prog-title"
                data-field="programme"
              >
                <div class="fd-section-head fd-section-head--prog reveal">
                  <span class="fd-section-num">02</span>
                  <div>
                    <h2 class="fd-section-title" id="fd-prog-title">
                      Programme détaillé
                    </h2>
                  </div>
                  <button
                    type="button"
                    class="fd-expand"
                    id="fd-expand"
                    data-open="false"
                    aria-label="Déplier tous les modules du programme"
                  >
                    <span class="fd-expand-tx">Tout déplier</span>
                    <svg
                      viewBox="0 0 10 10"
                      fill="none"
                      aria-hidden="true"
                      focusable="false"
                      ><path
                        d="M2.5 4l2.5 2.5L7.5 4"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path></svg
                    >
                  </button>
                </div>
                <div class="fd-acc reveal delay-1">
                  {
                    formation.programme.map((ligne: any, index: number) => {
                      let detail = ligne.detail.replace(
                        "<ul>",
                        '<ul class="fd-mod-list">',
                      );
                      return (
                        <article
                          class="fd-mod"
                          data-open={index == 0 ? true : false}
                        >
                          <button
                            type="button"
                            class="fd-mod-btn"
                            aria-expanded={index == 0 ? true : false}
                          >
                            <span class="fd-mod-num">
                              {index + 1 < 10 ? "0" : ""}
                              {index + 1}
                            </span>
                            <span class="fd-mod-title">{ligne.titre}</span>
                            <span class="fd-mod-chev" aria-hidden="true">
                              <svg viewBox="0 0 10 10" fill="none">
                                <path
                                  d="M2.5 4l2.5 2.5L7.5 4"
                                  stroke="currentColor"
                                  stroke-width="1.4"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            </span>
                          </button>
                          <div class="fd-mod-body">
                            <div class="fd-mod-wrap">
                              <Fragment set:html={detail} />
                            </div>
                          </div>
                        </article>
                      );
                    })
                  }
                </div>
              </section>

              <!-- Public & prérequis -->
              <section id="fd-s-public" aria-labelledby="fd-pub-title">
                <div class="fd-section-head reveal">
                  <span class="fd-section-num">03</span>
                  <h2 class="fd-section-title" id="fd-pub-title">
                    Public visé &amp; prérequis
                  </h2>
                </div>
                <div class="fd-cards reveal delay-1">
                  <div class="fd-card" data-field="public">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><circle cx="9" cy="8" r="3.2"></circle><path
                            d="M3 19c0-3 2.7-5 6-5s6 2 6 5"></path><circle
                            cx="17"
                            cy="9.5"
                            r="2.4"></circle><path
                            d="M14.5 19c.2-2.2 1.8-4 4-4s3.5 1.5 3.5 3.5"
                          ></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Public visé</h3>
                    </div>
                    <p class="fd-card-tx">
                      {formation.public}
                    </p>
                  </div>
                  <div class="fd-card" data-field="prerequis">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path
                            d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"
                          ></path><rect x="9" y="3" width="6" height="4" rx="1"
                          ></rect><path d="M9 13l2 2 4-4"></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Prérequis</h3>
                    </div>
                    <p class="fd-card-tx">
                      {formation.prerequis ?? formations_commun.prerequis}
                    </p>
                  </div>
                </div>
              </section>

              <!-- Modalités -->
              <section id="fd-s-modalites" aria-labelledby="fd-mod-title2">
                <div class="fd-section-head reveal">
                  <span class="fd-section-num">04</span>
                  <h2 class="fd-section-title" id="fd-mod-title2">
                    Modalités &amp; encadrement
                  </h2>
                </div>
                <div class="fd-cards reveal delay-1">
                  <div class="fd-card" data-field="modalites_pedagogiques">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M22 10 12 5 2 10l10 5 10-5z"></path><path
                            d="M6 12v5c2 2 4 3 6 3s4-1 6-3v-5"></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Modalités pédagogiques</h3>
                    </div>
                    <p class="fd-card-tx">
                      {formation.methodes_pedagogiques}
                    </p>
                  </div>
                  <div class="fd-card" data-field="modalites_evaluation">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M9 11l3 3 8-8"></path><path
                            d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"
                          ></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Modalités d'évaluation</h3>
                    </div>
                    <p class="fd-card-tx">
                      {
                        formation.suivi_et_evaluation_de_l_action ??
                          formations_commun.suivi_et_evaluation_de_l_action
                      }
                    </p>
                  </div>
                  <div class="fd-card" data-field="intervenant">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><circle cx="12" cy="8" r="3.4"></circle><path
                            d="M5 20c0-3.3 3.1-5.5 7-5.5s7 2.2 7 5.5"
                          ></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Profil intervenant</h3>
                    </div>
                    <p class="fd-card-tx">
                      {
                        formation.profils_intervenants ??
                          formation.thematique.profils_intervenants
                      }
                    </p>
                  </div>
                  <div class="fd-card" data-field="accessibilite">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><circle cx="12" cy="5" r="2"></circle><path
                            d="M12 7v6l4 1.5M12 13l-4 1.5"></path><path
                            d="M6.5 17.5a6 6 0 0 0 11 0"></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Accessibilité handicap</h3>
                    </div>
                    <p class="fd-card-tx">
                      La formation est accessible aux personnes à mobilité
                      réduite et toute demande d’adaptation peut être étudiée en
                      amont de la formation en fonction du besoin des personnes.
                      Nous contacter pour plus d’informations.
                    </p>
                  </div>
                </div>
              </section>

              <!-- Tarifs — INTER / INTRA sur-mesure -->
              <section id="fd-s-tarifs" aria-labelledby="fd-tarifs-title">
                <div class="fd-section-head reveal">
                  <span class="fd-section-num">05</span>
                  <h2 class="fd-section-title" id="fd-tarifs-title">
                    Tarifs &amp; modalités d'inscription
                  </h2>
                </div>
                <div class="fd-tarifs reveal delay-1">
                  <div class="fd-tarif" data-mode="inter">
                    <div class="fd-tarif-head">
                      <span class="fd-tarif-tag">Inter-entreprises</span>
                      {
                        (formation.duree_en_jours ||
                          formation.duree_en_heures) && (
                          <span class="fd-tarif-dur" data-field="duree">
                            {formation.duree_en_jours &&
                              `${formation.duree_en_jours} jour${formation.duree_en_jours >= 2 ? "s" : ""}`}
                            {formation.duree_en_jours &&
                              formation.duree_en_heures &&
                              " · "}
                            {formation.duree_en_heures &&
                              `${formation.duree_en_heures} heure${formation.duree_en_heures >= 2 ? "s" : ""}`}
                          </span>
                        )
                      }
                    </div>
                    {
                      formation.tarif_par_participant ? (
                        <p class="fd-tarif-price">
                          <strong data-field="tarif">
                            {formation.tarif_par_participant}&nbsp;€&nbsp;HT
                          </strong>
                          <small>/ participant</small>
                        </p>
                      ) : (
                        <p class="fd-tarif-price">
                          <strong data-field="tarif">Tarif sur mesure</strong>
                        </p>
                      )
                    }
                    <p class="fd-tarif-tx">
                      Session ouverte en petit groupe, dans nos centres de Metz
                      ou à distance. Support pédagogique et évaluation des
                      acquis inclus.
                    </p>
                    <a
                      class="fd-tarif-cta fd-tarif-cta--solid"
                      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${pageFormation.bulletin_d_inscription}?download`}
                      download="formulaire-inscription-jcd.pdf"
                      >Télécharger le formulaire d'inscription</a
                    >
                  </div>
                  <div class="fd-tarif" data-mode="intra">
                    <div class="fd-tarif-head">
                      <span class="fd-tarif-tag">Intra &amp; sur-mesure</span>
                      <span class="fd-tarif-dur">Durée adaptée</span>
                    </div>
                    <p class="fd-tarif-price"><strong>Sur devis</strong></p>
                    <p class="fd-tarif-tx">
                      Formation dans vos locaux, dans nos centres ou à distance.
                      Programme, rythme et cas pratiques co-construits à partir
                      de votre contexte métier.
                    </p>
                    <a
                      class="fd-tarif-cta"
                      href="/contact?pole=formation&step=2">Demander un devis</a
                    >
                  </div>
                </div>
              </section>

              <!-- Certification -->
              <section
                id="fd-s-certif"
                aria-label="Certification"
                data-field="certification"
                data-tosa
              >
                <div class="fd-certif reveal">
                  <span class="fd-certif-ic" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><circle cx="12" cy="9" r="6"></circle><path
                        d="M8.5 14 7 22l5-2.5L17 22l-1.5-8"></path><path
                        d="M9.7 9l1.6 1.6L14.5 7.4"></path></svg
                    >
                  </span>
                  <div class="fd-certif-tx">
                    <h2 class="fd-certif-title">
                      Attestation de stage {
                        formation.certification_tosa ?
                          " · Certification TOSA en option"
                          : formation.certification_sur_demande && ' · Certification possible sur demande'
                      }
                    </h2>
                    {
                      formation.certification_tosa && (
                        <p class="fd-certif-sub">
                          Validez officiellement votre niveau à l'issue du stage
                          : JCD Formation est centre d'examen TOSA agréé. Score
                          reconnu par les entreprises, éligible aux
                          financements.
                        </p>
                      )
                    }
                  </div>
                </div>
              </section>
            </div>

            <!-- Récapitulatif sticky -->
            <aside
              class="fd-aside reveal delay-2"
              aria-label="Informations pratiques"
            >
              <div class="fd-aside-shell">
                <div class="fd-aside-core">
                  <nav class="fd-toc" aria-label="Sommaire de la fiche">
                    <a
                      href="#fd-s-objectifs"
                      class="fd-toc-item"
                      data-spy="fd-s-objectifs"
                      ><span class="fd-toc-n">01</span>Objectifs</a
                    >
                    <a
                      href="#fd-s-programme"
                      class="fd-toc-item"
                      data-spy="fd-s-programme"
