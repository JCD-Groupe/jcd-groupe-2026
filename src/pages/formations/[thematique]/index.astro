---
import { readItems, readSingleton } from "@directus/sdk";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import { directus } from "../../../lib/directus";

export async function getStaticPaths() {
  const thematiques = await directus.request(
    readItems("thematiques_formation"),
  );

  return thematiques.map((thematique) => ({
    params: { thematique: thematique.slug },
    props: { data: thematique },
  }));
}

let thematique = Astro.props.data;

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let formations = await directus.request(
  readItems("formations", {
    fields: ["*", { thematique: ["slug"] }],
    filter: {
      _or: [
        {
          thematique: {
            slug: {
              _eq: thematique.slug,
            },
          },
        },
        {
          thematiques_secondaires: {
            thematiques_formation_id: {
              slug: {
                _eq: thematique.slug,
              },
            },
          },
        },
      ],
    },
  }),
);

let thematiques = await directus.request(
  readItems("thematiques_formation", {
    fields: ["*", { formations: ["id"] }, { formations_bis: ["id"] }],
    filter: {
      slug: {
        _neq: thematique.slug,
      },
    },
  }),
);

let formation = await directus.request(
  readSingleton("JCD_Formation", {
    fields: ["*"],
  }),
);

const fetchSvgContent = async (id: string) => {
  if (!id) return null;
  const response = await fetch(
    `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${id}`,
  );
  return response.text();
};

function hexToRgbChannels(hex: string) {
  if (!hex) return "0, 0, 0";
  let cleanHex = hex.replace("#", "");
  if (cleanHex.length === 3) {
    cleanHex = cleanHex
      .split("")
      .map((c) => c + c)
      .join("");
  }
  const num = parseInt(cleanHex, 16);
  return `${(num >> 16) & 255}, ${(num >> 8) & 255}, ${num & 255}`;
}

formation.icone_cta_content = await fetchSvgContent(formation.icone_cta);

thematique.couleur_rgb = hexToRgbChannels(thematique.couleur);
