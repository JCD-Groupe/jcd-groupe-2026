---
import { readItems, readSingleton } from "@directus/sdk";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import { directus } from "../../../lib/directus";
import { fetchSvgContent, hexToRgbChannels } from "../../../utils/formatters";

export async function getStaticPaths() {
  const thematiques = await directus.request(
    readItems("thematiques_formation"),
  );

  return thematiques.map((thematique) => ({
    params: { thematique: thematique.slug },
    props: { data: thematique },
  }));
}

let thematique = Astro.props.data;

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let formations = await directus.request(
  readItems("formations", {
    fields: ["*", { thematique: ["slug"] }],
    filter: {
      _or: [
        {
          thematique: {
            slug: {
              _eq: thematique.slug,
            },
          },
        },
        {
          thematiques_secondaires: {
            thematiques_formation_id: {
              slug: {
                _eq: thematique.slug,
              },
            },
          },
        },
      ],
    },
  }),
);

let thematiques = await directus.request(
  readItems("thematiques_formation", {
    fields: ["*"],
    filter: {
      slug: {
        _neq: thematique.slug,
      },
    },
  }),
);

let formation = await directus.request(
  readSingleton("JCD_Formation", {
    fields: ["*"],
  }),
);

formation.icone_cta_content = await fetchSvgContent(formation.icone_cta);

thematique.couleur_rgb = hexToRgbChannels(thematique.couleur);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon_claire}`}
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon_sombre}`}
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="description"
      content={`Formations Administratif - Secrétariat - Accueil · ${
        thematique.formations.length + thematique.formations_bis.length
      } formations · ${formation.meta_description}`}
    />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/formations/${thematique.slug}`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content={`${thematique.titre_de_la_thematique_de_formations} · Catalogue des formations · ${global.nom_societe}`}
    />
    <meta
      property="og:description"
      content={`Formations Administratif - Secrétariat - Accueil · ${
        thematique.formations.length + thematique.formations_bis.length
      } formations · ${formation.meta_description}`}
    />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/formations/${thematique.slug}`}
    />
    <meta name="twitter:card" content="summary" />
    <title>
      {thematique.titre_de_la_thematique_de_formations} · Catalogue des formations
      · {global.nom_societe}
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@1&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/thematique-formation.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/thematique-formation-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/mpolish.js" id="jcd-mpolish-js"></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body style={`--cat: ${thematique.couleur_rgb};`}>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <div class="scroll-progress" aria-hidden="true"></div>

    <Header catalogue />

    <main id="contenu">
      <!-- ================================
     HERO — catégorie du catalogue
     ================================ -->
      <section class="cat-hero" aria-labelledby="cat-hero-title">
        <div class="cat-hero-stars" aria-hidden="true">
          <i style="left:64%;top:18%;animation-delay:-1.2s"></i>
          <i style="left:78%;top:34%;animation-delay:-3.4s"></i>
          <i style="left:88%;top:14%;animation-delay:-2.1s"></i>
          <i style="left:71%;top:52%;animation-delay:-4.6s"></i>
          <i style="left:93%;top:44%;animation-delay:-0.8s"></i>
          <i style="left:82%;top:62%;animation-delay:-5.5s"></i>
          <i style="left:58%;top:38%;animation-delay:-2.9s"></i>
        </div>
        <div class="container">
          <nav class="crumbs reveal" aria-label="Fil d'Ariane">
            <a href="/formation">Formation</a>
            <span class="crumbs-sep" aria-hidden="true">/</span>
            <span>Catalogue</span>
            <span class="crumbs-sep" aria-hidden="true">/</span>
            <span aria-current="page"
              >{thematique.titre_de_la_thematique_de_formations}</span
            >
          </nav>

          <h1 class="cat-hero-title reveal delay-1" id="cat-hero-title">
            {thematique.titre_de_la_thematique_de_formations}<span
              class="cat-dot">.</span
            >
          </h1>

          <p class="cat-hero-sub reveal delay-2">
            {thematique.description}
          </p>

          <div class="cat-hero-actions reveal delay-3">
            <a href="#liste" class="btn-cta btn-cta--primary">
              Choisir une formation
              <span class="btn-cta-arrow"
                ><svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                ></span
              >
            </a>
            <a
              href="/contact?pole=formation&step=2"
              class="btn-cta btn-cta--ghost">Être conseillé</a
            >
          </div>
        </div>
      </section>

      <!-- ================================
     LISTE — formations de la catégorie
     (recherche + filtres de niveau in-page)
     ================================ -->
      <section
        class="cat-list"
        id="liste"
        aria-label="Catalogue des formations"
      >
        <div class="container">
          <div class="cat-toolbar reveal delay-1" id="cat-toolbar">
            <div class="cat-toolbar-shell">
              <div class="ct-search">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                  ><circle cx="11" cy="11" r="7"></circle><path
                    d="m21 21-4.3-4.3"></path></svg
                >
                <input
                  type="search"
                  class="ct-input"
                  id="ct-search"
                  placeholder="Filtrer ces formations…"
                  autocomplete="off"
                  spellcheck="false"
                  aria-label="Filtrer les formations de la catégorie"
                />
                <kbd class="ct-kbd" aria-hidden="true">/</kbd>
              </div>
              <div
                class="ct-levels"
                role="group"
                aria-label="Filtrer par niveau"
                id="ct-levels"
              >
                <button
                  type="button"
                  class="ct-level"
                  data-level="all"
                  aria-pressed="true">Tous</button
                >
                <button
                  type="button"
                  class="ct-level"
                  data-level="initiation"
                  aria-pressed="false"
                  >Initiation <span class="ct-level-n"></span></button
                >
                <button
                  type="button"
                  class="ct-level"
                  data-level="intermediaire"
                  aria-pressed="false"
                  >Intermédiaire <span class="ct-level-n"></span></button
                >
                <button
                  type="button"
                  class="ct-level"
                  data-level="perfectionnement"
                  aria-pressed="false"
                  >Perfectionnement <span class="ct-level-n"></span></button
                >
                <button
                  type="button"
                  class="ct-level"
                  data-level="expert"
                  aria-pressed="false"
                  >Expert <span class="ct-level-n"></span></button
                >
              </div>
              <span class="ct-count"
                ><strong id="ct-n">{formations.length}</strong> / {
                  formations.length
                } affichées</span
              >
            </div>
          </div>

          <ol class="fcat-grid" id="fcat-grid">
            {
              formations.map((formation: any, index: number) => (
                <li
                  class="fcat-card reveal"
                  id={formation.slug}
                  data-level={formation.niveau}
                  style="--i:0"
                >
                  <a
                    class="fcat-card-link"
                    href={`/formations/${formation.thematique.slug}/${formation.slug}`}
                  >
                    <div class="fcat-card-top">
                      <span class="fcat-num">
                        {index < 10 ? "0" : ""}
                        {index + 1}
                      </span>
                      <span
                        class="fcat-level"
                        data-level={formation.niveau}
                        aria-label={`Niveau : ${formation.niveau}`}
                      >
                        <span class="fcat-level-bars" aria-hidden="true">
                          <>
                            <i />
                            <i />
                            <i />
                          </>
                        </span>
                        {formation.niveau}
                      </span>
                    </div>
                    <h3 class="fcat-title">
                      {formation.titre_de_la_formation}
                    </h3>
                    <div class="fcat-card-foot">
                      <span class="fcat-cta">Voir la formation</span>
                      <span class="fcat-arrow" aria-hidden="true">
                        <svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path d="M3 8h10M9 4l4 4-4 4" />
                        </svg>
                      </span>
                    </div>
                  </a>
                </li>
              ))
            }
          </ol>

          <div class="fcat-empty" id="fcat-empty" hidden>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
              ><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"
              ></path><path d="M8.5 8.5l5 5M13.5 8.5l-5 5"></path></svg
            >
            <span>Aucune formation ne correspond à ces critères.</span>
            <button type="button" class="fcat-empty-reset" id="fcat-empty-reset"
              >Réinitialiser les filtres</button
            >
          </div>
        </div>
      </section>

      <!-- ================================
     EXPLORER — autres catégories
     ================================ -->
      <section class="cat-others" aria-labelledby="cat-others-title">
        <div class="container">
          <header class="cat-others-head reveal">
            <div class="eyebrow">Explorer</div>
            <h2 class="cat-others-title" id="cat-others-title">
              Les autres catégories du catalogue
            </h2>
          </header>
          <ul class="cat-others-rail reveal delay-1">
            {
              thematiques.map(async (thematique: any) => {
                thematique.couleur_rgb = hexToRgbChannels(thematique.couleur);
                thematique.icone_thematique_content = await fetchSvgContent(
                  thematique.icone_thematique,
                );
                return (
                  <li>
                    <a
                      class="ocat-chip"
                      href={`/formations/${thematique.slug}`}
                      style={`--cc:${thematique.couleur_rgb}`}
                    >
                      <>
                        <span
                          class="ocat-ic"
                          aria-hidden="true"
                          set:html={thematique.icone_thematique_content}
                        />
                        <span class="ocat-tx">
                          {thematique.titre_de_la_thematique_de_formations}
                        </span>
                        <span class="ocat-n">
                          {thematique.formations.length +
                            thematique.formations_bis.length}
                        </span>
                      </>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </section>

      <section class="cta-section" id="contact" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-frame">
            <div class="cta-inner">
              <Fragment set:html={formation.icone_cta_content} />
              <div class="cta-body">
                <h2 class="cta-title reveal delay-1" id="cta-title">
                  <Fragment set:html={formation.titre_cta} />

                  <p class="cta-sub reveal delay-2">
                    {formation.sous_titre_cta}
                  </p>

                  <div class="cta-actions reveal delay-3">
                    <a
                      href="/contact?pole=formation&step=2"
                      class="btn-cta btn-cta--primary"
                    >
                      {formation.bouton_cta}
                      <span class="btn-cta-arrow"
                        ><svg
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                        ></span
                      >
                    </a>
                    <span class="cta-actions-divider" aria-hidden="true"></span>
                    <span class="cta-phone">
                      <svg
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        width="14"
                        height="14"
                        ><path
                          d="M2 3a1 1 0 011-1h3.28a1 1 0 01.95.68l1.07 3.21a1 1 0 01-.25 1L6.54 8.4a12.06 12.06 0 005.06 5.06l1.51-1.51a1 1 0 011-.25l3.21 1.07a1 1 0 01.68.95V17a1 1 0 01-1 1A15 15 0 012 3z"
                        ></path></svg
                      >
                      <a href="tel:+33387184920" class="cta-phone-num"
                        >03 87 18 49 20</a
                      >
                    </span>
                  </div>
                </h2>
              </div>
            </div>
          </div>
        </div>
      </section>

      <Footer />

      <script is:inline src="/js/shared/formation-page.js"></script>

      <!-- jcd-a11y (Lot 5) -->
      <div class="jcd-fab-wrap" id="jcd-fab">
        <button
          class="jcd-fab jcd-fab--top"
          id="jcdToTop"
          type="button"
          aria-label="Remonter en haut"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M10 16V5M5 10l5-5 5 5"></path></svg
          >
        </button>
        <a
          class="jcd-fab jcd-fab--contact"
          id="jcdFabContact"
          href="/contact"
          aria-label="Nous contacter"
        >
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><rect x="2.5" y="4.5" width="15" height="11" rx="2.3"></rect><path
              d="M3 6.7 L10 10.7 L17 6.7"></path></svg
          >
        </a>
      </div>
      <script is:inline src="/js/shared/a11y.js" id="jcd-a11y-js"></script>
      <script is:inline src="/js/shared/mrefonte.js" id="jcd-mrefonte-js"
      ></script>
    </main>
  </body>
</html>
