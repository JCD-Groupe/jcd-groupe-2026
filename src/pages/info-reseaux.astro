---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="JCD Groupe · Pôle Informatique. Architectures systèmes & réseaux : serveurs, virtualisation, réseau et sécurité."
    />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/info-reseaux`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content="Architectures systèmes & réseaux · Informatique · JCD Groupe"
    />
    <meta
      property="og:description"
      content="JCD Groupe · Pôle Informatique. Architectures systèmes & réseaux : serveurs, virtualisation, réseau et sécurité."
    />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/info-reseaux`}
    />
    <meta name="twitter:card" content="summary" />
    <title>
      Architectures systèmes &amp; réseaux · Informatique · JCD Groupe
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/info-reseaux.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/info-reseaux-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/infocompact.js" id="jcd-infocompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/page-boot.js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <div id="jcd-pagefade" aria-hidden="true"></div>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <!-- ====================================================================
     RAIL DE SOUS-NAVIGATION — écosystème Informatique
     Ancré en permanence sous le navbar. Libellés complets, page active
     en bleu JCD. Permet de naviguer entre la vue d'ensemble et les 4
     domaines du pôle.
     ==================================================================== -->
    <nav
      class="info-subnav"
      aria-label="Navigation du pôle Informatique"
      role="menubar"
    >
      <div class="info-subnav__inner">
        <a
          href="/informatique"
          class="info-subnav__home"
          role="menuitem"
          aria-label="Vue d'ensemble, Pôle Informatique"
          title="Vue d'ensemble"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><rect x="3" y="3" width="7" height="7" rx="1.6"></rect><rect
              x="14"
              y="3"
              width="7"
              height="7"
              rx="1.6"></rect><rect x="3" y="14" width="7" height="7" rx="1.6"
            ></rect><rect x="14" y="14" width="7" height="7" rx="1.6"
            ></rect></svg
          >
        </a>
        <span class="info-subnav__sep" aria-hidden="true"></span>
        <ul class="info-subnav__list">
          <li role="none">
            <a
              href="/info-integration"
              class="info-subnav__link"
              role="menuitem"
              ><span class="info-subnav__ic" aria-hidden="true"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
                  ></path></svg
                ></span
              >Service Intégration &amp; Support PC</a
            >
          </li>
          <li role="none">
            <a
              href="/info-reseaux"
              class="info-subnav__link is-active"
              aria-current="page"
              role="menuitem"
              ><span class="info-subnav__ic" aria-hidden="true"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="2" y="3" width="20" height="8" rx="2"></rect><rect
                    x="2"
                    y="13"
                    width="20"
                    height="8"
                    rx="2"></rect><path d="M6 7h.01M6 17h.01"></path></svg
                ></span
              >Architectures systèmes &amp; réseaux</a
            >
          </li>
          <li role="none">
            <a
              href="/info-collaboratif"
              class="info-subnav__link"
              role="menuitem"
              ><span class="info-subnav__ic" aria-hidden="true"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="m22 8-6 4 6 4V8Z"></path><rect
                    x="2"
                    y="6"
                    width="14"
                    height="12"
                    rx="2"></rect></svg
                ></span
              >Solutions collaboratives &amp; audiovisuelles</a
            >
          </li>
          <li role="none">
            <a href="/info-cloud" class="info-subnav__link" role="menuitem"
              ><span class="info-subnav__ic" aria-hidden="true"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"
                  ></path></svg
                ></span
              >Cloud Microsoft</a
            >
          </li>
        </ul>
      </div>
    </nav>

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ====================================================================
     HERO — épinglé (sticky), fond animé. La couche WebGL (.hero-mesh)
     sera branchée plus tard ; le fallback CSS reste visible d'ici là.
     ==================================================================== -->
        <section class="print-hero" aria-labelledby="hero-title">
          <div class="hero-mesh-fallback" aria-hidden="true"></div>
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>
          <div class="hero-texture" aria-hidden="true"></div>
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1 id="hero-title" class="hero-title reveal delay-1">
              Des <em>architectures</em> systèmes et réseaux maintenues.
            </h1>

            <p class="hero-sub reveal delay-2">
              Serveurs, virtualisation, réseau et sécurité. Une infrastructure
              dimensionnée, supervisée et résiliente, étudiée, déployée et
              maintenue.
            </p>

            <div class="hero-actions reveal delay-3">
              <a
                href="/contact?pole=informatique&step=2"
                class="btn-cta btn-cta--ghost"
              >
                Échanger avec nos experts
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ====================================================================
     MANIFESTE — feuille sticky (JetBrains Mono) qui glisse par-dessus
     le hero épinglé. Personnalisable par section.
     ==================================================================== -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="info-sheet">
            <div class="container">
              <header class="mf-head reveal">
                <span class="mf-head-side">
                  <span class="mf-caret" aria-hidden="true">&#9656;</span>
                  <span class="mf-id">INFRA&middot;02</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Manifeste</span>
                </span>
                <span class="mf-head-side">
                  <span>Pôle Informatique</span>
                </span>
              </header>

              <blockquote
                class="manifesto-quote manifesto-rich reveal delay-1"
                id="manifesto-title"
              >
                Une infrastructure doit &ecirc;tre <em>solide et durable</em>.
                Nous concevons des architectures syst&egrave;mes et
                r&eacute;seaux dimensionn&eacute;es pour votre
                r&eacute;alit&eacute; (technique, organisationnelle et
                budg&eacute;taire), puis nous les <em
                  >d&eacute;ployons, s&eacute;curisons et supervisons</em
                >.<span class="mf-cursor" aria-hidden="true"></span>
              </blockquote>
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone : hero sticky + manifeste qui glisse par-dessus -->

      <!-- ====================================================================
     PRESTATIONS
     ==================================================================== -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prest-title"
      >
        <div class="container">
          <div class="sec-head reveal">
            <h2 id="prest-title">
              De la <em>conception</em> à la mise en œuvre.
            </h2>
            <p>
              Serveurs, virtualisation, stockage, sauvegarde, r&eacute;seau et
              s&eacute;curit&eacute;.
            </p>
          </div>

          <div class="prest-grid reveal delay-1">
            <article class="prest-item">
              <div class="prest-item-head">
                <span class="prest-item-glyph" aria-hidden="true">
                  <svg
                    viewBox="0 0 40 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><rect x="7" y="7" width="12" height="12" rx="1.5"
                    ></rect><rect x="21" y="21" width="12" height="12" rx="1.5"
                    ></rect><path d="M19 13h4a2 2 0 0 1 2 2v4"></path></svg
                  >
                </span>
              </div>
              <h3 class="prest-item-title">
                Études, conseils &amp; conception d'architectures
              </h3>
              <p class="prest-item-desc">
                Analyse de l'existant et conception des architectures robustes,
                s&eacute;curis&eacute;es et &eacute;volutives, adapt&eacute;es
                &agrave; vos besoins techniques et strat&eacute;giques,
                jusqu'&agrave; la valorisation des phases de mise en
                &oelig;uvre.
              </p>
            </article>

            <article class="prest-item">
              <div class="prest-item-head">
                <span class="prest-item-glyph" aria-hidden="true">
                  <svg
                    viewBox="0 0 40 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><rect x="8" y="7" width="24" height="9" rx="1.6"
                    ></rect><rect x="8" y="20" width="24" height="9" rx="1.6"
                    ></rect><path
                      d="M13 11.5h.01M13 24.5h.01M27 11.5h2M27 24.5h2"
                    ></path></svg
                  >
                </span>
              </div>
              <h3 class="prest-item-title">Mise en œuvre d'infrastructures</h3>
              <p class="prest-item-desc">
                Déploiement opérationnel des infrastructures serveurs, stockage,
                sauvegarde, réseau et sécurité&nbsp;: intégration,
                configuration, sécurisation et accompagnement de vos équipes à
                la prise en main.
              </p>
            </article>

            <article class="prest-item">
              <div class="prest-item-head">
                <span class="prest-item-glyph" aria-hidden="true">
                  <svg
                    viewBox="0 0 40 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M9 15h18l-5-5M31 25H13l5 5"></path></svg
                  >
                </span>
              </div>
              <h3 class="prest-item-title">
                Migration d'environnements systèmes
              </h3>
              <p class="prest-item-desc">
                Plan de migration tenant compte des contraintes et
                pr&eacute;requis &eacute;diteurs, puis ex&eacute;cution
                ma&icirc;tris&eacute;e&nbsp;: POC, tests, migration et
                validation.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     SÉCURITÉ BY DESIGN — cybersécurité distillée
     ==================================================================== -->
      <section class="secblock" aria-labelledby="sec-title">
        <div class="container">
          <div class="secblock-head secblock-head--center reveal">
            <h2 id="sec-title">
              La s&eacute;curit&eacute; <em>int&eacute;gr&eacute;e</em> &agrave; l'architecture
            </h2>
            <p>
              Une infrastructure performante n'a de valeur que si elle est
              prot&eacute;g&eacute;e. Chaque conception embarque la
              s&eacute;curit&eacute;.
            </p>
            <a href="/informatique#cybersecurite" class="secblock-link">
              Découvrir notre expertise Cybersécurité
              <svg
                viewBox="0 0 16 16"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
              >
            </a>
          </div>

          <div class="defense reveal delay-1">
            <div class="defense-rings" aria-hidden="true">
              <svg viewBox="0 12 520 470" fill="none">
                <defs>
                  <radialGradient id="dfCore" cx="0.5" cy="0.42" r="0.65">
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.14"
                    ></stop>
                    <stop offset="0.55" stop-color="#4FC9E2" stop-opacity="0.04"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </radialGradient>
                  <radialGradient id="dfBg" cx="0.5" cy="0.5" r="0.5">
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.012"
                    ></stop>
                    <stop
                      offset="0.78"
                      stop-color="#4FC9E2"
                      stop-opacity="0.010"></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </radialGradient>
                  <linearGradient id="dfRim" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.22"
                    ></stop>
                    <stop offset="0.55" stop-color="#4FC9E2" stop-opacity="0.10"
                    ></stop>
                    <stop offset="1" stop-color="#FFFFFF" stop-opacity="0.04"
                    ></stop>
                  </linearGradient>
                  <linearGradient
                    id="dfSweepFill"
                    gradientUnits="userSpaceOnUse"
                    x1="260"
                    y1="60"
                    x2="86"
                    y2="196"
                  >
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.11"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </linearGradient>
                  <linearGradient
                    id="dfBeam"
                    gradientUnits="userSpaceOnUse"
                    x1="260"
                    y1="260"
                    x2="260"
                    y2="40"
                  >
                    <stop offset="0.18" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0.45"
                    ></stop>
                  </linearGradient>
                  <mask id="dfDonut">
                    <rect x="0" y="12" width="520" height="470" fill="#FFFFFF"
                    ></rect>
                    <circle cx="260" cy="260" r="54" fill="#000000"></circle>
                  </mask>
                </defs>

                <!-- fond : paliers concentriques à peine teintés + halo central discret -->
                <circle cx="260" cy="260" r="222" fill="url(#dfBg)"></circle>
                <circle
                  cx="260"
                  cy="260"
                  r="160"
                  fill="#4FC9E2"
                  fill-opacity="0.014"></circle>
                <circle
                  cx="260"
                  cy="260"
                  r="100"
                  fill="#4FC9E2"
                  fill-opacity="0.018"></circle>
                <circle cx="260" cy="260" r="150" fill="url(#dfCore)"></circle>

                <!-- balayage radar : rotation continue lente, épargne le cœur (mask donut).
               Pivot porté par le CSS (transform-box: view-box, origine 260/248). -->
                <g class="df-sweep" mask="url(#dfDonut)">
                  <path
                    d="M260 260 L60.4 162.7 A222 222 0 0 1 260 38 Z"
                    fill="url(#dfSweepFill)"></path>
                  <line
                    class="df-beam"
                    x1="260"
                    y1="260"
                    x2="260"
                    y2="40"
                    stroke="url(#dfBeam)"
                    stroke-width="1.2"></line>
                  <circle class="df-beam-tip" cx="260" cy="40" r="2.4"></circle>
                </g>

                <!-- anneau 03 — posture (externe, graduation fine) -->
                <g class="df-g3">
                  <circle
                    class="df-base"
                    cx="260"
                    cy="260"
                    r="222"
                    stroke="#4FC9E2"
                    stroke-opacity="0.14"
                    stroke-width="1"
                    stroke-dasharray="1 7"></circle>
                  <circle
                    class="df-arc"
                    cx="260"
                    cy="260"
                    r="222"
                    pathLength="100"
                    stroke="#4FC9E2"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-dasharray="15 85"
                    transform="rotate(-28 260 260)"></circle>
                  <text x="260" y="27" class="df-lab">POSTURE</text>
                </g>

                <!-- anneau 02 — réseau -->
                <g class="df-g2">
                  <circle
                    class="df-base"
                    cx="260"
                    cy="260"
                    r="160"
                    stroke="#4FC9E2"
                    stroke-opacity="0.13"
                    stroke-width="0.8"></circle>
                  <circle
                    class="df-arc"
                    cx="260"
                    cy="260"
                    r="160"
                    pathLength="100"
                    stroke="#4FC9E2"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-dasharray="19 81"
                    transform="rotate(108 260 260)"></circle>
                  <text x="260" y="89" class="df-lab">RÉSEAU</text>
                </g>

                <!-- anneau 01 — données -->
                <g class="df-g1">
                  <circle
                    class="df-base"
                    cx="260"
                    cy="260"
                    r="100"
                    stroke="#4FC9E2"
                    stroke-opacity="0.18"
                    stroke-width="0.9"></circle>
                  <circle
                    class="df-arc"
                    cx="260"
                    cy="260"
                    r="100"
                    pathLength="100"
                    stroke="#4FC9E2"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-dasharray="22 78"
                    transform="rotate(-118 260 260)"></circle>
                  <text x="260" y="149" class="df-lab">DONNÉES</text>
                </g>

                <!-- point d'ancrage des connecteurs, au bas de l'anneau externe -->
                <circle
                  cx="260"
                  cy="482"
                  r="1.8"
                  fill="#4FC9E2"
                  fill-opacity="0.35"></circle>

                <!-- cœur bouclier (verre) -->
                <circle
                  cx="260"
                  cy="260"
                  r="42"
                  fill="rgba(79,201,226,0.05)"
                  stroke="url(#dfRim)"
                  stroke-width="1"></circle>
                <g class="df-shield">
                  <path
                    d="M260 238 l16 6 v12 c0 11 -7.5 17.5 -16 20.5 c-8.5 -3 -16 -9.5 -16 -20.5 v-12 z"
                    stroke="#4FC9E2"
                    stroke-width="1.4"
                    stroke-linejoin="round"></path>
                  <path
                    d="M252.5 260.5 l5.5 5.5 l10.5 -11.5"
                    stroke="#4FC9E2"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </g>
              </svg>
            </div>

            <!-- connecteurs schéma → cartes (statiques, illuminés au survol de la carte) -->
            <svg
              class="defense-wires"
              viewBox="0 0 1000 110"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <linearGradient
                  id="dfWire"
                  x1="0"
                  y1="0"
                  x2="0"
                  y2="110"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.30"
                  ></stop>
                  <stop offset="1" stop-color="#4FC9E2" stop-opacity="0.05"
                  ></stop>
                </linearGradient>
              </defs>
              <path class="df-wire df-wire-1" d="M500 0 C500 54 161 50 161 110"
              ></path>
              <path class="df-wire df-wire-2" d="M500 0 L500 110"></path>
              <path class="df-wire df-wire-3" d="M500 0 C500 54 839 50 839 110"
              ></path>
            </svg>

            <div class="defense-grid">
              <div class="defpoint" data-ring="1">
                <span class="df-node" aria-hidden="true"></span>
                <h4>Sauvegarde à 3 niveaux &amp; PRA</h4>
                <p>
                  Stratégie de sauvegarde à 3 niveaux et plan de reprise&nbsp;:
                  vos données restent récupérables, même en cas d'incident
                  majeur.
                </p>
              </div>
              <div class="defpoint" data-ring="2">
                <span class="df-node" aria-hidden="true"></span>
                <h4>Sécurité réseau &amp; segmentation</h4>
                <p>
                  Pare-feu, segmentation et filtrage pour cloisonner les flux et
                  réduire la surface d'attaque.
                </p>
              </div>
              <div class="defpoint" data-ring="3">
                <span class="df-node" aria-hidden="true"></span>
                <h4>Résilience &amp; posture NIS2-ready</h4>
                <p>
                  Bonnes pratiques et durcissement&nbsp;: une infrastructure
                  auditable, résiliente et prête pour les exigences
                  réglementaires.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     PROCESS
     ==================================================================== -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="sec-head reveal">
            <h2 id="process-title">
              Un accompagnement <em>de bout en bout</em>.
            </h2>
            <p>
              De la compréhension du besoin à l'évolution de l'environnement,
              une démarche structurée et maîtrisée.
            </p>
