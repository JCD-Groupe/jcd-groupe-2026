---
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavInformatique from "../components/NavInformatique.astro";

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let informatique = await directus.request(
  readSingleton("JCD_Informatique", {
    fields: ["nom_pole"],
  }),
);

let info_reseaux = await directus.request(
  readSingleton("architectures_systemes_reseaux", {
    fields: [
      "*",
      { prestations: ["*"] },
      { processus_cybersecurite: ["*"] },
      { processus: ["*"] },
    ],
  }),
);

const fetchSvgContent = async (id: string) => {
  if (!id) return null;
  const response = await fetch(
    `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${id}`,
  );
  return response.text();
};

info_reseaux.prestations = await Promise.all(
  info_reseaux.prestations.map(async (prestation: any) => ({
    ...prestation,
    icone_content: await fetchSvgContent(prestation.icone),
  })),
);

info_reseaux.icone_cta_content = await fetchSvgContent(info_reseaux.icone_cta);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon}`}
      type="image/svg+xml"
    />
    <meta name="description" content={info_reseaux.meta_description} />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/info-reseaux`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content={`${info_reseaux.nom_service} • ${informatique.nom_pole} • ${global.nom_societe}`}
    />
    <meta property="og:description" content={info_reseaux.meta_description} />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/info-reseaux`}
    />
    <meta name="twitter:card" content="summary" />
    <title>
      {info_reseaux.nom_service} • {informatique.nom_pole} • {
        global.nom_societe
      }
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/info-reseaux.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/info-reseaux-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/infocompact.js" id="jcd-infocompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/page-boot.js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <div id="jcd-pagefade" aria-hidden="true"></div>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <!-- ====================================================================
     RAIL DE SOUS-NAVIGATION — écosystème Informatique
     Ancré en permanence sous le navbar. Libellés complets, page active
     en bleu JCD. Permet de naviguer entre la vue d'ensemble et les 4
     domaines du pôle.
     ==================================================================== -->
    <NavInformatique current="info-reseaux" />

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ====================================================================
     HERO — épinglé (sticky), fond animé. La couche WebGL (.hero-mesh)
     sera branchée plus tard ; le fallback CSS reste visible d'ici là.
     ==================================================================== -->
        <section class="print-hero" aria-labelledby="hero-title">
          <div class="hero-mesh-fallback" aria-hidden="true"></div>
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>
          <div class="hero-texture" aria-hidden="true"></div>
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1 id="hero-title" class="hero-title reveal delay-1">
              <Fragment set:html={info_reseaux.titre_hero} />
            </h1>

            <p class="hero-sub reveal delay-2">
              {info_reseaux.sous_titre_hero}
            </p>

            <div class="hero-actions reveal delay-3">
              <a
                href="/contact?pole=informatique&step=2"
                class="btn-cta btn-cta--ghost"
              >
                {info_reseaux.bouton_hero}
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ====================================================================
     MANIFESTE — feuille sticky (JetBrains Mono) qui glisse par-dessus
     le hero épinglé. Personnalisable par section.
     ==================================================================== -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="info-sheet">
            <div class="container">
              <header class="mf-head reveal">
                <span class="mf-head-side">
                  <span class="mf-caret" aria-hidden="true">&#9656;</span>
                  <span class="mf-id">{info_reseaux.manifeste_id}</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Manifeste</span>
                </span>
                <span class="mf-head-side">
                  <span>Pôle Informatique</span>
                </span>
              </header>

              <blockquote
                class="manifesto-quote manifesto-rich reveal delay-1"
                id="manifesto-title"
                set:html={info_reseaux.manifeste}
              />
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone : hero sticky + manifeste qui glisse par-dessus -->

      <!-- ====================================================================
     PRESTATIONS
     ==================================================================== -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prest-title"
      >
        <div class="container">
          <div class="sec-head reveal">
            <h2 id="prest-title" set:html={info_reseaux.titre_prestations} />
            <p set:html={info_reseaux.sous_titre_prestations} />
          </div>

          <div class="prest-grid reveal delay-1">
            {
              info_reseaux.prestations.map((prestation: any) => (
                <article class="prest-item">
                  <div class="prest-item-head">
                    <span
                      class="prest-item-glyph"
                      aria-hidden="true"
                      set:html={prestation.icone_content}
                    />
                  </div>
                  <h3 class="prest-item-title">{prestation.titre}</h3>
                  <p class="prest-item-desc">{prestation.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ====================================================================
     SÉCURITÉ BY DESIGN — cybersécurité distillée
     ==================================================================== -->
      <section class="secblock" aria-labelledby="sec-title">
        <div class="container">
          <div class="secblock-head secblock-head--center reveal">
            <h2
              id="sec-title"
              set:html={info_reseaux.titre_processus_cybersecurite}
            />
            <p set:html={info_reseaux.sous_titre_processus_cybersecurite} />
            <a href="/informatique#cybersecurite" class="secblock-link">
              {info_reseaux.bouton_processus_cybersecurite}
              <svg
                viewBox="0 0 16 16"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
              >
            </a>
          </div>

          <div class="defense reveal delay-1">
            <div class="defense-rings" aria-hidden="true">
              <svg viewBox="0 12 520 470" fill="none">
                <defs>
                  <radialGradient id="dfCore" cx="0.5" cy="0.42" r="0.65">
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.14"
                    ></stop>
                    <stop offset="0.55" stop-color="#4FC9E2" stop-opacity="0.04"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </radialGradient>
                  <radialGradient id="dfBg" cx="0.5" cy="0.5" r="0.5">
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.012"
                    ></stop>
                    <stop
                      offset="0.78"
                      stop-color="#4FC9E2"
                      stop-opacity="0.010"></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </radialGradient>
                  <linearGradient id="dfRim" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.22"
                    ></stop>
                    <stop offset="0.55" stop-color="#4FC9E2" stop-opacity="0.10"
                    ></stop>
                    <stop offset="1" stop-color="#FFFFFF" stop-opacity="0.04"
                    ></stop>
                  </linearGradient>
                  <linearGradient
                    id="dfSweepFill"
                    gradientUnits="userSpaceOnUse"
                    x1="260"
                    y1="60"
                    x2="86"
                    y2="196"
                  >
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.11"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </linearGradient>
                  <linearGradient
                    id="dfBeam"
                    gradientUnits="userSpaceOnUse"
                    x1="260"
                    y1="260"
                    x2="260"
                    y2="40"
                  >
                    <stop offset="0.18" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0.45"
                    ></stop>
                  </linearGradient>
                  <mask id="dfDonut">
                    <rect x="0" y="12" width="520" height="470" fill="#FFFFFF"
                    ></rect>
                    <circle cx="260" cy="260" r="54" fill="#000000"></circle>
                  </mask>
                </defs>

                <!-- fond : paliers concentriques à peine teintés + halo central discret -->
                <circle cx="260" cy="260" r="222" fill="url(#dfBg)"></circle>
                <circle
                  cx="260"
                  cy="260"
                  r="160"
                  fill="#4FC9E2"
                  fill-opacity="0.014"></circle>
                <circle
                  cx="260"
                  cy="260"
                  r="100"
                  fill="#4FC9E2"
                  fill-opacity="0.018"></circle>
                <circle cx="260" cy="260" r="150" fill="url(#dfCore)"></circle>

                <!-- balayage radar : rotation continue lente, épargne le cœur (mask donut).
               Pivot porté par le CSS (transform-box: view-box, origine 260/248). -->
                <g class="df-sweep" mask="url(#dfDonut)">
                  <path
                    d="M260 260 L60.4 162.7 A222 222 0 0 1 260 38 Z"
                    fill="url(#dfSweepFill)"></path>
                  <line
                    class="df-beam"
                    x1="260"
                    y1="260"
                    x2="260"
                    y2="40"
                    stroke="url(#dfBeam)"
                    stroke-width="1.2"></line>
                  <circle class="df-beam-tip" cx="260" cy="40" r="2.4"></circle>
                </g>

                <!-- anneau 03 — posture (externe, graduation fine) -->
                <g class="df-g3">
                  <circle
                    class="df-base"
                    cx="260"
                    cy="260"
                    r="222"
                    stroke="#4FC9E2"
                    stroke-opacity="0.14"
                    stroke-width="1"
                    stroke-dasharray="1 7"></circle>
                  <circle
                    class="df-arc"
                    cx="260"
                    cy="260"
                    r="222"
                    pathLength="100"
                    stroke="#4FC9E2"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-dasharray="15 85"
                    transform="rotate(-28 260 260)"></circle>
                  <text x="260" y="27" class="df-lab"
                    >{info_reseaux.processus_cybersecurite_label_01}</text
                  >
                </g>

                <!-- anneau 02 — réseau -->
                <g class="df-g2">
                  <circle
                    class="df-base"
                    cx="260"
                    cy="260"
                    r="160"
                    stroke="#4FC9E2"
                    stroke-opacity="0.13"
                    stroke-width="0.8"></circle>
                  <circle
                    class="df-arc"
                    cx="260"
                    cy="260"
                    r="160"
                    pathLength="100"
                    stroke="#4FC9E2"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-dasharray="19 81"
                    transform="rotate(108 260 260)"></circle>
                  <text x="260" y="89" class="df-lab"
                    >{info_reseaux.processus_cybersecurite_label_02}</text
                  >
                </g>

                <!-- anneau 01 — données -->
                <g class="df-g1">
                  <circle
                    class="df-base"
                    cx="260"
                    cy="260"
                    r="100"
                    stroke="#4FC9E2"
                    stroke-opacity="0.18"
                    stroke-width="0.9"></circle>
                  <circle
                    class="df-arc"
                    cx="260"
                    cy="260"
                    r="100"
                    pathLength="100"
                    stroke="#4FC9E2"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-dasharray="22 78"
                    transform="rotate(-118 260 260)"></circle>
                  <text x="260" y="149" class="df-lab">
                    {info_reseaux.processus_cybersecurite_label_03}
                  </text>
                </g>

                <!-- point d'ancrage des connecteurs, au bas de l'anneau externe -->
                <circle
                  cx="260"
                  cy="482"
                  r="1.8"
                  fill="#4FC9E2"
                  fill-opacity="0.35"></circle>

                <!-- cœur bouclier (verre) -->
                <circle
                  cx="260"
                  cy="260"
                  r="42"
                  fill="rgba(79,201,226,0.05)"
                  stroke="url(#dfRim)"
                  stroke-width="1"></circle>
                <g class="df-shield">
                  <path
                    d="M260 238 l16 6 v12 c0 11 -7.5 17.5 -16 20.5 c-8.5 -3 -16 -9.5 -16 -20.5 v-12 z"
                    stroke="#4FC9E2"
                    stroke-width="1.4"
                    stroke-linejoin="round"></path>
                  <path
                    d="M252.5 260.5 l5.5 5.5 l10.5 -11.5"
                    stroke="#4FC9E2"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </g>
              </svg>
            </div>

            <!-- connecteurs schéma → cartes (statiques, illuminés au survol de la carte) -->
            <svg
              class="defense-wires"
              viewBox="0 0 1000 110"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <linearGradient
                  id="dfWire"
                  x1="0"
                  y1="0"
                  x2="0"
                  y2="110"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.30"
                  ></stop>
                  <stop offset="1" stop-color="#4FC9E2" stop-opacity="0.05"
                  ></stop>
                </linearGradient>
              </defs>
              <path class="df-wire df-wire-1" d="M500 0 C500 54 161 50 161 110"
              ></path>
              <path class="df-wire df-wire-2" d="M500 0 L500 110"></path>
              <path class="df-wire df-wire-3" d="M500 0 C500 54 839 50 839 110"
              ></path>
            </svg>

            <div class="defense-grid">
              {
                info_reseaux.processus_cybersecurite.map(
                  (item: any, index: number) => (
                    <div class="defpoint" data-ring={index + 1}>
                      <span class="df-node" aria-hidden="true" />
                      <h4>{item.titre}</h4>
                      <p>{item.description}</p>
                    </div>
                  ),
                )
              }
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     PROCESS
     ==================================================================== -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="sec-head reveal">
            <h2 id="process-title" set:html={info_reseaux.titre_processus} />
            <p set:html={info_reseaux.sous_titre_processus} />
          </div>

          <div class="blueprint reveal delay-1">
            <div class="bp-frame" aria-hidden="true"></div>

            <div class="bp-step bp-step--l bp-step--1">
              <h3>{info_reseaux.processus[0]?.titre}</h3>
              <p>{info_reseaux.processus[0]?.description}</p>
            </div>

            <div class="bp-step bp-step--r bp-step--2">
              <h3>{info_reseaux.processus[1]?.titre}</h3>
              <p>{info_reseaux.processus[1]?.description}</p>
            </div>

            <div class="bp-step bp-step--l bp-step--3">
              <h3>{info_reseaux.processus[2]?.titre}</h3>
              <p>{info_reseaux.processus[2]?.description}</p>
            </div>

            <div class="bp-step bp-step--r bp-step--4 bp-step--svc">
              <h3>{info_reseaux.processus[3]?.titre}</h3>
              <p>{info_reseaux.processus[3]?.description}</p>
              <div class="bp-svc">
                <span class="bp-svc-note"
                  >Pour aller plus loin, confiez-nous la supervision de votre
                  infra.</span
                >
                <a class="bp-svc-link" href="/service"
                  >Découvrir le pôle Service <span class="bp-svc-arrow"
                    >&rarr;</span
                  ></a
                >
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     CTA — style maison (icône + corps + téléphone), commun aux pôles
     ==================================================================== -->
      <section class="cta-section" id="contact" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-frame">
            <div class="cta-inner">
              <span
                class="cta-icon reveal"
                aria-hidden="true"
                set:html={info_reseaux.icone_cta_content}
              />

              <div class="cta-body">
                <h2
                  class="cta-title reveal delay-1"
                  id="cta-title"
                  set:html={info_reseaux.titre_cta}
                />
                <p
                  class="cta-sub reveal delay-2"
                  set:html={info_reseaux.sous_titre_cta}
                />
                <div class="cta-actions reveal delay-3">
                  <a
                    href="/contact?pole=informatique&step=2"
                    class="btn-cta btn-cta--primary"
                  >
                    {info_reseaux.bouton_cta}
                    <span class="btn-cta-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </a>
                  <span class="cta-actions-divider" aria-hidden="true"></span>
                  <span class="cta-phone">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      width="14"
                      height="14"
                      ><path
                        d="M2 3a1 1 0 011-1h3.28a1 1 0 01.95.68l1.07 3.21a1 1 0 01-.25 1L6.54 8.4a12.06 12.06 0 005.06 5.06l1.51-1.51a1 1 0 011-.25l3.21 1.07a1 1 0 01.68.95V17a1 1 0 01-1 1A15 15 0 012 3z"
                      ></path></svg
                    >
                    <a href="tel:+33387184920" class="cta-phone-num"
                      >03 87 18 49 20</a
                    >
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline src="/js/pages/info-reseaux-1.js"></script>
    <script is:inline src="/js/shared/menu-frost.js"></script>
    <!-- jcd-a11y (Lot 5) -->
    <div class="jcd-fab-wrap" id="jcd-fab">
      <button
        class="jcd-fab jcd-fab--top"
        id="jcdToTop"
        type="button"
        aria-label="Remonter en haut"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M10 16V5M5 10l5-5 5 5"></path></svg
        >
      </button>
      <a
        class="jcd-fab jcd-fab--contact"
        id="jcdFabContact"
        href="/contact"
        aria-label="Nous contacter"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2.5" y="4.5" width="15" height="11" rx="2.3"></rect><path
            d="M3 6.7 L10 10.7 L17 6.7"></path></svg
        >
      </a>
    </div>
    <script is:inline src="/js/shared/a11y.js" id="jcd-a11y-js"></script>
    <script is:inline src="/js/shared/micons.js" id="jcd-micons-js"></script>
    <script is:inline src="/js/shared/mrefonte.js" id="jcd-mrefonte-js"
    ></script>
  </body>
</html>
