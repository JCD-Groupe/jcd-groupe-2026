---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { directus } from "../lib/directus";
import { readItems, readSingleton } from "@directus/sdk";
import { fetchSvgContent } from "../utils/formatters";

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let carriere = await directus.request(
  readSingleton("carriere", {
    fields: [
      "*",
      { valeurs: ["*"] },
      { avantages: ["*"] },
      { processus: ["*"] },
      { informations_supplementaires_formulaire: ["*"] },
    ],
  }),
);

let offres = await directus.request(
  readItems("Offres", {
    fields: [
      "*",
      {
        pole_concerne: ["*"],
      },
    ],
  }),
);

carriere.valeurs = await Promise.all(
  carriere.valeurs.map(async (valeur: any) => ({
    ...valeur,
    icone_content: await fetchSvgContent(valeur.icone),
  })),
);

let informatique = await directus.request(
  readSingleton("JCD_Informatique", {
    fields: ["nom_pole"],
  }),
);

let developpement = await directus.request(
  readSingleton("JCD_Developpement", {
    fields: ["nom_pole"],
  }),
);

let print = await directus.request(
  readSingleton("JCD_Print", {
    fields: ["nom_pole"],
  }),
);

let service = await directus.request(
  readSingleton("JCD_Service", {
    fields: ["nom_pole"],
  }),
);

let telecom = await directus.request(
  readSingleton("JCD_Telecom", {
    fields: ["nom_pole"],
  }),
);

let formation = await directus.request(
  readSingleton("JCD_Formation", {
    fields: ["nom_pole"],
  }),
);

let agencement = await directus.request(
  readSingleton("JCD_Agencement", {
    fields: ["nom_pole"],
  }),
);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon}`}
      type="image/svg+xml"
    />
    <meta name="description" content={carriere.meta_description} />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/carrieres`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content={`${carriere.titre} · ${global.nom_societe}`}
    />
    <meta property="og:description" content={carriere.meta_description} />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/carrieres`}
    />
    <meta name="twitter:card" content="summary" />
    <title>{carriere.titre} · {global.nom_societe}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Hero : 1re image de la video disponible des l'arrivee sur la page, pour que le
     cadre ne reste jamais noir en attendant les donnees video (11 Mo). -->
    <link
      rel="preload"
      as="image"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${carriere.image_backup_video}`}
      fetchpriority="high"
    />

    <link rel="stylesheet" href="/css/carrieres.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/carrieres-overrides.css" />
    <script is:inline src="/js/shared/mpolish.js" id="jcd-mpolish-js"></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Nos solutions ▾ · icône Carrières,
     marquée page courante} · CTA Assistance + Contact (d).
     Dropdown 7 expertises.
     ==================================================================== -->
    <Header current="carrieres" />

    <main id="contenu">
      <!-- ================================
     HERO — vidéo de présentation en arrière-plan + texte en surimpression
     ================================ -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="container">
          <!-- Vidéo encadrée (double-cadre, coins arrondis) — lecture auto, muette, en boucle, décorative -->
          <div class="hero-media reveal">
            <div class="hero-screen">
              <!-- preload="auto" : le scanner de preload du navigateur met le MP4 en file
             des le debut du parsing (avant meme la feuille de style), au lieu
             d'attendre un script. media="(min-width:821px)" sur la <source> garde
             le mobile a 0 octet de video : la source ne matche pas, seul le poster
             s'affiche. -->
              <video
                class="hero-video"
                id="hero-video"
                muted
                loop
                playsinline
                preload="auto"
                poster={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${carriere.image_backup_video}`}
                aria-hidden="true"
                tabindex="-1"
              >
                <source
                  src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${carriere.video}`}
                  type="video/mp4"
                  media="(min-width: 821px)"
                />
              </video>
              <script is:inline src="/js/pages/carrieres-5.js"></script>
            </div>
          </div>

          <!-- Sous la vidéo : titre + CTA (gauche) · paragraphe (droite) -->
          <div class="hero-row">
            <div class="hero-headcol reveal delay-1">
              <h1
                class="hero-h1"
                id="hero-title"
                set:html={carriere.titre_hero}
              />
              <!-- Découvrir d'abord les offres (primaire) ; « Postuler »
                   reste en second pour la candidature spontanée. -->
              <div class="hero-ctas">
                <a href="#offres" class="hero-apply">
                  <span>{carriere.bouton_blanc}</span>
                  <span class="hero-apply-ic" aria-hidden="true">
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                    >
                  </span>
                </a>
                <a href="#postuler" class="hero-apply hero-apply--ghost">
                  <span>{carriere.bouton_noir}</span>
                  <span class="hero-apply-ic" aria-hidden="true">
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                    >
                  </span>
                </a>
              </div>
            </div>
            <p class="hero-lead reveal delay-2">
              {carriere.texte_hero}
            </p>
          </div>
        </div>
      </section>

      <!-- ================================
     PRINCIPES / VALEURS — carrousel (titre · valeur active · pagination)
     ================================ -->
      <section
        class="sec values-sec"
        id="valeurs"
        aria-labelledby="values-title"
      >
        <div class="container">
          <div class="values-panel reveal">
            <div class="values-head">
              <h2
                class="values-title"
                id="values-title"
                set:html={carriere.titre_valeur}
              />
            </div>

            <div class="values-stage" data-values>
              <div class="values-viewport">
                <ul class="values-track" id="values-track">
                  {
                    carriere.valeurs.map((valeur: any, index: number) => (
                      <li class="value-slide is-active">
                        <span
                          class="value-visual"
                          aria-hidden="true"
                          set:html={valeur.icone_content}
                        />
                        <div class="value-body">
                          <h3 class="value-name">{valeur.titre}</h3>
                          <p class="value-text">{valeur.description}</p>
                        </div>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div class="values-foot">
                <span class="values-count"
                  ><b id="values-cur">01</b><span
                    >&thinsp;/&thinsp;0{carriere.valeurs.length}</span
                  ></span
                >
                <div class="values-nav">
                  <button
                    type="button"
                    class="values-arrow"
                    data-values-prev
                    aria-label="Principe précédent"
                  >
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"><path d="M10 3 5 8l5 5"></path></svg
                    >
                  </button>
                  <button
                    type="button"
                    class="values-arrow"
                    data-values-next
                    aria-label="Principe suivant"
                  >
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"><path d="M6 3l5 5-5 5"></path></svg
                    >
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     CE QU'ON VOUS OFFRE — intro (g) + accordéon avantages (d)
     ================================ -->
      <section
        class="sec acc-sec"
        id="avantages"
        aria-labelledby="support-title"
      >
        <div class="container">
          <div class="acc-grid">
            <div class="acc-intro reveal">
              <h2 class="acc-title" id="support-title">
                {carriere.titre_avantages}
              </h2>
              <p class="acc-text">
                {carriere.sous_titre_avantages}
              </p>
            </div>
            <div class="acc-list reveal delay-1">
              {
                carriere.avantages.map((avantage: any) => (
                  <div class="acc-item">
                    <h3 class="acc-h">
                      <button type="button" class="acc-q" aria-expanded="false">
                        <span class="acc-q-tx">{avantage.titre}</span>
                        <span class="acc-icon" aria-hidden="true" />
                      </button>
                    </h3>
                    <div class="acc-a">
                      <div class="acc-a-in">
                        <p>{avantage.description}</p>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     COMMENT ON RECRUTE — intro (g) + accordéon process (d)
     ================================ -->
      <section
        class="sec acc-sec"
        id="recrutement"
        aria-labelledby="hire-title"
      >
        <div class="container">
          <div class="acc-grid">
            <div class="acc-intro reveal">
              <h2 class="acc-title" id="hire-title">
                {carriere.titre_processus}
              </h2>
              <p class="acc-text">
                {carriere.sous_titre_processus}
              </p>
            </div>
            <div class="acc-list reveal delay-1">
              {
                carriere.processus.map((etape: any) => (
                  <div class="acc-item">
                    <h3 class="acc-h">
                      <button type="button" class="acc-q" aria-expanded="false">
                        <span class="acc-q-tx">{etape.titre}</span>
                        <span class="acc-icon" aria-hidden="true" />
                      </button>
                    </h3>
                    <div class="acc-a">
                      <div class="acc-a-in">
                        <p>{etape.description}</p>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     OFFRES DU MOMENT — carrousel de postes ouverts, description dépliable.
     Source de données : tableau OFFRES dans le script en bas de page.
     ================================ -->
      <section
        class="sec offers-sec"
        id="offres"
        aria-labelledby="offres-title"
      >
        <div class="container">
          <div class="offers-head reveal">
            <div>
              <h2
                class="sec-title"
                id="offres-title"
                set:html={carriere.titre_offres}
              />
              <p class="offers-count" id="offres-count" aria-live="polite"></p>
            </div>
            <div class="offers-ctrl">
              <button
                type="button"
                class="offers-btn"
                id="offers-prev"
                aria-label="Offres précédentes"
              >
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4"></path></svg
                >
              </button>
              <button
                type="button"
                class="offers-btn"
                id="offers-next"
                aria-label="Offres suivantes"
              >
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                >
              </button>
            </div>
          </div>
          <div
            class="offers-track reveal delay-1"
            id="offers-list"
            role="list"
            aria-label="Offres d'emploi ouvertes"
          >
            {
              offres.length == 0 ? (
                <div class="offers-empty" role="listitem">
                  Aucune offre ouverte pour le moment, les candidatures
                  spontanées restent les bienvenues.
                </div>
              ) : (
                offres.map((offre: any) => {
                  let pole =
                    offre.pole_concerne == "informatique"
                      ? informatique
                      : offre.pole_concerne == "developpement"
                        ? developpement
                        : offre.pole_concerne == "print"
                          ? print
                          : offre.pole_concerne == "service"
                            ? service
                            : offre.pole_concerne == "telecom"
                              ? telecom
                              : offre.pole_concerne == "formation"
                                ? formation
                                : agencement;
                  let couleur =
                    offre.pole_concerne == "informatique"
                      ? "#2E72BA"
                      : offre.pole_concerne == "developpement"
                        ? "#F9D605"
                        : offre.pole_concerne == "print"
                          ? "#F4941D"
                          : offre.pole_concerne == "service"
                            ? "#ED1B25"
                            : offre.pole_concerne == "telecom"
                              ? "#91258E"
                              : offre.pole_concerne == "formation"
                                ? "#8CC63E"
                                : "#A78E76";

                  return (
                    <article
                      class="offer-card"
                      role="listitem"
                      style={`--pc: ${couleur}`}
                    >
                      <span class="offer-pole">{pole.nom_pole}</span>
                      <h3 class="offer-title">{offre.titre}</h3>
                      <span class="offer-meta">
                        <span>
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <>
                              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                              <circle cx="12" cy="10" r="3" />
                            </>
                          </svg>
                          {offre.site.join(" / ")}
                        </span>
                        <span class="meta-sep" aria-hidden="true" />
                        <span>{offre.type_de_contrat}</span>
                        <span class="meta-sep" aria-hidden="true" />
                        <span>{offre.type_de_poste}</span>
                      </span>
                      <button
                        type="button"
                        class="offer-toggle"
                        aria-expanded="false"
                      >
                        Le poste en détail
                        <svg
                          viewBox="0 0 10 10"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M2.5 4l2.5 2.5L7.5 4" />
                        </svg>
                      </button>
                      <div class="offer-desc">
                        <div>
                          <p>{offre.description}</p>
                        </div>
                      </div>
                      <div class="offer-foot">
                        <a
                          class="offer-apply"
                          href="#postuler"
                          data-offre={offre.id}
                          aria-label={`Postuler — ${offre.titre}, ${offre.site.join(" / ")}, ${offre.type_de_contrat}`}
                        >
                          Postuler
                          <span class="offer-apply-arrow" aria-hidden="true">
                            <svg
                              viewBox="0 0 16 16"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M3 8h10M9 4l4 4-4 4" />
                            </svg>
                          </span>
                        </a>
                      </div>
                    </article>
                  );
                })
              )
            }
          </div>
        </div>
      </section>

      <!-- ================================
     FORMULAIRE DE CANDIDATURE
     ================================ -->
      <section
        class="sec apply-sec"
        id="postuler"
        aria-labelledby="postuler-title"
      >
        <div class="container">
          <div class="apply-grid">
            <aside class="apply-aside reveal">
              <h2
                class="sec-title"
                id="postuler-title"
                set:html={carriere.titre_formulaire}
              />
              <p class="sec-text">
                {carriere.sous_titre_formulaire}
              </p>
              <ul class="apply-points">
                {
                  carriere.informations_supplementaires_formulaire.map(
                    (info: any) => (
                      <li class="apply-point">
                        <span class="apply-point-tx">
                          <strong>{info.titre}</strong>
                          {info.description}
                        </span>
                      </li>
                    ),
                  )
                }
              </ul>
            </aside>

            <div class="apply-main">
              <form id="apply-form" class="q-shell reveal delay-1" novalidate>
                <div class="q-shell-inner">
                  <!-- Type de candidature -->
                  <div
                    class="q-intent"
                    role="radiogroup"
                    aria-label="Type de candidature"
                  >
                    <button
                      type="button"
                      class="q-intent-opt is-selected"
                      data-intent="offre"
                      role="radio"
                      aria-checked="true">Répondre à une offre</button
                    >
                    <button
                      type="button"
                      class="q-intent-opt"
                      data-intent="spontanee"
                      role="radio"
                      aria-checked="false">Candidature spontanée</button
                    >
                    <span class="q-intent-glider" aria-hidden="true"></span>
                  </div>

                  <p class="apply-lead" id="apply-lead">
                    Sélectionnez l'offre qui vous intéresse, joignez votre CV :
                    c'est tout.
                  </p>

                  <div class="q-fields">
                    <div class="q-row">
                      <div class="q-field">
                        <label for="f-firstname"
                          >Prénom <span aria-hidden="true">*</span></label
                        >
                        <input
                          id="f-firstname"
                          name="prenom"
                          type="text"
                          autocomplete="given-name"
                          required
                          placeholder="Jeanne"
                        />
                      </div>
                      <div class="q-field">
                        <label for="f-lastname"
                          >Nom <span aria-hidden="true">*</span></label
                        >
                        <input
                          id="f-lastname"
                          name="nom"
                          type="text"
                          autocomplete="family-name"
                          required
                          placeholder="Dupont"
                        />
                      </div>
                    </div>

                    <div class="q-row">
                      <div class="q-field">
                        <label for="f-phone"
                          >Numéro de téléphone <span aria-hidden="true">*</span
                          ></label
                        >
                        <input
                          id="f-phone"
                          name="telephone"
                          type="tel"
                          autocomplete="tel"
                          inputmode="tel"
                          required
                          placeholder="06 12 34 56 78"
                        />
                      </div>
                      <div class="q-field">
                        <label for="f-email"
                          >Email <span aria-hidden="true">*</span></label
                        >
                        <input
                          id="f-email"
                          name="email"
                          type="email"
                          autocomplete="email"
                          required
                          placeholder="jeanne.dupont@email.fr"
                        />
                      </div>
                    </div>

                    <!-- Visible en mode "Répondre à une offre" -->
                    <div class="q-field" id="field-offre">
                      <label for="f-offre"
                        >Offre concernée <span aria-hidden="true">*</span
                        ></label
                      >
                      <select id="f-offre" name="offre" required>
                        <option value="" disabled selected
                          >Choisissez une offre…</option
                        >
                        {
                          offres.map((offre: any) => (
                            <option value={offre.id}>
                              {offre.titre}, {offre.site.join("/")} (
                              {offre.type_de_contrat})
                            </option>
                          ))
                        }
                        <option value="__autre__"
                          >Autre / offre non listée</option
                        >
                      </select>
                    </div>

                    <!-- Visible en mode "Candidature spontanée" -->
                    <div class="q-field" id="field-poste" hidden>
                      <label for="f-poste"
                        >Poste recherché <span aria-hidden="true">*</span
                        ></label
                      >
                      <input
                        id="f-poste"
                        name="poste_recherche"
                        type="text"
                        placeholder="Ex. : technicien support, commercial, formateur…"
                      />
                    </div>

                    <!-- CV : zone de dépôt drag & drop -->
                    <div class="q-field">
                      <label for="f-cv"
                        >Votre CV <span aria-hidden="true">*</span></label
                      >
                      <div class="cv-drop" id="cv-drop">
                        <span class="cv-drop-ico" aria-hidden="true">
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                            ></path><path d="M17 8l-5-5-5 5"></path><path
                              d="M12 3v12"></path></svg
                          >
                        </span>
                        <span class="cv-drop-label"
                          >Glissez votre CV ici, ou <em
                            >parcourez vos fichiers</em
                          ></span
                        >
                        <span class="cv-drop-hint"
                          >PDF, DOC ou DOCX · 5 Mo max</span
                        >
                        <input
                          id="f-cv"
                          name="attachment"
                          type="file"
                          accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                          aria-describedby="cv-status"
                        />
                        <div class="cv-file" id="cv-file">
                          <span class="cv-file-ico" aria-hidden="true">
                            <svg
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              ><path
                                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                              ></path><path d="M14 2v6h6"></path></svg
                            >
