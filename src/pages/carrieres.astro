                          <span class="cv-file-tx">
                            <span class="cv-file-name" id="cv-file-name"></span>
                            <span class="cv-file-size" id="cv-file-size"></span>
                          </span>
                          <button
                            type="button"
                            class="cv-file-remove"
                            id="cv-file-remove"
                            aria-label="Retirer le fichier"
                          >
                            <svg
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                              ><path d="M18 6 6 18M6 6l12 12"></path></svg
                            >
                          </button>
                        </div>
                      </div>
                      <span
                        class="visually-hidden"
                        id="cv-status"
                        role="status"
                        aria-live="polite"></span>
