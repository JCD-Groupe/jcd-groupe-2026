<main id="contenu">

<div class="hero-pin-zone">

<!-- ====================================================================
     HERO — épinglé (sticky), fond animé. Couche WebGL (.hero-mesh) à
     brancher plus tard ; le fallback CSS reste visible d'ici là.
     ==================================================================== -->
<section class="print-hero" aria-labelledby="hero-title">

  <div class="hero-mesh-fallback" aria-hidden="true"></div>
  <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>
  <div class="hero-texture" aria-hidden="true"></div>
  <div class="hero-grain" aria-hidden="true"></div>

  <div class="container">
    <h1 id="hero-title" class="hero-title reveal delay-1">
      <span class="accent-grad">Collaborer</span> et communiquer &agrave; distance
    </h1>

    <p class="hero-sub reveal delay-2">
      Visioconférence, audiovisuel et salles équipées. Des outils qui rapprochent vos équipes, conçus et intégrés sur mesure.
    </p>

    <div class="hero-actions reveal delay-3">
      <a href="contact.html?pole=informatique" class="btn-cta btn-cta--ghost">
        Demander une démonstration
        <span class="btn-cta-arrow"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
      </a>
    </div>
  </div>
</section>

<!-- ====================================================================
     MANIFESTE — feuille sticky (JetBrains Mono) qui glisse par-dessus le
     hero épinglé. Personnalisable par section.
     ==================================================================== -->
<section class="manifesto" aria-labelledby="manifesto-title">
  <div class="info-sheet">
    <div class="container">

      <header class="mf-head reveal">
        <span class="mf-head-side">
          <span class="mf-caret" aria-hidden="true">&#9656;</span>
          <span class="mf-id">AV&middot;03</span>
          <span class="mf-rule" aria-hidden="true"></span>
          <span>Manifeste</span>
        </span>
        <span class="mf-head-side">
          <span>Pôle Informatique</span>
        </span>
      </header>

      <blockquote class="manifesto-quote reveal delay-1" id="manifesto-title">
        Une salle de r&eacute;union se doit d'&ecirc;tre <em>optimis&eacute;e</em> afin de travailler dans les meilleures conditions. Nous concevons, int&eacute;grons et maintenons des <span class="accent">solutions audiovisuelles et de visioconf&eacute;rence</span> pens&eacute;es pour vos usages et vos espaces.<span class="mf-cursor" aria-hidden="true"></span>
      </blockquote>

    </div>
  </div>
</section>

</div><!-- /hero-pin-zone : hero sticky + manifeste qui glisse par-dessus -->

<!-- ====================================================================
     PRESTATIONS
     ==================================================================== -->
<section class="prestations" id="prestations" aria-labelledby="prest-title">
  <div class="container">
    <div class="sec-head reveal">
      <h2 id="prest-title">Des espaces <em>sur-mesure</em>.</h2>
      <p>Visioconférence, affichage et audio : une solution adaptée à vos usages et à vos espaces.</p>
    </div>

    <div class="prest-grid reveal delay-1">

      <article class="prest-item">
        <div class="prest-item-head">
          <span class="prest-item-glyph" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="10" y="6" width="20" height="28" rx="2"/><path d="M16 6V4h8v2"/><circle cx="18.5" cy="19" r="4"/><path d="M21.5 22l3.5 3.5"/></svg></span>
        </div>
        <h3 class="prest-item-title">Analyse du besoin</h3>
        <p class="prest-item-desc">Analyse des usages, des espaces et des contraintes techniques pour définir une solution adaptée, évolutive et interopérable.</p>
      </article>

      <article class="prest-item">
        <div class="prest-item-head">
          <span class="prest-item-glyph" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6l12 6.5v15L20 34 8 27.5v-15z"/><path d="M20 6v28M8 12.5l12 6.5 12-6.5"/></svg></span>
        </div>
        <h3 class="prest-item-title">Conception &amp; qualification</h3>
        <p class="prest-item-desc">Conception de l'architecture et sélection des équipements, suivies de tests et validation : performance, compatibilité, pérennité.</p>
      </article>

      <article class="prest-item">
        <div class="prest-item-head">
          <span class="prest-item-glyph" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="9" width="26" height="16" rx="2"/><path d="M20 25v5M14 32h12"/><path d="M16 17l3 3 5-5"/></svg></span>
        </div>
        <h3 class="prest-item-title">Installation &amp; prise en main</h3>
        <p class="prest-item-desc">Installation soignée et conforme, intégrée à votre environnement, avec formation des utilisateurs pour une adoption durable.</p>
      </article>

    </div>
  </div>
</section>

<!-- ====================================================================
     SÉCURITÉ BY DESIGN — cybersécurité distillée (accent cyan)
     ==================================================================== -->
<section class="secblock" aria-labelledby="sec-title">
  <div class="container">

    <div class="secblock-head secblock-head--center reveal">
      <h2 id="sec-title">Tous vos échanges <em>sécurisés</em></h2>
      <p>Réunions sensibles, contenus partagés : la sécurité et la maîtrise des salles font partie de l'intégration.</p>
      <a href="informatique.html#cybersecurite" class="secblock-link">
        Découvrir notre expertise Cybersécurité
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </a>
    </div>

    <div class="seclink reveal delay-1" aria-hidden="true">
      <div class="seclink-band">

        <div class="seclink-end">
          <span class="seclink-end-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01"/></svg></span>
          <span class="seclink-end-lab">Salle<br>équipée</span>
        </div>

        <div class="seclink-wave">
          <svg viewBox="0 0 1000 120" preserveAspectRatio="none">
            <defs>
              <linearGradient id="clWave" x1="0" y1="0" x2="1000" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.55"/>
                <stop offset="0.16" stop-color="#4FC9E2" stop-opacity="0.38"/>
                <stop offset="0.5" stop-color="#4FC9E2" stop-opacity="0.8"/>
                <stop offset="0.84" stop-color="#4FC9E2" stop-opacity="0.38"/>
                <stop offset="1" stop-color="#4FC9E2" stop-opacity="0.55"/>
              </linearGradient>
            </defs>
            <path stroke="rgba(79,201,226,0.13)" stroke-width="4" fill="none" vector-effect="non-scaling-stroke"
              d="M0 60 C50 60 85 70 130 70 S225 44 275 48 S365 76 415 72 S480 52 500 56 S595 78 645 74 S735 40 790 46 S895 68 945 64 S1000 60 1000 60"/>
            <path stroke="url(#clWave)" stroke-width="1.6" fill="none" vector-effect="non-scaling-stroke"
              d="M0 60 C40 60 70 48 115 48 S205 74 255 72 S350 38 400 42 S475 70 500 64 S585 40 635 44 S730 80 785 74 S890 50 940 54 S1000 60 1000 60"/>
          </svg>
        </div>

        <div class="seclink-lock">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><path d="M12 15v2"/></svg>
        </div>

        <div class="seclink-end">
          <span class="seclink-end-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
          <span class="seclink-end-lab">Participants<br>distants</span>
        </div>

      </div>
      <div class="seclink-caption">Communication <span class="accent">chiffrée</span></div>
    </div>

    <div class="seclink-points reveal delay-2">

      <div class="seclink-point">
        <h4>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 01-11.5 7.2L4 21l1.8-5.5A8 8 0 1121 12z"/><rect x="9.3" y="11" width="5.4" height="4" rx="0.8"/><path d="M10.5 11v-1a1.5 1.5 0 013 0v1"/></svg>
          Confidentialité des échanges
        </h4>
        <p>Visioconférence et partages protégés : vos réunions sensibles restent privées.</p>
      </div>

      <div class="seclink-point">
        <h4>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M9.5 10.5l2 2 3.5-3.5"/></svg>
          Salles maîtrisées
        </h4>
        <p>Équipements administrés et cloisonnés du réseau pour limiter les risques.</p>
      </div>

      <div class="seclink-point">
        <h4>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 11-2.3-5.6"/><path d="M20 4v4h-4"/><path d="M12 9v3l2 2"/></svg>
          Mises à jour &amp; supervision
        </h4>
        <p>Maintenance et mises à jour suivies : des salles fiables et à jour dans le temps.</p>
      </div>

    </div>
  </div>
</section>

<!-- ====================================================================
     PROCESS
     ==================================================================== -->
<section class="process" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="sec-head reveal">
      <h2 id="process-title">Une intégration <em>soignée</em>.</h2>
      <p>De l'écoute du besoin à la prise en main, en lien avec tous les acteurs du projet.</p>
    </div>

    <div class="regie-track reveal delay-1" aria-hidden="true">
      <span class="regie-tc regie-tc--1">00:00</span>
      <span class="regie-tc regie-tc--2">00:45</span>
      <span class="regie-tc regie-tc--3">01:30</span>
      <span class="regie-tc regie-tc--4">02:15</span>
      <div class="regie-ruler"></div>
      <div class="regie-bar"></div>
      <span class="regie-marker regie-marker--1"></span>
      <span class="regie-marker regie-marker--2"></span>
      <span class="regie-marker regie-marker--3"></span>
      <span class="regie-marker regie-marker--4"></span>
      <span class="regie-playhead"></span>
    </div>

    <div class="regie-steps reveal delay-2">
      <div class="clip">
        <h3>Écoute &amp; usages</h3>
        <p>Analyse des usages, des espaces et des contraintes techniques.</p>
      </div>
      <div class="clip">
        <h3>Architecture &amp; matériel</h3>
        <p>Sélection des équipements, tests et validation de la solution.</p>
      </div>
      <div class="clip">
        <h3>Intégration</h3>
        <p>Installation soignée et conforme, intégrée à votre environnement.</p>
      </div>
      <div class="clip">
        <h3>Prise en main</h3>
        <p>Formation des utilisateurs et maintenance pour une utilisation durable.</p>
      </div>
    </div>
  </div>
</section>

<!-- ====================================================================
     CTA — style maison (icône + corps + téléphone), commun aux pôles
     ==================================================================== -->
<section class="cta-section" id="contact" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-frame">
      <div class="cta-inner">
        <svg class="cta-icon reveal" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <!-- Écran de salle 16:9 -->
          <rect x="18" y="26" width="76" height="48" rx="5" stroke="#f4f4f4" stroke-width="1.1" opacity="0.30"/>

          <!-- Pied + base -->
          <g stroke="#f4f4f4" stroke-width="1.1" stroke-linecap="round" opacity="0.22">
            <line x1="56" y1="74" x2="56" y2="84"/>
            <line x1="42" y1="86" x2="70" y2="86"/>
          </g>

          <!-- Grille visio : deux tuiles participants + zone contenu -->
          <g stroke="#f4f4f4" stroke-width="0.9" opacity="0.14">
            <rect x="24" y="32" width="20" height="16" rx="2.5"/>
            <rect x="24" y="52" width="20" height="16" rx="2.5"/>
            <rect x="48" y="32" width="40" height="36" rx="2.5"/>
          </g>

          <!-- Participants : buste fine ligne -->
          <g stroke="#f4f4f4" stroke-width="0.9" stroke-linecap="round" opacity="0.30">
            <circle cx="34" cy="38.2" r="2.6"/>
            <path d="M29.5 45.4c1-2.5 2.9-3.2 4.5-3.2s3.5.7 4.5 3.2"/>
            <circle cx="34" cy="58.2" r="2.6"/>
            <path d="M29.5 65.4c1-2.5 2.9-3.2 4.5-3.2s3.5.7 4.5 3.2"/>
          </g>

          <!-- Contenu partagé : lignes de présentation -->
          <g stroke="#f4f4f4" stroke-width="0.9" stroke-linecap="round" opacity="0.18">
            <line x1="54" y1="40" x2="82" y2="40"/>
            <line x1="54" y1="46" x2="76" y2="46"/>
            <line x1="54" y1="52" x2="80" y2="52"/>
          </g>
          <!-- Courbe de flux — seul tracé accent dans l'écran -->
          <path d="M54 61c4-4.5 7 1.5 11-1.5s6-4 9-2 5.5 1 8-2.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.55"/>

          <!-- Barre visio posée sur l'écran : objectif accent + ping -->
          <rect x="48" y="17.5" width="16" height="7" rx="3.5" stroke="#f4f4f4" stroke-width="1" opacity="0.35"/>
          <circle cx="56" cy="21" r="1.7" fill="currentColor"/>
          <circle class="cta-vig-ping" cx="56" cy="21" r="6.5" stroke="currentColor" stroke-width="1"/>

          <!-- Diffusion : ondes rayonnantes (motif JCD) -->
          <g stroke="currentColor" stroke-width="1.1" stroke-linecap="round" fill="none">
            <path d="M99 42a11 11 0 010 16" opacity="0.45"/>
            <path d="M103 37.5a17 17 0 010 25" opacity="0.26"/>
            <path d="M107 33a23.5 23.5 0 010 34" opacity="0.12"/>
          </g>
        </svg>

        <div class="cta-body">
          <h2 class="cta-title reveal delay-1" id="cta-title">
            Un projet <em>audiovisuel&thinsp;?</em>
          </h2>
          <p class="cta-sub reveal delay-2">
            Visioconférence, affichage, salles hybrides… Et si on vous le montrait ? Demandez une démonstration.
          </p>
          <div class="cta-actions reveal delay-3">
            <a href="contact.html?pole=informatique" class="btn-cta btn-cta--primary">
              Contacter le pôle Informatique
              <span class="btn-cta-arrow"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
            </a>
            <span class="cta-actions-divider" aria-hidden="true"></span>
            <span class="cta-phone">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M2 3a1 1 0 011-1h3.28a1 1 0 01.95.68l1.07 3.21a1 1 0 01-.25 1L6.54 8.4a12.06 12.06 0 005.06 5.06l1.51-1.51a1 1 0 011-.25l3.21 1.07a1 1 0 01.68.95V17a1 1 0 01-1 1A15 15 0 012 3z"/></svg>
              <a href="tel:+33387184920" class="cta-phone-num">03 87 18 49 20</a>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

</main>

<Footer />


