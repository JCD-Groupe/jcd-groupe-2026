        }
        if (toTop) {
          toTop.addEventListener("click", function () {
            var rm = window.matchMedia(
              "(prefers-reduced-motion:reduce)",
            ).matches;
            try {
              window.scrollTo({ top: 0, behavior: rm ? "auto" : "smooth" });
            } catch (e) {
              window.scrollTo(0, 0);
            }
          });
        }
