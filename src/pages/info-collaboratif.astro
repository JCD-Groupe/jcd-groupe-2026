---
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavInformatique from "../components/NavInformatique.astro";

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let informatique = await directus.request(
  readSingleton("JCD_Informatique", {
    fields: ["nom_pole"],
  }),
);

let info_collaboratif = await directus.request(
  readSingleton("solutions_collaboratives_audiovisuelles", {
    fields: [
      "*",
      { prestations: ["*"] },
      { processus_cybersecurite: ["*"] },
      { processus: ["*"] },
    ],
  }),
);

const fetchSvgContent = async (id: string) => {
  if (!id) return null;
  const response = await fetch(
    `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${id}`,
  );
  return response.text();
};

info_collaboratif.prestations = await Promise.all(
  info_collaboratif.prestations.map(async (prestation: any) => ({
    ...prestation,
    icone_content: await fetchSvgContent(prestation.icone),
  })),
);

info_collaboratif.icone_cta_content = await fetchSvgContent(
  info_collaboratif.icone_cta,
);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon}`}
      type="image/svg+xml"
    />
    <meta name="description" content={info_collaboratif.meta_description} />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/info-collaboratif`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content={`${info_collaboratif.nom_service} • ${informatique.nom_pole} • ${global.nom_societe}`}
    />
    <meta
      property="og:description"
      content={info_collaboratif.meta_description}
    />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/info-collaboratif}`}
    />
    <meta name="twitter:card" content="summary" />
    <title>
      {info_collaboratif.nom_service} • {informatique.nom_pole} • {
        global.nom_societe
      }
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/info-collaboratif.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/info-collaboratif-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/infocompact.js" id="jcd-infocompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/page-boot.js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <div id="jcd-pagefade" aria-hidden="true"></div>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <!-- ====================================================================
     RAIL DE SOUS-NAVIGATION — écosystème Informatique
     Ancré en permanence sous le navbar. Libellés complets, page active
     en bleu JCD. Permet de naviguer entre la vue d'ensemble et les 4
     domaines du pôle.
     ==================================================================== -->
    <NavInformatique current="info-collaboratif" />

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ====================================================================
     HERO — épinglé (sticky), fond animé. Couche WebGL (.hero-mesh) à
     brancher plus tard ; le fallback CSS reste visible d'ici là.
     ==================================================================== -->
        <section class="print-hero" aria-labelledby="hero-title">
          <div class="hero-mesh-fallback" aria-hidden="true"></div>
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>
          <div class="hero-texture" aria-hidden="true"></div>
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1
              id="hero-title"
              class="hero-title reveal delay-1"
              set:html={info_collaboratif.titre_hero}
            />

            <p class="hero-sub reveal delay-2">
              {info_collaboratif.sous_titre_hero}
            </p>
            <div class="hero-actions reveal delay-3">
              <a
                href="/contact?pole=informatique&step=2"
                class="btn-cta btn-cta--ghost"
              >
                Demander une démonstration
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ====================================================================
     MANIFESTE — feuille sticky (JetBrains Mono) qui glisse par-dessus le
     hero épinglé. Personnalisable par section.
     ==================================================================== -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="info-sheet">
            <div class="container">
              <header class="mf-head reveal">
                <span class="mf-head-side">
                  <span class="mf-caret" aria-hidden="true">&#9656;</span>
                  <span class="mf-id">{info_collaboratif.manifeste_id}</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Manifeste</span>
                </span>
                <span class="mf-head-side">
                  <span>Pôle Informatique</span>
                </span>
              </header>
              <blockquote
                class="manifesto-quote manifesto-rich reveal delay-1"
                id="manifesto-title"
                set:html={info_collaboratif.manifeste}
              />
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone : hero sticky + manifeste qui glisse par-dessus -->

      <!-- ====================================================================
     PRESTATIONS
     ==================================================================== -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prest-title"
      >
        <div class="container">
          <div class="sec-head reveal">
            <h2
              id="prest-title"
              set:html={info_collaboratif.titre_prestations}
            />
            <p set:html={info_collaboratif.sous_titre_prestations} />
          </div>
          <div class="prest-grid reveal delay-1">
            {
              info_collaboratif.prestations.map((prestation: any) => (
                <article class="prest-item">
                  <div class="prest-item-head">
                    <span
                      class="prest-item-glyph"
                      aria-hidden="true"
                      set:html={prestation.icone_content}
                    />
                  </div>
                  <h3 class="prest-item-title">{prestation.titre}</h3>
                  <p class="prest-item-desc">{prestation.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ====================================================================
     SÉCURITÉ BY DESIGN — cybersécurité distillée (accent cyan)
     ==================================================================== -->
      <section class="secblock" aria-labelledby="sec-title">
        <div class="container">
          <div class="secblock-head secblock-head--center reveal">
            <h2
              id="sec-title"
              set:html={info_collaboratif.titre_processus_cybersecurite}
            />
            <p>{info_collaboratif.sous_titre_processus_cybersecurite}</p>
            <a href="/informatique#cybersecurite" class="secblock-link">
              {info_collaboratif.bouton_processus_cybersecurite}
              <svg
                viewBox="0 0 16 16"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
              >
            </a>
          </div>

          <div class="seclink reveal delay-1" aria-hidden="true">
            <div class="seclink-band">
              <div class="seclink-end">
                <span class="seclink-end-ic"
                  ><svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><rect x="2.5" y="4" width="19" height="13" rx="2"
                    ></rect><path d="M8 21h8M12 17v4"></path><path
                      d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01"></path></svg
                  ></span
                ><span
                  class="seclink-end-lab"
                  set:html={info_collaboratif.processus_cybersecurite_label_01}
                />
              </div>

              <div class="seclink-wave">
                <svg viewBox="0 0 1000 120" preserveAspectRatio="none">
                  <defs>
                    <linearGradient
                      id="clWave"
                      x1="0"
                      y1="0"
                      x2="1000"
                      y2="0"
                      gradientUnits="userSpaceOnUse"
                    >
                      <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.55"
                      ></stop>
                      <stop
                        offset="0.16"
                        stop-color="#4FC9E2"
                        stop-opacity="0.38"></stop>
                      <stop offset="0.5" stop-color="#4FC9E2" stop-opacity="0.8"
                      ></stop>
                      <stop
                        offset="0.84"
                        stop-color="#4FC9E2"
                        stop-opacity="0.38"></stop>
                      <stop offset="1" stop-color="#4FC9E2" stop-opacity="0.55"
                      ></stop>
                    </linearGradient>
                  </defs>
                  <path
                    stroke="rgba(79,201,226,0.13)"
                    stroke-width="4"
                    fill="none"
                    vector-effect="non-scaling-stroke"
                    d="M0 60 C50 60 85 70 130 70 S225 44 275 48 S365 76 415 72 S480 52 500 56 S595 78 645 74 S735 40 790 46 S895 68 945 64 S1000 60 1000 60"
                  ></path>
                  <path
                    stroke="url(#clWave)"
                    stroke-width="1.6"
                    fill="none"
                    vector-effect="non-scaling-stroke"
                    d="M0 60 C40 60 70 48 115 48 S205 74 255 72 S350 38 400 42 S475 70 500 64 S585 40 635 44 S730 80 785 74 S890 50 940 54 S1000 60 1000 60"
                  ></path>
                </svg>
              </div>

              <div class="seclink-lock">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="5" y="11" width="14" height="9" rx="2"></rect><path
                    d="M8 11V8a4 4 0 0 1 8 0v3"></path><path d="M12 15v2"
                  ></path></svg
                >
              </div>

              <div class="seclink-end">
                <span class="seclink-end-ic"
                  ><svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                    ></path><circle cx="9" cy="7" r="4"></circle><path
                      d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"
                    ></path></svg
                  ></span
                ><span
                  class="seclink-end-lab"
                  set:html={info_collaboratif.processus_cybersecurite_label_03}
                />
              </div>
            </div>
            <div
              class="seclink-caption"
              set:html={info_collaboratif.processus_cybersecurite_label_02}
            />
          </div>
          <div class="seclink-points reveal delay-2">
            <div class="seclink-point">
              <h4>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  ><path
                    d="M21 12a8 8 0 01-11.5 7.2L4 21l1.8-5.5A8 8 0 1121 12z"
                  ></path><rect x="9.3" y="11" width="5.4" height="4" rx="0.8"
                  ></rect><path d="M10.5 11v-1a1.5 1.5 0 013 0v1"></path></svg
                >
                {info_collaboratif.processus_cybersecurite[0]?.titre}
              </h4>
              <p>
                {info_collaboratif.processus_cybersecurite[0]?.description}
              </p>
            </div>

            <div class="seclink-point">
              <h4>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  ><rect x="2.5" y="4" width="19" height="13" rx="2"
                  ></rect><path d="M8 21h8M12 17v4"></path><path
                    d="M9.5 10.5l2 2 3.5-3.5"></path></svg
                >
                {info_collaboratif.processus_cybersecurite[1]?.titre}
              </h4>
              <p>
                {info_collaboratif.processus_cybersecurite[1]?.description}
              </p>
            </div>

            <div class="seclink-point">
              <h4>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  ><path d="M20 12a8 8 0 11-2.3-5.6"></path><path d="M20 4v4h-4"
                  ></path><path d="M12 9v3l2 2"></path></svg
                >
                {info_collaboratif.processus_cybersecurite[2]?.titre}
              </h4>
              <p>
                {info_collaboratif.processus_cybersecurite[2]?.description}
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     PROCESS
     ==================================================================== -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="sec-head reveal">
            <h2
              id="process-title"
              set:html={info_collaboratif.titre_processus}
            />
            <p>{info_collaboratif.sous_titre_processus}</p>
          </div>
          <div class="regie-track reveal delay-1" aria-hidden="true">
            <span class="regie-tc regie-tc--1">00:00</span>
            <span class="regie-tc regie-tc--2">00:45</span>
            <span class="regie-tc regie-tc--3">01:30</span>
            <span class="regie-tc regie-tc--4">02:15</span>
            <div class="regie-ruler"></div>
            <div class="regie-bar"></div>
            <span class="regie-marker regie-marker--1"></span>
            <span class="regie-marker regie-marker--2"></span>
            <span class="regie-marker regie-marker--3"></span>
            <span class="regie-marker regie-marker--4"></span>
            <span class="regie-playhead"></span>
          </div>
          <div class="regie-steps reveal delay-2">
            {
              info_collaboratif.processus.map((clip: any) => (
                <div class="clip">
                  <h3>{clip.titre}</h3>
                  <p>{clip.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ====================================================================
     CTA — style maison (icône + corps + téléphone), commun aux pôles
     ==================================================================== -->
      <section class="cta-section" id="contact" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-frame">
            <div class="cta-inner">
              <svg
                class="cta-icon reveal"
                viewBox="0 0 120 120"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
                focusable="false"
              >
                <!-- Écran de salle 16:9 -->
                <rect
                  x="18"
                  y="26"
                  width="76"
                  height="48"
                  rx="5"
                  stroke="#f4f4f4"
                  stroke-width="1.1"
                  opacity="0.30"></rect>

                <!-- Pied + base -->
                <g
                  stroke="#f4f4f4"
                  stroke-width="1.1"
                  stroke-linecap="round"
                  opacity="0.22"
                >
                  <line x1="56" y1="74" x2="56" y2="84"></line>
                  <line x1="42" y1="86" x2="70" y2="86"></line>
                </g>

                <!-- Grille visio : deux tuiles participants + zone contenu -->
                <g stroke="#f4f4f4" stroke-width="0.9" opacity="0.14">
                  <rect x="24" y="32" width="20" height="16" rx="2.5"></rect>
                  <rect x="24" y="52" width="20" height="16" rx="2.5"></rect>
                  <rect x="48" y="32" width="40" height="36" rx="2.5"></rect>
                </g>

                <!-- Participants : buste fine ligne -->
                <g
                  stroke="#f4f4f4"
                  stroke-width="0.9"
                  stroke-linecap="round"
                  opacity="0.30"
                >
                  <circle cx="34" cy="38.2" r="2.6"></circle>
                  <path d="M29.5 45.4c1-2.5 2.9-3.2 4.5-3.2s3.5.7 4.5 3.2"
                  ></path>
                  <circle cx="34" cy="58.2" r="2.6"></circle>
                  <path d="M29.5 65.4c1-2.5 2.9-3.2 4.5-3.2s3.5.7 4.5 3.2"
                  ></path>
                </g>

                <!-- Contenu partagé : lignes de présentation -->
                <g
                  stroke="#f4f4f4"
                  stroke-width="0.9"
                  stroke-linecap="round"
                  opacity="0.18"
                >
                  <line x1="54" y1="40" x2="82" y2="40"></line>
                  <line x1="54" y1="46" x2="76" y2="46"></line>
                  <line x1="54" y1="52" x2="80" y2="52"></line>
                </g>
                <!-- Courbe de flux — seul tracé accent dans l'écran -->
                <path
                  d="M54 61c4-4.5 7 1.5 11-1.5s6-4 9-2 5.5 1 8-2.5"
                  stroke="currentColor"
                  stroke-width="1.1"
                  stroke-linecap="round"
                  opacity="0.55"></path>

                <!-- Barre visio posée sur l'écran : objectif accent + ping -->
                <rect
                  x="48"
                  y="17.5"
                  width="16"
                  height="7"
                  rx="3.5"
                  stroke="#f4f4f4"
                  stroke-width="1"
                  opacity="0.35"></rect>
                <circle cx="56" cy="21" r="1.7" fill="currentColor"></circle>
                <circle
                  class="cta-vig-ping"
                  cx="56"
                  cy="21"
                  r="6.5"
                  stroke="currentColor"
                  stroke-width="1"></circle>

                <!-- Diffusion : ondes rayonnantes (motif JCD) -->
                <g
                  stroke="currentColor"
                  stroke-width="1.1"
                  stroke-linecap="round"
                  fill="none"
                >
                  <path d="M99 42a11 11 0 010 16" opacity="0.45"></path>
                  <path d="M103 37.5a17 17 0 010 25" opacity="0.26"></path>
                  <path d="M107 33a23.5 23.5 0 010 34" opacity="0.12"></path>
                </g>
              </svg>

              <div class="cta-body">
                <h2
                  class="cta-title reveal delay-1"
                  id="cta-title"
                  set:html={info_collaboratif.titre_cta}
                />
                <p
                  class="cta-sub reveal delay-2"
                  set:html={info_collaboratif.sous_titre_cta}
                />
                <div class="cta-actions reveal delay-3">
                  <a
                    href="/contact?pole=informatique&step=2"
                    class="btn-cta btn-cta--primary"
                  >
                    {info_collaboratif.bouton_cta}
                    <span class="btn-cta-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </a>
                  <span class="cta-actions-divider" aria-hidden="true"></span>
                  <span class="cta-phone">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      width="14"
                      height="14"
                      ><path
                        d="M2 3a1 1 0 011-1h3.28a1 1 0 01.95.68l1.07 3.21a1 1 0 01-.25 1L6.54 8.4a12.06 12.06 0 005.06 5.06l1.51-1.51a1 1 0 011-.25l3.21 1.07a1 1 0 01.68.95V17a1 1 0 01-1 1A15 15 0 012 3z"
                      ></path></svg
                    >
                    <a href="tel:+33387184920" class="cta-phone-num"
                      >03 87 18 49 20</a
                    >
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline src="/js/pages/info-collaboratif-1.js"></script>
    <script is:inline src="/js/shared/menu-frost.js"></script>
    <!-- jcd-mobile-nav (injected) -->
    <button
      class="jcd-burger"
      id="jcdBurger"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="jcdMnav"
    >
      <span class="jcd-burger__box" aria-hidden="true"
        ><i></i><i></i><i></i></span
      >
    </button>
    <div
      class="jcd-mnav"
      id="jcdMnav"
      role="dialog"
      aria-modal="true"
      aria-label="Menu de navigation"
      aria-hidden="true"
    >
      <div class="jcd-mnav__scroll">
        <div class="jcd-mnav__inner">
          <p
            class="jcd-mnav__eyebrow jcd-mnav__reveal"
            style="transition-delay:.04s"
          >
            Expertises
          </p>

          <div class="jcd-mnav__reveal" style="transition-delay:.07s">
            <div class="jcd-mnav__item" style="--mnav-c:#2E72BA">
              <a class="jcd-mnav__link" href="/informatique"
                ><span class="jcd-mnav__dot"></span><span
                  class="jcd-mnav__label">Informatique</span
                ></a
              >
              <button
                class="jcd-acc__toggle"
                type="button"
