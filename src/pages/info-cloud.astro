                    <stop offset="0.55" stop-color="#4FC9E2" stop-opacity="0.14"
                    ></stop>
                    <stop offset="1" stop-color="#FFFFFF" stop-opacity="0.05"
                    ></stop>
                  </linearGradient>
                  <!-- Le balayage est rogné à la voûte : rien ne dépasse sous l'horizon,
                 le rebouclage (-24° → 156°) se produit hors champ. -->
                  <clipPath id="skClip">
                    <path d="M60 360 A320 320 0 0 1 700 360 Z"></path>
                  </clipPath>
                </defs>

                <!-- voûte : remplissage à peine teinté, plus dense vers l'horizon -->
                <path d="M60 360 A320 320 0 0 1 700 360 Z" fill="url(#skDome)"
                ></path>

                <!-- secteurs de veille (illuminés au survol des cartes) + labels -->
                <g class="sk-s1">
                  <path
                    class="sk-sector"
                    d="M380 360 L60 360 A320 320 0 0 1 220 82.9 Z"></path>
                  <text x="79" y="186" class="sk-lab"
                    >01 · {info_cloud.processus_cybersecurite_label_01}</text
                  >
                </g>
                <g class="sk-s2">
                  <path
                    class="sk-sector"
                    d="M380 360 L220 82.9 A320 320 0 0 1 540 82.9 Z"></path>
                  <text x="380" y="24" class="sk-lab"
                    >02 · {info_cloud.processus_cybersecurite_label_02}</text
                  >
                </g>
                <g class="sk-s3">
                  <path
                    class="sk-sector"
                    d="M380 360 L540 82.9 A320 320 0 0 1 700 360 Z"></path>
                  <text x="681" y="186" class="sk-lab"
