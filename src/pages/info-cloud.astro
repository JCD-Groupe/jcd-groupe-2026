              {info_cloud.bouton_processus_cybersecurite}
              <svg
                viewBox="0 0 16 16"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
              >
            </a>
          </div>

          <div class="skywatch reveal delay-1">
            <div class="sky-dome" aria-hidden="true">
              <svg viewBox="0 0 760 400" fill="none">
                <defs>
                  <radialGradient id="skDome" cx="0.5" cy="1" r="0.9">
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.05"
                    ></stop>
                    <stop offset="0.6" stop-color="#4FC9E2" stop-opacity="0.018"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </radialGradient>
                  <linearGradient id="skSweep" x1="0.1" y1="0" x2="0.55" y2="1">
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.26"
                    ></stop>
                    <stop offset="0.55" stop-color="#4FC9E2" stop-opacity="0.07"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </linearGradient>
                  <linearGradient
                    id="skBase"
                    x1="0"
                    y1="0"
                    x2="760"
                    y2="0"
                    gradientUnits="userSpaceOnUse"
