---
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavInformatique from "../components/NavInformatique.astro";

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let info_cloud = await directus.request(
  readSingleton("cloud_microsoft", {
    fields: [
      "*",
      { prestations: ["*"] },
      { processus_cybersecurite: ["*"] },
      { processus: ["*"] },
    ],
  }),
);

const fetchSvgContent = async (id: string) => {
  if (!id) return null;
  const response = await fetch(
    `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${id}`,
  );
  return response.text();
};

function contient(cherche: string, str: string) {
  // Normalise un texte (supprime les accents et passe en minuscules)
  const normaliser = (s: string) =>
    s
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase();

  const texte = normaliser(str);

  // Si "cherche" est un tableau de mots (ex: ["telephonie", "mobile", "internet"])
  if (Array.isArray(cherche)) {
    return cherche.some((mot) => texte.includes(normaliser(mot)));
  }

  // Si "cherche" est une simple chaîne de caractères
  return texte.includes(normaliser(cherche));
}

info_cloud.prestations = await Promise.all(
  info_cloud.prestations.map(async (prestation: any) => ({
    ...prestation,
    icone_content: await fetchSvgContent(prestation.icone),
  })),
);

info_cloud.icone_cta_content = await fetchSvgContent(info_cloud.icone_cta);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={info_cloud.meta_description} />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/info-cloud`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content={`${info_cloud.nom_service} · Informatique · ${global.nom_societe}`}
    />
    <meta property="og:description" content={info_cloud.meta_description} />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/info-cloud`}
    />
    <meta name="twitter:card" content="summary" />
    <title>
      {info_cloud.nom_service} · Informatique · {global.nom_societe}
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/info-cloud.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/info-cloud-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/infocompact.js" id="jcd-infocompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/page-boot.js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <div id="jcd-pagefade" aria-hidden="true"></div>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <!-- ====================================================================
     RAIL DE SOUS-NAVIGATION — écosystème Informatique
     Ancré en permanence sous le navbar. Libellés complets, page active
     en bleu JCD. Permet de naviguer entre la vue d'ensemble et les 4
     domaines du pôle.
     ==================================================================== -->
    <NavInformatique current="info-cloud" />

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ====================================================================
     HERO — épinglé (sticky), fond animé. La couche WebGL (.hero-mesh)
     sera branchée plus tard ; le fallback CSS reste visible d'ici là.
     ==================================================================== -->
        <section class="print-hero" aria-labelledby="hero-title">
          <div class="hero-mesh-fallback" aria-hidden="true"></div>
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>
          <div class="hero-texture" aria-hidden="true"></div>
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1
              id="hero-title"
              class="hero-title reveal delay-1"
              set:html={info_cloud.titre_hero}
            />

            <p
              class="hero-sub reveal delay-2"
              set:html={info_cloud.sous_titre_hero}
            />

            <div class="hero-actions reveal delay-3">
              <a
                href="/contact?pole=informatique&step=2"
                class="btn-cta btn-cta--ghost"
              >
                {info_cloud.bouton_hero}
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ====================================================================
     MANIFESTE — feuille sticky (JetBrains Mono) qui glisse par-dessus
     le hero épinglé. Personnalisable par section.
     ==================================================================== -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="info-sheet">
            <div class="container">
              <header class="mf-head reveal">
                <span class="mf-head-side">
                  <span class="mf-caret" aria-hidden="true">&#9656;</span>
                  <span class="mf-id">{info_cloud.manifeste_id}</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Manifeste</span>
                </span>
                <span class="mf-head-side">
                  <span>Pôle Informatique</span>
                </span>
              </header>

              <div class="mf-cols">
                <blockquote
                  class="manifesto-quote manifesto-rich reveal delay-1"
                  id="manifesto-title"
                  set:html={info_cloud.manifeste}
                >
                  <span class="mf-cursor" aria-hidden="true"></span>
                </blockquote>
              </div>
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone : hero sticky + manifeste qui glisse par-dessus -->

      <!-- ====================================================================
     PRESTATIONS
     ==================================================================== -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prest-title"
      >
        <div class="container">
          <div class="sec-head reveal">
            <h2 id="prest-title" set:html={info_cloud.titre_prestations} />
            <p set:html={info_cloud.sous_titre_prestations} />
          </div>

          <div class="prest-grid reveal delay-1">
            {
              info_cloud.prestations.map((prestation: any, index: number) => (
                <article
                  class:list={["prest-item", { "prest-item--wide": index > 2 }]}
                >
                  <div class="prest-item-head">
                    <span
                      class="prest-item-glyph"
                      aria-hidden="true"
                      set:html={prestation.icone_content}
                    />
                  </div>
                  <h3 class="prest-item-title" set:html={prestation.titre} />
                  <p
                    class="prest-item-desc"
                    set:html={prestation.description}
                  />
                  {contient("telephonie", prestation.titre) && (
                    <a class="prest-cta" href="/telecom">
                      Découvrez nos offres télécom
                      <svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M3 8h10M9 4l4 4-4 4" />
                      </svg>
                    </a>
                  )}
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ====================================================================
     SÉCURITÉ OPÉRÉE — cybersécurité distillée (réponses questionnaire)
     ==================================================================== -->
      <section class="secblock" aria-labelledby="sec-title">
        <div class="container">
          <div class="secblock-head secblock-head--center reveal">
            <h2
