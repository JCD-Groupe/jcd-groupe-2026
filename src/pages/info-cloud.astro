              </p>
              <a
                href="/contact?pole=informatique&step=2"
                class="sky-offer-link"
              >
                En profiter
                <svg
                  viewBox="0 0 16 16"
                  width="14"
                  height="14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                >
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     PROCESS
     ==================================================================== -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="sec-head reveal">
            <h2 id="process-title" set:html={info_cloud.titre_processus} />
            <p set:html={info_cloud.sous_titre_processus} />
          </div>

          <div class="flightpath reveal delay-1">
            <div class="fp-sky" aria-hidden="true">
              <svg viewBox="0 0 1000 250" fill="none">
                <defs>
                  <linearGradient
                    id="fpStroke"
                    x1="0"
                    y1="0"
                    x2="1000"
                    y2="0"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop offset="0" stop-color="#2E72BA" stop-opacity="0.30"
                    ></stop>
                    <stop offset="1" stop-color="#5290cb" stop-opacity="0.95"
                    ></stop>
                  </linearGradient>
                </defs>

                <!-- repères : départ au sol (votre SI) → arrivée en altitude (cloud) -->
                <text x="14" y="243" class="fp-tag"
                  >{info_cloud.processus_label_debut}</text
                >
                <text
                  x="986"
                  y="22"
                  class="fp-tag fp-tag-cloud"
                  text-anchor="end">{info_cloud.processus_label_fin}</text
                >
                <g
                  class="fp-cloud-ic"
                  transform="translate(922 7.5) scale(0.62)"
                  ><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"
                  ></path></g
                >

                <!-- descentes pointillées jalons → étapes -->
                <line
                  class="fp-drop fp-drop-1"
                  x1="125"
                  y1="207"
                  x2="125"
                  y2="246"></line>
                <line
                  class="fp-drop fp-drop-2"
                  x1="375"
                  y1="159"
                  x2="375"
                  y2="246"></line>
                <line
                  class="fp-drop fp-drop-3"
                  x1="625"
                  y1="111"
                  x2="625"
                  y2="246"></line>
                <line
                  class="fp-drop fp-drop-4"
                  x1="875"
                  y1="63"
                  x2="875"
                  y2="246"></line>

                <!-- route d'ascension : pointillés (toujours) + tracé qui se dessine
               + progression lumineuse (étendue au survol des étapes) -->
                <path
                  class="fp-route-base"
                  d="M 0 222 C 69 222 56 196 125 196 C 263 196 237 148 375 148 C 513 148 487 100 625 100 C 763 100 737 52 875 52 C 944 52 931 36 1000 36"
                ></path>
                <path
                  class="fp-route"
                  pathLength="100"
                  d="M 0 222 C 69 222 56 196 125 196 C 263 196 237 148 375 148 C 513 148 487 100 625 100 C 763 100 737 52 875 52 C 944 52 931 36 1000 36"
                ></path>
                <path
                  class="fp-progress"
                  pathLength="100"
                  d="M 0 222 C 69 222 56 196 125 196 C 263 196 237 148 375 148 C 513 148 487 100 625 100 C 763 100 737 52 875 52 C 944 52 931 36 1000 36"
                ></path>

                <!-- jalons posés sur la courbe -->
                <g class="fp-node fp-n1"
                  ><circle class="fp-ring" cx="125" cy="196" r="8"
                  ></circle><circle class="fp-core" cx="125" cy="196" r="3.4"
                  ></circle></g
                >
                <g class="fp-node fp-n2"
                  ><circle class="fp-ring" cx="375" cy="148" r="8"
                  ></circle><circle class="fp-core" cx="375" cy="148" r="3.4"
                  ></circle></g
                >
                <g class="fp-node fp-n3"
                  ><circle class="fp-ring" cx="625" cy="100" r="8"
                  ></circle><circle class="fp-core" cx="625" cy="100" r="3.4"
                  ></circle></g
                >
                <g class="fp-node fp-n4"
                  ><circle class="fp-ring" cx="875" cy="52" r="8"
                  ></circle><circle class="fp-core" cx="875" cy="52" r="3.4"
                  ></circle></g
                >

                <!-- arrivée cloud : halo + point au bout du tracé -->
                <g class="fp-node fp-end"
                  ><circle class="fp-end-glow" cx="1000" cy="36" r="12"
                  ></circle><circle class="fp-end-dot" cx="1000" cy="36" r="2.6"
                  ></circle></g
                >
              </svg>
            </div>

            <ol class="fp-steps">
              {
                info_cloud.processus.map((etapes: any) => (
                  <li class="fp-step">
                    <h3 set:html={etapes.titre} />
                    <p set:html={etapes.description} />
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     CTA — style maison (icône + corps + téléphone), commun aux pôles
     ==================================================================== -->
      <section class="cta-section" id="contact" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-frame">
            <div class="cta-inner">
              <span
                class="cta-icon reveal"
                aria-hidden="true"
                set:html={info_cloud.icone_cta_content}
              />

              <div class="cta-body">
                <h2
                  class="cta-title reveal delay-1"
                  id="cta-title"
                  set:html={info_cloud.titre_cta}
                />
                <p
                  class="cta-sub reveal delay-2"
                  set:html={info_cloud.sous_titre_cta}
                />
                <div class="cta-actions reveal delay-3">
                  <a
                    href="/contact?pole=informatique&step=2"
                    class="btn-cta btn-cta--primary"
                  >
                    {info_cloud.bouton_cta}
                    <span class="btn-cta-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </a>
                  <span class="cta-actions-divider" aria-hidden="true"></span>
                  <span class="cta-phone">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      width="14"
                      height="14"
                      ><path
                        d="M2 3a1 1 0 011-1h3.28a1 1 0 01.95.68l1.07 3.21a1 1 0 01-.25 1L6.54 8.4a12.06 12.06 0 005.06 5.06l1.51-1.51a1 1 0 011-.25l3.21 1.07a1 1 0 01.68.95V17a1 1 0 01-1 1A15 15 0 012 3z"
                      ></path></svg
                    >
                    <a href="tel:+33387184920" class="cta-phone-num"
                      >03 87 18 49 20</a
                    >
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />

