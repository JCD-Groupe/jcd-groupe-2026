                  style="--sk-arcop: 0.22"
                  d="M60 360 A320 320 0 0 1 700 360"
                  stroke-dasharray="2 7"></path>
                <path
                  class="sk-arc"
                  style="--sk-arcop: 0.12"
                  d="M140 360 A240 240 0 0 1 620 360"></path>
                <path
                  class="sk-arc"
                  style="--sk-arcop: 0.09"
                  d="M220 360 A160 160 0 0 1 540 360"></path>
                <path
                  class="sk-arc"
                  style="--sk-arcop: 0.07"
                  d="M300 360 A80 80 0 0 1 460 360"></path>
                <path
                  class="sk-ticks"
                  d="M92 356.5 V360 M124 356.5 V360 M156 356.5 V360 M188 356.5 V360 M220 356.5 V360 M252 356.5 V360 M284 356.5 V360 M316 356.5 V360 M444 356.5 V360 M476 356.5 V360 M508 356.5 V360 M540 356.5 V360 M572 356.5 V360 M604 356.5 V360 M636 356.5 V360 M668 356.5 V360"
                  stroke-width="1"></path>
                <line class="sk-ray" x1="449.3" y1="320" x2="657.1" y2="200"
                ></line>
                <line class="sk-ray" x1="420" y1="290.7" x2="540" y2="82.9"
                ></line>
                <line class="sk-ray" x1="380" y1="280" x2="380" y2="40"></line>
                <line class="sk-ray" x1="340" y1="290.7" x2="220" y2="82.9"
                ></line>
                <line class="sk-ray" x1="310.7" y1="320" x2="102.9" y2="200"
                ></line>

                <!-- faisceau de balayage (rotation continue gauche → droite) —
               le clip est porté par le groupe PARENT fixe : il resterait
               solidaire du faisceau s'il était posé sur le groupe animé. -->
                <g clip-path="url(#skClip)">
                  <g class="sk-sweep">
                    <path
                      d="M380 360 L87.7 229.9 A320 320 0 0 0 60 360 Z"
                      fill="url(#skSweep)"></path>
                    <line class="sk-beam" x1="380" y1="360" x2="87.7" y2="229.9"
                    ></line>
                    <circle class="sk-beam-tip" cx="87.7" cy="229.9" r="3"
