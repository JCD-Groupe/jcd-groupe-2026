                <!-- échos détectés (pulse phasé sur le passage du faisceau) -->
                <g class="sk-blip" style="animation-delay: 0.98s"
                  ><circle
                    class="sk-bcore"
                    cx="170"
                    cy="280"
                    r="3"
                    fill="#4FC9E2"></circle><circle
                    class="sk-bw sk-bw1"
                    cx="170"
                    cy="280"
                    r="9"
                    stroke="rgba(79,201,226,0.45)"
                    stroke-width="1"></circle><circle
                    class="sk-bw sk-bw2"
                    cx="170"
                    cy="280"
                    r="9"
                    stroke="rgba(79,201,226,0.30)"
                    stroke-width="1"></circle></g
                >
                <g class="sk-blip" style="animation-delay: 2.71s"
                  ><circle
                    class="sk-bcore"
                    cx="255"
                    cy="160"
                    r="3"
                    fill="#4FC9E2"></circle><circle
                    class="sk-bw sk-bw1"
                    cx="255"
                    cy="160"
                    r="9"
                    stroke="rgba(79,201,226,0.45)"
                    stroke-width="1"></circle><circle
                    class="sk-bw sk-bw2"
                    cx="255"
                    cy="160"
                    r="9"
                    stroke="rgba(79,201,226,0.30)"
                    stroke-width="1"></circle></g
                >
                <g class="sk-blip" style="animation-delay: 4.75s"
                  ><circle
                    class="sk-bcore"
                    cx="430"
                    cy="120"
                    r="3"
                    fill="#4FC9E2"></circle><circle
                    class="sk-bw sk-bw1"
                    cx="430"
                    cy="120"
                    r="9"
                    stroke="rgba(79,201,226,0.45)"
                    stroke-width="1"></circle><circle
                    class="sk-bw sk-bw2"
                    cx="430"
                    cy="120"
                    r="9"
                    stroke="rgba(79,201,226,0.30)"
                    stroke-width="1"></circle></g
                >
                <g class="sk-blip" style="animation-delay: 6.53s"
                  ><circle
                    class="sk-bcore"
                    cx="565"
                    cy="205"
                    r="3"
                    fill="#4FC9E2"></circle><circle
                    class="sk-bw sk-bw1"
                    cx="565"
                    cy="205"
                    r="9"
                    stroke="rgba(79,201,226,0.45)"
                    stroke-width="1"></circle><circle
                    class="sk-bw sk-bw2"
                    cx="565"
                    cy="205"
                    r="9"
                    stroke="rgba(79,201,226,0.30)"
                    stroke-width="1"></circle></g
                >
                <g class="sk-blip" style="animation-delay: 7.79s"
                  ><circle
                    class="sk-bcore"
                    cx="640"
                    cy="300"
                    r="3"
                    fill="#4FC9E2"></circle><circle
                    class="sk-bw sk-bw1"
                    cx="640"
                    cy="300"
                    r="9"
                    stroke="rgba(79,201,226,0.45)"
                    stroke-width="1"></circle><circle
                    class="sk-bw sk-bw2"
                    cx="640"
                    cy="300"
                    r="9"
                    stroke="rgba(79,201,226,0.30)"
                    stroke-width="1"></circle></g
                >

                <!-- horizon : votre SI (g) ↔ cloud public (d), SOC au centre -->
                <line
                  x1="36"
                  y1="360"
                  x2="724"
                  y2="360"
                  stroke="url(#skBase)"
                  stroke-width="1"></line>
                <circle
                  cx="60"
                  cy="360"
                  r="4"
                  stroke="#4FC9E2"
                  stroke-opacity="0.55"></circle>
                <circle
                  cx="60"
                  cy="360"
                  r="1.6"
                  fill="#4FC9E2"
                  fill-opacity="0.8"></circle>
                <circle
                  cx="700"
                  cy="360"
                  r="4"
                  stroke="#4FC9E2"
                  stroke-opacity="0.55"></circle>
                <circle
                  cx="700"
                  cy="360"
                  r="1.6"
                  fill="#4FC9E2"
                  fill-opacity="0.8"></circle>
                <text x="60" y="388" class="sk-end">VOTRE SI</text>
                <text x="700" y="388" class="sk-end">CLOUD PUBLIC</text>
                <text x="380" y="388" class="sk-end sk-soc">SOC · 24/7</text>

                <!-- cœur bouclier (verre) à la base du dôme -->
                <path
                  d="M330 360 A50 50 0 0 1 430 360 Z"
                  fill="rgba(79,201,226,0.07)"
                  stroke="url(#skRim)"
                  stroke-width="1.1"></path>
                <ellipse cx="368" cy="334" rx="18" ry="9" fill="url(#skSpec)"
                ></ellipse>
                <g class="sk-shield">
                  <path
                    d="M380 318 l14 5.2 v10.4 c0 9.6 -6.6 15.3 -14 17.9 c-7.4 -2.6 -14 -8.3 -14 -17.9 v-10.4 z"
                    stroke="#4FC9E2"
                    stroke-width="1.6"
