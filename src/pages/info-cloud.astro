---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="JCD Groupe · Pôle Informatique. Partenaire Tier 1 Microsoft : déploiement et optimisation de Microsoft 365, Azure, téléphonie Teams et gouvernance du cloud. 11 ans d'expertise, 200 000+ utilisateurs suivis."
    />
    <link rel="canonical" href="https://www.jcd-groupe.fr/info-cloud.html" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content="Cloud Microsoft 365 & Azure · Informatique · JCD Groupe"
    />
    <meta
      property="og:description"
      content="JCD Groupe · Pôle Informatique. Partenaire Tier 1 Microsoft : déploiement et optimisation de Microsoft 365, Azure, téléphonie Teams et gouvernance du cloud. 11 ans d'expertise, 200 000+ utilisateurs suivis."
    />
    <meta
      property="og:url"
      content="https://www.jcd-groupe.fr/info-cloud.html"
    />
    <meta name="twitter:card" content="summary" />
    <title>Cloud Microsoft 365 &amp; Azure · Informatique · JCD Groupe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="css/info-cloud.css" />
    <link rel="stylesheet" href="css/global.css" />
    <link rel="stylesheet" href="css/info-cloud-overrides.css" />
    <link rel="stylesheet" href="transition.css" />
    <script is:inline src="transition.js"></script>
    <script is:inline src="js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="js/shared/infocompact.js" id="jcd-infocompact-js"
    ></script>
    <script is:inline src="js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="js/shared/page-boot.js"></script>
    <script is:inline src="js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <div id="jcd-pagefade" aria-hidden="true"></div>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <!-- ====================================================================
     RAIL DE SOUS-NAVIGATION — écosystème Informatique
     Ancré en permanence sous le navbar. Libellés complets, page active
     en bleu JCD. Permet de naviguer entre la vue d'ensemble et les 4
     domaines du pôle.
     ==================================================================== -->
    <nav
      class="info-subnav"
      aria-label="Navigation du pôle Informatique"
      role="menubar"
    >
      <div class="info-subnav__inner">
        <a
          href="informatique.html"
          class="info-subnav__home"
          role="menuitem"
          aria-label="Vue d'ensemble, Pôle Informatique"
          title="Vue d'ensemble"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><rect x="3" y="3" width="7" height="7" rx="1.6"></rect><rect
              x="14"
              y="3"
              width="7"
              height="7"
              rx="1.6"></rect><rect x="3" y="14" width="7" height="7" rx="1.6"
            ></rect><rect x="14" y="14" width="7" height="7" rx="1.6"
            ></rect></svg
          >
        </a>
        <span class="info-subnav__sep" aria-hidden="true"></span>
        <ul class="info-subnav__list">
          <li role="none">
            <a
              href="info-integration.html"
              class="info-subnav__link"
              role="menuitem"
              ><span class="info-subnav__ic" aria-hidden="true"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
                  ></path></svg
                ></span
              >Service Intégration &amp; Support PC</a>
          </li>
          <li role="none">
            <a
              href="info-reseaux.html"
              class="info-subnav__link"
              role="menuitem"
              ><span class="info-subnav__ic" aria-hidden="true"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect x="2" y="3" width="20" height="8" rx="2"></rect><rect
                    x="2"
                    y="13"
                    width="20"
                    height="8"
                    rx="2"></rect><path d="M6 7h.01M6 17h.01"></path></svg
                ></span
              >Architectures systèmes &amp; réseaux</a>
          </li>
          <li role="none">
            <a
              href="info-collaboratif.html"
              class="info-subnav__link"
              role="menuitem"
              ><span class="info-subnav__ic" aria-hidden="true"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="m22 8-6 4 6 4V8Z"></path><rect
                    x="2"
                    y="6"
                    width="14"
                    height="12"
                    rx="2"></rect></svg
                ></span
              >Solutions collaboratives &amp; audiovisuelles</a>
          </li>
          <li role="none">
            <a
              href="info-cloud.html"
              class="info-subnav__link is-active"
              aria-current="page"
              role="menuitem"
              ><span class="info-subnav__ic" aria-hidden="true"
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"
                  ></path></svg
                ></span
              >Cloud Microsoft</a>
          </li>
        </ul>
      </div>
    </nav>

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ====================================================================
     HERO — épinglé (sticky), fond animé. La couche WebGL (.hero-mesh)
     sera branchée plus tard ; le fallback CSS reste visible d'ici là.
     ==================================================================== -->
        <section class="print-hero" aria-labelledby="hero-title">
          <div class="hero-mesh-fallback" aria-hidden="true"></div>
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>
          <div class="hero-texture" aria-hidden="true"></div>
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1 id="hero-title" class="hero-title reveal delay-1">
              Le <span class="accent-grad">Cloud Microsoft</span>, déployé et
              maîtrisé.
            </h1>

            <p class="hero-sub reveal delay-2">
              Microsoft 365, Azure et Teams. Nous accompagnons tout type de
              structure dans la modernisation de son informatique en tirant
              parti de la puissance du Cloud — en partenaire <strong
                >Tier&nbsp;1 Microsoft</strong
              >.
            </p>

            <div class="hero-actions reveal delay-3">
              <a
                href="contact.html?pole=informatique"
                class="btn-cta btn-cta--ghost"
              >
                Échanger avec un expert Microsoft
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ====================================================================
     MANIFESTE — feuille sticky (JetBrains Mono) qui glisse par-dessus
     le hero épinglé. Personnalisable par section.
     ==================================================================== -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="info-sheet">
            <div class="container">
              <header class="mf-head reveal">
                <span class="mf-head-side">
                  <span class="mf-caret" aria-hidden="true">&#9656;</span>
                  <span class="mf-id">CLOUD&middot;04</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Manifeste</span>
                </span>
                <span class="mf-head-side">
                  <span>Pôle Informatique</span>
                </span>
              </header>

              <div class="mf-cols">
                <blockquote
                  class="manifesto-quote reveal delay-1"
                  id="manifesto-title"
                >
                  Depuis plus de <span class="accent">10 ans</span>, nous
                  déployons et optimisons les environnements Microsoft&nbsp;365
                  et Azure. <span class="q-soft"
                    >Vous gagnez en puissance, tout en gardant la maîtrise.</span
                  ><span class="mf-cursor" aria-hidden="true"></span>
                </blockquote>
              </div>
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone : hero sticky + manifeste qui glisse par-dessus -->

      <!-- ====================================================================
     PRESTATIONS
     ==================================================================== -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prest-title"
      >
        <div class="container">
          <div class="sec-head reveal">
            <h2 id="prest-title">
              Tout l'écosystème <em>Microsoft</em>, opéré pour vous.
            </h2>
            <p>
              De Microsoft&nbsp;365 à Azure, de la téléphonie Teams aux
              signatures de mail&nbsp;: un accompagnement complet, de l'étude de
              l'existant à l'exploitation au quotidien.
            </p>
          </div>

          <div class="prest-grid reveal delay-1">
            <article class="prest-item">
              <div class="prest-item-head">
                <span class="prest-item-glyph" aria-hidden="true">
                  <svg
                    viewBox="0 0 40 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                      d="M27.5 26.5H13a6 6 0 1 1 1.6-11.8A8.5 8.5 0 0 1 31 13.8a5.5 5.5 0 0 1 2 10.4"
                    ></path><path d="M20 33V21.5"></path><path
                      d="m15.5 26 4.5-4.5L24.5 26"></path></svg
                  >
                </span>
              </div>
              <h3 class="prest-item-title">
                Migration &amp; optimisation Microsoft&nbsp;365
              </h3>
              <p class="prest-item-desc">
                Étude de votre existant, identification des plus fortes valeurs
                ajoutées du cloud Microsoft, puis accompagnement complet dans la
                mise en œuvre.
              </p>
            </article>

            <article class="prest-item">
              <div class="prest-item-head">
                <span class="prest-item-glyph" aria-hidden="true">
                  <svg
                    viewBox="0 0 40 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M20 6.5l11.5 6.3v12.4L20 31.5 8.5 25.2V12.8z"
                    ></path><path d="M8.7 13l11.3 6.4L31.3 13"></path><path
                      d="M20 19.4V31.5"></path></svg
                  >
                </span>
              </div>
              <h3 class="prest-item-title">Environnements Microsoft Azure</h3>
              <p class="prest-item-desc">
                Mise en œuvre d'environnements Azure pour améliorer la
                disponibilité et la sécurité de vos applicatifs métier, en
                tirant parti de la puissance et de la résilience du cloud.
              </p>
            </article>

            <article class="prest-item">
              <div class="prest-item-head">
                <span class="prest-item-glyph" aria-hidden="true">
                  <svg
                    viewBox="0 0 40 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                      d="M20 5.5l12 4.2v8.8c0 7.2-5.1 12.2-12 14.5-6.9-2.3-12-7.3-12-14.5V9.7z"
                    ></path><path d="m14.8 19.6 3.4 3.4 7-7.4"></path></svg
                  >
                </span>
              </div>
              <h3 class="prest-item-title">
                Gouvernance &amp; sécurité du cloud
              </h3>
              <p class="prest-item-desc">
                Suivi des évolutions, sauvegardes et conseil de proximité&nbsp;:
                vous gardez la maîtrise de votre environnement, en alliant
                sécurité et ergonomie.
              </p>
            </article>

            <article class="prest-item prest-item--wide">
              <div class="prest-item-head">
                <span class="prest-item-glyph" aria-hidden="true">
                  <svg
                    viewBox="0 0 40 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M11 20.5v-1a9 9 0 0 1 18 0v1"></path><path
                      d="M8.5 20.5h3.2v7.8H9.7a1.2 1.2 0 0 1-1.2-1.2z"
                    ></path><path
                      d="M31.5 20.5h-3.2v7.8h2a1.2 1.2 0 0 0 1.2-1.2z"
                    ></path><path d="M28.3 28.3v1a3 3 0 0 1-3 3H20.8"
                    ></path></svg
                  >
                </span>
              </div>
              <h3 class="prest-item-title">Téléphonie Teams</h3>
              <p class="prest-item-desc">
                Migration de votre téléphonie existante vers Microsoft Teams
                pour accroître la mobilité et la sécurité de vos utilisateurs,
                où qu'ils travaillent.
              </p>
              <a class="prest-cta" href="telecom.html">
                Découvrez nos offres télécom
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                >
              </a>
            </article>

            <article class="prest-item prest-item--wide">
              <div class="prest-item-head">
                <span class="prest-item-glyph" aria-hidden="true">
                  <svg
                    viewBox="0 0 40 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><rect x="7" y="11.5" width="26" height="17" rx="2.5"
                    ></rect><path d="M8 13.5l12 8 12-8"></path><path
                      d="M13 33c2-1.6 3.5-1.6 5 0s3.5 1.6 5 0 3.5-1.6 5 0"
                    ></path></svg
                  >
                </span>
              </div>
              <h3 class="prest-item-title">
                Signatures de mail &amp; bannières
              </h3>
              <p class="prest-item-desc">
                Déploiement de signatures de mail et de bannières dynamiques
                pour améliorer votre communication interne et externe, sur
                l'ensemble de vos collaborateurs.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     SÉCURITÉ OPÉRÉE — cybersécurité distillée (réponses questionnaire)
     ==================================================================== -->
      <section class="secblock" aria-labelledby="sec-title">
        <div class="container">
          <div class="secblock-head secblock-head--center reveal">
            <h2 id="sec-title">
              Vos environnements Microsoft, <em>sous bonne garde.</em>
            </h2>
            <p>
              Moderniser son informatique, c'est aussi en garder la maîtrise.
              Nos équipes assurent le suivi, la sauvegarde et la sécurisation de
              vos environnements Microsoft&nbsp;365 et Azure.
            </p>
            <a href="informatique.html#cybersecurite" class="secblock-link">
              Découvrir notre expertise Cybersécurité
              <svg
                viewBox="0 0 16 16"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
              >
            </a>
          </div>

          <div class="skywatch reveal delay-1">
            <div class="sky-dome" aria-hidden="true">
              <svg viewBox="0 0 760 400" fill="none">
                <defs>
                  <radialGradient id="skDome" cx="0.5" cy="1" r="0.9">
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.05"
                    ></stop>
                    <stop offset="0.6" stop-color="#4FC9E2" stop-opacity="0.018"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </radialGradient>
                  <linearGradient id="skSweep" x1="0.1" y1="0" x2="0.55" y2="1">
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.26"
                    ></stop>
                    <stop offset="0.55" stop-color="#4FC9E2" stop-opacity="0.07"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </linearGradient>
                  <linearGradient
                    id="skBase"
                    x1="0"
                    y1="0"
                    x2="760"
                    y2="0"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop offset="0" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                    <stop offset="0.12" stop-color="#4FC9E2" stop-opacity="0.34"
                    ></stop>
                    <stop offset="0.88" stop-color="#4FC9E2" stop-opacity="0.34"
                    ></stop>
                    <stop offset="1" stop-color="#4FC9E2" stop-opacity="0"
                    ></stop>
                  </linearGradient>
                  <radialGradient id="skSpec" cx="0.5" cy="0.5" r="0.5">
                    <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.16"
                    ></stop>
                    <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"
                    ></stop>
                  </radialGradient>
                  <linearGradient id="skRim" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.34"
                    ></stop>
                    <stop offset="0.55" stop-color="#4FC9E2" stop-opacity="0.14"
                    ></stop>
                    <stop offset="1" stop-color="#FFFFFF" stop-opacity="0.05"
                    ></stop>
                  </linearGradient>
                  <!-- Le balayage est rogné à la voûte : rien ne dépasse sous l'horizon,
                 le rebouclage (-24° → 156°) se produit hors champ. -->
                  <clipPath id="skClip">
                    <path d="M60 360 A320 320 0 0 1 700 360 Z"></path>
                  </clipPath>
                </defs>

                <!-- voûte : remplissage à peine teinté, plus dense vers l'horizon -->
                <path d="M60 360 A320 320 0 0 1 700 360 Z" fill="url(#skDome)"
                ></path>

                <!-- secteurs de veille (illuminés au survol des cartes) + labels -->
                <g class="sk-s1">
                  <path
                    class="sk-sector"
                    d="M380 360 L60 360 A320 320 0 0 1 220 82.9 Z"></path>
                  <text x="79" y="186" class="sk-lab">01 · AUDITER</text>
                </g>
                <g class="sk-s2">
                  <path
                    class="sk-sector"
                    d="M380 360 L220 82.9 A320 320 0 0 1 540 82.9 Z"></path>
                  <text x="380" y="24" class="sk-lab">02 · DÉTECTER</text>
                </g>
                <g class="sk-s3">
                  <path
                    class="sk-sector"
                    d="M380 360 L540 82.9 A320 320 0 0 1 700 360 Z"></path>
                  <text x="681" y="186" class="sk-lab">03 · FORMER</text>
                </g>

                <!-- grille du dôme : arcs de portée hiérarchisés (extérieur affirmé,
               internes en retrait) + rayons atténués + graduations d'horizon -->
                <path
                  class="sk-arc"
                  style="--sk-arcop: 0.22"
                  d="M60 360 A320 320 0 0 1 700 360"
                  stroke-dasharray="2 7"></path>
                <path
                  class="sk-arc"
                  style="--sk-arcop: 0.12"
                  d="M140 360 A240 240 0 0 1 620 360"></path>
                <path
                  class="sk-arc"
                  style="--sk-arcop: 0.09"
                  d="M220 360 A160 160 0 0 1 540 360"></path>
                <path
                  class="sk-arc"
                  style="--sk-arcop: 0.07"
                  d="M300 360 A80 80 0 0 1 460 360"></path>
                <path
                  class="sk-ticks"
                  d="M92 356.5 V360 M124 356.5 V360 M156 356.5 V360 M188 356.5 V360 M220 356.5 V360 M252 356.5 V360 M284 356.5 V360 M316 356.5 V360 M444 356.5 V360 M476 356.5 V360 M508 356.5 V360 M540 356.5 V360 M572 356.5 V360 M604 356.5 V360 M636 356.5 V360 M668 356.5 V360"
                  stroke-width="1"></path>
                <line class="sk-ray" x1="449.3" y1="320" x2="657.1" y2="200"
                ></line>
                <line class="sk-ray" x1="420" y1="290.7" x2="540" y2="82.9"
                ></line>
                <line class="sk-ray" x1="380" y1="280" x2="380" y2="40"></line>
                <line class="sk-ray" x1="340" y1="290.7" x2="220" y2="82.9"
                ></line>
                <line class="sk-ray" x1="310.7" y1="320" x2="102.9" y2="200"
                ></line>

                <!-- faisceau de balayage (rotation continue gauche → droite) —
               le clip est porté par le groupe PARENT fixe : il resterait
               solidaire du faisceau s'il était posé sur le groupe animé. -->
                <g clip-path="url(#skClip)">
                  <g class="sk-sweep">
                    <path
                      d="M380 360 L87.7 229.9 A320 320 0 0 0 60 360 Z"
                      fill="url(#skSweep)"></path>
                    <line class="sk-beam" x1="380" y1="360" x2="87.7" y2="229.9"
                    ></line>
                    <circle class="sk-beam-tip" cx="87.7" cy="229.9" r="3"
                    ></circle>
                  </g>
                </g>

                <!-- échos détectés (pulse phasé sur le passage du faisceau) -->
                <g class="sk-blip" style="animation-delay: 0.98s"
                  ><circle
                    class="sk-bcore"
                    cx="170"
                    cy="280"
                    r="3"
                    fill="#4FC9E2"></circle><circle
                    class="sk-bw sk-bw1"
                    cx="170"
                    cy="280"
                    r="9"
                    stroke="rgba(79,201,226,0.45)"
