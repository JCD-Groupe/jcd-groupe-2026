                  <path
                    d="M373.5 337 l4.8 4.8 l9.2 -10"
                    stroke="#4FC9E2"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </g>
              </svg>
            </div>

            <!-- connecteurs schéma → cartes (statiques, illuminés au survol de la carte) -->
            <svg
              class="sky-wires"
              viewBox="0 0 1000 110"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <linearGradient
                  id="skWire"
                  x1="0"
                  y1="0"
                  x2="0"
                  y2="110"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.45"
                  ></stop>
                  <stop offset="1" stop-color="#4FC9E2" stop-opacity="0.10"
                  ></stop>
                </linearGradient>
              </defs>
              <path
                class="sk-wire sk-wire-1"
                pathLength="100"
                d="M500 0 C500 54 161 50 161 110"></path>
              <path
                class="sk-wire sk-wire-2"
                pathLength="100"
                d="M500 0 L500 110"></path>
              <path
                class="sk-wire sk-wire-3"
                pathLength="100"
                d="M500 0 C500 54 839 50 839 110"></path>
            </svg>

            <div class="sky-grid">
              {
                info_cloud.processus_cybersecurite.map((etapes: any) => (
                  <div class="skypoint" data-sector="3">
                    <span class="sk-node" aria-hidden="true" />
                    <h4 set:html={etapes.titre} />
                    <p set:html={etapes.description} />
                    {contient("formation", etapes.titre) && (
                      <a class="skypoint-cta" href="/formation-informatique">
                        Découvrez nos formations cybersécurité
