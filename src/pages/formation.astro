          </div>

          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1 id="formation-hero-title" class="hero-title reveal delay-1">
              Des formations <em>professionnalisantes</em> adaptées à tous vos besoins.
            </h1>

            <p class="hero-sub reveal delay-2">
              Le centre de formation JCD est certifié Qualiopi et habilité en
              tant que centre d'examen pour la certification TOSA.
            </p>

            <div class="hero-actions reveal delay-3">
              <a
                href="/contact?pole=formation&step=2"
                class="btn-cta btn-cta--ghost"
              >
                Contacter un conseiller
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ================================
     MANIFESTO — "Cahier de formation" : police Fraunces,
     lignes de cahier, marge rouge discrète.
     ================================ -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="cahier-sheet">
            <div class="cahier-margin" aria-hidden="true"></div>
            <div class="container">
              <header class="mf-header reveal">
                <span class="mf-header-side">
                  <span class="mf-caret" aria-hidden="true">&#9656;</span>
                  <span class="mf-id">FM&middot;01</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Manifeste</span>
                </span>
                <span class="mf-header-side">
                  <span>Cahier</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Pôle Formation</span>
                </span>
              </header>

              <div class="manifesto-top reveal delay-1">
                <blockquote class="manifesto-quote manifesto-rich" id="manifesto-title">
                  <strong>Le catalogue est notre vitrine,</strong> le sur-mesure
                  notre signature. Notre force&nbsp;: <em>co-construire</em> un dispositif unique, aligné sur vos objectifs, vos métiers et
                  vos contraintes opérationnelles.
                </blockquote>
                <div class="mf-certs">
                  <a
                    class="mf-cert mf-cert--qualiopi"
                    href="https://travail-emploi.gouv.fr/qualiopi-marque-de-certification-qualite-des-prestataires-de-formation"
                    target="_blank"
                    rel="noopener"
                    aria-label="Certifié Qualiopi — Processus certifié — Action de formation"
                  >
                    <img
                      src="/assets/qualiopi.png"
                      alt="Certifié Qualiopi — Processus certifié — Action de formation"
                      width="980"
                      height="825"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <a
                    class="mf-cert mf-cert--tosa"
                    href="https://www.tosa.org/"
                    target="_blank"
                    rel="noopener"
                    aria-label="Centre d'examen TOSA — certification des compétences digitales"
                  >
                    <img
                      src="/assets/tosa.png"
                      alt="Centre d'examen TOSA"
                      width="2121"
                      height="529"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
