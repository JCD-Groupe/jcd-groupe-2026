      <!-- ================================
     PROCESS — "Parcours apprenant" : timeline verticale alternée
     4 étapes du parcours de formation JCD.
     ================================ -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="section-head reveal">
            <h2
              class="section-title"
              id="process-title"
              set:html={formation.titre_processus}
            >
              <span
                class="text-muted"
                set:html={formation.sous_titre_processus}
              />
            </h2>
          </div>

          <!-- « Courbe d'apprentissage » — schéma ascendant à 4 jalons de maîtrise.
         Technique identique aux autres pages process (SVG pathLength + glow +
         pulse + .reveal) ; forme inédite qui matérialise la progression
         pédagogique : courbe lime ascendante, hexagones-jalons à icônes
         thématiques, connecteurs aux longueurs progressives. -->
          <div class="pf-vflow reveal" id="pf-vflow">
            <svg
              class="pf-vsvg"
              viewBox="0 0 900 290"
              preserveAspectRatio="xMidYMid meet"
              aria-hidden="true"
            >
              <defs>
                <linearGradient id="pf-curve-grad" x1="0" y1="1" x2="1" y2="0">
                  <stop offset="0%" stop-color="#bfe17b"></stop>
                  <stop offset="35%" stop-color="#9ecf52"></stop>
                  <stop offset="70%" stop-color="#8EC041"></stop>
                  <stop offset="100%" stop-color="#6e9c2c"></stop>
                </linearGradient>
                <filter
                  id="pf-glow"
                  x="-15%"
                  y="-15%"
                  width="130%"
                  height="130%"
                >
                  <feGaussianBlur stdDeviation="2.6" result="b"
                  ></feGaussianBlur>
                  <feMerge>
                    <feMergeNode in="b"></feMergeNode>
                    <feMergeNode in="SourceGraphic"></feMergeNode>
                  </feMerge>
                </filter>
                <!-- Faisceaux verticaux : un dégradé par connecteur (couleur de l'étape),
               opaque sous le node, fondu vers la card. userSpaceOnUse = fade
               propre à la longueur de chaque faisceau. -->
                <linearGradient
                  id="pf-drop-g1"
                  gradientUnits="userSpaceOnUse"
                  x1="0"
                  y1="253"
                  x2="0"
                  y2="290"
                >
                  <stop offset="0%" stop-color="#bfe17b" stop-opacity="0.55"
                  ></stop>
                  <stop offset="62%" stop-color="#bfe17b" stop-opacity="0.20"
                  ></stop>
                  <stop offset="100%" stop-color="#bfe17b" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <linearGradient
                  id="pf-drop-g2"
                  gradientUnits="userSpaceOnUse"
                  x1="0"
                  y1="168"
                  x2="0"
                  y2="290"
                >
                  <stop offset="0%" stop-color="#9ecf52" stop-opacity="0.55"
                  ></stop>
                  <stop offset="70%" stop-color="#9ecf52" stop-opacity="0.16"
                  ></stop>
                  <stop offset="100%" stop-color="#9ecf52" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <linearGradient
                  id="pf-drop-g3"
                  gradientUnits="userSpaceOnUse"
                  x1="0"
                  y1="103"
                  x2="0"
                  y2="290"
                >
                  <stop offset="0%" stop-color="#8EC041" stop-opacity="0.55"
                  ></stop>
                  <stop offset="74%" stop-color="#8EC041" stop-opacity="0.14"
                  ></stop>
                  <stop offset="100%" stop-color="#8EC041" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <linearGradient
                  id="pf-drop-g4"
                  gradientUnits="userSpaceOnUse"
                  x1="0"
                  y1="57"
                  x2="0"
                  y2="290"
                >
                  <stop offset="0%" stop-color="#7cab38" stop-opacity="0.55"
                  ></stop>
                  <stop offset="78%" stop-color="#7cab38" stop-opacity="0.12"
                  ></stop>
                  <stop offset="100%" stop-color="#7cab38" stop-opacity="0"
                  ></stop>
                </linearGradient>
                <!-- Aire sous la courbe : l'acquis s'accumule vers la droite (diagonale ascendante) -->
                <linearGradient id="pf-area-grad" x1="0" y1="1" x2="1" y2="0">
                  <stop offset="0%" stop-color="#8EC041" stop-opacity="0.02"
                  ></stop>
                  <stop offset="55%" stop-color="#8EC041" stop-opacity="0.05"
                  ></stop>
                  <stop offset="100%" stop-color="#8EC041" stop-opacity="0.11"
                  ></stop>
                </linearGradient>
              </defs>

              <!-- Graphe assumé : aire sous la courbe (le savoir accumulé) -->
              <path
                class="pf-area"
                d="M 113 240 C 339 145, 561 81, 787 44 L 787 270 L 113 270 Z"
                fill="url(#pf-area-grad)"></path>

              <!-- Axes fléchés du graphe, calés sur le papier millimétré -->
              <g aria-hidden="true">
                <path
                  class="pf-axis"
                  d="M 80 270 V 36 M 76.5 42 L 80 36 L 83.5 42"></path>
                <path
                  class="pf-axis"
                  d="M 80 270 H 832 M 826 266.5 L 832 270 L 826 273.5"></path>
              </g>

              <!-- Étiquettes bookend : chacune posée au-dessus de son jalon -->
              <text class="pf-label" x="135" y="262" text-anchor="start"
                >{formation.label_debut_processus}</text
              >
              <text class="pf-label" x="850" y="20" text-anchor="end"
                >{formation.label_fin_processus}</text
              >

              <!-- Courbe d'apprentissage : 3 couches superposées.
             Démarre/finit exactement sur le 1er et le dernier jalon
             (cubique interpolant qui passe par les 4 nœuds). -->
              <path
                class="pf-curve-glow"
                d="M 113 240 C 339 145, 561 81, 787 44"></path>
              <path
                class="pf-curve-echo"
                d="M 113 242 C 339 147, 561 83, 787 46"></path>
              <path
                class="pf-curve"
                d="M 113 240 C 339 145, 561 81, 787 44"
                pathLength="100"></path>

              <!-- Faisceaux verticaux : descendent du node et se fondent vers la card -->
              <line
                class="pf-drop pf-drop--1"
                style="--dc:#bfe17b"
                x1="113"
                y1="253"
                x2="113"
                y2="290"
                pathLength="100"></line>
              <line
                class="pf-drop pf-drop--2"
                style="--dc:#9ecf52"
                x1="338"
                y1="168"
                x2="338"
                y2="290"
                pathLength="100"></line>
              <line
                class="pf-drop pf-drop--3"
                style="--dc:#8EC041"
                x1="562"
                y1="103"
                x2="562"
                y2="290"
                pathLength="100"></line>
              <line
                class="pf-drop pf-drop--4"
                style="--dc:#7cab38"
                x1="787"
                y1="57"
                x2="787"
                y2="290"
                pathLength="100"></line>

              <!-- Hex node 01 : Écouter (headphones) -->
              <g transform="translate(113 240)">
                <g class="pf-node pf-node--1" style="--node-c:#bfe17b">
                  <circle class="pf-node-halo" r="20"></circle>
                  <polygon
                    class="pf-node-hex"
                    points="0,-13 11.3,-6.5 11.3,6.5 0,13 -11.3,6.5 -11.3,-6.5"
                  ></polygon>
                  <path class="pf-node-icon" d="M -6 0 A 6 6 0 0 1 6 0"></path>
                  <path
                    class="pf-node-icon"
                    d="M -6 0 L -6 4 M -6 4 L -3 4 L -3 0 M 6 0 L 6 4 M 6 4 L 3 4 L 3 0"
                  ></path>
                </g>
              </g>

              <!-- Hex node 02 : Concevoir (compass) -->
              <g transform="translate(338 155)">
                <g class="pf-node pf-node--2" style="--node-c:#9ecf52">
                  <circle class="pf-node-halo" r="20"></circle>
                  <polygon
                    class="pf-node-hex"
                    points="0,-13 11.3,-6.5 11.3,6.5 0,13 -11.3,6.5 -11.3,-6.5"
                  ></polygon>
                  <circle class="pf-node-icon" cx="0" cy="-4" r="1.6"></circle>
                  <path class="pf-node-icon" d="M 0 -2.4 L -4 6 M 0 -2.4 L 4 6"
                  ></path>
                </g>
              </g>

              <!-- Hex node 03 : Former (chalkboard) -->
              <g transform="translate(562 90)">
                <g class="pf-node pf-node--3" style="--node-c:#8EC041">
                  <circle class="pf-node-halo" r="20"></circle>
                  <polygon
                    class="pf-node-hex"
                    points="0,-13 11.3,-6.5 11.3,6.5 0,13 -11.3,6.5 -11.3,-6.5"
                  ></polygon>
                  <rect
                    class="pf-node-icon"
                    x="-6"
                    y="-4"
                    width="12"
                    height="7.5"
                    rx="0.5"></rect>
                  <path
                    class="pf-node-icon"
                    d="M -3.5 -1.5 L 3.5 -1.5 M -3.5 0.6 L 1.6 0.6"></path>
                </g>
              </g>

              <!-- Hex node 04 : Mesurer (ascending bars) -->
              <g transform="translate(787 44)">
                <g class="pf-node pf-node--4" style="--node-c:#6e9c2c">
                  <circle class="pf-node-halo" r="20"></circle>
                  <polygon
                    class="pf-node-hex"
                    points="0,-13 11.3,-6.5 11.3,6.5 0,13 -11.3,6.5 -11.3,-6.5"
                  ></polygon>
                  <path
                    class="pf-node-icon"
                    d="M -5 5 L -5 1.5 M -1.7 5 L -1.7 -2 M 1.7 5 L 1.7 -4.5 M 5 5 L 5 -1"
                  ></path>
                </g>
              </g>
            </svg>

            <div class="pf-vcards">
              {
                formation.processus.map((etape: any) => (
                  <article
                    class="pf-vcard"
                    style="--c:#bfe17b; --c-rgb:191, 225, 123;"
                  >
                    <span class="pf-vcard-land" aria-hidden="true" />
                    <h3 class="pf-vcard-title">{etape.titre}</h3>
                    <p class="pf-vcard-desc">{etape.description}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     ENGAGEMENTS & CERTIFICATIONS — rubrique Qualiopi :
     indicateurs de résultats + engagements.
     ================================ -->
      <section
        class="fq-engage"
        id="engagements"
        aria-labelledby="fq-engage-title"
      >
        <div class="container">
          <div class="section-head reveal">
            <span class="eyebrow">{formation.sur_titre_preuves}</span>
            <h2
              class="section-title"
              id="fq-engage-title"
              set:html={formation.titre_preuves}
            >
              <span
                class="text-muted"
                set:html={formation.sous_titre_preuves}
              />
            </h2>
          </div>

          <!-- Dégradé d'anneau, partagé par les quatre cadrans. -->
          <svg class="fq-defs" aria-hidden="true" focusable="false">
            <defs>
              <!-- Teintes reprises en CSS (#fq-arc stop) ; les valeurs
                   litterales servent de repli si var() n'est pas resolu
                   dans un attribut de presentation. -->
              <linearGradient id="fq-arc" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#a4d05c"></stop>
                <stop offset="52%" stop-color="#8ec041"></stop>
                <stop offset="100%" stop-color="#6c9430"></stop>
              </linearGradient>
            </defs>
          </svg>

          <!-- Indicateurs de résultats — obligation Qualiopi (indicateur 2) -->
          <ul class="fq-kpis reveal delay-1">
            {
              formation.compteurs.map((compteur: any) => (
                <li class="fq-kpi" style={`--ratio: ${compteur.ratio}`}>
                  <span class="fq-kpi-dial">
                    <span class="fq-kpi-halo" aria-hidden="true" />
                    <svg
                      class="fq-kpi-ring"
                      viewBox="0 0 120 120"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <circle class="fq-kpi-track" cx="60" cy="60" r="54" />
                      <circle
                        class="fq-kpi-arc"
                        cx="60"
                        cy="60"
                        r="54"
                        stroke="url(#fq-arc)"
                      />
                    </svg>
                    <span class="fq-kpi-v" data-count={compteur.valeur}>
                      {compteur.valeur}
                      <small>{compteur.suffixe_valeur}</small>
                    </span>
                  </span>
                  <span class="fq-kpi-k">{compteur.titre}</span>
                  <span class="fq-kpi-y">{compteur.sous_titre}</span>
                </li>
              ))
            }
          </ul>

          <!-- Engagements publiés — registre en lignes, pas de cartes :
               un filet dégradé par ligne, la lecture reste verticale. -->
          <div class="fq-ledger reveal delay-2">
            {
              formation.infos_supplementaires.map(
                (info_supplementaires: any, index: number) => (
                  <article class="fq-row">
                    <span class="fq-row-n" aria-hidden="true">
                      0{index + 1}
                    </span>
                    <h3 class="fq-row-k">{info_supplementaires.titre}</h3>
                    <p class="fq-row-tx">{info_supplementaires.description}</p>
                    {info_supplementaires.lien_cta && (
                      <a
                        class="fq-row-link"
                        href={info_supplementaires.lien_cta}
                        target={
                          info_supplementaires.lien_cta.includes("http")
                            ? "_blank"
                            : "_self"
                        }
                        rel={
                          info_supplementaires.lien_cta.includes("http")
                            ? "noopener"
                            : ""
                        }
                      >
                        {info_supplementaires.texte_cta}
                        {info_supplementaires.lien_cta.includes("http") ? (
                          <span class="fq-row-arrow" aria-hidden="true">
                            &#8599;
                          </span>
                        ) : (
                          <span class="fq-row-arrow" aria-hidden="true">
                            &#8594;
                          </span>
                        )}
                      </a>
                    )}
                  </article>
                ),
              )
            }
          </div>
        </div>
      </section>

      <!-- ================================
     CTA — Bandeau compact
     ================================ -->
      <section class="cta-section" id="contact" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-frame">
            <div class="cta-inner">
              <Fragment set:html={formation.icone_cta_content} />

              <div class="cta-body">
                <h2
                  class="cta-title reveal delay-1"
                  id="cta-title"
                  set:html={formation.titre_cta}
                />

                <p
                  class="cta-sub reveal delay-2"
                  set:html={formation.sous_titre_cta}
                />

                <div class="cta-actions reveal delay-3">
                  <a
                    href="/contact?pole=formation&step=2"
                    class="btn-cta btn-cta--primary"
                  >
                    {formation.bouton_cta}
                    <span class="btn-cta-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </a>
                  <span class="cta-actions-divider" aria-hidden="true"></span>
                  <span class="cta-phone">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      width="14"
                      height="14"
                      ><path
                        d="M2 3a1 1 0 011-1h3.28a1 1 0 01.95.68l1.07 3.21a1 1 0 01-.25 1L6.54 8.4a12.06 12.06 0 005.06 5.06l1.51-1.51a1 1 0 011-.25l3.21 1.07a1 1 0 01.68.95V17a1 1 0 01-1 1A15 15 0 012 3z"
                      ></path></svg
                    >
                    <a href="tel:+33387184920" class="cta-phone-num"
                      >03 87 18 49 20</a
                    >
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ================================
     FOOTER
     ================================ -->
    <Footer />

    <script is:inline src="/js/pages/formation-1.js"></script>
    <script is:inline src="/js/shared/menu-frost.js"></script>
    <!-- jcd-mobile-nav (injected) -->
    <button
      class="jcd-burger"
      id="jcdBurger"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="jcdMnav"
    >
      <span class="jcd-burger__box" aria-hidden="true"
        ><i></i><i></i><i></i></span
      >
    </button>
    <div
      class="jcd-mnav"
      id="jcdMnav"
      role="dialog"
      aria-modal="true"
      aria-label="Menu de navigation"
      aria-hidden="true"
    >
      <div class="jcd-mnav__scroll">
        <div class="jcd-mnav__inner">
