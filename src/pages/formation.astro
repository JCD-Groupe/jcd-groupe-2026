---
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let formation = await directus.request(
  readSingleton("JCD_Formation", {
    fields: [
      "*",
      { logo_manifeste_1: ["*"] },
      { logo_manifeste_2: ["*"] },
      { prestations: ["*"] },
      { processus: ["*"] },
      { logos_confiance: ["*", { directus_files_id: ["*"] }] },
      { compteurs: ["*"] },
      { infos_supplementaires: ["*"] },
    ],
  }),
);

const fetchSvgContent = async (id: string) => {
  if (!id) return null;
  const response = await fetch(
    `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${id}`,
  );
  return response.text();
};

formation.icone_cta_content = await fetchSvgContent(formation.icone_cta);

formation.prestations = await Promise.all(
  formation.prestations.map(async (prestation: any) => ({
    ...prestation,
    icone_content: await fetchSvgContent(prestation.icone),
  })),
);

formation.compteurs = formation.compteurs.map((compteur: any) => {
  let ratio = 1;

  if (compteur.suffixe_valeur) {
    if (compteur.suffixe_valeur == "%") {
      ratio = compteur.valeur / 100;
    } else if (
      compteur.suffixe_valeur &&
      /^\/\s*\d+/.test(compteur.suffixe_valeur)
    ) {
      // Suffixe de type "/10", "/20", etc.
      const max = compteur.suffixe_valeur.replace("/", "");
      if (max > 0) ratio = compteur.valeur / max;
    }
  }

  return {
    ...compteur,
    valeur: `${compteur.valeur}`.replace(".", ","),
    ratio: ratio,
  };
});

const logos = formation.logos_confiance || [];
const totalLogos = logos.length;
const half = Math.ceil(totalLogos / 2);

const logos1 = logos.slice(0, half);
const logos2 = logos.slice(half);
