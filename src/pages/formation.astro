              <!-- Pulses traversants sur les arcs clés (le savoir qui circule).
           Démarrent au centre exact d'un nœud, voyagent jusqu'au centre du suivant. -->
              <g>
                <circle
                  class="pulse"
                  cx="740"
                  cy="100"
                  r="2.6"
                  style="--dx:180px;--dy:100px;animation-duration:4.2s;animation-delay:-1.0s"
