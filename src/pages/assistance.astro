---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="Assistance JCD Groupe. Prise en main à distance par nos techniciens : LogMeIn Rescue, Assist ou TeamViewer. Service clients au 03 87 18 49 20, du lundi au vendredi de 8h30 à 18h."
    />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assistance`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content="Assistance · Prise en main à distance · JCD Groupe"
    />
    <meta
      property="og:description"
      content="Un technicien JCD vous guide en direct : ouvrez l'outil de prise en main à distance qu'il vous indique — LogMeIn Rescue, Assist ou TeamViewer."
    />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assistance`}
    />
    <meta name="twitter:card" content="summary" />
    <title>Assistance · Prise en main à distance · JCD Groupe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/assistance.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/assistance-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <main id="contenu">
      <!-- ================================
     EN-TÊTE — compact, utilitaire : consigne + téléphone (pas de hero)
     ================================ -->
      <section class="assist-head" aria-labelledby="assist-hero-title">
        <div class="container">
          <div class="assist-head-grid">
            <div class="assist-head-main">
              <h1 id="assist-hero-title" class="assist-title reveal delay-1">
                Assistance
              </h1>
              <p class="assist-lead reveal delay-2">
                Vous êtes en ligne avec notre service clients&nbsp;? Ouvrez
                l’outil que votre technicien vous indique ci-dessous et
                laissez-vous guider.
              </p>
            </div>

            <aside
              class="assist-head-aside reveal delay-2"
              aria-label="Contacter le service clients"
            >
              <a href="tel:+33387184922" class="assist-phone-card">
                <span class="assist-phone-ic" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                      d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.29a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"
                    ></path></svg
                  >
                </span>
                <span class="assist-phone-tx">
                  <span class="assist-phone-label">
                    Pas encore en ligne&nbsp;?
                  </span>
                  <span class="assist-phone-num"
                    >03&nbsp;87&nbsp;18&nbsp;49&nbsp;22</span
                  >
                  <span class="assist-phone-hours"
                    >Lun&ndash;Ven &middot; 8h30&ndash;18h</span
                  >
                </span>
              </a>
            </aside>
          </div>
        </div>
      </section>

      <!-- ================================
     OUTILS — 3 accès de prise en main à distance
     ================================ -->
      <section
        class="assist-tools"
        id="outils"
        aria-labelledby="assist-tools-title"
      >
        <div class="container">
          <div class="assist-tools-head reveal">
            <h2 class="section-title" id="assist-tools-title">
              Cliquez sur l'outil indiqué par votre technicien.
            </h2>
          </div>

          <div class="assist-grid">
            <!-- 01 — Prise en main à distance (LogMeIn Rescue) -->
            <a
              class="assist-card reveal delay-1"
              style="--tc:#2E72BA; --tc-rgb:46,114,186"
              href="https://secure.logmeinrescue.com/Customer/Code.aspx"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="assist-card-top">
                <span class="assist-card-num">Outil&nbsp;01</span>
                <svg
                  class="assist-card-ic"
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="4" y="6" width="24" height="16" rx="2.5"></rect>
                  <path d="M12 27h8M16 22v5"></path>
                  <path d="M12 12l3 2.5-3 2.5M17 17h4"></path>
                </svg>
              </span>
              <span class="assist-card-name">Prise en main à distance</span>
              <span class="assist-card-desc"
                >Saisissez le code à 6 chiffres communiqué par votre technicien
                pour ouvrir la session.</span
              >
              <span class="assist-card-cta">
                Ouvrir la session
                <span class="assist-card-arrow" aria-hidden="true"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </span>
            </a>

            <!-- 02 — Assist -->
            <a
              class="assist-card reveal delay-2"
              style="--tc:#8EC041; --tc-rgb:142,192,65"
              href="https://assist.rg.gg/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="assist-card-top">
                <span class="assist-card-num">Outil&nbsp;02</span>
                <svg
                  class="assist-card-ic"
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="16" cy="16" r="11"></circle>
                  <path d="M16 5v4M16 23v4M5 16h4M23 16h4"></path>
                  <circle cx="16" cy="16" r="3.4"></circle>
                </svg>
              </span>
              <span class="assist-card-name">Assist</span>
              <span class="assist-card-desc"
                >Lancez l'outil Assist et communiquez l'identifiant affiché à
                votre technicien.</span
              >
              <span class="assist-card-cta">
                Lancer Assist
                <span class="assist-card-arrow" aria-hidden="true"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </span>
            </a>

            <!-- 03 — TeamViewer -->
            <a
              class="assist-card reveal delay-3"
              style="--tc:#F3941D; --tc-rgb:243,148,29"
              href="https://custom.teamviewer.com/easisupportjcd"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="assist-card-top">
                <span class="assist-card-num">Outil&nbsp;03</span>
                <svg
                  class="assist-card-ic"
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 4v14M16 18l-5-5M16 18l5-5"></path>
                  <path
                    d="M6 21v3.5a2.5 2.5 0 0 0 2.5 2.5h15a2.5 2.5 0 0 0 2.5-2.5V21"
                  ></path>
                </svg>
              </span>
              <span class="assist-card-name">TeamViewer</span>
              <span class="assist-card-desc"
                >Téléchargez le module TeamViewer JCD, puis transmettez votre ID
                à votre technicien.</span
              >
              <span class="assist-card-cta">
                Télécharger TeamViewer
                <span class="assist-card-arrow" aria-hidden="true"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </span>
            </a>
          </div>

          <!-- Accès secondaires : Servicedesk (clients sous contrat) + contact -->
          <div class="assist-secondary reveal delay-3">
            <a
              class="assist-sec-link"
              href="https://servicedesk.easisupport.fr"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="assist-sec-main">
                <span class="assist-sec-name">Portail EASI support</span>
                <span class="assist-sec-desc"
                  >Portail de tickets &mdash; réservé aux clients sous contrat.</span
                >
              </span>
            </a>
            <a class="assist-sec-link" href="/contact?pole=service&step=2">
              <span class="assist-sec-main">
                <span class="assist-sec-name">Nous contacter</span>
                <span class="assist-sec-desc"
                  >Une autre demande&nbsp;? Écrivez au pôle Service.</span
                >
              </span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- ================================
     FOOTER
     ================================ -->
    <Footer />

    <!-- ================================
     SCRIPTS
     ================================ -->
    <script is:inline src="/js/shared/reveal-animations.js"></script>
    <script is:inline src="/js/shared/menu-frost.js"></script>
    <!-- jcd-a11y (Lot 5) -->
    <div class="jcd-fab-wrap" id="jcd-fab">
      <button
        class="jcd-fab jcd-fab--top"
        id="jcdToTop"
        type="button"
        aria-label="Remonter en haut"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M10 16V5M5 10l5-5 5 5"></path></svg
        >
      </button>
      <a
        class="jcd-fab jcd-fab--contact"
        id="jcdFabContact"
        href="/contact"
        aria-label="Nous contacter"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2.5" y="4.5" width="15" height="11" rx="2.3"></rect><path
            d="M3 6.7 L10 10.7 L17 6.7"></path></svg
        >
      </a>
    </div>
    <script is:inline src="/js/shared/a11y.js" id="jcd-a11y-js"></script>
    <script is:inline src="/js/shared/micons.js" id="jcd-micons-js"></script>
    <script is:inline src="/js/shared/mrefonte.js" id="jcd-mrefonte-js"
    ></script>
  </body>
</html>
