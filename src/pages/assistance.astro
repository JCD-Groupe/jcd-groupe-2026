---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="Assistance JCD Groupe. Prise en main à distance par nos techniciens : LogMeIn Rescue, Assist ou TeamViewer. Service clients au 03 87 18 49 20, du lundi au vendredi de 8h30 à 18h."
    />
    <link rel="canonical" href="https://www.jcd-groupe.fr/assistance" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content="Assistance · Prise en main à distance · JCD Groupe"
    />
    <meta
      property="og:description"
      content="Un technicien JCD vous guide en direct : ouvrez l'outil de prise en main à distance qu'il vous indique — LogMeIn Rescue, Assist ou TeamViewer."
    />
    <meta property="og:url" content="https://www.jcd-groupe.fr/assistance" />
    <meta name="twitter:card" content="summary" />
    <title>Assistance · Prise en main à distance · JCD Groupe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="css/assistance.css" />
    <link rel="stylesheet" href="css/global.css" />
    <link rel="stylesheet" href="css/assistance-overrides.css" />
    <link rel="stylesheet" href="css/transition.css" />
    <script is:inline src="js/shared/transition.js"></script>
    <script is:inline src="js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <main id="contenu">
      <!-- ================================
     EN-TÊTE — compact, utilitaire : consigne + téléphone (pas de hero)
     ================================ -->
      <section class="assist-head" aria-labelledby="assist-hero-title">
        <div class="container">
          <div class="assist-head-grid">
            <div class="assist-head-main">
              <h1 id="assist-hero-title" class="assist-title reveal delay-1">
                Assistance
              </h1>
              <p class="assist-lead reveal delay-2">
                Vous êtes en ligne avec notre service clients&nbsp;? Ouvrez
                l’outil que votre technicien vous indique ci-dessous et
                laissez-vous guider.
              </p>
            </div>

            <aside
              class="assist-head-aside reveal delay-2"
              aria-label="Contacter le service clients"
            >
              <span class="assist-phone-label">
                <span class="assist-phone-dot" aria-hidden="true"></span>
                Pas encore en ligne&nbsp;?
              </span>
              <a href="tel:+33387184922" class="assist-phone-num"
                >03&nbsp;87&nbsp;18&nbsp;49&nbsp;22</a
              >
            </aside>
          </div>
        </div>
      </section>

      <!-- ================================
     OUTILS — 3 accès de prise en main à distance
     ================================ -->
      <section
        class="assist-tools"
        id="outils"
        aria-labelledby="assist-tools-title"
      >
        <div class="container">
          <div class="assist-tools-head reveal">
            <h2 class="section-title" id="assist-tools-title">
              Cliquez sur l'outil indiqué par votre technicien.
            </h2>
          </div>

          <div class="assist-grid">
            <!-- 01 — Prise en main à distance (LogMeIn Rescue) -->
            <a
              class="assist-card reveal delay-1"
              href="https://secure.logmeinrescue.com/Customer/Code.aspx"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="assist-card-top">
                <svg
                  class="assist-card-ic"
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="4" y="6" width="24" height="16" rx="2.5"></rect>
                  <path d="M12 27h8M16 22v5"></path>
                  <path d="M12 12l3 2.5-3 2.5M17 17h4"></path>
                </svg>
              </span>
              <span class="assist-card-name">Prise en main à distance</span>
              <span class="assist-card-desc"
                >Saisissez le code à 6 chiffres communiqué par votre technicien
                pour ouvrir la session.</span
              >
              <span class="assist-card-cta">
                Ouvrir la session
                <span class="assist-card-arrow" aria-hidden="true"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </span>
            </a>

            <!-- 02 — Assist -->
            <a
              class="assist-card reveal delay-2"
              href="https://assist.rg.gg/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="assist-card-top">
                <svg
                  class="assist-card-ic"
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="16" cy="16" r="11"></circle>
                  <path d="M16 5v4M16 23v4M5 16h4M23 16h4"></path>
                  <circle cx="16" cy="16" r="3.4"></circle>
                </svg>
              </span>
              <span class="assist-card-name">Assist</span>
              <span class="assist-card-desc"
                >Lancez l'outil Assist et communiquez l'identifiant affiché à
                votre technicien.</span
              >
              <span class="assist-card-cta">
                Lancer Assist
                <span class="assist-card-arrow" aria-hidden="true"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </span>
            </a>

            <!-- 03 — TeamViewer -->
            <a
              class="assist-card reveal delay-3"
              href="https://custom.teamviewer.com/easisupportjcd"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="assist-card-top">
                <svg
                  class="assist-card-ic"
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 4v14M16 18l-5-5M16 18l5-5"></path>
                  <path
                    d="M6 21v3.5a2.5 2.5 0 0 0 2.5 2.5h15a2.5 2.5 0 0 0 2.5-2.5V21"
                  ></path>
                </svg>
              </span>
              <span class="assist-card-name">TeamViewer</span>
              <span class="assist-card-desc"
                >Téléchargez le module TeamViewer JCD, puis transmettez votre ID
                à votre technicien.</span
              >
              <span class="assist-card-cta">
                Télécharger TeamViewer
                <span class="assist-card-arrow" aria-hidden="true"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </span>
            </a>
          </div>

          <!-- Accès secondaires : Servicedesk (clients sous contrat) + contact -->
          <div class="assist-secondary reveal delay-3">
            <a
              class="assist-sec-link"
              href="https://servicedesk.easisupport.fr"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="assist-sec-main">
                <span class="assist-sec-name">Portail EASI support</span>
                <span class="assist-sec-desc"
                  >Portail de tickets &mdash; réservé aux clients sous contrat.</span
                >
              </span>
              <span class="assist-card-arrow" aria-hidden="true"
                ><svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                ></span
              >
            </a>
            <a class="assist-sec-link" href="contact?pole=service">
              <span class="assist-sec-main">
                <span class="assist-sec-name">Nous contacter</span>
                <span class="assist-sec-desc"
                  >Une autre demande&nbsp;? Écrivez au pôle Service.</span
                >
              </span>
              <span class="assist-card-arrow" aria-hidden="true"
                ><svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                ></span
              >
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- ================================
     FOOTER
     ================================ -->
    <Footer />

    <!-- ================================
     SCRIPTS
     ================================ -->
    <script is:inline src="js/shared/reveal-animations.js"></script>
    <script is:inline src="js/shared/menu-frost.js"></script>
    <!-- jcd-mobile-nav (injected) -->
    <button
      class="jcd-burger"
      id="jcdBurger"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="jcdMnav"
    >
      <span class="jcd-burger__box" aria-hidden="true"
        ><i></i><i></i><i></i></span
      >
    </button>
    <div
      class="jcd-mnav"
      id="jcdMnav"
      role="dialog"
      aria-modal="true"
      aria-label="Menu de navigation"
      aria-hidden="true"
    >
      <div class="jcd-mnav__scroll">
        <div class="jcd-mnav__inner">
          <p
            class="jcd-mnav__eyebrow jcd-mnav__reveal"
            style="transition-delay:.04s"
          >
            Expertises
          </p>

          <div class="jcd-mnav__reveal" style="transition-delay:.07s">
            <div class="jcd-mnav__item" style="--mnav-c:#2E72BA">
              <a class="jcd-mnav__link" href="informatique"
                ><span class="jcd-mnav__dot"></span><span
                  class="jcd-mnav__label">Informatique</span
                ></a
              >
              <button
                class="jcd-acc__toggle"
                type="button"
                aria-expanded="false"
                aria-controls="jcdAccInfo"
                aria-label="Afficher les sous-pages Informatique"
              >
                <svg
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"><path d="M7 2v10M2 7h10"></path></svg
                >
              </button>
            </div>
            <div class="jcd-acc__panel" id="jcdAccInfo">
              <a class="jcd-mnav__sub" href="info-cloud">Cloud Microsoft</a>
              <a class="jcd-mnav__sub" href="info-collaboratif"
                >Solutions collaboratives &amp; audiovisuelles</a
              >
              <a class="jcd-mnav__sub" href="info-reseaux"
                >Architectures syst&egrave;mes &amp; r&eacute;seaux</a
              >
              <a class="jcd-mnav__sub" href="info-integration"
                >Int&eacute;gration &amp; Support PC</a
              >
            </div>
          </div>

          <a
            class="jcd-mnav__item jcd-mnav__reveal"
            style="--mnav-c:#E51D29;transition-delay:.10s"
            href="service"
            ><span class="jcd-mnav__dot"></span><span class="jcd-mnav__label"
              >Service</span
            ></a
          >
          <a
            class="jcd-mnav__item jcd-mnav__reveal"
            style="--mnav-c:#F9D605;transition-delay:.13s"
            href="developpement"
            ><span class="jcd-mnav__dot"></span><span class="jcd-mnav__label"
              >D&eacute;veloppement</span
            ></a
          >
          <a
            class="jcd-mnav__item jcd-mnav__reveal"
            style="--mnav-c:#F3941D;transition-delay:.16s"
            href="print"
            ><span class="jcd-mnav__dot"></span><span class="jcd-mnav__label"
              >Print</span
            ></a
          >
          <a
            class="jcd-mnav__item jcd-mnav__reveal"
            style="--mnav-c:#B063AC;transition-delay:.19s"
            href="telecom"
            ><span class="jcd-mnav__dot"></span><span class="jcd-mnav__label"
              >T&eacute;l&eacute;com</span
            ></a
          >
          <div class="jcd-mnav__reveal" style="transition-delay:.22s">
            <div class="jcd-mnav__item" style="--mnav-c:#8EC041">
              <a class="jcd-mnav__link" href="formation"
                ><span class="jcd-mnav__dot"></span><span
                  class="jcd-mnav__label">Formation</span
                ></a
              >
              <button
                class="jcd-acc__toggle"
                type="button"
                aria-expanded="false"
                aria-controls="jcdAccForm"
                aria-label="Afficher les catégories de formation"
              >
                <svg
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"><path d="M7 2v10M2 7h10"></path></svg
                >
              </button>
            </div>
            <div class="jcd-acc__panel" id="jcdAccForm">
              <a class="jcd-mnav__sub" href="formation-bureautique"
                >Bureautique</a
              >
              <a
                class="jcd-mnav__sub"
                href="formation-intelligence-artificielle"
                >Intelligence artificielle</a
              >
              <a class="jcd-mnav__sub" href="formation-informatique"
                >Informatique</a
              >
              <a class="jcd-mnav__sub" href="formation-communication-marketing"
                >Communication - Marketing</a
              >
              <a class="jcd-mnav__sub" href="formation-management">Management</a
              >
              <a class="jcd-mnav__sub" href="formation-commerce-relation-client"
                >Commerce - Relation client</a
              >
              <a class="jcd-mnav__sub" href="formation-comptabilite-gestion"
                >Comptabilit&eacute; - Gestion</a
              >
              <a class="jcd-mnav__sub" href="formation-ressources-humaines"
                >Ressources humaines</a
              >
              <a class="jcd-mnav__sub" href="formation-developpement-personnel"
                >D&eacute;veloppement personnel</a
              >
              <a class="jcd-mnav__sub" href="formation-graphisme-pao"
                >Graphisme - PAO</a
              >
              <a
                class="jcd-mnav__sub"
                href="formation-administratif-secretariat-accueil"
                >Administratif - Secr&eacute;tariat</a
              >
              <a class="jcd-mnav__sub" href="formation-securite"
                >S&eacute;curit&eacute;</a
              >
              <a class="jcd-mnav__sub" href="formation-langues">Langues</a>
            </div>
          </div>
          <a
            class="jcd-mnav__item jcd-mnav__reveal"
            style="--mnav-c:#A78D75;transition-delay:.25s"
            href="agencement"
            ><span class="jcd-mnav__dot"></span><span class="jcd-mnav__label"
              >Agencement</span
            ></a
          >

          <p
            class="jcd-mnav__eyebrow jcd-mnav__sec2 jcd-mnav__reveal"
            style="transition-delay:.30s"
          >
            D&eacute;couvrir
          </p>
          <a
            class="jcd-mnav__item jcd-mnav__reveal"
            style="--mnav-c:#9a9a9a;transition-delay:.33s"
            href="assistance"
            ><span class="jcd-mnav__dot"></span><span
              class="jcd-mnav__label"
              style="font-size:19px">Assistance</span
            ></a
          >
          <a
            class="jcd-mnav__item jcd-mnav__reveal"
            style="--mnav-c:#9a9a9a;transition-delay:.36s"
            href="carrieres"
            ><span class="jcd-mnav__dot"></span><span
              class="jcd-mnav__label"
              style="font-size:19px">Carri&egrave;res</span
            ></a
          >

          <div
            class="jcd-mnav__cta jcd-mnav__reveal"
            style="transition-delay:.40s"
          >
            <a class="jcd-mnav__btn jcd-mnav__btn--primary" href="contact"
              >Contacter un expert
              <span class="jcd-mnav__btn-ic"
                ><svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                ></span
              ></a
            >
            <a
              class="jcd-mnav__btn jcd-mnav__btn--ghost"
              href="tel:+33387184920"
              >03 87 18 49 20
              <span class="jcd-mnav__btn-ic"
                ><svg
                  viewBox="0 0 18 18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path
                    d="M2.5 3.5a1 1 0 011-1h2.4a1 1 0 01.95.68l.86 2.4a1 1 0 01-.24 1l-1.2 1.2a11 11 0 004.6 4.6l1.2-1.2a1 1 0 011-.24l2.4.86a1 1 0 01.68.95V15a1 1 0 01-1 1A13.5 13.5 0 012.5 3.5z"
                  ></path></svg
                ></span
              ></a
            >
          </div>
        </div>
      </div>
    </div>
    <script is:inline src="js/shared/mobile-nav.js"></script>
    <!-- jcd-a11y (Lot 5) -->
    <div class="jcd-fab-wrap" id="jcd-fab">
      <button
        class="jcd-fab jcd-fab--top"
        id="jcdToTop"
        type="button"
        aria-label="Remonter en haut"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M10 16V5M5 10l5-5 5 5"></path></svg
        >
      </button>
      <a
        class="jcd-fab jcd-fab--contact"
        id="jcdFabContact"
        href="contact"
        aria-label="Nous contacter"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="2.5" y="4.5" width="15" height="11" rx="2.3"></rect><path
            d="M3 6.7 L10 10.7 L17 6.7"></path></svg
        >
      </a>
    </div>
    <script is:inline src="js/shared/a11y.js" id="jcd-a11y-js"></script>
    <script is:inline src="js/shared/micons.js" id="jcd-micons-js"></script>
    <script is:inline src="js/shared/mrefonte.js" id="jcd-mrefonte-js"></script>
  </body>
</html>
