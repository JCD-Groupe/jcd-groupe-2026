---
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

let developpement;

developpement = await directus.request(
  readSingleton("JCD_Developpement", {
    fields: [
      "*",
      { logo_client_1: ["*"] },
      { logo_client_2: ["*"] },
      { logo_client_3: ["*"] },
      { logo_client_4: ["*"] },
      { logo_client_5: ["*"] },
      { logo_client_6: ["*"] },
    ],
  }),
);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={developpement.meta_description} />
    <link rel="canonical" href="https://www.jcd-groupe.fr/developpement" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={developpement.og_title} />
    <meta property="og:description" content={developpement.og_description} />
    <meta property="og:url" content="https://www.jcd-groupe.fr/developpement" />
    <meta name="twitter:card" content="summary" />
    <title>{developpement.meta_title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/developpement.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/developpement-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ====================================================================
     HERO — Mesh WebGL (or JCD) + champ ASCII binaire
     ==================================================================== -->
        <section class="print-hero" aria-labelledby="hero-title">
          <div class="hero-mesh-fallback" aria-hidden="true"></div>
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>
          <canvas class="hero-gridglow" id="heroGrid" aria-hidden="true"
          ></canvas>
          <div class="hero-texture hero-texture--grid" aria-hidden="true"></div>
          <canvas class="hero-ascii" id="heroAscii" aria-hidden="true"></canvas>
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1
              id="hero-title"
              class="hero-title reveal delay-1"
              set:html={developpement.titre_hero}
            />
            <p class="hero-sub reveal delay-2">
              {developpement.sous_titre_hero}
            </p>

            <div class="hero-actions reveal delay-3">
              <a
                href="/contact?pole=developpement&step=2"
                class="btn-cta btn-cta--ghost"
              >
                {developpement.bouton_hero}
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ====================================================================
     MANIFESTO — Fenêtre terminal : le manifeste du pôle, en ligne de commande
     ==================================================================== -->
        <section class="manifesto" aria-label="Manifeste du pôle Développement">
          <div class="container">
            <div class="mf-shell">
              <header class="mf-header reveal">
                <span class="mf-header-side">
                  <span class="mf-caret" aria-hidden="true">&#9656;</span>
                  <span class="mf-id">DEV&middot;01</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Manifeste</span>
                </span>
                <span class="mf-header-side">
                  <span>Terminal</span>
                  <span class="mf-rule" aria-hidden="true"></span>
                  <span>Pôle Développement</span>
                </span>
              </header>

              <div class="term-window reveal delay-1" id="termWindow">
                <div class="term-bar">
                  <span class="term-dots" aria-hidden="true"
                    ><i></i><i></i><i></i></span
                  >
                  <span class="term-title"
                    >manifeste · jcd:~/developpement · zsh</span
                  >
                  <span class="term-bar-spacer" aria-hidden="true"></span>
                </div>
                <div class="term-body">
                  <div class="term-line">
                    <span class="term-prompt" aria-hidden="true">$</span>
                    <span
                      class="term-cmd"
                      id="termCmd"
                      data-cmd="cat manifeste.md"></span><span
                      class="term-cursor"
                      id="termCursor"
                      aria-hidden="true"></span>
                  </div>
                  <span class="term-com"># pôle développement · jcd groupe</span
                  >
                  <div
                    class="manifesto-rich"
                    set:html={developpement.manifeste}
                  />
                </div>
              </div>
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone -->

      <!-- ====================================================================
     PRESTATIONS — Deux solutions (apps web + sites) en grille 2x3
     ==================================================================== -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prestations-title"
      >
        <div class="container">
          <div class="prest-layout">
            <aside class="prest-aside reveal">
              <h2
                class="prest-aside-title"
                id="prestations-title"
                set:html={developpement.titre_prestations}
              />
              <p
                class="prest-aside-sub"
                set:html={developpement.sous_titre_prestations}
              />

              <div class="prest-aside-clients">
                <div class="prest-aside-clients-head">
                  <span class="prest-aside-clients-label"
                    >{developpement.titre_clients}</span
                  >
                  <span class="prest-aside-clients-rule" aria-hidden="true"
                  ></span>
                  <span class="prest-aside-clients-count"
                    >{developpement.nombre_clients}</span
                  >
                </div>
                <div class="jcd-lcards" aria-label="Logos de nos clients">
                  <div class="jcd-lcard" data-name="Banque Populaire ALC">
                    <img
                      src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${developpement.logo_client_1.id}`}
                      alt={developpement.logo_client_1.title || ""}
                      title={developpement.logo_client_1.title || ""}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="jcd-lcard" data-name="Viessmann">
                    <img
                      src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${developpement.logo_client_2.id}`}
                      alt={developpement.logo_client_2.title || ""}
                      title={developpement.logo_client_2.title || ""}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="jcd-lcard" data-name="Georgia Tech Europe">
                    <img
                      src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${developpement.logo_client_3.id}`}
                      alt={developpement.logo_client_3.title || ""}
                      title={developpement.logo_client_3.title || ""}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="jcd-lcard" data-name="Lorraine Aéroport">
                    <img
                      src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${developpement.logo_client_4.id}`}
                      alt={developpement.logo_client_4.title || ""}
                      title={developpement.logo_client_4.title || ""}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="jcd-lcard" data-name="Car Avenue">
                    <img
                      src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${developpement.logo_client_5.id}`}
                      alt={developpement.logo_client_5.title || ""}
                      title={developpement.logo_client_5.title || ""}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="jcd-lcard" data-name="Briotet">
                    <img
                      src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${developpement.logo_client_6.id}`}
                      alt={developpement.logo_client_6.title || ""}
                      title={developpement.logo_client_6.title || ""}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              </div>
            </aside>

            <div class="prest-menu reveal delay-1">
              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.25"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <path
                        d="M20 7 a8 8 0 0 1 5 14 c-1 1-1.5 2-1.5 3.5 h-7 c0-1.5-.5-2.5-1.5-3.5 a8 8 0 0 1 5-14 Z"
                      ></path>
                      <path d="M16.5 28 h7 M17.5 32 h5" opacity="0.6"></path>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  {developpement.prestation_1_titre}
                </h3>
                <p class="prest-item-desc">
                  {developpement.prestation_1_description}
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.25"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <rect x="9" y="6" width="22" height="28" rx="2"></rect>
                      <path d="M14 14 h12 M14 19 h12 M14 24 h7" opacity="0.6"
                      ></path>
                      <path d="M21 28.5 l2 2 4-4" opacity="0.9"></path>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  {developpement.prestation_2_titre}
                </h3>
                <p class="prest-item-desc">
                  {developpement.prestation_2_description}
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.25"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <path d="M15 14 l-7 6 7 6"></path>
                      <path d="M25 14 l7 6-7 6"></path>
                      <path d="M22 11 l-4 18" opacity="0.6"></path>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  {developpement.prestation_3_titre}
                </h3>
                <p class="prest-item-desc">
                  {developpement.prestation_3_description}
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.25"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <rect x="7" y="9" width="26" height="22" rx="2"></rect>
                      <path d="M7 15 h26"></path>
                      <circle
                        cx="11"
                        cy="12"
                        r="0.9"
                        fill="currentColor"
                        stroke="none"></circle>
                      <path d="M14 21 h7 M14 25 h12" opacity="0.55"></path>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  {developpement.prestation_4_titre}
                </h3>
                <p class="prest-item-desc">
                  {developpement.prestation_4_description}
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.25"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <circle cx="17" cy="17" r="9"></circle>
                      <path d="M23.5 23.5 L32 32"></path>
                      <path d="M13 19 l3-3 2 2 4-5" opacity="0.7"></path>
                      <path d="M20 13 h2.4 v2.4" opacity="0.7"></path>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  {developpement.prestation_5_titre}
                </h3>
                <p class="prest-item-desc">
                  {developpement.prestation_5_description}
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.25"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <rect x="8" y="8" width="24" height="9" rx="1.5"></rect>
                      <rect x="8" y="21" width="24" height="9" rx="1.5"></rect>
                      <circle
                        cx="13"
                        cy="12.5"
                        r="1"
                        fill="currentColor"
                        stroke="none"></circle>
                      <circle
                        cx="13"
                        cy="25.5"
                        r="1"
                        fill="currentColor"
                        stroke="none"></circle>
                      <path d="M23 25.5 h5" opacity="0.5"></path>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  {developpement.prestation_6_titre}
                </h3>
                <p class="prest-item-desc">
                  {developpement.prestation_6_description}
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     SECTION DIVIDER
     ==================================================================== -->
      <div class="section-divider" aria-hidden="true">
        <div class="container"><span class="section-divider-line"></span></div>
      </div>

      <!-- ====================================================================
     PROCESS — "Pipeline" : axe CI/CD horizontal à 4 étapes
     ==================================================================== -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="section-head reveal">
            <h2 class="section-title" id="process-title">
              <span set:html={developpement.titre_processus} />
              <span class="text-muted"
                >{developpement.sous_titre_processus}</span
              >
            </h2>
          </div>

          <!-- « Pipeline développement » : axe horizontal, 4 jalons (cadrage → build →
         run), pulse de données qui traverse en boucle. Technique identique aux
         autres pôles (SVG pathLength + glow + .reveal IntersectionObserver). -->
          <div class="pf-vflow reveal" id="pf-vflow">
            <svg
              class="pf-vsvg"
              viewBox="0 0 900 290"
              preserveAspectRatio="xMidYMid meet"
              aria-hidden="true"
            >
              <defs>
                <linearGradient id="pf-curve-grad" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#fce148"></stop>
                  <stop offset="35%" stop-color="#F9D605"></stop>
                  <stop offset="70%" stop-color="#d9bd05"></stop>
                  <stop offset="100%" stop-color="#b89e04"></stop>
                </linearGradient>
                <filter
                  id="pf-glow"
                  x="-15%"
                  y="-15%"
                  width="130%"
                  height="130%"
                >
                  <feGaussianBlur stdDeviation="2.2" result="b"
                  ></feGaussianBlur>
                  <feMerge
                    ><feMergeNode in="b"></feMergeNode><feMergeNode
                      in="SourceGraphic"></feMergeNode></feMerge
                  >
                </filter>
                <!-- Flou doux dédié au signal : feutre les extrémités du faisceau pour
               un fondu progressif avec sa courbe (rupture moins nette). -->
                <filter
                  id="pf-signal-soft"
                  x="-50%"
                  y="-50%"
                  width="200%"
                  height="200%"
                >
                  <feGaussianBlur stdDeviation="3.2"></feGaussianBlur>
                </filter>
                <linearGradient
                  id="pf-drop-g1"
                  gradientUnits="userSpaceOnUse"
                  x1="0"
                  y1="113"
                  x2="0"
                  y2="272"
                >
                  <stop offset="0%" stop-color="#fce148" stop-opacity="0.55"
                  ></stop>
                  <stop offset="62%" stop-color="#fce148" stop-opacity="0.20"
                  ></stop>
                  <stop offset="100%" stop-color="#fce148" stop-opacity="0.08"
                  ></stop>
                </linearGradient>
                <linearGradient
                  id="pf-drop-g2"
                  gradientUnits="userSpaceOnUse"
                  x1="0"
                  y1="153"
                  x2="0"
                  y2="272"
                >
                  <stop offset="0%" stop-color="#F9D605" stop-opacity="0.55"
                  ></stop>
                  <stop offset="62%" stop-color="#F9D605" stop-opacity="0.20"
                  ></stop>
                  <stop offset="100%" stop-color="#F9D605" stop-opacity="0.08"
                  ></stop>
                </linearGradient>
                <linearGradient
                  id="pf-drop-g3"
                  gradientUnits="userSpaceOnUse"
                  x1="0"
                  y1="71"
                  x2="0"
                  y2="272"
                >
                  <stop offset="0%" stop-color="#d9bd05" stop-opacity="0.55"
                  ></stop>
                  <stop offset="62%" stop-color="#d9bd05" stop-opacity="0.18"
                  ></stop>
                  <stop offset="100%" stop-color="#d9bd05" stop-opacity="0.08"
                  ></stop>
                </linearGradient>
                <linearGradient
                  id="pf-drop-g4"
                  gradientUnits="userSpaceOnUse"
                  x1="0"
                  y1="113"
                  x2="0"
                  y2="272"
                >
                  <stop offset="0%" stop-color="#b89e04" stop-opacity="0.55"
                  ></stop>
                  <stop offset="62%" stop-color="#b89e04" stop-opacity="0.18"
                  ></stop>
                  <stop offset="100%" stop-color="#b89e04" stop-opacity="0.08"
                  ></stop>
                </linearGradient>
              </defs>

              <!-- Étiquettes bookend (au-dessus des nodes d'entrée / sortie) -->
              <text class="pf-label" x="113" y="74" text-anchor="middle"
                >{developpement.processus_label_debut}</text
              >
              <text class="pf-label" x="787" y="74" text-anchor="middle"
                >{developpement.processus_label_fin}</text
              >

              <!-- Circuit PCB : tracé en escalier (routage 90° arrondi) reliant les 4 nodes -->
              <path
                class="pf-track-base"
                d="M 113 100 L 215 100 Q 225 100 225 110 L 225 130 Q 225 140 235 140 L 338 140 L 440 140 Q 450 140 450 130 L 450 68 Q 450 58 460 58 L 562 58 L 665 58 Q 675 58 675 68 L 675 90 Q 675 100 685 100 L 787 100"
              ></path>
              <path
                class="pf-track-line"
                d="M 113 100 L 215 100 Q 225 100 225 110 L 225 130 Q 225 140 235 140 L 338 140 L 440 140 Q 450 140 450 130 L 450 68 Q 450 58 460 58 L 562 58 L 665 58 Q 675 58 675 68 L 675 90 Q 675 100 685 100 L 787 100"
                pathLength="100"></path>
              <path
                class="pf-signal"
                d="M 113 100 L 215 100 Q 225 100 225 110 L 225 130 Q 225 140 235 140 L 338 140 L 440 140 Q 450 140 450 130 L 450 68 Q 450 58 460 58 L 562 58 L 665 58 Q 675 58 675 68 L 675 90 Q 675 100 685 100 L 787 100"
                pathLength="100"></path>

              <!-- Faisceaux verticaux node → stack (longueurs variées selon la hauteur du node) -->
              <line
                class="pf-drop pf-drop--1"
                x1="113"
                y1="113"
                x2="113"
                y2="252"
                pathLength="100"></line>
              <line
                class="pf-drop pf-drop--2"
                x1="338"
                y1="153"
                x2="338"
                y2="270"
                pathLength="100"></line>
              <line
                class="pf-drop pf-drop--3"
                x1="562"
                y1="71"
                x2="562"
                y2="252"
                pathLength="100"></line>
              <line
                class="pf-drop pf-drop--4"
                x1="787"
                y1="113"
                x2="787"
                y2="270"
                pathLength="100"></line>

              <!-- Stacks de couches (terminal de chaque faisceau) : 3 barres décroissantes -->
              <g class="pf-stack pf-stack--1" style="--node-c:#fce148">
                <line
                  class="pf-stack-bar pf-stack-bar--1"
                  x1="100"
                  y1="254"
                  x2="126"
                  y2="254"></line>
                <line
                  class="pf-stack-bar pf-stack-bar--2"
                  x1="104.5"
                  y1="260"
                  x2="121.5"
                  y2="260"></line>
                <line
                  class="pf-stack-bar pf-stack-bar--3"
                  x1="109"
                  y1="266"
                  x2="117"
                  y2="266"></line>
              </g>
              <g class="pf-stack pf-stack--2" style="--node-c:#F9D605">
                <line
                  class="pf-stack-bar pf-stack-bar--1"
                  x1="325"
                  y1="272"
                  x2="351"
                  y2="272"></line>
                <line
                  class="pf-stack-bar pf-stack-bar--2"
                  x1="329.5"
                  y1="278"
                  x2="346.5"
                  y2="278"></line>
                <line
                  class="pf-stack-bar pf-stack-bar--3"
                  x1="334"
                  y1="284"
                  x2="342"
                  y2="284"></line>
              </g>
              <g class="pf-stack pf-stack--3" style="--node-c:#d9bd05">
                <line
                  class="pf-stack-bar pf-stack-bar--1"
                  x1="549"
                  y1="254"
                  x2="575"
                  y2="254"></line>
                <line
                  class="pf-stack-bar pf-stack-bar--2"
                  x1="553.5"
                  y1="260"
                  x2="570.5"
                  y2="260"></line>
                <line
                  class="pf-stack-bar pf-stack-bar--3"
                  x1="558"
                  y1="266"
                  x2="566"
                  y2="266"></line>
              </g>
              <g class="pf-stack pf-stack--4" style="--node-c:#b89e04">
                <line
                  class="pf-stack-bar pf-stack-bar--1"
                  x1="774"
                  y1="272"
                  x2="800"
                  y2="272"></line>
                <line
                  class="pf-stack-bar pf-stack-bar--2"
                  x1="778.5"
