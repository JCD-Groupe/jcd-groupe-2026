---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#0d0d0d" />
<link rel="icon" href="favicon.svg" type="image/svg+xml" />
<meta name="description" content="JCD Groupe · Pôle Développement. Outils sur mesure, digitalisation des processus." />
<link rel="canonical" href="https://www.jcd-groupe.fr/developpement.html" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="JCD Groupe" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:title" content="Développement · JCD Groupe" />
<meta property="og:description" content="JCD Groupe · Pôle Développement. Outils sur mesure, digitalisation des processus." />
<meta property="og:url" content="https://www.jcd-groupe.fr/developpement.html" />
<meta name="twitter:card" content="summary" />
<title>Développement · JCD Groupe</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

<link rel="stylesheet" href="css/developpement.css">
<link rel="stylesheet" href="css/global.css">
<link rel="stylesheet" href="css/developpement-overrides.css">
  <link rel="stylesheet" href="transition.css">
  <script is:inline src="transition.js"></script>
<script is:inline src="js/shared/xpcompact.js" id="jcd-xpcompact-js"></script>
<script is:inline src="js/shared/touch.js" id="jcd-touch-js"></script>
<script is:inline src="js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"></script>
</head>
<body>
<a class="jcd-skip" href="#contenu">Aller au contenu</a>

<!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
<Header />


<main id="contenu">

<div class="hero-pin-zone">

<!-- ====================================================================
     HERO — Mesh WebGL (or JCD) + champ ASCII binaire
     ==================================================================== -->
<section class="print-hero" aria-labelledby="hero-title">

  <div class="hero-mesh-fallback" aria-hidden="true"></div>
  <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>
  <canvas class="hero-gridglow" id="heroGrid" aria-hidden="true"></canvas>
  <div class="hero-texture hero-texture--grid" aria-hidden="true"></div>
  <canvas class="hero-ascii" id="heroAscii" aria-hidden="true"></canvas>
  <div class="hero-grain" aria-hidden="true"></div>

  <div class="container">
    <h1 id="hero-title" class="hero-title reveal delay-1">
      Des applications <span class="accent-grad">sur mesure</span>, pensées pour votre métier.
    </h1>

    <p class="hero-sub reveal delay-2">
      Applications web et sites internet conçus et développés pour tous vos besoins.
    </p>

    <div class="hero-actions reveal delay-3">
      <a href="contact.html?pole=developpement" class="btn-cta btn-cta--ghost">
        Démarrer un projet
        <span class="btn-cta-arrow"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
      </a>
    </div>
  </div>
</section>


<!-- ====================================================================
     MANIFESTO — Fenêtre terminal : le manifeste du pôle, en ligne de commande
     ==================================================================== -->
<section class="manifesto" aria-label="Manifeste du pôle Développement">
  <div class="container">
    <div class="mf-shell">

      <header class="mf-header reveal">
        <span class="mf-header-side">
          <span class="mf-caret" aria-hidden="true">&#9656;</span>
          <span class="mf-id">DEV&middot;01</span>
          <span class="mf-rule" aria-hidden="true"></span>
          <span>Manifeste</span>
        </span>
        <span class="mf-header-side">
          <span>Terminal</span>
          <span class="mf-rule" aria-hidden="true"></span>
          <span>Pôle Développement</span>
        </span>
      </header>

      <div class="term-window reveal delay-1" id="termWindow">
        <div class="term-bar">
          <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="term-title">manifeste · jcd:~/developpement · zsh</span>
          <span class="term-bar-spacer" aria-hidden="true"></span>
        </div>
        <div class="term-body">
          <div class="term-line">
            <span class="term-prompt" aria-hidden="true">$</span>
            <span class="term-cmd" id="termCmd" data-cmd="cat manifeste.md"></span><span class="term-cursor" id="termCursor" aria-hidden="true"></span>
          </div>
          <span class="term-com"># pôle développement · jcd groupe</span>
          <p class="term-out" id="termOut">
            <strong>Développer</strong>, ce n'est pas seulement empiler des lignes de code. C'est aussi traduire vos besoins métier en un outil qui travaille pour vous. Chaque application est <span class="accent">conçue sur mesure</span>. À partir de votre cahier des charges, nous développons votre projet. Notre code l'exécute, le teste et le maintient. La technologie au service du résultat.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

</div><!-- /hero-pin-zone -->

<!-- ====================================================================
     PRESTATIONS — Deux solutions (apps web + sites) en grille 2x3
     ==================================================================== -->
<section class="prestations" id="prestations" aria-labelledby="prestations-title">
  <div class="container">
    <div class="prest-layout">

      <aside class="prest-aside reveal">
        <h2 class="prest-aside-title" id="prestations-title">
          <span class="accent">Six prestations</span>, un seul interlocuteur.
        </h2>
        <p class="prest-aside-sub">
          Applications web métier et sites internet vitrine ou marchand, de l'analyse du besoin à l'hébergement et la maintenance, tout est internalisé.
        </p>

        <div class="prest-aside-clients">
          <div class="prest-aside-clients-head">
            <span class="prest-aside-clients-label">Ils nous font confiance</span>
            <span class="prest-aside-clients-rule" aria-hidden="true"></span>
            <span class="prest-aside-clients-count">100+</span>
          </div>
          <div class="jcd-lcards" aria-label="Logos de nos clients">
            <div class="jcd-lcard" data-name="Banque Populaire ALC">
              <img src="logos%20DEV/banque-populaire.png" alt="Banque Populaire ALC">
            </div>
            <div class="jcd-lcard" data-name="Viessmann">
              <img src="logos%20DEV/viessmann.png" alt="Viessmann">
            </div>
            <div class="jcd-lcard" data-name="Georgia Tech Europe">
              <img src="logos%20DEV/georgia-tech.png" alt="Georgia Tech Europe">
            </div>
            <div class="jcd-lcard" data-name="Lorraine Aéroport">
              <img src="logos%20DEV/lorraine-aeroport.png" alt="Lorraine Aéroport">
            </div>
            <div class="jcd-lcard" data-name="Car Avenue">
              <img src="logos%20DEV/car-avenue.webp" alt="Car Avenue">
            </div>
            <div class="jcd-lcard" data-name="Briotet">
              <img src="logos%20DEV/briotet.webp" alt="Briotet">
            </div>
          </div>
        </div>
      </aside>

      <div class="prest-menu reveal delay-1">

        <article class="prest-item">
          <div class="prest-item-head">
            <span class="prest-item-glyph" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round">
                <path d="M20 7 a8 8 0 0 1 5 14 c-1 1-1.5 2-1.5 3.5 h-7 c0-1.5-.5-2.5-1.5-3.5 a8 8 0 0 1 5-14 Z"/>
                <path d="M16.5 28 h7 M17.5 32 h5" opacity="0.6"/>
              </svg>
            </span>
          </div>
          <h3 class="prest-item-title">Analyse &amp; conseil</h3>
          <p class="prest-item-desc">Étude du contexte et du besoin réel. On vous oriente vers la solution la plus juste.</p>
        </article>

        <article class="prest-item">
          <div class="prest-item-head">
            <span class="prest-item-glyph" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round">
                <rect x="9" y="6" width="22" height="28" rx="2"/>
                <path d="M14 14 h12 M14 19 h12 M14 24 h7" opacity="0.6"/>
                <path d="M21 28.5 l2 2 4-4" opacity="0.9"/>
              </svg>
            </span>
          </div>
          <h3 class="prest-item-title">Audit &amp; cahier des charges</h3>
          <p class="prest-item-desc">Audit de l'existant et rédaction d'un cahier des charges clair, qui cadre le projet et les coûts.</p>
        </article>

        <article class="prest-item">
          <div class="prest-item-head">
            <span class="prest-item-glyph" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round">
                <path d="M15 14 l-7 6 7 6"/>
                <path d="M25 14 l7 6-7 6"/>
                <path d="M22 11 l-4 18" opacity="0.6"/>
              </svg>
            </span>
          </div>
          <h3 class="prest-item-title">Applications web sur mesure</h3>
          <p class="prest-item-desc">Conception, développement et mise en œuvre d'outils métier qui digitalisent vos processus.</p>
        </article>

        <article class="prest-item">
          <div class="prest-item-head">
            <span class="prest-item-glyph" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round">
                <rect x="7" y="9" width="26" height="22" rx="2"/>
                <path d="M7 15 h26"/>
                <circle cx="11" cy="12" r="0.9" fill="currentColor" stroke="none"/>
                <path d="M14 21 h7 M14 25 h12" opacity="0.55"/>
              </svg>
            </span>
          </div>
          <h3 class="prest-item-title">Sites vitrine &amp; marchands</h3>
          <p class="prest-item-desc">Sites internet sur mesure, du site vitrine à la boutique en ligne, pensés pour convertir.</p>
        </article>

        <article class="prest-item">
          <div class="prest-item-head">
            <span class="prest-item-glyph" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round">
                <circle cx="17" cy="17" r="9"/>
                <path d="M23.5 23.5 L32 32"/>
                <path d="M13 19 l3-3 2 2 4-5" opacity="0.7"/>
                <path d="M20 13 h2.4 v2.4" opacity="0.7"/>
              </svg>
            </span>
          </div>
          <h3 class="prest-item-title">Référencement SEO / SEA</h3>
          <p class="prest-item-desc">Optimisation du référencement naturel et payant pour rendre votre site visible et performant.</p>
        </article>

        <article class="prest-item">
          <div class="prest-item-head">
            <span class="prest-item-glyph" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round">
                <rect x="8" y="8" width="24" height="9" rx="1.5"/>
                <rect x="8" y="21" width="24" height="9" rx="1.5"/>
                <circle cx="13" cy="12.5" r="1" fill="currentColor" stroke="none"/>
                <circle cx="13" cy="25.5" r="1" fill="currentColor" stroke="none"/>
                <path d="M23 25.5 h5" opacity="0.5"/>
              </svg>
            </span>
          </div>
          <h3 class="prest-item-title">Hébergement &amp; maintenance</h3>
          <p class="prest-item-desc">Formation, suivi, hotline, hébergement et maintenance. Votre solution reste vivante dans le temps.</p>
        </article>

      </div>
    </div>
  </div>
</section>


<!-- ====================================================================
     SECTION DIVIDER
     ==================================================================== -->
<div class="section-divider" aria-hidden="true">
  <div class="container"><span class="section-divider-line"></span></div>
</div>


<!-- ====================================================================
     PROCESS — "Pipeline" : axe CI/CD horizontal à 4 étapes
     ==================================================================== -->
<section class="process" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="section-title" id="process-title">
        Quatre temps, <span class="accent">un pipeline maîtrisé de bout en bout.</span>
        <span class="text-muted">De l'écoute du besoin à la mise en production et la maintenance, chaque étape est tracée et validée avec vous.</span>
      </h2>
    </div>

    <!-- « Pipeline développement » : axe horizontal, 4 jalons (cadrage → build →
         run), pulse de données qui traverse en boucle. Technique identique aux
         autres pôles (SVG pathLength + glow + .reveal IntersectionObserver). -->
    <div class="pf-vflow reveal" id="pf-vflow">
      <svg class="pf-vsvg" viewBox="0 0 900 290" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <linearGradient id="pf-curve-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"   stop-color="#fce148"/>
            <stop offset="35%"  stop-color="#F9D605"/>
            <stop offset="70%"  stop-color="#d9bd05"/>
            <stop offset="100%" stop-color="#b89e04"/>
          </linearGradient>
          <filter id="pf-glow" x="-15%" y="-15%" width="130%" height="130%">
            <feGaussianBlur stdDeviation="2.2" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <!-- Flou doux dédié au signal : feutre les extrémités du faisceau pour
               un fondu progressif avec sa courbe (rupture moins nette). -->
          <filter id="pf-signal-soft" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="3.2"/>
          </filter>
          <linearGradient id="pf-drop-g1" gradientUnits="userSpaceOnUse" x1="0" y1="113" x2="0" y2="272">
            <stop offset="0%" stop-color="#fce148" stop-opacity="0.55"/>
            <stop offset="62%" stop-color="#fce148" stop-opacity="0.20"/>
            <stop offset="100%" stop-color="#fce148" stop-opacity="0.08"/>
          </linearGradient>
          <linearGradient id="pf-drop-g2" gradientUnits="userSpaceOnUse" x1="0" y1="153" x2="0" y2="272">
            <stop offset="0%" stop-color="#F9D605" stop-opacity="0.55"/>
            <stop offset="62%" stop-color="#F9D605" stop-opacity="0.20"/>
            <stop offset="100%" stop-color="#F9D605" stop-opacity="0.08"/>
          </linearGradient>
          <linearGradient id="pf-drop-g3" gradientUnits="userSpaceOnUse" x1="0" y1="71" x2="0" y2="272">
            <stop offset="0%" stop-color="#d9bd05" stop-opacity="0.55"/>
            <stop offset="62%" stop-color="#d9bd05" stop-opacity="0.18"/>
            <stop offset="100%" stop-color="#d9bd05" stop-opacity="0.08"/>
          </linearGradient>
          <linearGradient id="pf-drop-g4" gradientUnits="userSpaceOnUse" x1="0" y1="113" x2="0" y2="272">
            <stop offset="0%" stop-color="#b89e04" stop-opacity="0.55"/>
            <stop offset="62%" stop-color="#b89e04" stop-opacity="0.18"/>
            <stop offset="100%" stop-color="#b89e04" stop-opacity="0.08"/>
          </linearGradient>
        </defs>


        <!-- Étiquettes bookend (au-dessus des nodes d'entrée / sortie) -->
        <text class="pf-label" x="113" y="74" text-anchor="middle">Brief client</text>
        <text class="pf-label" x="787" y="74" text-anchor="middle">Livraison</text>

        <!-- Circuit PCB : tracé en escalier (routage 90° arrondi) reliant les 4 nodes -->
        <path class="pf-track-base" d="M 113 100 L 215 100 Q 225 100 225 110 L 225 130 Q 225 140 235 140 L 338 140 L 440 140 Q 450 140 450 130 L 450 68 Q 450 58 460 58 L 562 58 L 665 58 Q 675 58 675 68 L 675 90 Q 675 100 685 100 L 787 100"/>
        <path class="pf-track-line" d="M 113 100 L 215 100 Q 225 100 225 110 L 225 130 Q 225 140 235 140 L 338 140 L 440 140 Q 450 140 450 130 L 450 68 Q 450 58 460 58 L 562 58 L 665 58 Q 675 58 675 68 L 675 90 Q 675 100 685 100 L 787 100" pathLength="100"/>
        <path class="pf-signal" d="M 113 100 L 215 100 Q 225 100 225 110 L 225 130 Q 225 140 235 140 L 338 140 L 440 140 Q 450 140 450 130 L 450 68 Q 450 58 460 58 L 562 58 L 665 58 Q 675 58 675 68 L 675 90 Q 675 100 685 100 L 787 100" pathLength="100"/>

        <!-- Faisceaux verticaux node → stack (longueurs variées selon la hauteur du node) -->
        <line class="pf-drop pf-drop--1" x1="113" y1="113" x2="113" y2="252" pathLength="100"/>
        <line class="pf-drop pf-drop--2" x1="338" y1="153" x2="338" y2="270" pathLength="100"/>
        <line class="pf-drop pf-drop--3" x1="562" y1="71"  x2="562" y2="252" pathLength="100"/>
        <line class="pf-drop pf-drop--4" x1="787" y1="113" x2="787" y2="270" pathLength="100"/>

        <!-- Stacks de couches (terminal de chaque faisceau) : 3 barres décroissantes -->
        <g class="pf-stack pf-stack--1" style="--node-c:#fce148">
          <line class="pf-stack-bar pf-stack-bar--1" x1="100" y1="254" x2="126" y2="254"/>
          <line class="pf-stack-bar pf-stack-bar--2" x1="104.5" y1="260" x2="121.5" y2="260"/>
          <line class="pf-stack-bar pf-stack-bar--3" x1="109" y1="266" x2="117" y2="266"/>
        </g>
        <g class="pf-stack pf-stack--2" style="--node-c:#F9D605">
          <line class="pf-stack-bar pf-stack-bar--1" x1="325" y1="272" x2="351" y2="272"/>
          <line class="pf-stack-bar pf-stack-bar--2" x1="329.5" y1="278" x2="346.5" y2="278"/>
          <line class="pf-stack-bar pf-stack-bar--3" x1="334" y1="284" x2="342" y2="284"/>
        </g>
        <g class="pf-stack pf-stack--3" style="--node-c:#d9bd05">
          <line class="pf-stack-bar pf-stack-bar--1" x1="549" y1="254" x2="575" y2="254"/>
          <line class="pf-stack-bar pf-stack-bar--2" x1="553.5" y1="260" x2="570.5" y2="260"/>
          <line class="pf-stack-bar pf-stack-bar--3" x1="558" y1="266" x2="566" y2="266"/>
        </g>
        <g class="pf-stack pf-stack--4" style="--node-c:#b89e04">
          <line class="pf-stack-bar pf-stack-bar--1" x1="774" y1="272" x2="800" y2="272"/>
          <line class="pf-stack-bar pf-stack-bar--2" x1="778.5" y1="278" x2="795.5" y2="278"/>
          <line class="pf-stack-bar pf-stack-bar--3" x1="783" y1="284" x2="791" y2="284"/>
        </g>

        <!-- Node 01 : Analyse (loupe) — hauteur milieu -->
        <g transform="translate(113 100)">
          <g class="pf-node pf-node--1" style="--node-c:#fce148">
            <circle class="pf-node-halo" r="20"/>
            <rect class="pf-node-box" x="-13" y="-13" width="26" height="26" rx="7"/>
            <circle class="pf-node-icon" cx="-2" cy="-2" r="5"/>
            <path class="pf-node-icon" d="M2 2 L6 6"/>
          </g>
        </g>

        <!-- Node 02 : Conception (drafting) — hauteur basse -->
        <g transform="translate(338 140)">
          <g class="pf-node pf-node--2" style="--node-c:#F9D605">
            <circle class="pf-node-halo" r="20"/>
            <rect class="pf-node-box" x="-13" y="-13" width="26" height="26" rx="7"/>
            <path class="pf-node-icon" d="M-4 -8 q-4 0 -4 5 q0 3 -2 3 q2 0 2 3 q0 5 4 5"/>
            <path class="pf-node-icon" d="M4 -8 q4 0 4 5 q0 3 2 3 q-2 0 -2 3 q0 5 -4 5"/>
          </g>
        </g>

        <!-- Node 03 : Développement (code) — hauteur haute -->
        <g transform="translate(562 58)">
          <g class="pf-node pf-node--3" style="--node-c:#d9bd05">
            <circle class="pf-node-halo" r="20"/>
            <rect class="pf-node-box" x="-13" y="-13" width="26" height="26" rx="7"/>
            <path class="pf-node-icon" d="M-3 -5 L-8 0 L-3 5"/>
            <path class="pf-node-icon" d="M3 -5 L8 0 L3 5"/>
          </g>
        </g>

        <!-- Node 04 : Mise en prod (rocket) — hauteur milieu -->
        <g transform="translate(787 100)">
          <g class="pf-node pf-node--4" style="--node-c:#b89e04">
            <circle class="pf-node-halo" r="20"/>
            <rect class="pf-node-box" x="-13" y="-13" width="26" height="26" rx="7"/>
            <path class="pf-node-icon" d="M0 -8 C4 -4 4 2 0 6 C-4 2 -4 -4 0 -8 Z"/>
            <path class="pf-node-icon" d="M-3 3 L-5 7 M3 3 L5 7"/>
            <circle class="pf-node-icon" cx="0" cy="-2" r="1.4"/>
          </g>
        </g>
      </svg>

      <div class="pf-vcards">

        <article class="pf-vcard" style="--c:#fce148; --c-rgb:252, 225, 72;">
          <h3 class="pf-vcard-title">Analyse &amp; cahier des charges</h3>
          <p class="pf-vcard-desc">Écoute du besoin, audit, rédaction du cahier des charges. On ne code rien avant d'avoir compris.</p>
        </article>

        <article class="pf-vcard" style="--c:#F9D605; --c-rgb:249, 214, 5;">
          <h3 class="pf-vcard-title">Conception &amp; architecture</h3>
          <p class="pf-vcard-desc">Choix techniques, maquettage et architecture de la solution. Le bon outil pour le bon usage.</p>
        </article>

        <article class="pf-vcard" style="--c:#d9bd05; --c-rgb:217, 189, 5;">
          <h3 class="pf-vcard-title">Développement &amp; intégration</h3>
          <p class="pf-vcard-desc">Code sur mesure, intégrations et recette. Des points réguliers avec un chef de projet dédié.</p>
        </article>

        <article class="pf-vcard" style="--c:#b89e04; --c-rgb:184, 158, 4;">
          <h3 class="pf-vcard-title">Déploiement &amp; maintenance</h3>
          <p class="pf-vcard-desc">Déploiement, formation, hébergement, hotline et maintenance. On reste à vos côtés après la livraison.</p>
        </article>

      </div>
    </div>
  </div>
</section>


<!-- ====================================================================
     TÉMOIGNAGES — 2 vidéos clients (placeholders : liens à venir)
     ==================================================================== -->
<section class="testi" id="temoignages" aria-labelledby="real-title">
  <div class="container">

