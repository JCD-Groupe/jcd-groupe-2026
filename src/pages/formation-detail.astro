---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="Fiche formation JCD Groupe : objectifs, programme détaillé, modalités et certification. Organisme certifié Qualiopi, centre d'examen TOSA, Metz & Nancy."
    />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/formation-detail`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content="Formation · JCD Groupe" />
    <meta
      property="og:description"
      content="Fiche formation JCD Groupe : objectifs, programme détaillé, modalités et certification. Organisme certifié Qualiopi, centre d'examen TOSA, Metz & Nancy."
    />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/formation-detail`}
    />
    <meta name="twitter:card" content="summary" />
    <title>Formation · JCD Groupe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@1&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/formation-detail.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/formation-detail-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/mpolish.js" id="jcd-mpolish-js"></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <div class="scroll-progress" aria-hidden="true"></div>

    <Header catalogue />

    <main id="contenu">
      <!-- ================================
     HERO — fiche formation
     (zones data-field : à câbler sur Directus)
     ================================ -->
      <section class="fd-hero" aria-labelledby="fd-title">
        <div class="container">
          <nav class="crumbs reveal" aria-label="Fil d'Ariane">
            <a href="/formation">Formation</a>
            <span class="crumbs-sep" aria-hidden="true">/</span>
            <a
              href="/formation-bureautique"
              id="fd-crumb-cat"
              data-field="categorie">Bureautique</a
            >
            <span class="crumbs-sep" aria-hidden="true">/</span>
            <span aria-current="page" data-field="title">Excel initiation</span>
          </nav>

          <h1 class="fd-title reveal delay-1" id="fd-title">
            <span data-field="title">Excel initiation</span><span
              class="cat-dot">.</span
            >
          </h1>

          <div class="fd-hero-meta reveal delay-2">
            <span class="chip chip--cat" data-field="categorie"
              >Bureautique</span
            >
            <span class="chip">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                ><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"
                ></path></svg
              >
              <span data-field="duree">2 jours · 14 heures</span>
            </span>
            <span class="chip">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                ><circle cx="12" cy="12" r="9"></circle><path
                  d="M14.8 9.2a3 3 0 0 0-5.6 1.3c0 3 5.6 2 5.6 5a3 3 0 0 1-5.6 1.3M12 6v2M12 16v2"
                ></path></svg
              >
              <strong data-field="tarif">490&nbsp;€&nbsp;HT</strong>&nbsp;/
              participant
            </span>
            <span class="chip">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                ><path d="M12 3l8 3v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3z"
                ></path><path d="M9 11.5l2 2 4-4"></path></svg
              >
              Certification TOSA en option
            </span>
          </div>
        </div>
      </section>

      <!-- ================================
     CORPS — contenu + récapitulatif sticky
     ================================ -->
      <section class="fd-body" aria-label="Détail de la formation">
        <div class="container">
          <div class="fd-layout">
            <div class="fd-main">
              <!-- Objectifs pédagogiques -->
              <section
                id="fd-s-objectifs"
                aria-labelledby="fd-goals-title"
                data-field="objectifs"
              >
                <div class="fd-section-head reveal">
                  <span class="fd-section-num">01</span>
                  <div>
                    <h2 class="fd-section-title" id="fd-goals-title">
                      Objectifs pédagogiques
                    </h2>
                    <p class="fd-section-sub">
                      À l'issue de la formation, vous serez capable de :
                    </p>
                  </div>
                </div>
                <ul class="fd-goals reveal delay-1">
                  <li class="fd-goal">
                    <span class="fd-goal-ic" aria-hidden="true"
                      ><svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg
                      ></span
                    >
                    Construire et mettre en forme des tableaux avec des formules de
                    calcul
                  </li>
                  <li class="fd-goal">
                    <span class="fd-goal-ic" aria-hidden="true"
                      ><svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg
                      ></span
                    >
                    Mettre en page et imprimer ses documents
                  </li>
                  <li class="fd-goal">
                    <span class="fd-goal-ic" aria-hidden="true"
                      ><svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg
                      ></span
                    >
                    Créer et personnaliser un graphique
                  </li>
                </ul>
              </section>

              <!-- Programme -->
              <section
                id="fd-s-programme"
                aria-labelledby="fd-prog-title"
                data-field="programme"
              >
                <div class="fd-section-head fd-section-head--prog reveal">
                  <span class="fd-section-num">02</span>
                  <div>
                    <h2 class="fd-section-title" id="fd-prog-title">
                      Programme détaillé
                    </h2>
                    <p class="fd-section-sub">
                      8 modules progressifs, du premier classeur à l'analyse de
                      données.
                    </p>
                  </div>
                  <button
                    type="button"
                    class="fd-expand"
                    id="fd-expand"
                    data-open="false"
                    aria-label="Déplier tous les modules du programme"
                  >
                    <span class="fd-expand-tx">Tout déplier</span>
                    <svg
                      viewBox="0 0 10 10"
                      fill="none"
                      aria-hidden="true"
                      focusable="false"
                      ><path
                        d="M2.5 4l2.5 2.5L7.5 4"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path></svg
                    >
                  </button>
                </div>
                <div class="fd-acc reveal delay-1">
                  <article class="fd-mod" data-open="true">
                    <button
                      type="button"
                      class="fd-mod-btn"
                      aria-expanded="true"
                    >
                      <span class="fd-mod-num">M·01</span>
                      <span class="fd-mod-title">Présentation d'Excel</span>
                      <span class="fd-mod-chev" aria-hidden="true"
                        ><svg viewBox="0 0 10 10" fill="none"
                          ><path
                            d="M2.5 4l2.5 2.5L7.5 4"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                        ></span
                      >
                    </button>
                    <div class="fd-mod-body">
                      <div class="fd-mod-wrap">
                        <ul class="fd-mod-list">
                          <li>
                            Découverte de l'interface : ruban, barre d'outils,
                            zone de travail
                          </li>
                          <li>
                            Notions de classeur, feuille, cellule et plage
                          </li>
                          <li>Se déplacer et sélectionner efficacement</li>
                        </ul>
                      </div>
                    </div>
                  </article>

                  <article class="fd-mod" data-open="false">
                    <button
                      type="button"
                      class="fd-mod-btn"
                      aria-expanded="false"
                    >
                      <span class="fd-mod-num">M·02</span>
                      <span class="fd-mod-title">Gestion des documents</span>
                      <span class="fd-mod-chev" aria-hidden="true"
                        ><svg viewBox="0 0 10 10" fill="none"
                          ><path
                            d="M2.5 4l2.5 2.5L7.5 4"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                        ></span
                      >
                    </button>
                    <div class="fd-mod-body">
                      <div class="fd-mod-wrap">
                        <ul class="fd-mod-list">
                          <li>Créer, ouvrir et enregistrer un classeur</li>
                          <li>Organiser ses fichiers et ses versions</li>
                        </ul>
                      </div>
                    </div>
                  </article>

                  <article class="fd-mod" data-open="false">
                    <button
                      type="button"
                      class="fd-mod-btn"
                      aria-expanded="false"
                    >
                      <span class="fd-mod-num">M·03</span>
                      <span class="fd-mod-title"
                        >Saisir des données et des formules de calcul</span
                      >
                      <span class="fd-mod-chev" aria-hidden="true"
                        ><svg viewBox="0 0 10 10" fill="none"
                          ><path
                            d="M2.5 4l2.5 2.5L7.5 4"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                        ></span
                      >
                    </button>
                    <div class="fd-mod-body">
                      <div class="fd-mod-wrap">
                        <ul class="fd-mod-list">
                          <li>
                            Saisir, modifier, copier et déplacer des données
                          </li>
                          <li>
                            Construire des formules simples : opérateurs,
                            références
                          </li>
                          <li>
                            Fonctions essentielles : SOMME, MOYENNE, MIN, MAX
                          </li>
                        </ul>
                      </div>
                    </div>
                  </article>

                  <article class="fd-mod" data-open="false">
                    <button
                      type="button"
                      class="fd-mod-btn"
                      aria-expanded="false"
                    >
                      <span class="fd-mod-num">M·04</span>
                      <span class="fd-mod-title">Mise en forme</span>
                      <span class="fd-mod-chev" aria-hidden="true"
                        ><svg viewBox="0 0 10 10" fill="none"
                          ><path
                            d="M2.5 4l2.5 2.5L7.5 4"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                        ></span
                      >
                    </button>
                    <div class="fd-mod-body">
                      <div class="fd-mod-wrap">
                        <ul class="fd-mod-list">
                          <li>
                            Formats de cellules : nombres, dates, pourcentages
                          </li>
                          <li>Bordures, couleurs et styles de tableaux</li>
                        </ul>
                      </div>
                    </div>
                  </article>

                  <article class="fd-mod" data-open="false">
                    <button
                      type="button"
                      class="fd-mod-btn"
                      aria-expanded="false"
                    >
                      <span class="fd-mod-num">M·05</span>
                      <span class="fd-mod-title">Impression des documents</span>
                      <span class="fd-mod-chev" aria-hidden="true"
                        ><svg viewBox="0 0 10 10" fill="none"
                          ><path
                            d="M2.5 4l2.5 2.5L7.5 4"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                        ></span
                      >
                    </button>
                    <div class="fd-mod-body">
                      <div class="fd-mod-wrap">
                        <ul class="fd-mod-list">
                          <li>
                            Mise en page : marges, orientation, en-têtes et
                            pieds de page
                          </li>
                          <li>Zone d'impression et aperçu avant impression</li>
                        </ul>
                      </div>
                    </div>
                  </article>

                  <article class="fd-mod" data-open="false">
                    <button
                      type="button"
                      class="fd-mod-btn"
                      aria-expanded="false"
                    >
                      <span class="fd-mod-num">M·06</span>
                      <span class="fd-mod-title">Les graphiques</span>
                      <span class="fd-mod-chev" aria-hidden="true"
                        ><svg viewBox="0 0 10 10" fill="none"
                          ><path
                            d="M2.5 4l2.5 2.5L7.5 4"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                        ></span
                      >
                    </button>
                    <div class="fd-mod-body">
                      <div class="fd-mod-wrap">
                        <ul class="fd-mod-list">
                          <li>Choisir le bon type de graphique</li>
                          <li>
                            Créer, mettre en forme et imprimer un graphique
                          </li>
                        </ul>
                      </div>
                    </div>
                  </article>

                  <article class="fd-mod" data-open="false">
                    <button
                      type="button"
                      class="fd-mod-btn"
                      aria-expanded="false"
                    >
                      <span class="fd-mod-num">M·07</span>
                      <span class="fd-mod-title">Gestion du classeur</span>
                      <span class="fd-mod-chev" aria-hidden="true"
                        ><svg viewBox="0 0 10 10" fill="none"
                          ><path
                            d="M2.5 4l2.5 2.5L7.5 4"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                        ></span
                      >
                    </button>
                    <div class="fd-mod-body">
                      <div class="fd-mod-wrap">
                        <ul class="fd-mod-list">
                          <li>Insérer, déplacer et renommer des feuilles</li>
                          <li>
                            Travailler sur plusieurs feuilles simultanément
                          </li>
                        </ul>
                      </div>
                    </div>
                  </article>

                  <article class="fd-mod" data-open="false">
                    <button
                      type="button"
                      class="fd-mod-btn"
                      aria-expanded="false"
                    >
                      <span class="fd-mod-num">M·08</span>
                      <span class="fd-mod-title">L'analyse de données</span>
                      <span class="fd-mod-chev" aria-hidden="true"
                        ><svg viewBox="0 0 10 10" fill="none"
                          ><path
                            d="M2.5 4l2.5 2.5L7.5 4"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                        ></span
                      >
                    </button>
                    <div class="fd-mod-body">
                      <div class="fd-mod-wrap">
                        <ul class="fd-mod-list">
                          <li>Trier et filtrer des listes de données</li>
                          <li>
                            Premiers pas vers les tableaux croisés dynamiques
                          </li>
                        </ul>
                      </div>
                    </div>
                  </article>
                </div>
              </section>

              <!-- Public & prérequis -->
              <section id="fd-s-public" aria-labelledby="fd-pub-title">
                <div class="fd-section-head reveal">
                  <span class="fd-section-num">03</span>
                  <h2 class="fd-section-title" id="fd-pub-title">
                    Public visé &amp; prérequis
                  </h2>
                </div>
                <div class="fd-cards reveal delay-1">
                  <div class="fd-card" data-field="public">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><circle cx="9" cy="8" r="3.2"></circle><path
                            d="M3 19c0-3 2.7-5 6-5s6 2 6 5"></path><circle
                            cx="17"
                            cy="9.5"
                            r="2.4"></circle><path
                            d="M14.5 19c.2-2.2 1.8-4 4-4s3.5 1.5 3.5 3.5"
                          ></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Public visé</h3>
                    </div>
                    <p class="fd-card-tx">
                      Toute personne souhaitant connaître les fonctionnalités de
                      base d'Excel.
                    </p>
                  </div>
                  <div class="fd-card" data-field="prerequis">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path
                            d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"
                          ></path><rect x="9" y="3" width="6" height="4" rx="1"
                          ></rect><path d="M9 13l2 2 4-4"></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Prérequis</h3>
                    </div>
                    <p class="fd-card-tx">
                      Pratique de l'environnement Windows requise. Aucune
                      connaissance préalable d'Excel n'est nécessaire.
                    </p>
                  </div>
                </div>
              </section>

              <!-- Modalités -->
              <section id="fd-s-modalites" aria-labelledby="fd-mod-title2">
                <div class="fd-section-head reveal">
                  <span class="fd-section-num">04</span>
                  <h2 class="fd-section-title" id="fd-mod-title2">
                    Modalités &amp; encadrement
                  </h2>
                </div>
                <div class="fd-cards reveal delay-1">
                  <div class="fd-card" data-field="modalites_pedagogiques">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M22 10 12 5 2 10l10 5 10-5z"></path><path
                            d="M6 12v5c2 2 4 3 6 3s4-1 6-3v-5"></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Modalités pédagogiques</h3>
                    </div>
                    <p class="fd-card-tx">
                      Alternance continue entre apports de connaissances et
                      manipulation des outils. Salles équipées :
                      vidéoprojecteur, un ordinateur par stagiaire, support
                      papier et électronique.
                    </p>
                  </div>
                  <div class="fd-card" data-field="modalites_evaluation">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><path d="M9 11l3 3 8-8"></path><path
                            d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"
                          ></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Modalités d'évaluation</h3>
                    </div>
                    <p class="fd-card-tx">
                      Évaluation continue des acquis pendant le stage.
                      Attestation de stage remise au participant et
                      questionnaire d'évaluation de la formation.
                    </p>
                  </div>
                  <div class="fd-card" data-field="intervenant">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><circle cx="12" cy="8" r="3.4"></circle><path
                            d="M5 20c0-3.3 3.1-5.5 7-5.5s7 2.2 7 5.5"
                          ></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Intervenant</h3>
                    </div>
                    <p class="fd-card-tx">
                      Professionnel de l'informatique, expert en bureautique,
                      sélectionné et présenté avant le démarrage de la
                      formation.
                    </p>
                  </div>
                  <div class="fd-card" data-field="accessibilite">
                    <div class="fd-card-head">
                      <span class="fd-card-ic" aria-hidden="true"
                        ><svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><circle cx="12" cy="5" r="2"></circle><path
                            d="M12 7v6l4 1.5M12 13l-4 1.5"></path><path
                            d="M6.5 17.5a6 6 0 0 0 11 0"></path></svg
                        ></span
                      >
                      <h3 class="fd-card-title">Accessibilité handicap</h3>
                    </div>
                    <p class="fd-card-tx">
                      Locaux accessibles aux personnes à mobilité réduite.
                      Adaptations possibles sur demande auprès de notre référent
                      handicap.
                    </p>
                  </div>
                </div>
              </section>

              <!-- Certification -->
              <section
                id="fd-s-certif"
                aria-label="Certification"
                data-field="certification"
              >
                <div class="fd-certif reveal">
                  <span class="fd-certif-ic" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><circle cx="12" cy="9" r="6"></circle><path
                        d="M8.5 14 7 22l5-2.5L17 22l-1.5-8"></path><path
