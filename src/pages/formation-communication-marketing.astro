---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="Formations Communication - Marketing · 11 formations · JCD Groupe, organisme certifié Qualiopi à Metz et Nancy. Stratégie digitale, réseaux sociaux et prise de parole."
    />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/formation-communication-marketing`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content="Communication - Marketing · Catalogue des formations · JCD Groupe"
    />
    <meta
      property="og:description"
      content="Formations Communication - Marketing · 11 formations · JCD Groupe, organisme certifié Qualiopi à Metz et Nancy. Stratégie digitale, réseaux sociaux et prise de parole."
    />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/formation-communication-marketing`}
    />
    <meta name="twitter:card" content="summary" />
    <title>
      Communication - Marketing · Catalogue des formations · JCD Groupe
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@1&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/formation-communication-marketing.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link
      rel="stylesheet"
      href="/css/formation-communication-marketing-overrides.css"
    />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/mpolish.js" id="jcd-mpolish-js"></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
