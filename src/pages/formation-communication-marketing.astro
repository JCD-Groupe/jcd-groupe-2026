  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <div class="scroll-progress" aria-hidden="true"></div>

    <Header catalogue />

    <main id="contenu">
      <!-- ================================
     HERO — catégorie du catalogue
     ================================ -->
      <section class="cat-hero" aria-labelledby="cat-hero-title">
        <div class="cat-hero-stars" aria-hidden="true">
          <i style="left:64%;top:18%;animation-delay:-1.2s"></i>
          <i style="left:78%;top:34%;animation-delay:-3.4s"></i>
          <i style="left:88%;top:14%;animation-delay:-2.1s"></i>
          <i style="left:71%;top:52%;animation-delay:-4.6s"></i>
          <i style="left:93%;top:44%;animation-delay:-0.8s"></i>
          <i style="left:82%;top:62%;animation-delay:-5.5s"></i>
          <i style="left:58%;top:38%;animation-delay:-2.9s"></i>
        </div>
        <div class="container">
          <nav class="crumbs reveal" aria-label="Fil d'Ariane">
            <a href="/formation">Formation</a>
            <span class="crumbs-sep" aria-hidden="true">/</span>
            <span>Catalogue</span>
            <span class="crumbs-sep" aria-hidden="true">/</span>
            <span aria-current="page">Communication - Marketing</span>
          </nav>

          <h1 class="cat-hero-title reveal delay-1" id="cat-hero-title">
            Communication - Marketing<span class="cat-dot">.</span>
          </h1>

          <p class="cat-hero-sub reveal delay-2">
            Stratégie digitale, réseaux sociaux et prise de parole. Des parcours
            animés par des formateurs experts, en intra ou inter-entreprises, au
            rythme de vos équipes.
          </p>

          <div class="cat-hero-actions reveal delay-3">
            <a href="#liste" class="btn-cta btn-cta--primary">
              Choisir une formation
              <span class="btn-cta-arrow"
                ><svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                ></span
              >
            </a>
            <a
              href="/contact?pole=formation&step=2"
              class="btn-cta btn-cta--ghost">Être conseillé</a
            >
          </div>
        </div>
      </section>

      <!-- ================================
