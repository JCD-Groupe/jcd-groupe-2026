      <section class="why" aria-labelledby="why-title">
        <div class="container">
          <div class="why-tree reveal">
            <!-- Corridor du tronc : prolonge la verticale de l'écosystème jusqu'au distributeur -->
            <div class="wt-head">
              <span class="wt-trunk" aria-hidden="true"></span>
              <span class="wt-elbow-h" aria-hidden="true"></span>
              <span class="wt-elbow-v" aria-hidden="true"></span>
              <span class="wt-trunk-node" aria-hidden="true"></span>
              <div class="hub-sechead">
                <h2 id="why-title">
                  Plus qu'un prestataire, <em>un v&eacute;ritable partenaire</em
                  >.
                </h2>
              </div>
            </div>

            <!-- Distributeur → 4 cartes-raisons suspendues à hauteurs décalées (réf. croquis) -->
            <div class="wt-body">
              <span class="wt-dist" aria-hidden="true"></span>
              <ol class="wt-items">
                <li class="wt-item">
                  <span class="wt-branch" aria-hidden="true"></span>
                  <span class="wt-node" aria-hidden="true"></span>
                  <div class="wt-card-box">
                    <h3>Interlocuteur unique</h3>
                    <p>Un seul partenaire pour tout votre IT.</p>
                  </div>
                </li>
                <li class="wt-item">
                  <span class="wt-branch" aria-hidden="true"></span>
                  <span class="wt-node" aria-hidden="true"></span>
