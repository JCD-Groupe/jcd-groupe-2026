              <div class="eco-quad-grid g-2x2">
                <div class="eco-tile has-logo" data-brand="hp">
                  <img
                    class="eco-tile-img"
                    src="/logos%20INFORMATIQUE/hp.png"
                    alt="HP"
                    loading="lazy"
                    decoding="async"
                  /><span class="eco-tile-name">HP</span>
                </div>
                <div class="eco-tile has-logo" data-brand="hpe">
                  <img
                    class="eco-tile-img"
                    src="/logos%20INFORMATIQUE/hpe.png"
                    alt="HPE"
                    loading="lazy"
                    decoding="async"
                  /><span class="eco-tile-name">HPE</span>
                </div>
                <div class="eco-tile has-logo" data-brand="lenovo">
                  <img
                    class="eco-tile-img"
                    src="/logos%20INFORMATIQUE/lenovo.png"
