                  <rect x="66" y="20" width="34" height="34" rx="7"></rect>
                  <rect x="20" y="66" width="34" height="34" rx="7"></rect>
                  <rect x="66" y="66" width="34" height="34" rx="7"></rect>
                </g>
                <path
