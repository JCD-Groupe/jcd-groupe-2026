                </p>
                <div class="cta-actions reveal delay-3">
                  <a
                    href="/contact?pole=informatique&step=2"
                    class="btn-cta btn-cta--primary"
                  >
                    Contacter le pôle Informatique
                    <span class="btn-cta-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
