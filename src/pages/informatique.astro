                </li>
                <li class="wt-item">
                  <span class="wt-branch" aria-hidden="true"></span>
                  <span class="wt-node" aria-hidden="true"></span>
                  <div class="wt-card-box">
                    <h3>Internalisation compl&egrave;te</h3>
                    <p>Préparation, déploiement, support, sécurité.</p>
                  </div>
                </li>
                <li class="wt-item">
                  <span class="wt-branch" aria-hidden="true"></span>
                  <span class="wt-node" aria-hidden="true"></span>
                  <div class="wt-card-box">
                    <h3>La sécurité par défaut</h3>
                    <p>
                      La cybers&eacute;curit&eacute; int&eacute;gr&eacute;e dans
                      toutes nos solutions.
                    </p>
                  </div>
                </li>
              </ol>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
