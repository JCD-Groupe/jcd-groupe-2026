---
import { directus } from "../lib/directus";
import { readSingleton } from "@directus/sdk";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavInformatique from "../components/NavInformatique.astro";
import { fetchSvgContent } from "../utils/formatters";

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

let informatique = await directus.request(
  readSingleton("JCD_Informatique", {
    fields: [
      "*",
      { logo_partenaire_cybersecurite: ["*"] },
      { prestations_cybersecurite: ["*"] },
      { processus: ["*"] },
      {
        logos_technologies_collaboratif_et_audiovisuel: [
          "*",
          { directus_files_id: ["*"] },
        ],
      },
      {
        logos_technologies_cloud: ["*", { directus_files_id: ["*"] }],
      },
      {
        logos_technologies_postes_et_materiel: [
          "*",
          { directus_files_id: ["*"] },
        ],
      },
      {
        logos_technologies_infrastructure_et_securite: [
          "*",
          { directus_files_id: ["*"] },
        ],
      },
    ],
  }),
);

let info_cloud = await directus.request(
  readSingleton("cloud_microsoft", {
    fields: ["nom_service", "icone_service", "description_page_informatique"],
  }),
);
let info_collaboratif = await directus.request(
  readSingleton("solutions_collaboratives_audiovisuelles", {
    fields: ["nom_service", "icone_service", "description_page_informatique"],
  }),
);
let info_integration = await directus.request(
  readSingleton("integration_support_pc", {
    fields: ["nom_service", "icone_service", "description_page_informatique"],
  }),
);
let info_reseaux = await directus.request(
  readSingleton("architectures_systemes_reseaux", {
    fields: ["nom_service", "icone_service", "description_page_informatique"],
  }),
);

informatique.icone_cta_content = await fetchSvgContent(informatique.icone_cta);

informatique.prestations_cybersecurite = await Promise.all(
  informatique.prestations_cybersecurite.map(async (prestation: any) => ({
    ...prestation,
    icone_content: await fetchSvgContent(prestation.icone),
  })),
);

info_cloud.icone_service = await fetchSvgContent(info_cloud.icone_service);
info_collaboratif.icone_service = await fetchSvgContent(
  info_collaboratif.icone_service,
);
info_integration.icone_service = await fetchSvgContent(
  info_integration.icone_service,
);
info_reseaux.icone_service = await fetchSvgContent(info_reseaux.icone_service);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link
      rel="icon"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.favicon}`}
      type="image/svg+xml"
    />
    <meta name="description" content={informatique.meta_description} />
    <link
      rel="canonical"
      href={`${import.meta.env.PUBLIC_DIRECTUS_URL}/informatique`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.nom_societe} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content={`${informatique.nom_pole} · ${global.nom_societe}`}
    />
    <meta property="og:description" content={informatique.meta_description} />
    <meta
      property="og:url"
      content={`${import.meta.env.PUBLIC_DIRECTUS_URL}/informatique`}
    />
    <meta name="twitter:card" content="summary" />
    <title>{informatique.nom_pole} · {global.nom_societe}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/informatique.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/informatique-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/mpolish.js" id="jcd-mpolish-js"></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/page-boot.js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <div id="jcd-pagefade" aria-hidden="true"></div>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <!-- ====================================================================
    RAIL DE SOUS-NAVIGATION — écosystème Informatique
    Ancré en permanence sous le navbar. Libellés complets, page active
    en bleu JCD. Permet de naviguer entre la vue d'ensemble et les 4
    domaines du pôle.
    ==================================================================== -->
    <NavInformatique current="info-general" />

    <main id="contenu">
      <!-- ====================================================================
     ACCÈS — intro + les 4 domaines (cards, display repris de la home)
     ==================================================================== -->
      <section class="hub-intro" aria-labelledby="hub-title">
        <div class="container">
          <h1
            id="hub-title"
            class="reveal delay-1"
            set:html={informatique.titre_hero}
          />
          <p class="reveal delay-2">
            {informatique.sous_titre_hero}
          </p>
        </div>
      </section>

      <section class="poles" aria-label="Les domaines du pôle Informatique">
        <div class="container">
          <div class="pole-cards reveal">
            <a
              class="pole-card"
              href="/info-integration"
              aria-label={info_integration.nom_service}
            >
              <div class="pole-card-top">
                <span
                  class="pole-card-icon"
                  aria-hidden="true"
                  set:html={info_integration.icone_service}
                />
                <span class="pole-card-num">01 / 04</span>
              </div>
              <h3>{info_integration.nom_service}</h3>
              <p>
                {info_integration.description_page_informatique}
              </p>
            </a>

            <a
              class="pole-card"
              href="/info-reseaux"
              aria-label={info_reseaux.nom_service}
            >
              <div class="pole-card-top">
                <span
                  class="pole-card-icon"
                  aria-hidden="true"
                  set:html={info_reseaux.icone_service}
                />
                <span class="pole-card-num">02 / 04</span>
              </div>
              <h3>{info_reseaux.nom_service}</h3>
              <p>
                {info_reseaux.description_page_informatique}
              </p>
            </a>

            <a
              class="pole-card"
              href="/info-collaboratif"
              aria-label={info_collaboratif.nom_service}
            >
              <div class="pole-card-top">
                <span
                  class="pole-card-icon"
                  aria-hidden="true"
                  set:html={info_collaboratif.icone_service}
                />
                <span class="pole-card-num">03 / 04</span>
              </div>
              <h3>{info_collaboratif.nom_service}</h3>
              <p>
                {info_collaboratif.description_page_informatique}
              </p>
            </a>

            <a
              class="pole-card"
              href="/info-cloud"
              aria-label={info_cloud.nom_service}
            >
              <div class="pole-card-top">
                <span
                  class="pole-card-icon"
                  aria-hidden="true"
                  set:html={info_cloud.icone_service}
                />
                <span class="pole-card-num">04 / 04</span>
              </div>
              <h3>{info_cloud.nom_service}</h3>
              <p>{info_cloud.description_page_informatique}</p>
            </a>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     CYBERSÉCURITÉ — transversale (CYAN), id="cybersecurite"
     ==================================================================== -->
      <section class="cyber" id="cybersecurite" aria-labelledby="cyber-title">
        <div class="container">
          <div class="hub-sechead reveal">
            <h2
              id="cyber-title"
              set:html={informatique.titre_prestations_cybersecurite}
            />
            <p>
              {informatique.sous_titre_prestations_cybersecurite}
            </p>
          </div>

          <div class="cyber-diagram reveal delay-1">
            <!-- Bouclier fine-line : double liseré + check tracé au reveal -->
            <div class="cyber-shield">
              <svg
                class="cyber-orbits"
                viewBox="0 0 340 340"
                fill="none"
                aria-hidden="true"
              >
                <circle cx="170" cy="170" r="118" stroke="rgba(79,201,226,0.09)"
                ></circle>
                <circle
                  cx="170"
                  cy="170"
                  r="160"
                  stroke="rgba(79,201,226,0.06)"
                  stroke-dasharray="2 7"></circle>
              </svg>
              <div class="cyber-shield-art">
                <svg
                  class="cyber-shield-svg"
                  viewBox="0 0 146 152"
                  fill="none"
                  aria-hidden="true"
                >
                  <defs>
                    <linearGradient
                      id="cyberRim"
                      x1="0"
                      y1="0"
                      x2="0"
                      y2="152"
                      gradientUnits="userSpaceOnUse"
                    >
                      <stop offset="0" stop-color="#ffffff" stop-opacity="0.5"
                      ></stop>
                      <stop offset="0.4" stop-color="#4FC9E2" stop-opacity="0.5"
                      ></stop>
                      <stop offset="1" stop-color="#4FC9E2" stop-opacity="0.14"
                      ></stop>
                    </linearGradient>
                    <linearGradient
                      id="cyberFill"
                      x1="0"
                      y1="0"
                      x2="0"
                      y2="152"
                      gradientUnits="userSpaceOnUse"
                    >
                      <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.07"
                      ></stop>
                      <stop offset="1" stop-color="#4FC9E2" stop-opacity="0.015"
                      ></stop>
                    </linearGradient>
                  </defs>
                  <path
                    class="cyber-shield-fill"
                    d="M73 8 L120 25 Q126 28 126 34 L126 86 C126 118 104 136 73 148 C42 136 20 118 20 86 L20 34 Q20 28 26 25 Z"
                  ></path>
                  <path
                    class="cyber-shield-rim"
                    d="M73 8 L120 25 Q126 28 126 34 L126 86 C126 118 104 136 73 148 C42 136 20 118 20 86 L20 34 Q20 28 26 25 Z"
                  ></path>
                  <path
                    class="cyber-shield-rim2"
                    d="M73 8 L120 25 Q126 28 126 34 L126 86 C126 118 104 136 73 148 C42 136 20 118 20 86 L20 34 Q20 28 26 25 Z"
                    transform="translate(8.76 9.12) scale(0.88)"></path>
                  <path
                    class="cyber-shield-check"
                    d="M54 82 L68 95 L94 62"
                    pathLength="100"></path>
                </svg>
              </div>
            </div>

            <!-- 3 branches hairline (bouclier → piliers), tracées au reveal -->
            <svg
              class="cyber-branches"
              viewBox="0 0 1000 120"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <linearGradient
                  id="cyberWire"
                  x1="0"
                  y1="0"
                  x2="0"
                  y2="120"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop offset="0" stop-color="#4FC9E2" stop-opacity="0.5"
                  ></stop>
                  <stop offset="1" stop-color="#4FC9E2" stop-opacity="0.25"
                  ></stop>
                </linearGradient>
              </defs>
              <path
                class="cyber-wire cyber-wire--1"
                pathLength="1000"
                d="M500 2 C500 62 161 58 161 120"></path>
              <path
                class="cyber-wire cyber-wire--2"
                pathLength="1000"
                d="M500 2 L500 120"></path>
              <path
                class="cyber-wire cyber-wire--3"
                pathLength="1000"
                d="M500 2 C500 62 838 58 838 120"></path>
            </svg>

            <!-- 3 piliers reliés (contenu existant réutilisé) -->
            <div class="cyber-piliers">
              {
                informatique.prestations_cybersecurite.map(
                  (prestation: any) => (
                    <div class="cyber-pilier">
                      <span class="cyber-node" aria-hidden="true" />
                      <span
                        class="cyber-pilier-ic"
                        aria-hidden="true"
                        set:html={prestation.icone_content}
                      />
                      <h3>{prestation.titre}</h3>
                      <p>{prestation.description}</p>
                    </div>
                  ),
                )
              }
            </div>
          </div>

          <div class="cyber-band reveal delay-2">
            <span class="cyber-stats">
              <span class="cyber-stat"
                ><span class="cyber-stat-num"
                  >{informatique.nombre_client_cybersecurite}</span
                > clients</span
              >
              <span class="cyber-stat"
                ><span class="cyber-stat-num"
                  >{informatique.nombre_interventions_an_cybersecurite}</span
                > interventions/an</span
              >
              <span class="cyber-stat"
                ><span class="cyber-stat-num"
                  >{informatique.nombre_annees_expertises_cybersecurite}</span
                > ans d'expertise</span
              >
            </span>
            <span class="cyber-partner">
              <span class="cyber-partner-label"
                ><span class="cyber-partner-slash">//</span> Partenaire cybers&eacute;curit&eacute;</span
              >
              <img
                src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${informatique.logo_partenaire_cybersecurite.id}`}
                alt={informatique.logo_partenaire_cybersecurite.title}
                width="1000"
                height="290"
                loading="lazy"
                decoding="async"
              />
            </span>
            <a
              class="cyber-audit"
              href="/contact?pole=informatique&step=2"
              aria-label="Contacter un expert cybersécurité"
              ><strong>{informatique.label_cta_cybersecurite}</strong>.<span
                class="cyber-audit-path"
                aria-hidden="true"
                >info &rsaquo; cybers&eacute;curit&eacute;</span
              ></a
            >
          </div>
        </div>
      </section>

      <!-- ====================================================================
     PARTENAIRES & TECHNOLOGIES — global (regroupe les 4 domaines)
     ==================================================================== -->
      <section class="partners" aria-labelledby="partners-title">
        <div class="container">
          <div class="hub-sechead reveal">
            <h2
              id="partners-title"
              set:html={informatique.titre_technologies}
            />
          </div>
          <div class="eco-net reveal delay-1">
            <!-- Séparateurs « réseau » : tracés bleus fondus + nœuds de jonction pulsants -->
            <div class="eco-net-traces" aria-hidden="true">
              <span class="net-line net-v-top"></span>
              <span class="net-line net-h-mid"></span>
              <span class="net-line net-v-bot"></span>
            </div>

            <!-- Haut-gauche : Collaboratif & audiovisuel (6 · 3×2) -->
            <section
              class="eco-quad q-collab"
              aria-label="Collaboratif et audiovisuel"
            >
              <span class="eco-quad-label"
                ><span class="eco-quad-dot" aria-hidden="true"
                ></span>Collaboratif &amp; audiovisuel</span
              >
              <div class="eco-quad-grid g-3x2">
                {
                  informatique.logos_technologies_collaboratif_et_audiovisuel.map(
                    (logo: any) => (
                      <div
                        class="eco-tile has-logo"
                        data-brand={logo.directus_files_id.title}
                      >
                        <>
                          <img
                            class="eco-tile-img"
                            src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id.id}`}
                            alt={logo.directus_files_id.title}
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="eco-tile-name">
                            {logo.directus_files_id.title}
                          </span>
                        </>
                      </div>
                    ),
                  )
                }
              </div>
            </section>

            <!-- Haut-droite : Cloud (2 · 1×2) -->
            <section class="eco-quad q-cloud" aria-label="Cloud">
              <span class="eco-quad-label"
                ><span class="eco-quad-dot" aria-hidden="true"
                ></span>Cloud</span
              >
              <div class="eco-quad-grid g-1x2">
                {
                  informatique.logos_technologies_cloud.map((logo: any) => (
                    <div
                      class="eco-tile has-logo"
                      data-brand={logo.directus_files_id.title}
                    >
                      <>
                        <img
                          class="eco-tile-img"
                          src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id.id}`}
                          alt={logo.directus_files_id.title}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="eco-tile-name">
                          {logo.directus_files_id.title}
                        </span>
                      </>
                    </div>
                  ))
                }
              </div>
            </section>

            <!-- Bas-gauche : Postes & matériel (4 · 2×2) -->
            <section class="eco-quad q-postes" aria-label="Postes et matériel">
              <span class="eco-quad-label"
                ><span class="eco-quad-dot" aria-hidden="true"></span>Postes
                &amp; matériel</span
              >
              <div class="eco-quad-grid g-2x2">
                {
                  informatique.logos_technologies_postes_et_materiel.map(
                    (logo: any) => (
                      <div
                        class="eco-tile has-logo"
                        data-brand={logo.directus_files_id.title}
                      >
                        <>
                          <img
                            class="eco-tile-img"
                            src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id.id}`}
                            alt={logo.directus_files_id.title}
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="eco-tile-name">
                            {logo.directus_files_id.title}
                          </span>
                        </>
                      </div>
                    ),
                  )
                }
              </div>
            </section>

            <!-- Bas-droite : Infrastructure & sécurité (4 · 2×2) -->
            <section
              class="eco-quad q-infra"
              aria-label="Infrastructure et sécurité"
            >
              <span class="eco-quad-label"
                ><span class="eco-quad-dot" aria-hidden="true"
                ></span>Infrastructure &amp; sécurité</span
              >
              <div class="eco-quad-grid g-2x2">
                {
                  informatique.logos_technologies_infrastructure_et_securite.map(
                    (logo: any) => (
                      <div
                        class="eco-tile has-logo"
                        data-brand={logo.directus_files_id.title}
                      >
                        <>
                          <img
                            class="eco-tile-img"
                            src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${logo.directus_files_id.id}`}
                            alt={logo.directus_files_id.title}
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="eco-tile-name">
                            {logo.directus_files_id.title}
                          </span>
                        </>
                      </div>
                    ),
                  )
                }
              </div>
            </section>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     POURQUOI JCD
     ==================================================================== -->
      <section class="why" aria-labelledby="why-title">
        <div class="container">
          <div class="why-tree reveal">
            <!-- Corridor du tronc : prolonge la verticale de l'écosystème jusqu'au distributeur -->
            <div class="wt-head">
              <span class="wt-trunk" aria-hidden="true"></span>
              <span class="wt-elbow-h" aria-hidden="true"></span>
              <span class="wt-elbow-v" aria-hidden="true"></span>
              <span class="wt-trunk-node" aria-hidden="true"></span>
              <div class="hub-sechead">
                <h2 id="why-title" set:html={informatique.titre_processus} />
              </div>
            </div>

            <!-- Distributeur → 4 cartes-raisons suspendues à hauteurs décalées (réf. croquis) -->
            <div class="wt-body">
              <span class="wt-dist" aria-hidden="true"></span>
              <ol class="wt-items">
                {
                  informatique.processus.map((etape_processus: any) => (
                    <li class="wt-item">
                      <span class="wt-branch" aria-hidden="true" />
                      <span class="wt-node" aria-hidden="true" />
                      <div class="wt-card-box">
                        <h3>{etape_processus.titre}</h3>
                        <p>{etape_processus.description}</p>
                      </div>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
     CTA — style maison (icône + corps + téléphone)
     ==================================================================== -->
      <section class="cta-section" id="contact" aria-labelledby="cta-title">
        <div class="container">
          <div class="cta-frame">
            <div class="cta-inner">
              <Fragment set:html={informatique.icone_cta_content} />

              <div class="cta-body">
                <h2
                  class="cta-title reveal delay-1"
                  id="cta-title"
                  set:html={informatique.titre_cta}
                />
                <p class="cta-sub reveal delay-2">
                  {informatique.sous_titre_cta}
                </p>
                <div class="cta-actions reveal delay-3">
                  <a
                    href="/contact?pole=informatique&step=2"
                    class="btn-cta btn-cta--primary"
                  >
                    {informatique.bouton_cta}
                    <span class="btn-cta-arrow"
                      ><svg
                        viewBox="0 0 16 16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                      ></span
                    >
                  </a>
                  <span class="cta-actions-divider" aria-hidden="true"></span>
                  <span class="cta-phone">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      width="14"
                      height="14"
                      ><path
                        d="M2 3a1 1 0 011-1h3.28a1 1 0 01.95.68l1.07 3.21a1 1 0 01-.25 1L6.54 8.4a12.06 12.06 0 005.06 5.06l1.51-1.51a1 1 0 011-.25l3.21 1.07a1 1 0 01.68.95V17a1 1 0 01-1 1A15 15 0 012 3z"
                      ></path></svg
                    >
                    <a href="tel:+33387184920" class="cta-phone-num"
                      >03 87 18 49 20</a
                    >
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline src="/js/pages/informatique-1.js"></script>
    <script is:inline src="/js/shared/menu-frost.js"></script>
    <!-- jcd-a11y (Lot 5) -->
    <div class="jcd-fab-wrap" id="jcd-fab">
      <button
        class="jcd-fab jcd-fab--top"
        id="jcdToTop"
        type="button"
