              <span class="eco-quad-label"
                ><span class="eco-quad-dot" aria-hidden="true"
                ></span>Infrastructure &amp; sécurité</span
              >
              <div class="eco-quad-grid g-2x2">
                <div class="eco-tile eco-tile--ph" data-brand="hpe-silver">
                  <span class="eco-tile-name">HPE Silver Partner</span>
                </div>
                <div class="eco-tile has-logo" data-brand="microsoft">
                  <img
                    class="eco-tile-img"
                    src="/logos%20INFORMATIQUE/microsoft.png"
