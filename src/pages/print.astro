---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="JCD Groupe · Pôle Print. Fourniture, maintenance et gestion de vos solutions d'impression. Expertise terrain en Grand Est. Certifié PAPERCUT, HP, Toshiba."
    />
    <link rel="canonical" href="https://www.jcd-groupe.fr/print" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCD Groupe" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:title"
      content="Print · Impression & gestion documentaire · JCD Groupe"
    />
    <meta
      property="og:description"
      content="JCD Groupe · Pôle Print. Fourniture, maintenance et gestion de vos solutions d'impression. Expertise terrain en Grand Est. Certifié PAPERCUT, HP, Toshiba."
    />
    <meta property="og:url" content="https://www.jcd-groupe.fr/print" />
    <meta name="twitter:card" content="summary" />
    <title>Print · Impression &amp; gestion documentaire · JCD Groupe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/print.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/print-overrides.css" />
    <link rel="stylesheet" href="/css/transition.css" />
    <script is:inline src="/js/shared/transition.js"></script>
    <script is:inline src="/js/shared/xpcompact.js" id="jcd-xpcompact-js"
    ></script>
    <script is:inline src="/js/shared/touch.js" id="jcd-touch-js"></script>
    <script is:inline src="/js/shared/mrefonte-shim.js" id="jcd-mrefonte-shim"
    ></script>
  </head>
  <body>
    <a class="jcd-skip" href="#contenu">Aller au contenu</a>

    <!-- ====================================================================
     NAVBAR v2 — Modal-like
     Logo (g) · capsule centrale {Expertises ▾ · Contact · Carrières}
     · CTA Assistance (d). Bande pleine largeur, fade gauche/droite,
     dropdown "Expertises" avec 7 SVG 3D isométriques colorés.
     ==================================================================== -->
    <Header />

    <main id="contenu">
      <div class="hero-pin-zone">
        <!-- ================================
     HERO — Mesh WebGL fluide + texture pôle (pattern universel)
     ================================ -->
        <section class="print-hero" aria-labelledby="print-hero-title">
          <!-- Couche 0 : fallback CSS si WebGL indisponible / fade-in -->
          <div class="hero-mesh-fallback" aria-hidden="true"></div>

          <!-- Couche 1 : canvas WebGL animé (mesh gradient fluide) -->
          <canvas class="hero-mesh" id="heroMesh" aria-hidden="true"></canvas>

          <!-- Couche 2 : texture pôle — print = halftone -->
          <div class="hero-texture hero-texture--paper" aria-hidden="true">
          </div>

          <!-- Couche 3 : grain léger -->
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="container">
            <h1 id="print-hero-title" class="hero-title reveal delay-1">
              L'<span class="accent-grad">impression</span> au service de votre productivité.
            </h1>

            <p class="hero-sub reveal delay-2">
              Photocopieurs, traceurs, codes-barres et gestion
              documentaire&nbsp;: un interlocuteur dédié, une équipe terrain.
            </p>

            <div class="hero-actions reveal delay-3">
              <a href="/contact?pole=print&step=2" class="btn-cta btn-cta--ghost">
                Demander un devis
                <span class="btn-cta-arrow"
                  ><svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
                  ></span
                >
              </a>
            </div>
          </div>
        </section>

        <!-- ================================
     MANIFESTO — Paper sheet inversion
     ================================ -->
        <section class="manifesto" aria-labelledby="manifesto-title">
          <div class="paper-sheet">
            <div class="container">
              <header class="paper-header">
                <div class="paper-header-left">
                  <span class="paper-mark-num">N° 01</span>
                  <span class="paper-header-rule" aria-hidden="true"></span>
                  <span>Pôle Print &middot; Manifeste</span>
                </div>
                <span>JCD Groupe &middot; Édition 04 / 2026</span>
              </header>

              <blockquote class="manifesto-quote manifesto-rich reveal" id="manifesto-title">
                <em>Imprimer,</em> ce n'est pas <em>livrer une machine</em>.
                C'est tenir une chaîne complète, du <span class="accent"
                  >premier audit</span
                > à la dernière feuille. <span class="ink-muted"
                  >Sans intermédiaire, sans surprise, sans dépendance.</span
                >
              </blockquote>

              <div class="manifesto-pull reveal delay-2">
                <div class="manifesto-sig">
                  <div class="manifesto-sig-mark">
                    <span>L'équipe Print</span>
                    <span class="manifesto-sig-rule" aria-hidden="true"></span>
                  </div>
                  <span class="manifesto-sig-name">JCD Groupe</span>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div><!-- /hero-pin-zone : hero sticky + manifesto scrolling-over -->

      <!-- ================================
     PRESTATIONS — Catalog avec monogram glyphs
     ================================ -->
      <section
        class="prestations"
        id="prestations"
        aria-labelledby="prestations-title"
      >
        <div class="container">
          <div class="prest-layout">
            <aside class="prest-aside reveal">
              <h2 class="prest-aside-title" id="prestations-title">
                <span class="accent">Quatre savoir-faire</span>, une seule
                chaîne de service.
              </h2>
              <p class="prest-aside-sub">
                Équipements, maintenance et logiciels.
              </p>

              <div class="prest-aside-partners">
                <div class="prest-aside-partners-head">
                  <span class="prest-aside-partners-label">Partenaires</span>
                  <span class="prest-aside-partners-rule" aria-hidden="true"
                  ></span>
                  <span class="prest-aside-partners-count">06</span>
                </div>
                <div class="prest-aside-partners-grid">
                  <div class="logo-tile logo-tile--mini" data-brand="hp">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logos%20PRINT/logo_HP_Electric_Blue_keyline%201.webp"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">HP</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="toshiba">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logos%20PRINT/Toshiba_logo.svg.png"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Toshiba</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="papercut">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logos%20PRINT/papercut.png"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">PaperCut</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="brother">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logos%20PRINT/LOGO%20BROTHER.png"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Brother</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="gespage">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logos%20PRINT/gespage%201.webp"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Gespage</span>
                  </div>
                  <div class="logo-tile logo-tile--mini" data-brand="zebra">
                    <img
                      class="logo-tile-img"
                      loading="lazy"
                      decoding="async"
                      src="/logos%20PRINT/zebra-technologies-logo.svg"
                      alt=""
                      aria-hidden="true"
                    />
                    <span class="logo-tile-name">Zebra</span>
                  </div>
                </div>
              </div>
            </aside>

            <div class="prest-menu reveal delay-1">
              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                    >
                      <rect x="6" y="14" width="28" height="14" rx="0.5"></rect>
                      <rect
                        x="10"
                        y="6"
                        width="20"
                        height="8"
                        rx="0.5"
                        opacity="0.5"></rect>
                      <rect
                        x="10"
                        y="28"
                        width="20"
                        height="6"
                        rx="0.5"
                        opacity="0.7"></rect>
                      <circle
                        cx="28"
                        cy="21"
                        r="1.4"
                        fill="currentColor"
                        opacity="0.7"></circle>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  Photocopieurs &amp; imprimantes
                </h3>
                <p class="prest-item-desc">
                  Achat ou location, avec maintenance préventive et curative.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                    >
                      <circle
                        cx="20"
                        cy="20"
                        r="3.4"
                        fill="currentColor"
                        opacity="0.6"></circle>
                      <circle cx="9" cy="9" r="2.4"></circle>
                      <circle cx="31" cy="9" r="2.4"></circle>
                      <circle cx="9" cy="31" r="2.4"></circle>
                      <circle cx="31" cy="31" r="2.4"></circle>
                      <line x1="11" y1="11" x2="17.5" y2="17.5" opacity="0.4"
                      ></line>
                      <line x1="29" y1="11" x2="22.5" y2="17.5" opacity="0.4"
                      ></line>
                      <line x1="11" y1="29" x2="17.5" y2="22.5" opacity="0.4"
                      ></line>
                      <line x1="29" y1="29" x2="22.5" y2="22.5" opacity="0.4"
                      ></line>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Gestion des impressions</h3>
                <p class="prest-item-desc">
                  Contrôle des volumes, sécurisation des flux et traçabilité.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg viewBox="0 0 40 40" fill="currentColor" stroke="none">
                      <rect x="6" y="10" width="2" height="20"></rect>
                      <rect x="10" y="10" width="1" height="20"></rect>
                      <rect x="13" y="10" width="2.5" height="20"></rect>
                      <rect x="17" y="10" width="1" height="20"></rect>
                      <rect x="20" y="10" width="3" height="20"></rect>
                      <rect x="25" y="10" width="1" height="20"></rect>
                      <rect x="28" y="10" width="2" height="20"></rect>
                      <rect x="32" y="10" width="2.5" height="20"></rect>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">
                  Codes-barres &amp; étiqueteuses
                </h3>
                <p class="prest-item-desc">
                  Pour la logistique, l'inventaire et la traçabilité produit.
                </p>
              </article>

              <article class="prest-item">
                <div class="prest-item-head">
                  <span class="prest-item-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                    >
                      <rect x="3" y="14" width="34" height="10" rx="0.5"></rect>
                      <circle cx="9" cy="19" r="2.5" opacity="0.6"></circle>
                      <line x1="13" y1="19" x2="32" y2="19" opacity="0.3"
                      ></line>
                      <rect
                        x="3"
                        y="24"
                        width="34"
                        height="13"
                        rx="0.5"
                        opacity="0.35"></rect>
                      <line
                        x1="7"
                        y1="29"
                        x2="33"
                        y2="29"
                        stroke-dasharray="2 2"
                        opacity="0.5"></line>
                    </svg>
                  </span>
                </div>
                <h3 class="prest-item-title">Traceurs grand format</h3>
                <p class="prest-item-desc">
                  Conçus pour le bâtiment, l'architecture et les bureaux
                  d'études.
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================
     SECTION DIVIDER — Compétences → Méthode (hairline monochrome)
     ================================ -->
      <div class="section-divider" aria-hidden="true">
        <div class="container">
          <span class="section-divider-line"></span>
        </div>
      </div>

      <!-- ================================
     PROCESS — Étapes (épuré, sans détails techniques)
     ================================ -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="container">
          <div class="section-head reveal">
            <h2 class="section-title" id="process-title">
              Quatre étapes, <span class="accent">un seul interlocuteur</span>.
              <span class="text-muted"
                >De la première visite à la supervision au quotidien.</span
              >
            </h2>
          </div>

          <div class="pf-vflow reveal">
            <!-- ====== SVG Fountain : HUB top center → 4 branches Bezier orange divergent vers les 4 cards ====== -->
            <svg
              class="pf-vsvg"
              viewBox="0 0 900 350"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              preserveAspectRatio="xMidYMid meet"
            >
              <defs>
                <filter
                  id="pf-glow"
                  x="-20%"
                  y="-20%"
                  width="140%"
                  height="140%"
                >
                  <feGaussianBlur
                    in="SourceGraphic"
                    stdDeviation="4"
                    result="blur"></feGaussianBlur>
                  <feMerge>
                    <feMergeNode in="blur"></feMergeNode>
                    <feMergeNode in="SourceGraphic"></feMergeNode>
                  </feMerge>
                </filter>
                <radialGradient id="pf-hub-aura" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#F3941D" stop-opacity="0.18"
                  ></stop>
                  <stop offset="60%" stop-color="#F3941D" stop-opacity="0.04"
                  ></stop>
                  <stop offset="100%" stop-color="#F3941D" stop-opacity="0"
                  ></stop>
                </radialGradient>
              </defs>

              <!-- Hub aura (halo subtil, derrière les branches) -->
              <circle cx="450" cy="48" r="60" fill="url(#pf-hub-aura)"></circle>

              <!-- ===== GLOW LAYERS (blurred wide stroke derrière) ===== -->
              <path
                class="pf-glow-line"
                style="--d: 0.5s"
                d="M 450,54 L 450,72 C 450,210 113,265 113,350"
                stroke="#FFB877"
                stroke-width="6"
                stroke-linecap="round"
                filter="url(#pf-glow)"></path>
              <path
                class="pf-glow-line"
                style="--d: 0.6s"
                d="M 450,54 L 450,72 C 450,200 338,265 338,350"
                stroke="#F7A23F"
                stroke-width="6"
                stroke-linecap="round"
                filter="url(#pf-glow)"></path>
              <path
                class="pf-glow-line"
                style="--d: 0.7s"
                d="M 450,54 L 450,72 C 450,200 562,265 562,350"
                stroke="#F3941D"
                stroke-width="6"
                stroke-linecap="round"
                filter="url(#pf-glow)"></path>
              <path
                class="pf-glow-line"
                style="--d: 0.8s"
                d="M 450,54 L 450,72 C 450,210 787,265 787,350"
                stroke="#C47816"
                stroke-width="6"
                stroke-linecap="round"
                filter="url(#pf-glow)"></path>

              <!-- ===== ECHO BEZIER ULTRA-FINS (renfort visuel discret, statique) ===== -->
              <g aria-hidden="true">
                <path
                  d="M 450,54 L 450,72 C 450,210 113,265 113,350"
                  stroke="#FFB877"
                  stroke-width="0.6"
                  stroke-opacity="0.14"
                  stroke-linecap="round"
                  transform="translate(-4, 3)"
                  fill="none"></path>
                <path
                  d="M 450,54 L 450,72 C 450,200 338,265 338,350"
                  stroke="#F7A23F"
                  stroke-width="0.6"
                  stroke-opacity="0.14"
                  stroke-linecap="round"
                  transform="translate(-2, 3)"
                  fill="none"></path>
                <path
                  d="M 450,54 L 450,72 C 450,200 562,265 562,350"
                  stroke="#F3941D"
                  stroke-width="0.6"
                  stroke-opacity="0.14"
                  stroke-linecap="round"
                  transform="translate(2, 3)"
                  fill="none"></path>
                <path
                  d="M 450,54 L 450,72 C 450,210 787,265 787,350"
                  stroke="#C47816"
                  stroke-width="0.6"
                  stroke-opacity="0.14"
                  stroke-linecap="round"
                  transform="translate(4, 3)"
                  fill="none"></path>
              </g>

              <!-- ===== SHARP CURVES (4 branches Bezier élégantes jusqu'au bord inférieur SVG) ===== -->
              <path
                class="pf-anim-line"
                pathLength="100"
                style="--dur: 1.4s; --d: 0.5s"
                d="M 450,54 L 450,72 C 450,210 113,265 113,350"
                stroke="#FFB877"
                stroke-width="1.5"
                stroke-linecap="round"></path>
              <path
                class="pf-anim-line"
                pathLength="100"
                style="--dur: 1.4s; --d: 0.6s"
                d="M 450,54 L 450,72 C 450,200 338,265 338,350"
                stroke="#F7A23F"
                stroke-width="1.5"
                stroke-linecap="round"></path>
              <path
                class="pf-anim-line"
                pathLength="100"
                style="--dur: 1.4s; --d: 0.7s"
                d="M 450,54 L 450,72 C 450,200 562,265 562,350"
                stroke="#F3941D"
                stroke-width="1.5"
                stroke-linecap="round"></path>
              <path
                class="pf-anim-line"
                pathLength="100"
                style="--dur: 1.4s; --d: 0.8s"
                d="M 450,54 L 450,72 C 450,210 787,265 787,350"
                stroke="#C47816"
                stroke-width="1.5"
                stroke-linecap="round"></path>

              <!-- HUB : circle + printer icon — dessiné PAR-DESSUS les branches
             pour masquer proprement leur point de convergence (connexion nette) -->
              <g class="pf-anim-node" style="--d: 0s">
                <circle
                  cx="450"
                  cy="48"
                  r="24"
                  fill="#0a0a0a"
                  stroke="rgba(243,148,29,0.38)"
                  stroke-width="1"></circle>
                <g
                  stroke="#F3941D"
                  stroke-width="1.3"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  fill="none"
                >
                  <!-- ADF (top scanner unit) -->
                  <rect
                    x="442"
                    y="37"
                    width="16"
                    height="3.4"
                    rx="0.5"
                    opacity="0.7"></rect>
                  <!-- Main body -->
                  <rect x="440" y="40.6" width="20" height="9" rx="1"></rect>
                  <!-- Output paper (sheet) -->
                  <rect x="444.5" y="49.6" width="11" height="6.2" rx="0.6"
                  ></rect>
                  <!-- Print lines on paper -->
                  <line
                    x1="446.5"
                    y1="52"
                    x2="453"
                    y2="52"
                    stroke-width="0.65"
                    opacity="0.55"></line>
                  <line
                    x1="446.5"
                    y1="53.6"
                    x2="451"
                    y2="53.6"
                    stroke-width="0.6"
                    opacity="0.45"></line>
                  <!-- Status LED -->
                  <circle
                    cx="455.5"
                    cy="44.7"
                    r="0.9"
                    fill="#F3941D"
                    stroke="none"></circle>
                </g>
              </g>

              <!-- "VOTRE PARC" label au-dessus du hub -->
              <g class="pf-anim-node" style="--d: 0.15s">
                <text
                  x="450"
                  y="12"
                  text-anchor="middle"
                  font-family="JetBrains Mono, ui-monospace, monospace"
                  font-size="9.5"
                  fill="rgba(255,255,255,0.42)"
                  letter-spacing="3.5">VOTRE PARC</text
                >
              </g>

              <!-- ===== ENDPOINT DOTS — au bord inférieur SVG (cy=350) pour se brancher directement sur la card ===== -->
              <g class="pf-anim-node pf-vdot pf-vdot--1" style="--d: 1.1s">
                <circle cx="113" cy="350" r="8" fill="#FFB877" opacity="0.20"
                ></circle>
                <circle cx="113" cy="350" r="4" fill="#FFB877"></circle>
              </g>
              <g class="pf-anim-node pf-vdot pf-vdot--2" style="--d: 1.2s">
                <circle cx="338" cy="350" r="8" fill="#F7A23F" opacity="0.20"
                ></circle>
                <circle cx="338" cy="350" r="4" fill="#F7A23F"></circle>
              </g>
              <g class="pf-anim-node pf-vdot pf-vdot--3" style="--d: 1.3s">
                <circle cx="562" cy="350" r="8" fill="#F3941D" opacity="0.20"
                ></circle>
                <circle cx="562" cy="350" r="4" fill="#F3941D"></circle>
              </g>
              <g class="pf-anim-node pf-vdot pf-vdot--4" style="--d: 1.4s">
                <circle cx="787" cy="350" r="8" fill="#C47816" opacity="0.20"
                ></circle>
                <circle cx="787" cy="350" r="4" fill="#C47816"></circle>
              </g>
            </svg>

            <!-- ====== 4 CARDS alignées avec les endpoints des branches ====== -->
            <div class="pf-vcards">
              <article
                class="pf-vcard"
                style="--c: #FFB877; --c-rgb: 255,184,119;"
              >
                <div class="pf-vcard-shade" aria-hidden="true"></div>
                <div class="pf-vcard-head">
                  <span class="pf-vcard-glyph" aria-hidden="true">
                    <svg
                      viewBox="0 0 40 40"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="17" cy="17" r="9.5"></circle>
                      <path d="M23.9 23.9 L31 31"></path>
                      <circle
                        cx="13.6"
                        cy="13.8"
                        r="1.15"
                        fill="currentColor"
                        stroke="none"
                        opacity="0.85"></circle>
                      <circle
                        cx="20.4"
                        cy="13.8"
                        r="1.15"
                        fill="currentColor"
                        stroke="none"
