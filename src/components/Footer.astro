---
import { readSingleton } from "@directus/sdk";
import { directus } from "../lib/directus";
import { globalRegistry } from "astro:schema";

// Pied de page commun (toutes pages sauf 404, qui garde le sien).
// Props :
//   current 'carrieres' | null -> aria-current sur "Nous rejoindre"
//   home    true sur index     -> ancres nues (#histoire) au lieu de index#histoire
const { current = null, home = false } = Astro.props;

const currentYear = new Date().getFullYear();

let global = await directus.request(
  readSingleton("Global", {
    fields: [
      "*",
      {
        adresses: ["*"],
      },
      {
        entreprises_groupe: ["*"],
      },
    ],
  }),
);

let informatique = await directus.request(
  readSingleton("JCD_Informatique", {
    fields: ["nom_pole"],
  }),
);

let developpement = await directus.request(
  readSingleton("JCD_Developpement", {
    fields: ["nom_pole"],
  }),
);

let print = await directus.request(
  readSingleton("JCD_Print", {
    fields: ["nom_pole"],
  }),
);

let service = await directus.request(
  readSingleton("JCD_Service", {
    fields: ["nom_pole"],
  }),
);

let telecom = await directus.request(
  readSingleton("JCD_Telecom", {
    fields: ["nom_pole"],
  }),
);

let formation = await directus.request(
  readSingleton("JCD_Formation", {
    fields: ["nom_pole"],
  }),
);

let agencement = await directus.request(
  readSingleton("JCD_Agencement", {
    fields: ["nom_pole"],
  }),
);
---

<footer role="contentinfo">
  <div class="footer-grain" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-bento">
      <!-- Pôles -->
      <div class="fcard fcard--poles reveal">
        <div class="fcard-inner">
          <h4 class="fcard-title">Pôles</h4>
          <ul class="footer-links footer-links--cols">
            <li>
              <a class="footer-link" href="/informatique"
                >{informatique.nom_pole}</a
              >
            </li>
            <li>
              <a class="footer-link" href="/service">{service.nom_pole}</a>
            </li>
            <li>
              <a class="footer-link" href="/developpement"
                >{developpement.nom_pole}</a
              >
            </li>
            <li><a class="footer-link" href="/print">{print.nom_pole}</a></li>
            <li>
              <a class="footer-link" href="/telecom">{telecom.nom_pole}</a>
            </li>
            <li>
              <a class="footer-link" href="/formation">{formation.nom_pole}</a>
            </li>
            <li>
              <a class="footer-link" href="/agencement">{agencement.nom_pole}</a
              >
            </li>
          </ul>
        </div>
      </div>

      <!-- Le groupe -->
      <div class="fcard fcard--groupe reveal delay-1">
        <div class="fcard-inner">
          <h4 class="fcard-title">Le groupe</h4>
          <ul class="footer-links">
            <li>
              <a class="footer-link" href={(home ? "" : "/") + "#histoire"}
                >Histoire</a
              >
            </li>
            <li>
              <a class="footer-link" href={(home ? "" : "/") + "#valeurs"}
                >Valeurs</a
              >
            </li>
            <li>
              <a class="footer-link" href={(home ? "" : "/") + "#chiffres"}
                >Chiffres clés</a
              >
            </li>
            <li>
              <a
                class={"footer-link" +
                  (current === "carrieres" ? " is-current" : "")}
                href="/carrieres"
                aria-current={current === "carrieres" ? "page" : undefined}
                >Nous rejoindre</a
              >
            </li>
            <li><a class="footer-link" href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>

      <!-- Contact Metz + Nancy -->
      <div class="fcard fcard--contact reveal delay-2">
        <div class="fcard-inner">
          <h4 class="fcard-title">Nous trouver</h4>
          <div class="footer-contacts">
            {
              global.adresses.map((adresse: any) => (
                <div class="footer-contact-block">
                  <span class="fc-city">{adresse.titre}</span>
                  <span class="fc-role">{adresse.sous_titre}</span>
                  <address>
                    {adresse.adresse_rue}
                    {adresse.adresse_complement && <br />}
                    {adresse.adresse_complement}
                    <br />
                    {adresse.code_postal_ville}
                  </address>
                  <a class="footer-link" href="tel:+33387184920">
                    03 87 18 49 20
                  </a>
                  {adresse.horaires.map((horaires: any) => (
                    <span class="fc-hours">{horaires.horaires}</span>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom reveal delay-3">
      <span class="footer-copyright"
        >&copy; <span id="year">{currentYear}</span>
        &nbsp;{global.nom_societe} &middot; Tous droits réservés.</span
      >

      <!-- Le groupe : societes soeurs de la holding, signature centrale de
           la barre legale. La signification passe par la seule proximite
           avec "JCD Groupe", jamais enoncee. (inject_footer_eco.py) -->
      <div class="footer-eco">
        <span class="footer-eco-label">Le groupe</span>
        {
          global.entreprises_groupe.map((entreprise: any) => (
            <a
              class="footer-eco-link"
              href={entreprise.lien}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${entreprise.nom} — ${entreprise.sous_titre} (nouvel onglet)`}
            >
              <img
                src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${entreprise.logo}`}
                alt={entreprise.nom}
                height="14"
                decoding="async"
              />
              <svg
                class="footer-eco-arrow"
                width="9"
                height="9"
                viewBox="0 0 9 9"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M1.5 7.5 7.5 1.5M7.5 1.5H2.9M7.5 1.5v4.6"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          ))
        }
      </div>

      <div class="footer-bottom-right">
        <span class="footer-legal"
          ><a class="footer-link" href="/mentions-legales">Mentions légales</a> &middot;
          <a class="footer-link" href="/politique-de-confidentialite"
            >Politique de confidentialité</a
          ></span
        >
        <a
          class="footer-linkedin"
          href={global.lien_linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${global.nom_societe} sur LinkedIn`}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            ><path
              d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.6 0h4.37v1.92h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 7v7.44h-4.56v-6.6c0-1.57-.03-3.6-2.2-3.6-2.2 0-2.54 1.72-2.54 3.49V22H7.82V8z"
            ></path></svg
          >
        </a>
      </div>
    </div>
  </div>
</footer>
