---
import { readItems, readSingleton } from "@directus/sdk";
import { directus } from "../lib/directus";
import { fetchSvgContent } from "../utils/formatters";

let informatique = await directus.request(
  readSingleton("JCD_Informatique", {
    fields: ["nom_pole", "icone_pole"],
  }),
);
informatique.icone_pole_content = await fetchSvgContent(
  informatique.icone_pole,
);

let info_cloud = await directus.request(
  readSingleton("cloud_microsoft", {
    fields: ["nom_service"],
  }),
);
let info_collaboratif = await directus.request(
  readSingleton("solutions_collaboratives_audiovisuelles", {
    fields: ["nom_service"],
  }),
);
let info_integration = await directus.request(
  readSingleton("integration_support_pc", {
    fields: ["nom_service"],
  }),
);
let info_reseaux = await directus.request(
  readSingleton("architectures_systemes_reseaux", {
    fields: ["nom_service"],
  }),
);

let developpement = await directus.request(
  readSingleton("JCD_Developpement", {
    fields: ["nom_pole", "icone_pole"],
  }),
);
developpement.icone_pole_content = await fetchSvgContent(
  developpement.icone_pole,
);

let print = await directus.request(
  readSingleton("JCD_Print", {
    fields: ["nom_pole", "icone_pole"],
  }),
);
print.icone_pole_content = await fetchSvgContent(print.icone_pole);

let service = await directus.request(
  readSingleton("JCD_Service", {
    fields: ["nom_pole", "icone_pole"],
  }),
);
service.icone_pole_content = await fetchSvgContent(service.icone_pole);

let telecom = await directus.request(
  readSingleton("JCD_Telecom", {
    fields: ["nom_pole", "icone_pole"],
  }),
);
telecom.icone_pole_content = await fetchSvgContent(telecom.icone_pole);

let formation = await directus.request(
  readSingleton("JCD_Formation", {
    fields: ["nom_pole", "icone_pole"],
  }),
);
formation.icone_pole_content = await fetchSvgContent(formation.icone_pole);

let thematiques = await directus.request(
  readItems("thematiques_formation", {
    fields: ["*"],
  }),
);

let agencement = await directus.request(
  readSingleton("JCD_Agencement", {
    fields: ["nom_pole", "icone_pole"],
  }),
);
agencement.icone_pole_content = await fetchSvgContent(agencement.icone_pole);

let assistance = await directus.request(
  readSingleton("assistance", {
    fields: ["titre"],
  }),
);

let carriere = await directus.request(
  readSingleton("carriere", {
    fields: ["titre"],
  }),
);
---

<!-- jcd-mobile-nav (injected) -->
<button
  class="jcd-burger"
  id="jcdBurger"
  type="button"
  aria-label="Ouvrir le menu"
  aria-expanded="false"
  aria-controls="jcdMnav"
>
  <span class="jcd-burger__box" aria-hidden="true"><i></i><i></i><i></i></span>
</button>
<div
  class="jcd-mnav"
  id="jcdMnav"
  role="dialog"
  aria-modal="true"
  aria-label="Menu de navigation"
  aria-hidden="true"
>
  <div class="jcd-mnav__scroll">
    <div class="jcd-mnav__inner">
      <p
        class="jcd-mnav__eyebrow jcd-mnav__reveal"
        style="transition-delay:.04s"
      >
        Expertises
      </p>

      <div class="jcd-mnav__reveal" style="transition-delay:.07s">
        <div class="jcd-mnav__item" style="--mnav-c:#2E72BA">
          <a class="jcd-mnav__link" href="/informatique">
            <span class="jcd-mnav__ico" aria-hidden="true">
              <Fragment set:html={informatique.icone_pole_content} />
            </span>
            <span class="jcd-mnav__dot"></span><span class="jcd-mnav__label">
              {informatique.nom_pole}
            </span>
          </a>
          <button
            class="jcd-acc__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="jcdAccInfo"
            aria-label={`Afficher les sous-pages ${informatique.nom_pole}`}
          >
            <svg
              viewBox="0 0 14 14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"><path d="M7 2v10M2 7h10"></path></svg
            >
          </button>
        </div>
        <div class="jcd-acc__panel" id="jcdAccInfo">
          <a class="jcd-mnav__sub" href="/info-integration"
            >{info_integration.nom_service}</a
          >
          <a class="jcd-mnav__sub" href="/info-reseaux"
            >{info_reseaux.nom_service}</a
          >
          <a class="jcd-mnav__sub" href="/info-collaboratif"
            >{info_collaboratif.nom_service}</a
          >
          <a class="jcd-mnav__sub" href="/info-cloud"
            >{info_cloud.nom_service}</a
          >
        </div>
      </div>
      <a
        class="jcd-mnav__item jcd-mnav__reveal"
        style="--mnav-c:#E51D29;transition-delay:.10s"
        href="/service"
      >
        <span class="jcd-mnav__ico" aria-hidden="true">
          <Fragment set:html={service.icone_pole_content} />
        </span><span class="jcd-mnav__dot"></span><span class="jcd-mnav__label"
          >{service.nom_pole}</span
        ></a
      >
      <a
        class="jcd-mnav__item jcd-mnav__reveal"
        style="--mnav-c:#F9D605;transition-delay:.13s"
        href="/developpement"
      >
        <span class="jcd-mnav__ico" aria-hidden="true">
          <Fragment set:html={developpement.icone_pole_content} />
        </span><span class="jcd-mnav__dot"></span><span class="jcd-mnav__label"
          >{developpement.nom_pole}</span
        ></a
      >
      <a
        class="jcd-mnav__item jcd-mnav__reveal"
        style="--mnav-c:#F3941D;transition-delay:.16s"
        href="/print"
      >
        <span class="jcd-mnav__ico" aria-hidden="true">
          <Fragment set:html={print.icone_pole_content} />
        </span><span class="jcd-mnav__dot"></span><span class="jcd-mnav__label"
          >{print.nom_pole}</span
        ></a
      >
      <a
        class="jcd-mnav__item jcd-mnav__reveal"
        style="--mnav-c:#B063AC;transition-delay:.19s"
        href="/telecom"
      >
        <span class="jcd-mnav__ico" aria-hidden="true">
          <Fragment set:html={telecom.icone_pole_content} />
        </span><span class="jcd-mnav__dot"></span><span class="jcd-mnav__label"
          >{telecom.nom_pole}</span
        ></a
      >
      <div class="jcd-mnav__reveal" style="transition-delay:.22s">
        <div class="jcd-mnav__item" style="--mnav-c:#8EC041">
          <a class="jcd-mnav__link" href="/formation">
            <span class="jcd-mnav__ico" aria-hidden="true">
              <Fragment set:html={formation.icone_pole_content} />
            </span><span class="jcd-mnav__dot"></span><span
              class="jcd-mnav__label">{formation.nom_pole}</span
            ></a
          >
          <button
            class="jcd-acc__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="jcdAccForm"
            aria-label="Afficher les catégories de formation"
          >
            <svg
              viewBox="0 0 14 14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"><path d="M7 2v10M2 7h10"></path></svg
            >
          </button>
        </div>
        <div class="jcd-acc__panel" id="jcdAccForm">
          {
            thematiques.map((thematique: any) => (
              <a class="jcd-mnav__sub" href={`/formations/${thematique.slug}`}>
                {thematique.titre_de_la_thematique_de_formations}
              </a>
            ))
          }
        </div>
      </div>
      <a
        class="jcd-mnav__item jcd-mnav__reveal"
        style="--mnav-c:#A78D75;transition-delay:.25s"
        href="/agencement"
      >
        <span class="jcd-mnav__ico" aria-hidden="true">
          <Fragment set:html={agencement.icone_pole_content} />
        </span><span class="jcd-mnav__dot"></span><span class="jcd-mnav__label"
          >{agencement.nom_pole}</span
        ></a
      >

      <p
        class="jcd-mnav__eyebrow jcd-mnav__sec2 jcd-mnav__reveal"
        style="transition-delay:.30s"
      >
        D&eacute;couvrir
      </p>
      <a
        class="jcd-mnav__item jcd-mnav__reveal"
        style="--mnav-c:#9a9a9a;transition-delay:.33s"
        href="/assistance"
        ><span class="jcd-mnav__dot"></span><span
          class="jcd-mnav__label"
          style="font-size:19px">{assistance.titre}</span
        ></a
      >
      <a
        class="jcd-mnav__item jcd-mnav__reveal"
        style="--mnav-c:#9a9a9a;transition-delay:.36s"
        href="/carrieres"
        ><span class="jcd-mnav__dot"></span><span
          class="jcd-mnav__label"
          style="font-size:19px">{carriere.titre}</span
        ></a
      >

      <div class="jcd-mnav__cta jcd-mnav__reveal" style="transition-delay:.40s">
        <a class="jcd-mnav__btn jcd-mnav__btn--primary" href="/contact"
          >Contacter un expert
          <span class="jcd-mnav__btn-ic"
            ><svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
            ></span
          ></a
        >
        <a class="jcd-mnav__btn jcd-mnav__btn--ghost" href="tel:+33387184920"
          >03 87 18 49 20
          <span class="jcd-mnav__btn-ic"
            ><svg
              viewBox="0 0 18 18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M2.5 3.5a1 1 0 011-1h2.4a1 1 0 01.95.68l.86 2.4a1 1 0 01-.24 1l-1.2 1.2a11 11 0 004.6 4.6l1.2-1.2a1 1 0 011-.24l2.4.86a1 1 0 01.68.95V15a1 1 0 01-1 1A13.5 13.5 0 012.5 3.5z"
              ></path></svg
            ></span
          ></a
        >
      </div>
    </div>
  </div>
</div>
<script is:inline src="/js/shared/mobile-nav.js"></script>
