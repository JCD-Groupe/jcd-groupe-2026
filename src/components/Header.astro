---
// Barre de navigation commune (32 pages sauf 404).
// Props :
//   current   'carrieres' | 'contact' | null  -> aria-current sur le lien vise
//   catalogue true sur les 15 pages formation -> pill + mega-menu Catalogue
import { readSingleton } from "@directus/sdk";
import CatalogueMenu from "./CatalogueMenu.astro";
import MobileNav from "./MobileNav.astro";
import { directus } from "../lib/directus";
const { current = null, catalogue = false } = Astro.props;

let global = await directus.request(
  readSingleton("Global", {
    fields: ["*"],
  }),
);

const fetchSvgContent = async (id: string) => {
  if (!id) return null;
  const response = await fetch(
    `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${id}`,
  );
  return response.text();
};

let informatique = await directus.request(
  readSingleton("JCD_Informatique", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
informatique.icone_pole_content = await fetchSvgContent(
  informatique.icone_pole,
);

let info_cloud = await directus.request(
  readSingleton("cloud_microsoft", {
    fields: ["nom_service", "icone_service"],
  }),
);
info_cloud.icone_service_content = await fetchSvgContent(
  info_cloud.icone_service,
);
let info_collaboratif = await directus.request(
  readSingleton("solutions_collaboratives_audiovisuelles", {
    fields: ["nom_service", "icone_service"],
  }),
);
info_collaboratif.icone_service_content = await fetchSvgContent(
  info_collaboratif.icone_service,
);
let info_integration = await directus.request(
  readSingleton("integration_support_pc", {
    fields: ["nom_service", "icone_service"],
  }),
);
info_integration.icone_service_content = await fetchSvgContent(
  info_integration.icone_service,
);
let info_reseaux = await directus.request(
  readSingleton("architectures_systemes_reseaux", {
    fields: ["nom_service", "icone_service"],
  }),
);
info_reseaux.icone_service_content = await fetchSvgContent(
  info_reseaux.icone_service,
);

let developpement = await directus.request(
  readSingleton("JCD_Developpement", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
developpement.icone_pole_content = await fetchSvgContent(
  developpement.icone_pole,
);

let print = await directus.request(
  readSingleton("JCD_Print", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
print.icone_pole_content = await fetchSvgContent(print.icone_pole);

let service = await directus.request(
  readSingleton("JCD_Service", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
service.icone_pole_content = await fetchSvgContent(service.icone_pole);

let telecom = await directus.request(
  readSingleton("JCD_Telecom", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
telecom.icone_pole_content = await fetchSvgContent(telecom.icone_pole);

let formation = await directus.request(
  readSingleton("JCD_Formation", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
formation.icone_pole_content = await fetchSvgContent(formation.icone_pole);

let agencement = await directus.request(
  readSingleton("JCD_Agencement", {
    fields: ["nom_pole", "icone_pole", "description_navigation"],
  }),
);
agencement.icone_pole_content = await fetchSvgContent(agencement.icone_pole);
---

<header class="navbar" id="navbar" role="banner">
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="JCD Groupe · Accueil">
      <img
        class="logo-img"
        src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${global.logo_societe}`}
        alt={global.nom_societe}
        width="1530"
        height="482"
        decoding="async"
        loading="eager"
      />
    </a>

    <!-- Capsule centrale : trigger du dropdown "Nos solutions" + Catalogue (formation uniquement) -->
    <nav class="nav-center" aria-label="Navigation principale">
      <div class="nav-pill nav-pill--solo" id="nav-pill">
        <button
          type="button"
          class="nav-pill__item nav-pill__trigger"
          id="nav-expertises-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="nav-expertises-panel"
        >
          <span>Nos solutions</span>
          <svg
            class="nav-chevron"
            width="10"
            height="10"
            viewBox="0 0 10 10"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M2.5 4l2.5 2.5L7.5 4"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <span class="nav-pill__sep" aria-hidden="true"></span>
        <a
          href="/carrieres"
          class={"nav-pill__item nav-pill__careers" +
            (current === "carrieres" ? " is-current" : "")}
          aria-current={current === "carrieres" ? "page" : undefined}
          aria-label="Carrières — Rejoindre le groupe JCD"
          title="Carrières"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
            ><circle cx="9" cy="8" r="3.2"></circle><circle
              cx="17"
              cy="9.5"
              r="2.4"></circle><path d="M3 19c0-3 2.7-5 6-5s6 2 6 5"
            ></path><path d="M14.5 19c.2-2.2 1.8-4 4-4s3.5 1.5 3.5 3.5"
            ></path></svg
          >
        </a>
      </div>
      {
        catalogue && (
          <div class="nav-pill nav-pill--catalogue" id="nav-catalogue-pill">
            <button
              type="button"
              class="nav-pill__item nav-pill__item--catalogue nav-pill__trigger"
              id="nav-catalogue-trigger"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="nav-catalogue-panel"
              aria-label="Catalogue des formations"
            >
              Catalogue
              <svg
                class="nav-chevron"
                width="10"
                height="10"
                viewBox="0 0 10 10"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M2.5 4l2.5 2.5L7.5 4"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        )
      }
    </nav>

    <!-- Pillule droite : Assistance (blanc) + Contact (transparent) -->
    <div class="nav-cta">
      <div class="nav-pill nav-pill--actions">
        <a
          href="/assistance"
          class="nav-pill__item nav-pill__item--light"
          aria-label="Assistance JCD"
        >
          Assistance
        </a>
        <a
          href="/contact"
          class="nav-pill__item nav-pill__item--dark"
          aria-current={current === "contact" ? "page" : undefined}
        >
          Contact
        </a>
      </div>
    </div>
  </div>

  <!-- ============================================================
       DROPDOWN PANEL v3 — Antimetal-like, 3 colonnes.
       Zone Expertises : 2 sous-colonnes (3 + 4 items), icones JCD.
       Zone Decouvrir : monochrome blanc/gris.
       Informatique : sous-items inline en accordeon maitrise.
       ============================================================ -->
  <div
    class="nav-panel nav-menu"
    id="nav-expertises-panel"
    role="menu"
    aria-labelledby="nav-expertises-trigger"
    aria-hidden="true"
  >
    <div class="nav-panel__shell">
      <section class="nm-zone nm-zone--expertises" aria-label="Expertises JCD">
        <span class="nm-eyebrow">Expertises</span>
        <div class="nm-grid">
          <ul class="nm-list" role="none">
            <li class="nm-group" role="none">
              <a
                href="/informatique"
                class="nm-item"
                data-c="info"
                role="menuitem"
                tabindex="-1"
              >
                <span class="nm-icon" aria-hidden="true">
                  <Fragment set:html={informatique.icone_pole_content} />
                </span>
                <span class="nm-text">
                  <span class="nm-title">{informatique.nom_pole}</span>
                  <span class="nm-sub-label">
                    {informatique.description_navigation}
                  </span>
                </span>
              </a>
              <div class="nm-sub">
                <div class="nm-sub-wrap">
                  <ul class="nm-sub-list" role="none">
                    <li role="none">
                      <a
                        href="/info-integration"
                        class="nm-sub-item"
                        role="menuitem"
                        tabindex="-1"
                        ><span class="nm-sub-ic" aria-hidden="true">
                          <Fragment
                            set:html={info_integration.icone_service_content}
                          />
                        </span>
                        <span class="nm-sub-tx"
                          >{info_integration.nom_service}</span
                        >
                      </a>
                    </li>
                    <li role="none">
                      <a
                        href="/info-reseaux"
                        class="nm-sub-item"
                        role="menuitem"
                        tabindex="-1"
                        ><span class="nm-sub-ic" aria-hidden="true">
                          <Fragment
                            set:html={info_reseaux.icone_service_content}
                          />
                        </span><span class="nm-sub-tx"
                          >{info_reseaux.nom_service}</span
                        ></a
                      >
                    </li>
                    <li role="none">
                      <a
                        href="/info-collaboratif"
                        class="nm-sub-item"
                        role="menuitem"
                        tabindex="-1"
                        ><span class="nm-sub-ic" aria-hidden="true">
                          <Fragment
                            set:html={info_collaboratif.icone_service_content}
                          />
                        </span><span class="nm-sub-tx"
                          >{info_collaboratif.nom_service}</span
                        ></a
                      >
                    </li>
                    <li role="none">
                      <a
                        href="/info-cloud"
                        class="nm-sub-item"
                        role="menuitem"
                        tabindex="-1"
                        ><span class="nm-sub-ic" aria-hidden="true">
                          <Fragment
                            set:html={info_cloud.icone_service_content}
                          />
                        </span><span class="nm-sub-tx"
                          >{info_cloud.nom_service}</span
                        ></a
                      >
                    </li>
                  </ul>
                </div>
              </div>
            </li>

            <li class="nm-group" role="none">
              <a
                href="/service"
                class="nm-item"
                data-c="service"
                role="menuitem"
                tabindex="-1"
              >
                <span class="nm-icon" aria-hidden="true">
                  <Fragment set:html={service.icone_pole_content} />
                </span>
                <span class="nm-text">
                  <span class="nm-title">{service.nom_pole}</span>
                  <span class="nm-sub-label">
                    {service.description_navigation}
                  </span>
                </span>
              </a>
            </li>

            <li class="nm-group" role="none">
              <a
                href="/developpement"
                class="nm-item"
                data-c="dev"
                role="menuitem"
                tabindex="-1"
              >
                <span class="nm-icon" aria-hidden="true">
                  <Fragment set:html={developpement.icone_pole_content} />
                </span>
                <span class="nm-text">
                  <span class="nm-title">{developpement.nom_pole}</span>
                  <span class="nm-sub-label">
                    {developpement.description_navigation}
                  </span>
                </span>
              </a>
            </li>
          </ul>

          <ul class="nm-list" role="none">
            <li class="nm-group" role="none">
              <a
                href="/print"
                class="nm-item"
                data-c="print"
                role="menuitem"
                tabindex="-1"
              >
                <span class="nm-icon" aria-hidden="true">
                  <Fragment set:html={print.icone_pole_content} />
                </span>
                <span class="nm-text">
                  <span class="nm-title">{print.nom_pole}</span>
                  <span class="nm-sub-label">
                    {print.description_navigation}
                  </span>
                </span>
              </a>
            </li>

            <li class="nm-group" role="none">
              <a
                href="/telecom"
                class="nm-item"
                data-c="telecom"
                role="menuitem"
                tabindex="-1"
              >
                <span class="nm-icon" aria-hidden="true">
                  <Fragment set:html={telecom.icone_pole_content} />
                </span>
                <span class="nm-text">
                  <span class="nm-title">{telecom.nom_pole}</span>
                  <span class="nm-sub-label">
                    {telecom.description_navigation}
                  </span>
                </span>
              </a>
            </li>

            <li class="nm-group" role="none">
              <a
                href="/formation"
                class="nm-item"
                data-c="formation"
                role="menuitem"
                tabindex="-1"
              >
                <span class="nm-icon" aria-hidden="true">
                  <Fragment set:html={formation.icone_pole_content} />
                </span>
                <span class="nm-text">
                  <span class="nm-title">{formation.nom_pole}</span>
                  <span class="nm-sub-label">
                    {formation.description_navigation}
                  </span>
                </span>
              </a>
            </li>

            <li class="nm-group" role="none">
              <a
                href="/agencement"
                class="nm-item"
                data-c="agencement"
                role="menuitem"
                tabindex="-1"
              >
                <span class="nm-icon" aria-hidden="true">
                  <Fragment set:html={agencement.icone_pole_content} />
                </span>
                <span class="nm-text">
                  <span class="nm-title">{agencement.nom_pole}</span>
                  <span class="nm-sub-label">
                    {agencement.description_navigation}
                  </span>
                </span>
              </a>
            </li>
          </ul>
        </div>
      </section>
    </div>
  </div>

  <!-- ============================================================
       MEGA MENU CATALOGUE — bloc généré par
       _catalogue/build_catalogue.py depuis catalogue-data.json.
       Ne pas éditer entre les marqueurs : modifier le JSON puis
       relancer le script.
       ============================================================ -->
  {catalogue && <CatalogueMenu />}
</header>

<MobileNav />
