<div
  class="nav-panel nav-catalogue"
  id="nav-catalogue-panel"
  role="menu"
  aria-labelledby="nav-catalogue-trigger"
  aria-hidden="true"
>
  <div class="nav-panel__shell">
    <div class="ncat-head">
      <div class="ncat-search">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
          ><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"
          ></path></svg
        >
        <input
          type="search"
          class="ncat-input"
          placeholder="Rechercher une formation…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Rechercher une formation dans le catalogue"
          tabindex="-1"
        />
        <kbd class="ncat-kbd">ÉCHAP</kbd>
      </div>
      <span class="ncat-meta"
        ><strong>{formations.length}</strong> formations · <strong
          >{thematiques.length}</strong
        > catégories</span
      >
    </div>

    <div class="ncat-body">
      <ul class="ncat-rail" role="none">
        {
          thematiques.map(async (thematique: any, index: number) => (
            <li role="none">
              <a
                href={`/formations/${thematique.slug}`}
                class="ncat-cat"
                data-cat={thematique.slug}
                role="menuitem"
                tabindex="-1"
                aria-selected={index == 0 ? "true" : "false"}
                style={`--cc:${thematique.couleur_rgb}`}
              >
                <span class="ncat-cat-ic" aria-hidden="true">
                  <Fragment set:html={thematique.icone_thematique_content} />
                </span>
                <span class="ncat-cat-tx">
                  {thematique.titre_de_la_thematique_de_formations}
                </span>
                <span class="ncat-cat-n">
                  {thematique.formations_complet.length}
                </span>
                <svg
                  class="ncat-cat-go"
                  viewBox="0 0 10 10"
                  fill="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M4 2.5L6.5 5 4 7.5"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="ncat-stage">
        <div class="ncat-scroll">
          {
            thematiques.map((thematique: any, index: number) => (
              <section
                class={"ncat-group" + (index == 0 ? " is-active" : "")}
                data-cat={thematique.slug}
                style={`--cc:${thematique.couleur_rgb}`}
                aria-label={`Formations ${thematique.titre_de_la_thematique_de_formations}`}
              >
                <div class="ncat-group-head">
                  <div class="ncat-group-id">
                    <h3 class="ncat-group-title">
                      {thematique.titre_de_la_thematique_de_formations}
                    </h3>
                    <p class="ncat-group-desc">{thematique.description}</p>
                  </div>
                  <a
                    class="ncat-group-all"
                    href={`/formations/${thematique.slug}`}
                    role="menuitem"
                    tabindex="-1"
                  >
                    Voir la catégorie
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </a>
                </div>
                <ul class="ncat-list" role="none">
                  {thematique.formations_complet.map((formation: any) => (
                    <li role="none">
                      <a
                        class="ncat-item"
                        role="menuitem"
                        tabindex="-1"
                        href={`/formations/${formation?.thematique.slug}/${formation?.slug}`}
                      >
                        <span class="ncat-dot" aria-hidden="true" />
                        <span>{formation?.titre_de_la_formation}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
        <div class="ncat-void" role="status">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
            ><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"
            ></path><path d="M8.5 8.5l5 5M13.5 8.5l-5 5"></path></svg
          >
          <span>Aucune formation ne correspond à votre recherche.</span>
          <button type="button" class="ncat-void-reset" tabindex="-1"
            >Effacer la recherche</button
          >
        </div>
      </div>
    </div>

    <div class="ncat-foot">
      <span class="ncat-foot-note">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
          ><path d="M12 3l8 3v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3z"
          ></path><path d="M9 11.5l2 2 4-4"></path></svg
        >
        Certifié Qualiopi · Centre d’examen TOSA · Intra &amp; inter-entreprises
      </span>
      <a
        href="/contact?pole=formation&step=2"
        class="ncat-foot-cta"
        role="menuitem"
        tabindex="-1"
        >Conseil personnalisé<svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
        ></a
      >
    </div>
  </div>
</div>
