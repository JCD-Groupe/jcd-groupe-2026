---
import { readItems } from "@directus/sdk";
import { directus } from "../lib/directus";

let thematiques = await directus.request(
  readItems("thematiques_formation", {
    fields: [
      "*",
      {
        formations: [
          "id",
          "titre_de_la_formation",
          "slug",
          {
            thematique: ["*"],
          },
        ],
      },
      {
        formations_bis: [
          {
            formation_id: [
              "id",
              "titre_de_la_formation",
              "slug",
              {
                thematique: ["*"],
              },
            ],
          },
        ],
      },
    ],
  }),
);

let formations = await directus.request(
  readItems("formations", {
    fields: ["id"],
  }),
);

const fetchSvgContent = async (id: string) => {
  if (!id) return null;
  const response = await fetch(
    `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${id}`,
  );
  return response.text();
};

function hexToRgbChannels(hex: string) {
  if (!hex) return "0, 0, 0";
  let cleanHex = hex.replace("#", "");
  if (cleanHex.length === 3) {
    cleanHex = cleanHex
      .split("")
      .map((c) => c + c)
      .join("");
  }
  const num = parseInt(cleanHex, 16);
  return `${(num >> 16) & 255}, ${(num >> 8) & 255}, ${num & 255}`;
}

thematiques = await Promise.all(
  thematiques.map(async (thematique) => {
    return {
      ...thematique,
      couleur_rgb: hexToRgbChannels(thematique.couleur),
      icone_thematique_content: await fetchSvgContent(
        thematique.icone_thematique,
      ),

      formations_complet: await directus.request(
        readItems("formations", {
          fields: [
            "id",
            "titre_de_la_formation",
            "slug",
            {
              thematique: ["*"],
            },
          ],
          filter: {
            _or: [
              {
                thematique: {
                  slug: {
                    _eq: thematique.slug,
                  },
                },
              },
              {
                thematiques_secondaires: {
                  thematiques_formation_id: {
                    slug: {
                      _eq: thematique.slug,
                    },
                  },
                },
              },
            ],
          },
        }),
      ),
    };
  }),
);
